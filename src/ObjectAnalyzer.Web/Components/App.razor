<!DOCTYPE html>
<html lang="zh-CN">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="pages.css" />
    <link rel="stylesheet" href="job-detail.css" />
    <link rel="stylesheet" href="analysis-pages.css" />
    <link rel="stylesheet" href="system-pages.css" />
    <link rel="stylesheet" href="home.css" />
    <link rel="stylesheet" href="nav-menu.css" />
    <link rel="stylesheet" href="reference-ui.css" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <script>
        // 在首次绘制前套用已保存的主题，默认采用 reference UI 的深色工作台风格。
        (function () {
            try {
                var theme = localStorage.getItem('oa-theme') || 'dark';
                document.documentElement.setAttribute('data-bs-theme', theme);
            } catch (e) { /* 隐私模式/禁用存储时忽略 */ }
        })();
    </script>
    <script src="@Assets["lib/chart.js/chart.umd.min.js"]"></script>
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["interop.js"]"></script>
</body>

</html>
