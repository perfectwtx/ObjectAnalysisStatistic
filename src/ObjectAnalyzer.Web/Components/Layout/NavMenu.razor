@using Microsoft.JSInterop
@implements IDisposable
@inject NavigationManager Navigation
@inject IJSRuntime JS

<header class="oa-top-nav" aria-label="主导航">
    <div class="oa-top-nav__inner">
        <a class="oa-top-nav__brand" href="/" aria-label="ObjectAnalyzer 首页">
            <span class="oa-top-nav__mark" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none">
                    <path d="M4 19V5M4 19h16M7 15l3.5-5 2.8 2.4L18 7"
                          stroke="currentColor" stroke-width="1.8"
                          stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </span>
            <span class="oa-top-nav__brand-copy">
                <strong>Object Analyzer</strong>
                <small>Quality</small>
            </span>
        </a>

        <nav class="oa-top-nav__tabs" aria-label="一级导航">
            <div class="oa-top-nav__tabset">
                <a href="/" class="oa-top-nav__tab @(Section == "analysis" ? "is-active" : "")">分析</a>
                <a href="/quality" class="oa-top-nav__tab @(Section == "quality" ? "is-active" : "")">质量</a>
                <a href="/quality/data-lineage" class="oa-top-nav__tab @(Section == "insights" ? "is-active" : "")">洞察</a>
            </div>
        </nav>

        <div class="oa-top-nav__actions">
            <div class="oa-top-nav__search" @onfocusin="OpenSearch" @onfocusout="HandleSearchFocusOut">
                <span class="oa-top-nav__search-icon" aria-hidden="true">⌕</span>
                <input @bind="_searchQuery"
                       @bind:event="oninput"
                       @onkeydown="OnSearchKeyDown"
                       placeholder="搜索页面"
                       aria-label="搜索页面"
                       autocomplete="off" />
                @if (_searchOpen)
                {
                    <div class="oa-top-nav__search-results" role="listbox">
                        @foreach (var item in SearchResults)
                        {
                            <button type="button"
                                    role="option"
                                    class="oa-top-nav__search-item"
                                    @onclick="() => NavigateTo(item.Url)">
                                <span>@item.Label</span>
                                <small>@item.Hint</small>
                            </button>
                        }
                        @if (SearchResults.Count == 0)
                        {
                            <div class="oa-top-nav__search-empty">没有匹配页面</div>
                        }
                    </div>
                }
            </div>

            <div class="oa-top-nav__status" title="本地分析引擎已就绪">
                <span class="oa-top-nav__status-dot"></span>
                <span class="d-none d-xl-inline">Ready</span>
            </div>
            <button class="oa-top-nav__theme" type="button"
                    aria-label="@(_darkTheme ? "切换浅色主题" : "切换深色主题")"
                    title="@(_darkTheme ? "浅色主题" : "深色主题")"
                    @onclick="ToggleTheme">
                @if (_darkTheme)
                {
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.7" />
                        <path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.4-11.4 1.4-1.4"
                              stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                    </svg>
                }
                else
                {
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"
                              stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                }
            </button>
        </div>
    </div>

    @if (SubNav.Count > 0)
    {
        <div class="oa-top-nav__subnav">
            <div class="oa-top-nav__subnav-inner">
                @foreach (var item in SubNav)
                {
                    <a href="@item.Url" class="oa-top-nav__subitem @(IsSubActive(item.Url, item.Exact) ? "is-active" : "")">
                        @item.Label
                    </a>
                }
            </div>
        </div>
    }
</header>

@code {
    private bool _darkTheme = true;
    private string _path = "/";
    private string _searchQuery = string.Empty;
    private bool _searchOpen;

    private string Section => GetSection(_path);

    private IReadOnlyList<SearchItem> SearchResults =>
        string.IsNullOrWhiteSpace(_searchQuery)
            ? SearchItems.Take(6).ToList()
            : SearchItems
                .Where(x => x.Label.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase)
                    || x.Hint.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase)
                    || x.Url.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase))
                .Take(8)
                .ToList();

    private static readonly IReadOnlyList<SearchItem> SearchItems =
    [
        new("/", "分析工作台", "上传或粘贴数据"),
        new("/jobs", "分析作业", "历史分析记录"),
        new("/quality", "质量健康", "质量总览"),
        new("/quality/trend", "质量趋势", "质量分随时间变化"),
        new("/quality/fields", "字段质量", "字段级质量详情"),
        new("/issues", "问题中心", "质量问题与处理状态"),
        new("/quality/baselines", "质量基线", "基线快照"),
        new("/alert-rules", "告警规则", "质量规则与阈值"),
        new("/quality/regression", "质量回归", "两次分析结果对比"),
        new("/issues/responsibility", "责任治理", "问题责任归属"),
        new("/quality/webhooks", "Webhook 投递", "外部事件投递记录"),
        new("/quality/relationships", "字段关系", "字段相关性"),
        new("/quality/object-relationships", "对象关系", "嵌套对象关系"),
        new("/quality/data-lineage", "数据血缘", "对象与字段层级血缘"),
        new("/quality/schema-impact", "Schema 影响", "Schema 变更分析"),
        new("/quality/impact-analysis", "影响分析", "变更传播范围"),
        new("/quality/recommendations", "修复建议", "优先处理建议")
    ];

    private void OpenSearch(FocusEventArgs _)
    {
        _searchOpen = true;
    }

    private void HandleSearchFocusOut(FocusEventArgs _)
    {
        _ = Task.Delay(100).ContinueWith(async _ =>
        {
            await InvokeAsync(() =>
            {
                _searchOpen = false;
                StateHasChanged();
            });
        });
    }

    private void OnSearchKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && SearchResults.Count > 0)
        {
            NavigateTo(SearchResults[0].Url);
        }
        else if (args.Key == "Escape")
        {
            _searchOpen = false;
        }
    }

    private void NavigateTo(string url)
    {
        _searchOpen = false;
        _searchQuery = string.Empty;
        Navigation.NavigateTo(url);
    }


    private IReadOnlyList<NavItem> SubNav => GetSubNav(Section);

    protected override void OnInitialized()
    {
        _path = GetPath();
        Navigation.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _darkTheme = await JS.InvokeAsync<bool>("objectAnalyzer.isDarkTheme");
            await InvokeAsync(StateHasChanged);
        }
        catch (JSException)
        {
            _darkTheme = true;
        }
    }

    private async Task ToggleTheme()
    {
        _darkTheme = !_darkTheme;
        await JS.InvokeVoidAsync("objectAnalyzer.setTheme", _darkTheme ? "dark" : "light");
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        _path = GetPath();
        InvokeAsync(StateHasChanged);
    }

    private string GetPath()
    {
        if (Uri.TryCreate(Navigation.Uri, UriKind.Absolute, out var uri))
        {
            return string.IsNullOrWhiteSpace(uri.AbsolutePath) ? "/" : uri.AbsolutePath;
        }

        return "/";
    }

    private bool IsSubActive(string url, bool exact = false)
    {
        return exact
            ? _path.Equals(url, StringComparison.OrdinalIgnoreCase)
            : _path.Equals(url, StringComparison.OrdinalIgnoreCase)
                || _path.StartsWith(url + "/", StringComparison.OrdinalIgnoreCase);
    }

    private static string GetSection(string path)
    {
        if (IsInsightPath(path))
        {
            return "insights";
        }

        if (path == "/" || path.StartsWith("/jobs", StringComparison.OrdinalIgnoreCase))
        {
            return "analysis";
        }

        return "quality";
    }

    private static bool IsInsightPath(string path)
    {
        string[] insightPaths =
        [
            "/quality/data-lineage",
            "/quality/relationships",
            "/quality/object-relationships",
            "/quality/schema-impact",
            "/quality/impact-analysis",
            "/quality/recommendations"
        ];

        return insightPaths.Any(x => path.Equals(x, StringComparison.OrdinalIgnoreCase)
            || path.StartsWith(x + "/", StringComparison.OrdinalIgnoreCase));
    }

    private static IReadOnlyList<NavItem> GetSubNav(string section)
    {
        return section switch
        {
            "analysis" =>
            [
                new("/", "分析工作台", true),
                new("/jobs", "分析作业")
            ],
            "quality" =>
            [
                new("/quality", "健康", true),
                new("/quality/trend", "趋势"),
                new("/quality/fields", "字段"),
                new("/issues", "问题"),
                new("/quality/baselines", "基线"),
                new("/alert-rules", "告警"),
                new("/quality/regression", "回归"),
                new("/issues/responsibility", "责任"),
                new("/quality/webhooks", "投递")
            ],
            _ =>
            [
                new("/quality/relationships", "字段关系"),
                new("/quality/object-relationships", "对象关系"),
                new("/quality/data-lineage", "血缘"),
                new("/quality/schema-impact", "Schema"),
                new("/quality/impact-analysis", "影响"),
                new("/quality/recommendations", "建议")
            ]
        };
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }

    private sealed record NavItem(string Url, string Label, bool Exact = false);
}
