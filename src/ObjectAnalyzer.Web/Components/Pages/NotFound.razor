@page "/not-found"
@layout MainLayout

<PageTitle>页面未找到</PageTitle>

<div class="oa-system-page">
    <div class="oa-system-card">
        <div class="oa-system-code">404</div>
        <div>
            <div class="oa-eyebrow">PAGE NOT FOUND</div>
            <h1>页面不存在</h1>
            <p>你访问的页面可能已经移动、删除，或者地址输入有误。</p>
            <div class="oa-system-actions">
                <a class="btn btn-primary" href="/">返回首页</a>
                <a class="btn btn-outline-secondary" href="/quality">查看质量总览</a>
            </div>
        </div>
    </div>
</div>