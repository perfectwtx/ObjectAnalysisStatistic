@page "/quality/impact-analysis"
@using System.Text.Json
@using ObjectAnalyzer.Analysis
@using ObjectAnalyzer.Platform
@using ImpactModel = ObjectAnalyzer.Analysis.ImpactAnalysis
@inject IAnalysisHistoryStore HistoryStore

<PageTitle>影响分析</PageTitle>

<div class="oa-analysis-page">
    <div class="oa-analysis-header">
        <div>
            <div class="oa-eyebrow">Quality Analysis</div>
            <h1>影响分析</h1>
            <p>沿当前数据血缘查看 Schema 变更可能影响的父对象、子节点与关联对象。</p>
        </div>
        <a class="btn btn-outline-secondary" href="/quality/data-lineage">查看数据血缘</a>
    </div>

    @if (_loading)
    {
        <div class="alert alert-info">正在加载最近一次分析结果...</div>
    }
    else if (_job is null)
    {
        <div class="card"><div class="oa-empty-state"><strong>暂无成功的分析记录</strong>请先执行一次分析，再查看影响范围。</div></div>
    }
    else if (_impact is null)
    {
        <div class="card"><div class="oa-empty-state"><strong>分析结果无法解析</strong>请检查最近一次成功作业的结果数据。</div></div>
    }
    else
    {
        <div class="row g-3 mb-4">
            <div class="col-sm-6 col-xl-4"><div class="card oa-analysis-kpi h-100"><div class="card-body"><div class="oa-kpi-label">最高影响级别</div><div class="oa-kpi-value">@GetLevelText(_impact.HighestLevel)</div><div class="oa-kpi-meta">当前 Schema 影响范围</div></div></div></div>
            <div class="col-sm-6 col-xl-4"><div class="card oa-analysis-kpi h-100"><div class="card-body"><div class="oa-kpi-label">直接破坏性变更</div><div class="oa-kpi-value">@_impact.BreakingChangeCount</div><div class="oa-kpi-meta">来自 Schema Diff 的直接影响</div></div></div></div>
            <div class="col-sm-6 col-xl-4"><div class="card oa-analysis-kpi h-100"><div class="card-body"><div class="oa-kpi-label">受影响节点</div><div class="oa-kpi-value">@_impact.Nodes.Count</div><div class="oa-kpi-meta">沿数据血缘传播的节点</div></div></div></div>
        </div>

        <div class="card mb-4">
            <div class="card-header">影响传播</div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6"><div class="oa-kpi-label">数据源</div><div class="fw-semibold mt-1 text-break">@_job.SourceName</div></div>
                    <div class="col-md-6"><div class="oa-kpi-label">分析时间</div><div class="fw-semibold mt-1">@_job.StartedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</div></div>
                </div>
                <div class="oa-analysis-note mt-3 rounded">影响分析会把 Schema 变更沿当前数据血缘向父对象和子节点传播，并降低间接影响等级。</div>
            </div>
        </div>

        @if (_impact.Nodes.Count == 0)
        {
            <div class="card"><div class="oa-empty-state"><strong>当前没有检测到需要传播的 Schema 影响</strong>最近一次分析结果没有产生受影响节点。</div></div>
        }
        else
        {
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center"><span>受影响节点</span><span class="badge bg-primary">@_impact.Nodes.Count</span></div>
                <div class="card-body p-0"><div class="table-responsive"><table class="table table-hover align-middle mb-0">
                    <thead><tr><th>路径</th><th>类型</th><th>影响来源</th><th>级别</th><th>原因</th></tr></thead>
                    <tbody>
                    @foreach (var node in _impact.Nodes)
                    {
                        <tr>
                            <td><code>@node.Path</code></td>
                            <td>@GetTypeText(node.Type)</td>
                            <td>@GetSourceText(node.Type)</td>
                            <td><span class="badge @GetLevelClass(node.Level)">@GetLevelText(node.Level)</span></td>
                            <td>@node.Reason</td>
                        </tr>
                    }
                    </tbody>
                </table></div></div>
            </div>
        }
    }
</div>

@code {
    private bool _loading = true;
    private AnalysisJob? _job;
    private ImpactModel? _impact;

    protected override async Task OnInitializedAsync()
    {
        await HistoryStore.InitializeAsync();
        var jobs = await HistoryStore.GetRecentAsync(100);
        _job = jobs.Where(x => x.Status == AnalysisJobStatus.Succeeded && !string.IsNullOrWhiteSpace(x.ResultJson)).OrderByDescending(x => x.StartedAtUtc).FirstOrDefault();
        if (_job is not null)
        {
            try
            {
                var result = JsonSerializer.Deserialize<AnalysisResult>(_job.ResultJson!);
                var lineage = DataLineageBuilder.Build(result?.ObjectRelationships ?? new List<ObjectRelationship>());
                _impact = result is null ? null : ImpactAnalysisBuilder.Build(result.SchemaDiff, lineage);
            }
            catch (JsonException) { _impact = null; }
        }
        _loading = false;
    }

    private static string GetLevelText(ImpactLevel level) => level switch { ImpactLevel.Critical => "严重", ImpactLevel.High => "高", ImpactLevel.Medium => "中", _ => "低" };
    private static string GetLevelClass(ImpactLevel level) => level switch { ImpactLevel.Critical => "bg-danger", ImpactLevel.High => "bg-warning text-dark", ImpactLevel.Medium => "bg-info text-dark", _ => "bg-secondary" };
    private static string GetTypeText(ImpactType type) => type switch { ImpactType.ParentObject => "父对象", ImpactType.ChildNode => "子节点", ImpactType.RelatedObject => "关联对象", _ => "Schema 字段" };
    private static string GetSourceText(ImpactType type) => type switch { ImpactType.ParentObject => "父级血缘", ImpactType.ChildNode => "子级血缘", ImpactType.RelatedObject => "关系血缘", _ => "Schema Diff" };
}
