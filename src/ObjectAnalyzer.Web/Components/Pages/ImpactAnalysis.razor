@page "/quality/impact-analysis"
@using System.Text.Json
@using Microsoft.AspNetCore.Components
@using ObjectAnalyzer.Analysis
@using ObjectAnalyzer.Platform
@using ImpactModel = ObjectAnalyzer.Analysis.ImpactAnalysis
@inject IAnalysisHistoryStore HistoryStore

<PageTitle>影响分析</PageTitle>

<div class="oa-analysis-page oa-impact-analysis-page">
    <div class="oa-analysis-header">
        <div>
            <div class="oa-eyebrow">IMPACT ANALYSIS</div>
            <h1>影响分析</h1>
            <p>沿当前数据血缘查看 Schema 变更可能影响的父对象、子节点与关联对象。</p>
        </div>
        <div class="oa-header-actions">
            <a class="btn btn-outline-secondary" href="@SchemaImpactUrl">Schema 影响</a>
            <a class="btn btn-outline-secondary" href="@DataLineageUrl">查看数据血缘</a>
            <a class="btn btn-outline-secondary" href="@RegressionUrl">质量回归</a>
            @if (_job is not null)
            {
                <a class="btn btn-outline-primary" href="@($"/jobs/{_job.Id}")">当前作业</a>
            }
        </div>
    </div>

    @if (_loading)
    {
        <div class="oa-panel oa-empty-state"><div class="oa-empty-icon">…</div><strong>正在加载最近一次分析结果</strong><span>正在计算 Schema 变更的传播范围。</span></div>
    }
    else if (_job is null)
    {
        <div class="oa-panel oa-empty-state"><div class="oa-empty-icon">!</div><strong>暂无成功的分析记录</strong><span>请先执行一次分析，再查看影响范围。</span></div>
    }
    else
    {
        <section class="oa-panel oa-impact-filter-card">
            <div class="oa-panel-body">
                <div class="oa-impact-filter-grid">
                    <div>
                        <label class="form-label">分析任务</label>
                        <select class="form-select" @onchange="OnJobChanged">
                            @foreach (var job in _jobs)
                            {
                                <option value="@job.Id" selected="@(job.Id == _job?.Id)">@job.SourceName · @job.StartedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="form-label">影响级别</label>
                        <select class="form-select" @onchange="OnLevelChanged">
                            <option value="">全部级别</option>
                            <option value="Critical" selected="@(LevelFilter == "Critical")">严重</option>
                            <option value="High" selected="@(LevelFilter == "High")">高</option>
                            <option value="Medium" selected="@(LevelFilter == "Medium")">中</option>
                            <option value="Low" selected="@(LevelFilter == "Low")">低</option>
                        </select>
                    </div>
                    <div>
                        <label class="form-label">节点类型</label>
                        <select class="form-select" @onchange="OnTypeChanged">
                            <option value="">全部类型</option>
                            <option value="SchemaChange" selected="@(TypeFilter == "SchemaChange")">Schema 字段</option>
                            <option value="ParentObject" selected="@(TypeFilter == "ParentObject")">父对象</option>
                            <option value="ChildNode" selected="@(TypeFilter == "ChildNode")">子节点</option>
                            <option value="RelatedObject" selected="@(TypeFilter == "RelatedObject")">关联对象</option>
                        </select>
                    </div>
                    <div>
                        <label class="form-label">路径搜索</label>
                        <input class="form-control" value="@PathFilter" @oninput="OnPathChanged" placeholder="搜索受影响路径" />
                    </div>
                </div>
            </div>
        </section>

        @if (_impact is null)
        {
            <div class="oa-panel oa-empty-state">
                <div class="oa-empty-icon">!</div>
                <strong>分析结果无法解析</strong>
                <span>当前分析任务没有可用的影响分析结果。可以切换上方分析任务继续查看。</span>
            </div>
        }
        else
        {
        <div class="oa-kpi-grid is-3">
            <div class="oa-kpi-card"><span>最高影响级别</span><strong class="@GetLevelClass(_impact.HighestLevel)">@GetLevelText(_impact.HighestLevel)</strong><small>当前 Schema 影响范围</small></div>
            <div class="oa-kpi-card is-danger"><span>直接破坏性变更</span><strong>@_impact.BreakingChangeCount</strong><small>来自 Schema Diff 的直接影响</small></div>
            <div class="oa-kpi-card"><span>受影响节点</span><strong>@FilteredNodes.Count</strong><small>当前筛选节点 / @_impact.Nodes.Count 总节点</small></div>
        </div>

        <div class="oa-panel mb-4">
            <div class="oa-panel-header">
                <div><div class="oa-panel-kicker">PROPAGATION</div><h2>影响传播</h2></div>
            </div>
            <div class="oa-panel-body">
                <div class="oa-context-grid is-compact">
                    <div><span>数据源</span><strong title="@_job!.SourceName">@_job!.SourceName</strong></div>
                    <div><span>分析时间</span><strong>@_job!.StartedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</strong></div>
                </div>
                <div class="oa-analysis-note">影响分析会把 Schema 变更沿当前数据血缘向父对象和子节点传播，并降低间接影响等级。</div>
            </div>
        </div>

        @if (_impact.Nodes.Count == 0)
        {
            <div class="oa-panel oa-empty-state"><div class="oa-empty-icon">✓</div><strong>当前没有检测到需要传播的 Schema 影响</strong><span>最近一次分析结果没有产生受影响节点。</span></div>
        }
        else
        {
            <div class="oa-panel">
                <div class="oa-panel-header">
                    <div><div class="oa-panel-kicker">AFFECTED NODES</div><h2>受影响节点</h2></div>
                    <span class="oa-count-badge">@FilteredNodes.Count 个</span>
                </div>
                <div class="oa-table-wrap oa-impact-table-wrap">
                    <table class="table table-hover align-middle mb-0 oa-analysis-table">
                        <thead><tr><th>路径</th><th>类型</th><th>影响来源</th><th>级别</th><th>原因</th></tr></thead>
                        <tbody>
                        @foreach (var node in FilteredNodes)
                        {
                            <tr>
                                <td class="oa-impact-path"><code>@node.Path</code></td>
                                <td><span class="oa-impact-type">@GetTypeText(node.Type)</span></td>
                                <td>@GetSourceText(node.Type)</td>
                                <td><span class="oa-badge @GetLevelClass(node.Level)">@GetLevelText(node.Level)</span></td>
                                <td class="oa-impact-reason">@node.Reason</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        }
    }
</div>

@code {
    private readonly List<AnalysisJob> _jobs = new();
    private bool _loading = true;
    private AnalysisJob? _job;
    private ImpactModel? _impact;
    [SupplyParameterFromQuery(Name = "jobId")]
    public Guid? JobId { get; set; }

    private string? LevelFilter;
    private string? TypeFilter;
    private string? PathFilter;

    private string DataLineageUrl => _job is null ? "/quality/data-lineage" : $"/quality/data-lineage?jobId={_job.Id}";
    private string SchemaImpactUrl => _job is null ? "/quality/schema-impact" : $"/quality/schema-impact?jobId={_job!.Id}";
    private string RegressionUrl => _job is null ? "/quality/regression" : $"/quality/regression?jobId={_job.Id}";

    private IReadOnlyList<ImpactedNode> FilteredNodes => (_impact?.Nodes ?? new List<ImpactedNode>())
        .Where(x => string.IsNullOrWhiteSpace(LevelFilter) || string.Equals(x.Level.ToString(), LevelFilter, StringComparison.OrdinalIgnoreCase))
        .Where(x => string.IsNullOrWhiteSpace(TypeFilter) || string.Equals(x.Type.ToString(), TypeFilter, StringComparison.OrdinalIgnoreCase))
        .Where(x => string.IsNullOrWhiteSpace(PathFilter) || x.Path.Contains(PathFilter, StringComparison.OrdinalIgnoreCase))
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        await HistoryStore.InitializeAsync();
        var jobs = await HistoryStore.GetRecentAsync(100);
        _jobs.AddRange(jobs.Where(x => x.Status == AnalysisJobStatus.Succeeded && !string.IsNullOrWhiteSpace(x.ResultJson)).OrderByDescending(x => x.StartedAtUtc));
        _job = JobId.HasValue ? _jobs.FirstOrDefault(x => x.Id == JobId.Value) : _jobs.FirstOrDefault();
        if (_job is not null)
        {
            try
            {
                var result = JsonSerializer.Deserialize<AnalysisResult>(_job.ResultJson!);
                var lineage = DataLineageBuilder.Build(result?.ObjectRelationships ?? new List<ObjectRelationship>());
                _impact = result is null ? null : ImpactAnalysisBuilder.Build(result.SchemaDiff, lineage);
            }
            catch (JsonException) { _impact = null; }
        }
        _loading = false;
    }

    private async Task OnJobChanged(ChangeEventArgs args)
    {
        if (!Guid.TryParse(args.Value?.ToString(), out var id))
            return;

        _job = _jobs.FirstOrDefault(x => x.Id == id);
        _impact = null;
        if (_job is not null)
        {
            try
            {
                var result = JsonSerializer.Deserialize<AnalysisResult>(_job.ResultJson!);
                var lineage = DataLineageBuilder.Build(result?.ObjectRelationships ?? new List<ObjectRelationship>());
                _impact = result is null ? null : ImpactAnalysisBuilder.Build(result.SchemaDiff, lineage);
            }
            catch (JsonException)
            {
                _impact = null;
            }
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task OnLevelChanged(ChangeEventArgs args)
    {
        LevelFilter = args.Value?.ToString();
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnTypeChanged(ChangeEventArgs args)
    {
        TypeFilter = args.Value?.ToString();
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnPathChanged(ChangeEventArgs args)
    {
        PathFilter = args.Value?.ToString();
        await InvokeAsync(StateHasChanged);
    }

    private static string GetLevelText(ImpactLevel level) => level switch { ImpactLevel.Critical => "严重", ImpactLevel.High => "高", ImpactLevel.Medium => "中", _ => "低" };
    private static string GetLevelClass(ImpactLevel level) => level switch { ImpactLevel.Critical => "is-danger", ImpactLevel.High => "is-warning", ImpactLevel.Medium => "is-info", _ => "is-neutral" };
    private static string GetTypeText(ImpactType type) => type switch { ImpactType.ParentObject => "父对象", ImpactType.ChildNode => "子节点", ImpactType.RelatedObject => "关联对象", _ => "Schema 字段" };
    private static string GetSourceText(ImpactType type) => type switch { ImpactType.ParentObject => "父级血缘", ImpactType.ChildNode => "子级血缘", ImpactType.RelatedObject => "关系血缘", _ => "Schema Diff" };
}
