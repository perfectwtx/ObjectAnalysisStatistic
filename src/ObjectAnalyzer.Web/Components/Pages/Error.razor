@page "/Error"
@using System.Diagnostics

<PageTitle>发生错误</PageTitle>

<div class="oa-system-page">
    <div class="oa-system-card oa-system-card-error">
        <div class="oa-system-code">!</div>
        <div>
            <div class="oa-eyebrow">APPLICATION ERROR</div>
            <h1>页面处理时发生错误</h1>
            <p>应用在处理当前请求时遇到了异常。请重新加载页面后再试。</p>

            @if (ShowRequestId)
            {
                <div class="oa-request-id">
                    <span>Request ID</span>
                    <code>@RequestId</code>
                </div>
            }

            <details class="oa-error-help">
                <summary>本地调试提示</summary>
                <p>开发环境可以显示更详细的异常信息，但生产环境不建议启用 Development，以避免向用户暴露敏感信息。</p>
            </details>

            <div class="oa-system-actions">
                <a class="btn btn-primary" href="/">返回首页</a>
                <button class="btn btn-outline-secondary" onclick="location.reload()">重新加载</button>
            </div>
        </div>
    </div>
</div>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
