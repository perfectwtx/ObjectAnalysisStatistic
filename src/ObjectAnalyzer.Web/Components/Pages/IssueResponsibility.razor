@page "/issues/responsibility"
@using ObjectAnalyzer.Platform
@inject IAnalysisHistoryStore HistoryStore
@inject IQualityIssueQuery QualityIssueQuery
@inject IQualityIssueResponsibilityStore ResponsibilityStore
@inject IQualityIssueRemediationStore RemediationStore

<PageTitle>问题责任与整改</PageTitle>

<div class="oa-analysis-page oa-responsibility-page">
    <div class="oa-analysis-header">
        <div>
            <div class="oa-eyebrow">ISSUE MANAGEMENT</div>
            <h1>问题责任与整改</h1>
            <p>为质量问题指定责任人，记录整改措施，并跟踪整改闭环。</p>
        </div>
        <button class="btn btn-outline-secondary" @onclick="LoadAsync">刷新</button>
    </div>

    @if (_loading)
    {
        <div class="oa-empty-state">
            <div class="oa-empty-icon">↻</div>
            <h3>正在加载问题数据</h3>
            <p>正在读取最近一次成功的分析任务。</p>
        </div>
    }
    else if (_jobs.Count == 0)
    {
        <div class="oa-empty-state">
            <div class="oa-empty-icon">✓</div>
            <h3>暂无可处理的分析任务</h3>
            <p>完成一次成功的分析后，这里会显示对应的质量问题与整改记录。</p>
        </div>
    }
    else
    {
        <section class="oa-panel oa-job-selector-card">
            <div class="oa-panel-header">
                <div>
                    <div class="oa-panel-kicker">CURRENT RUN</div>
                    <h2>分析任务</h2>
                </div>
                <span class="oa-count-badge">@_jobs.Count 个任务</span>
            </div>
            <div class="oa-panel-body">
                <label class="form-label">选择分析任务</label>
                <select class="form-select" @onchange="OnJobChanged">
                    @foreach (var job in _jobs)
                    {
                        <option value="@job.Id" selected="@(job.Id == _selectedJob?.Id)">@job.SourceName · @job.StartedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</option>
                    }
                </select>
            </div>
        </section>

        <div class="oa-kpi-grid is-4">
            <div class="oa-kpi-card">
                <span>质量问题</span>
                <strong>@_issues.Count</strong>
                <small>当前分析发现的问题</small>
            </div>
            <div class="oa-kpi-card">
                <span>已指定责任人</span>
                <strong>@_items.Count(x => !string.IsNullOrWhiteSpace(x.Owner))</strong>
                <small>已有责任归属的问题</small>
            </div>
            <div class="oa-kpi-card">
                <span>处理中</span>
                <strong>@_items.Count(x => x.Status == "InProgress")</strong>
                <small>责任状态为处理中</small>
            </div>
            <div class="oa-kpi-card">
                <span>整改记录</span>
                <strong>@_items.Sum(x => x.Remediations.Count)</strong>
                <small>已记录的整改措施</small>
            </div>
        </div>

        @if (_issues.Count == 0)
        {
            <div class="oa-empty-state oa-empty-state-success">
                <div class="oa-empty-icon">✓</div>
                <h3>当前分析没有质量问题</h3>
                <p>无需分配责任，也暂无需要跟踪的整改事项。</p>
            </div>
        }
        else
        {
            <section class="oa-panel oa-responsibility-panel">
                <div class="oa-panel-header">
                    <div>
                        <div class="oa-panel-kicker">RESPONSIBILITY & REMEDIATION</div>
                        <h2>问题责任清单</h2>
                    </div>
                    <span class="oa-count-badge">@_items.Count 个问题</span>
                </div>
                <div class="oa-table-wrap">
                    <table class="table oa-analysis-table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>字段</th>
                                <th>检查类型</th>
                                <th>次数</th>
                                <th>责任人</th>
                                <th>状态</th>
                                <th>备注</th>
                                <th class="oa-action-column"></th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var item in _items)
                        {
                            <tr class="oa-issue-row">
                                <td><strong>@item.Issue.FieldName</strong></td>
                                <td><span class="oa-badge is-warning">@item.Issue.Check</span></td>
                                <td><span class="oa-number-value">@item.Issue.Count</span></td>
                                <td class="oa-edit-cell"><input class="form-control form-control-sm" @bind="item.Owner" placeholder="责任人" /></td>
                                <td class="oa-edit-cell">
                                    <select class="form-select form-select-sm" @bind="item.Status">
                                        <option value="Open">待处理</option>
                                        <option value="InProgress">处理中</option>
                                        <option value="Resolved">已解决</option>
                                        <option value="Ignored">已忽略</option>
                                    </select>
                                </td>
                                <td class="oa-edit-cell"><input class="form-control form-control-sm" @bind="item.Comment" placeholder="处理备注" /></td>
                                <td class="oa-action-column"><button class="btn btn-sm btn-primary" @onclick="() => SaveAsync(item)">保存</button></td>
                            </tr>
                            <tr class="oa-remediation-row">
                                <td colspan="7">
                                    <div class="oa-remediation">
                                        <div class="oa-remediation-header">
                                            <div>
                                                <strong>整改记录</strong>
                                                <span>@item.Remediations.Count 条</span>
                                            </div>
                                            <button class="btn btn-sm btn-outline-primary" @onclick="() => StartRemediation(item)">新增整改</button>
                                        </div>

                                        @if (item.Remediations.Count == 0 && !item.AddingRemediation)
                                        {
                                            <div class="oa-inline-empty">暂无整改记录。</div>
                                        }

                                        @if (item.AddingRemediation)
                                        {
                                            <div class="oa-remediation-editor">
                                                <div class="row g-3">
                                                    <div class="col-md-5">
                                                        <label class="form-label">整改措施</label>
                                                        <input class="form-control form-control-sm" @bind="item.RemediationAction" placeholder="例如：补齐缺失数据并增加校验" />
                                                    </div>
                                                    <div class="col-md-2">
                                                        <label class="form-label">状态</label>
                                                        <select class="form-select form-select-sm" @bind="item.RemediationStatus">
                                                            <option value="Planned">计划中</option>
                                                            <option value="InProgress">处理中</option>
                                                            <option value="Completed">已完成</option>
                                                        </select>
                                                    </div>
                                                    <div class="col-md-2">
                                                        <label class="form-label">截止日期</label>
                                                        <input type="date" class="form-control form-control-sm" @bind="item.RemediationDueDate" />
                                                    </div>
                                                    <div class="col-md-3">
                                                        <label class="form-label">备注</label>
                                                        <input class="form-control form-control-sm" @bind="item.RemediationComment" placeholder="整改说明" />
                                                    </div>
                                                </div>
                                                <div class="oa-editor-actions">
                                                    <button class="btn btn-sm btn-primary" @onclick="() => SaveRemediationAsync(item)">保存整改</button>
                                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => CancelRemediation(item)">取消</button>
                                                </div>
                                            </div>
                                        }

                                        @if (item.Remediations.Count > 0)
                                        {
                                            <div class="oa-table-wrap oa-remediation-table">
                                                <table class="table table-sm oa-analysis-table mb-0">
                                                    <thead>
                                                        <tr>
                                                            <th>整改措施</th>
                                                            <th>状态</th>
                                                            <th>截止日期</th>
                                                            <th>完成时间</th>
                                                            <th>备注</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                    @foreach (var remediation in item.Remediations)
                                                    {
                                                        <tr>
                                                            <td>@remediation.Action</td>
                                                            <td>@GetRemediationStatusText(remediation.Status)</td>
                                                            <td>@FormatDate(remediation.DueAtUtc)</td>
                                                            <td>@FormatDateTime(remediation.CompletedAtUtc)</td>
                                                            <td>@remediation.Comment</td>
                                                        </tr>
                                                    }
                                                    </tbody>
                                                </table>
                                            </div>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </section>
        }

        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div class="alert alert-success oa-feedback">@_message</div>
        }
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="alert alert-danger oa-feedback">@_error</div>
        }
    }
</div>

@code {
    private readonly List<AnalysisJob> _jobs = new();
    private readonly List<IssueItem> _items = new();
    private List<QualityIssue> _issues = new();
    private AnalysisJob? _selectedJob;
    private bool _loading;
    private string? _message;
    private string? _error;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _message = null;
        _error = null;
        try
        {
            _jobs.Clear();
            _jobs.AddRange((await HistoryStore.GetRecentAsync(100))
                .Where(x => x.Status == AnalysisJobStatus.Succeeded)
                .OrderByDescending(x => x.StartedAtUtc));
            _selectedJob = _jobs.FirstOrDefault();
            await LoadIssuesAsync(_selectedJob);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnJobChanged(ChangeEventArgs args)
    {
        if (Guid.TryParse(args.Value?.ToString(), out var id))
        {
            _selectedJob = _jobs.FirstOrDefault(x => x.Id == id);
            await LoadIssuesAsync(_selectedJob);
        }
    }

    private async Task LoadIssuesAsync(AnalysisJob? job)
    {
        _issues = job is null ? new List<QualityIssue>() : (await QualityIssueQuery.GetByJobAsync(job.Id)).ToList();
        _items.Clear();
        if (job is null)
            return;

        var responsibilities = await ResponsibilityStore.GetByJobAsync(job.Id);
        foreach (var issue in _issues)
        {
            var responsibility = responsibilities.FirstOrDefault(x =>
                string.Equals(x.FieldName, issue.FieldName, StringComparison.OrdinalIgnoreCase) &&
                string.Equals(x.Check, issue.Check, StringComparison.OrdinalIgnoreCase));
            var remediations = await RemediationStore.GetByIssueAsync(issue.JobId, issue.FieldName, issue.Check);
            _items.Add(new IssueItem
            {
                Issue = issue,
                Owner = responsibility?.Owner,
                Status = responsibility?.Status ?? "Open",
                Comment = responsibility?.Comment,
                Remediations = remediations.ToList()
            });
        }
    }

    private async Task SaveAsync(IssueItem item)
    {
        _message = null;
        _error = null;
        try
        {
            var responsibility = new QualityIssueResponsibility(
                item.Issue.JobId,
                item.Issue.FieldName,
                item.Issue.Check,
                string.IsNullOrWhiteSpace(item.Owner) ? null : item.Owner.Trim(),
                item.Status,
                string.IsNullOrWhiteSpace(item.Comment) ? null : item.Comment.Trim(),
                DateTime.UtcNow);
            responsibility.Validate();
            await ResponsibilityStore.SaveAsync(responsibility);
            _message = $"已保存：{item.Issue.FieldName} / {item.Issue.Check}";
        }
        catch (ArgumentException ex)
        {
            _error = ex.Message;
        }
    }

    private void StartRemediation(IssueItem item)
    {
        _message = null;
        _error = null;
        item.AddingRemediation = true;
        item.RemediationAction = null;
        item.RemediationStatus = "Planned";
        item.RemediationDueDate = null;
        item.RemediationComment = null;
    }

    private void CancelRemediation(IssueItem item) => item.AddingRemediation = false;

    private async Task SaveRemediationAsync(IssueItem item)
    {
        _message = null;
        _error = null;
        try
        {
            var completed = string.Equals(item.RemediationStatus, "Completed", StringComparison.OrdinalIgnoreCase)
                ? (DateTime?)DateTime.UtcNow
                : null;
            var remediation = new QualityIssueRemediation(
                Guid.NewGuid(),
                item.Issue.JobId,
                item.Issue.FieldName,
                item.Issue.Check,
                item.RemediationAction?.Trim() ?? string.Empty,
                item.RemediationStatus,
                item.RemediationDueDate?.ToUniversalTime(),
                completed,
                string.IsNullOrWhiteSpace(item.RemediationComment) ? null : item.RemediationComment.Trim())
            {
                CreatedAtUtc = DateTime.UtcNow
            };
            remediation.Validate();
            await RemediationStore.SaveAsync(remediation);
            item.Remediations.Insert(0, remediation);
            item.AddingRemediation = false;
            _message = $"已新增整改：{item.Issue.FieldName} / {item.Issue.Check}";
        }
        catch (ArgumentException ex)
        {
            _error = ex.Message;
        }
    }

    private static string GetRemediationStatusText(string status) => status switch
    {
        "Planned" => "计划中",
        "InProgress" => "处理中",
        "Completed" => "已完成",
        _ => status
    };

    private static string FormatDate(DateTime? value) => value?.ToLocalTime().ToString("yyyy-MM-dd") ?? "-";
    private static string FormatDateTime(DateTime? value) => value?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "-";

    private sealed class IssueItem
    {
        public required QualityIssue Issue { get; init; }
        public string? Owner { get; set; }
        public string Status { get; set; } = "Open";
        public string? Comment { get; set; }
        public List<QualityIssueRemediation> Remediations { get; init; } = new();
        public bool AddingRemediation { get; set; }
        public string? RemediationAction { get; set; }
        public string RemediationStatus { get; set; } = "Planned";
        public DateTime? RemediationDueDate { get; set; }
        public string? RemediationComment { get; set; }
    }
}
