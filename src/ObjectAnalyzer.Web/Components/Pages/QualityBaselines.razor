@page "/quality/baselines"
@using System.Text.Json
@using ObjectAnalyzer.Platform
@inject IAnalysisHistoryStore HistoryStore
@inject IQualityBaselineStore BaselineStore

<PageTitle>质量基线</PageTitle>

<div class="oa-analysis-page oa-baselines-page">
    <div class="oa-analysis-header">
        <div>
            <div class="oa-eyebrow">Quality Governance</div>
            <h1>质量基线</h1>
            <p>按数据源设置最低质量要求，分析完成后会自动记录本次基线评估结果。</p>
        </div>
        <div class="oa-header-actions"><a class="btn btn-outline-secondary" href="/quality">质量总览</a><a class="btn btn-outline-secondary" href="/quality/trend">质量趋势</a><a class="btn btn-outline-secondary" href="/jobs">作业中心</a><button class="btn btn-primary oa-header-action" @onclick="CreateAsync">新增基线</button></div>
    </div>

    @if (_loading)
    {
        <div class="oa-panel oa-empty-state"><div class="oa-empty-content">
                <div class="oa-empty-icon">◌</div>
                <strong>正在加载质量基线</strong>
                <span>正在读取已配置的数据源基线。</span>
            </div>
        </div>
    }
    else if (_baselines.Count == 0)
    {
        <div class="oa-panel oa-empty-state"><div class="oa-empty-content">
                <div class="oa-empty-icon">∅</div>
                <strong>暂无质量基线</strong>
                <span>未配置基线的数据源不会受到额外约束，可以点击右上角新增基线。</span>
            </div>
        </div>
    }
    else
    {
        <div class="oa-panel oa-baseline-list-panel">
            <div class="oa-panel-body">
                <div class="oa-baseline-summary"><div><span>已配置</span><strong>@FilteredBaselines.Count</strong></div><div><span>最近通过</span><strong>@FilteredBaselines.Count(x => GetLatestEvaluation(x.SourceName)?.Passed == true)</strong></div><div><span>最近未通过</span><strong>@FilteredBaselines.Count(x => GetLatestEvaluation(x.SourceName)?.Passed == false)</strong></div></div>
                <div class="oa-panel-header oa-baseline-panel-header">
                    <div>
                        <h2>已配置基线</h2>
                        <span>@FilteredBaselines.Count 个数据源</span>
                    </div>
                </div>
                <div class="oa-baseline-table-wrap">
                    <table class="table align-middle mb-0 oa-baseline-table">
                        <thead>
                            <tr>
                                <th>数据源</th>
                                <th>综合</th>
                                <th>完整性</th>
                                <th>有效性</th>
                                <th>唯一性</th>
                                <th>一致性</th>
                                <th>异常控制</th>
                                <th>最近评估</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var baseline in FilteredBaselines)
                        {
                            <tr>
                                <td class="oa-baseline-source"><strong>@baseline.SourceName</strong></td>
                                <td class="oa-baseline-score">@Format(baseline.MinimumOverallScore)</td>
                                <td class="oa-baseline-score">@Format(baseline.MinimumCompleteness)</td>
                                <td class="oa-baseline-score">@Format(baseline.MinimumValidity)</td>
                                <td class="oa-baseline-score">@Format(baseline.MinimumUniqueness)</td>
                                <td class="oa-baseline-score">@Format(baseline.MinimumConsistency)</td>
                                <td class="oa-baseline-score">@Format(baseline.MinimumAnomalyControl)</td>
                                <td>@RenderEvaluation(baseline.SourceName)</td>
                                <td class="oa-baseline-actions">
                                    <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => Edit(baseline)">编辑</button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(baseline.SourceName)">删除</button>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    @if (_editing is not null)
    {
        <div class="oa-panel oa-editor-card oa-baseline-editor">
            <div class="oa-panel-header">
                <div>
                    <h2>@(_isNew ? "新增质量基线" : "编辑质量基线")</h2>
                    <span>设置各质量维度的最低允许分数</span>
                </div>
            </div>
            <div class="oa-panel-body">
                <div class="oa-baseline-editor-grid">
                    <div>
                        <label class="form-label">数据源名称</label>
                        <input class="form-control" @bind="_editing.SourceName" disabled="@(!_isNew)" />
                        @if (!_isNew)
                        {
                            <div class="form-text">数据源名称是基线的唯一键。</div>
                        }
                    </div>
                    <div>
                        <label class="form-label">最低综合分</label>
                        <InputNumber class="form-control" @bind-Value="_editing.MinimumOverallScore" />
                    </div>
                    <div>
                        <label class="form-label">最低完整性</label>
                        <InputNumber class="form-control" @bind-Value="_editing.MinimumCompleteness" />
                    </div>
                    <div>
                        <label class="form-label">最低有效性</label>
                        <InputNumber class="form-control" @bind-Value="_editing.MinimumValidity" />
                    </div>
                    <div>
                        <label class="form-label">最低唯一性</label>
                        <InputNumber class="form-control" @bind-Value="_editing.MinimumUniqueness" />
                    </div>
                    <div>
                        <label class="form-label">最低一致性</label>
                        <InputNumber class="form-control" @bind-Value="_editing.MinimumConsistency" />
                    </div>
                    <div>
                        <label class="form-label">最低异常控制</label>
                        <InputNumber class="form-control" @bind-Value="_editing.MinimumAnomalyControl" />
                    </div>
                </div>
                @if (!string.IsNullOrWhiteSpace(_error))
                {
                    <div class="oa-baseline-error">@_error</div>
                }
                <div class="oa-editor-actions">
                    <button class="btn btn-primary" @onclick="SaveAsync">保存</button>
                    <button class="btn btn-outline-secondary" @onclick="Cancel">取消</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private readonly List<QualityBaseline> _baselines = new();
    private readonly Dictionary<string, QualityBaselineEvaluation> _latestEvaluations = new(StringComparer.OrdinalIgnoreCase);
    private IReadOnlyList<QualityBaseline> FilteredBaselines => _baselines;
    private IReadOnlyList<AnalysisJob> _recentJobs = Array.Empty<AnalysisJob>();
    private QualityBaselineEditor? _editing;
    private bool _isNew;
    private bool _loading;
    private string? _error;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _baselines.Clear();
            _baselines.AddRange(await BaselineStore.GetAllAsync());
            _latestEvaluations.Clear();
            _recentJobs = await HistoryStore.GetRecentAsync(100);
            foreach (var job in _recentJobs)
            {
                if (string.IsNullOrWhiteSpace(job.QualityBaselineEvaluationJson) || _latestEvaluations.ContainsKey(job.SourceName)) continue;
                try
                {
                    var evaluation = JsonSerializer.Deserialize<QualityBaselineEvaluation>(job.QualityBaselineEvaluationJson);
                    if (evaluation is not null) _latestEvaluations[job.SourceName] = evaluation;
                }
                catch (JsonException) { }
            }
        }
        finally
        {
            _loading = false;
        }
    }

    private Task CreateAsync()
    {
        _isNew = true;
        _error = null;
        _editing = new QualityBaselineEditor();
        return Task.CompletedTask;
    }

    private void Edit(QualityBaseline baseline)
    {
        _isNew = false;
        _error = null;
        _editing = QualityBaselineEditor.From(baseline);
    }

    private async Task SaveAsync()
    {
        if (_editing is null) return;
        try
        {
            var baseline = _editing.ToModel();
            baseline.Validate();
            await BaselineStore.SaveAsync(baseline);
            _editing = null;
            _error = null;
            await LoadAsync();
        }
        catch (ArgumentException ex)
        {
            _error = ex.Message;
        }
    }

    private void Cancel()
    {
        _editing = null;
        _error = null;
    }

    private async Task DeleteAsync(string sourceName)
    {
        await BaselineStore.DeleteAsync(sourceName);
        if (string.Equals(_editing?.SourceName, sourceName, StringComparison.OrdinalIgnoreCase))
            Cancel();
        await LoadAsync();
    }

    private QualityBaselineEvaluation? GetLatestEvaluation(string sourceName) => _latestEvaluations.TryGetValue(sourceName, out var evaluation) ? evaluation : null;

    private RenderFragment RenderEvaluation(string sourceName) => builder =>
    {
        var evaluation = GetLatestEvaluation(sourceName);
        if (evaluation is null)
        {
            builder.AddContent(0, "尚无评估");
            return;
        }
        builder.OpenElement(1, "span");
        builder.AddAttribute(2, "class", $"oa-baseline-evaluation {(evaluation.Passed ? "is-pass" : "is-fail")}");
        builder.AddContent(3, evaluation.Passed ? "通过" : $"未通过 · {evaluation.Failures.Count} 项");
        builder.CloseElement();
    };

    private static string Format(double? value) => value.HasValue ? $"{value.Value:F1}" : "不限制";

    private sealed class QualityBaselineEditor
    {
        public string SourceName { get; set; } = "";
        public double? MinimumOverallScore { get; set; } = 90;
        public double? MinimumCompleteness { get; set; } = 90;
        public double? MinimumValidity { get; set; } = 90;
        public double? MinimumUniqueness { get; set; } = 90;
        public double? MinimumConsistency { get; set; } = 90;
        public double? MinimumAnomalyControl { get; set; } = 90;

        public QualityBaseline ToModel() => new(
            SourceName,
            MinimumOverallScore,
            MinimumCompleteness,
            MinimumValidity,
            MinimumUniqueness,
            MinimumConsistency,
            MinimumAnomalyControl);

        public static QualityBaselineEditor From(QualityBaseline baseline) => new()
        {
            SourceName = baseline.SourceName,
            MinimumOverallScore = baseline.MinimumOverallScore,
            MinimumCompleteness = baseline.MinimumCompleteness,
            MinimumValidity = baseline.MinimumValidity,
            MinimumUniqueness = baseline.MinimumUniqueness,
            MinimumConsistency = baseline.MinimumConsistency,
            MinimumAnomalyControl = baseline.MinimumAnomalyControl
        };
    }
}