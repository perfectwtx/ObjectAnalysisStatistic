@page "/issues"
@using Microsoft.AspNetCore.Components
@using ObjectAnalyzer.Platform
@inject IAnalysisHistoryStore HistoryStore
@inject IQualityIssueQuery QualityIssueQuery

<PageTitle>Issue Center</PageTitle>

<div class="oa-analysis-page oa-issues-page">
    @if (!string.IsNullOrWhiteSpace(_fieldFilter))
    {
        <div class="oa-filter-context">
            <span>字段筛选</span>
            <strong>@_fieldFilter</strong>
            <a href="/issues">清除筛选</a>
        </div>
    }
    <div class="oa-analysis-header">
        <div>
            <div class="oa-eyebrow">QUALITY MONITORING</div>
            <h1>质量问题中心</h1>
            <p>按分析任务查看标准化字段级质量问题，定位影响质量分的问题来源。</p>
        </div>
        <button class="btn btn-outline-primary" @onclick="LoadAsync">刷新</button>
    </div>

    @if (_loading)
    {
        <div class="oa-panel oa-empty-state oa-loading-state"><div class="oa-empty-icon">◌</div><strong>正在加载问题中心</strong><span>正在读取最近一次分析结果。</span></div>
    }
    else if (_jobs.Count == 0)
    {
        <div class="oa-empty-state">
            <strong>暂无分析任务</strong>
            <span>完成一次成功的分析后，这里会汇总字段级质量问题。</span>
        </div>
    }
    else
    {
        <div class="oa-kpi-grid is-4 oa-issue-kpis">
            <div class="oa-kpi-card"><div class="oa-kpi-label">当前问题项</div><div class="oa-kpi-value">@FilteredIssues.Count</div><div class="oa-kpi-meta">标准化质量问题</div></div>
            <div class="oa-kpi-card"><div class="oa-kpi-label">问题字段</div><div class="oa-kpi-value">@FilteredIssues.Select(x => x.FieldName).Distinct(StringComparer.OrdinalIgnoreCase).Count()</div><div class="oa-kpi-meta">涉及字段数量</div></div>
            <div class="oa-kpi-card is-warning"><div class="oa-kpi-label">违规次数</div><div class="oa-kpi-value">@FilteredIssues.Sum(x => x.Count)</div><div class="oa-kpi-meta">当前筛选范围累计</div></div>
            <div class="oa-kpi-card is-info"><div class="oa-kpi-label">质量分</div><div class="oa-kpi-value">@(_selectedJob?.QualityScore?.ToString("F2") ?? "-")</div><div class="oa-kpi-meta">当前分析结果</div></div>
        </div>

        <div class="oa-panel oa-issue-selector-card">
            <div class="oa-panel-body">
                <div class="oa-issue-selector-grid">
                    <div>
                        <div class="oa-eyebrow">ANALYSIS RUN</div>
                        <h2>问题明细</h2>
                        <p>选择一次分析任务，查看该任务产生的标准化质量问题。</p>
                    </div>
                    <div>
                        <label class="form-label">分析任务</label>
                        <select class="form-select" @onchange="OnJobChanged">
                            @foreach (var job in _jobs)
                            {
                                <option value="@job.Id" selected="@(job.Id == _selectedJob?.Id)">@job.SourceName · @job.StartedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <div class="oa-panel oa-issue-table-card">
            <div class="oa-panel-header">
                <div><span class="oa-panel-kicker">Issue Inventory</span><h2>质量问题列表</h2></div>
                <span class="oa-count-pill">@FilteredIssues.Count</span>
            </div>
            @if (FilteredIssues.Count == 0)
            {
                <div class="oa-empty-state">
                    <strong>当前筛选条件下没有标准化质量违规</strong>
                    <span>当前数据质量检查没有发现需要记录的问题。</span>
                </div>
            }
            else
            {
                <div class="oa-table-wrap oa-data-table oa-issue-table-wrap">
                    <table class="table table-hover align-middle mb-0">
                        <thead><tr><th>字段</th><th>检查类型</th><th>次数</th><th>问题说明</th></tr></thead>
                        <tbody>
                        @foreach (var issue in FilteredIssues)
                        {
                            <tr><td><strong>@issue.FieldName</strong></td><td><span class="oa-badge is-warning">@issue.Check</span></td><td><span class="oa-issue-count">@issue.Count</span></td><td>@issue.Message</td></tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <div class="oa-analysis-note mt-3">ⓘ 标准化问题表当前保存字段、检查类型、违规次数和问题说明；历史 JSON 中的样本值不再作为问题中心的数据源。</div>
    }
</div>

@code {
    private readonly List<AnalysisJob> _jobs = new();
    private List<QualityIssue> _selectedIssues = new();
    private AnalysisJob? _selectedJob;
    private bool _loading;
    [SupplyParameterFromQuery(Name = "field")]
    private string? _fieldFilter { get; set; }

    private IReadOnlyList<QualityIssue> FilteredIssues =>
        string.IsNullOrWhiteSpace(_fieldFilter)
            ? _selectedIssues
            : _selectedIssues.Where(x => string.Equals(x.FieldName, _fieldFilter, StringComparison.OrdinalIgnoreCase)).ToList();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _jobs.Clear();
            _jobs.AddRange((await HistoryStore.GetRecentAsync(100)).Where(x => x.Status == AnalysisJobStatus.Succeeded).OrderByDescending(x => x.StartedAtUtc));
            _selectedJob = _jobs.FirstOrDefault();
            await LoadIssuesAsync(_selectedJob);
        }
        finally { _loading = false; }
    }

    private async Task OnJobChanged(ChangeEventArgs args)
    {
        if (Guid.TryParse(args.Value?.ToString(), out var id))
        {
            _selectedJob = _jobs.FirstOrDefault(x => x.Id == id);
            await LoadIssuesAsync(_selectedJob);
        }
    }

    private async Task LoadIssuesAsync(AnalysisJob? job)
    {
        _selectedIssues = job is null ? new List<QualityIssue>() : (await QualityIssueQuery.GetByJobAsync(job.Id)).ToList();
    }
}