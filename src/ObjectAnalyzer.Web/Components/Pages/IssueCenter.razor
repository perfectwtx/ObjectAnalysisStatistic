@page "/issues"
@using ObjectAnalyzer.Platform
@inject IAnalysisHistoryStore HistoryStore
@inject IQualityIssueQuery QualityIssueQuery

<PageTitle>Issue Center</PageTitle>

<div class="container py-4 oa-page oa-issues-page">
    <div class="d-flex justify-content-between align-items-center mb-4 oa-page-header">
        <div>
            <div class="oa-eyebrow">QUALITY MONITORING</div>
            <h1>质量问题中心</h1>
            <p class="text-muted mb-0">按分析任务查看标准化字段级质量问题，定位影响质量分的问题来源。</p>
        </div>
        <button class="btn btn-outline-primary" @onclick="LoadAsync">刷新</button>
    </div>

    @if (_loading)
    {
        <div class="alert alert-info">加载中...</div>
    }
    else if (_jobs.Count == 0)
    {
        <div class="oa-empty-state">
            <div class="oa-empty-icon">✓</div>
            <h2>暂无分析任务</h2>
            <p>完成一次成功的分析后，这里会汇总字段级质量问题。</p>
        </div>
    }
    else
    {
        <div class="oa-summary-grid mb-4">
            <div class="oa-summary-card oa-summary-warning">
                <span>当前问题项</span>
                <strong>@_selectedIssues.Count</strong>
                <small>标准化质量问题</small>
            </div>
            <div class="oa-summary-card">
                <span>问题字段</span>
                <strong>@_selectedIssues.Select(x => x.FieldName).Distinct(StringComparer.OrdinalIgnoreCase).Count()</strong>
                <small>涉及字段数量</small>
            </div>
            <div class="oa-summary-card">
                <span>违规次数</span>
                <strong>@_selectedIssues.Sum(x => x.Count)</strong>
                <small>当前作业累计</small>
            </div>
            <div class="oa-summary-card">
                <span>质量分</span>
                <strong>@(_selectedJob?.QualityScore?.ToString("F2") ?? "-")</strong>
                <small>当前分析结果</small>
            </div>
        </div>

        <div class="oa-issue-toolbar card mb-4">
            <div class="card-body">
                <div>
                    <div class="oa-eyebrow">ANALYSIS RUN</div>
                    <h2>问题明细</h2>
                    <p class="mb-0">选择一次分析任务，查看该任务产生的标准化质量问题。</p>
                </div>
                <div class="oa-job-selector">
                    <label class="form-label">分析任务</label>
                    <select class="form-select" @onchange="OnJobChanged">
                        @foreach (var job in _jobs)
                        {
                            <option value="@job.Id" selected="@(job.Id == _selectedJob?.Id)">@job.SourceName · @job.StartedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</option>
                        }
                    </select>
                </div>
            </div>
        </div>

        <div class="card oa-issue-table-card">
            @if (_selectedIssues.Count == 0)
            {
                <div class="oa-success-state">
                    <div class="oa-success-icon">✓</div>
                    <div>
                        <h3>本次分析没有标准化质量违规</h3>
                        <p>当前数据质量检查没有发现需要记录的问题。</p>
                    </div>
                </div>
            }
            else
            {
                <div class="table-responsive oa-data-table">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>字段</th>
                                <th>检查类型</th>
                                <th>次数</th>
                                <th>问题说明</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var issue in _selectedIssues)
                            {
                                <tr>
                                    <td><strong>@issue.FieldName</strong></td>
                                    <td><span class="badge text-bg-warning">@issue.Check</span></td>
                                    <td><span class="oa-issue-count">@issue.Count</span></td>
                                    <td>@issue.Message</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <div class="oa-source-note mt-3">
            <span>ⓘ</span>
            <span>标准化问题表当前保存字段、检查类型、违规次数和问题说明；历史 JSON 中的样本值不再作为问题中心的数据源。</span>
        </div>
    }
</div>

@code {
    private readonly List<AnalysisJob> _jobs = new();
    private List<QualityIssue> _selectedIssues = new();
    private AnalysisJob? _selectedJob;
    private bool _loading;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _jobs.Clear();
            _jobs.AddRange((await HistoryStore.GetRecentAsync(100))
                .Where(x => x.Status == AnalysisJobStatus.Succeeded)
                .OrderByDescending(x => x.StartedAtUtc));

            _selectedJob = _jobs.FirstOrDefault();
            await LoadIssuesAsync(_selectedJob);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnJobChanged(ChangeEventArgs args)
    {
        if (Guid.TryParse(args.Value?.ToString(), out var id))
        {
            _selectedJob = _jobs.FirstOrDefault(x => x.Id == id);
            await LoadIssuesAsync(_selectedJob);
        }
    }

    private async Task LoadIssuesAsync(AnalysisJob? job)
    {
        _selectedIssues = job is null
            ? new List<QualityIssue>()
            : (await QualityIssueQuery.GetByJobAsync(job.Id)).ToList();
    }
}
