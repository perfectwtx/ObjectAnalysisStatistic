@page "/issues"
@using Microsoft.AspNetCore.Components
@using ObjectAnalyzer.Platform
@inject IAnalysisHistoryStore HistoryStore
@inject IQualityIssueQuery QualityIssueQuery
@inject IQualityIssueResponsibilityStore ResponsibilityStore\n@using Microsoft.AspNetCore.Components

<PageTitle>Issue Center</PageTitle>

<div class="oa-analysis-page oa-issues-page">
    @if (HasActiveFilters)
    {
        <div class="oa-filter-context">
            <span>筛选条件</span>
            @if (JobId.HasValue) { <strong>任务: @JobId</strong> }\n            @if (!string.IsNullOrWhiteSpace(FieldFilter)) { <strong>字段: @FieldFilter</strong> }
            @if (!string.IsNullOrWhiteSpace(CheckFilter)) { <strong>检查: @GetCheckLabel(CheckFilter)</strong> }
            @if (!string.IsNullOrWhiteSpace(StatusFilter)) { <strong>状态: @GetStatusLabel(StatusFilter)</strong> }
            @if (!string.IsNullOrWhiteSpace(OwnerFilter)) { <strong>责任人: @GetOwnerLabel(OwnerFilter)</strong> }
            <a href="/issues">清除筛选</a>
        </div>
    }
    <div class="oa-analysis-header">
        <div>
            <div class="oa-eyebrow">QUALITY MONITORING</div>
            <h1>质量问题中心</h1>
            <p>按分析任务查看标准化字段级质量问题，定位影响质量分的问题来源。</p>
        </div>
        <button class="btn btn-outline-primary" @onclick="LoadAsync">刷新</button>
    </div>

    @if (_loading)
    {
        <div class="oa-panel oa-empty-state oa-loading-state"><div class="oa-empty-icon">◌</div><strong>正在加载问题中心</strong><span>正在读取最近一次分析结果。</span></div>
    }
    else if (_jobs.Count == 0)
    {
        <div class="oa-empty-state">
            <strong>暂无分析任务</strong>
            <span>完成一次成功的分析后，这里会汇总字段级质量问题。</span>
        </div>
    }
    else
    {
        <div class="oa-kpi-grid is-4 oa-issue-kpis">
            <div class="oa-kpi-card"><div class="oa-kpi-label">当前问题项</div><div class="oa-kpi-value">@FilteredIssues.Count</div><div class="oa-kpi-meta">标准化质量问题</div></div>
            <div class="oa-kpi-card"><div class="oa-kpi-label">问题字段</div><div class="oa-kpi-value">@FilteredIssues.Select(x => x.FieldName).Distinct(StringComparer.OrdinalIgnoreCase).Count()</div><div class="oa-kpi-meta">涉及字段数量</div></div>
            <div class="oa-kpi-card is-warning"><div class="oa-kpi-label">违规次数</div><div class="oa-kpi-value">@FilteredIssues.Sum(x => x.Count)</div><div class="oa-kpi-meta">当前筛选范围累计</div></div>
            <div class="oa-kpi-card is-info"><div class="oa-kpi-label">质量分</div><div class="oa-kpi-value">@(_selectedJob?.QualityScore?.ToString("F2") ?? "-")</div><div class="oa-kpi-meta">当前分析结果</div></div>
        </div>

        <div class="oa-panel oa-issue-selector-card">
            <div class="oa-panel-body">
                <div class="oa-issue-selector-grid">
                    <div>
                        <div class="oa-eyebrow">ANALYSIS RUN</div>
                        <h2>问题明细</h2>
                        <p>选择一次分析任务，查看该任务产生的标准化质量问题。</p>
                    </div>
                    <div>
                        <label class="form-label">分析任务</label>
                        <select class="form-select" @onchange="OnJobChanged">
                            @foreach (var job in _jobs)
                            {
                                <option value="@job.Id" selected="@(job.Id == _selectedJob?.Id)">@job.SourceName · @job.StartedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <div class="oa-panel oa-issue-filter-card">
            <div class="oa-panel-body">
                <div class="oa-issue-filter-grid">
                    <div>
                        <label class="form-label">字段</label>
                        <select class="form-select" @onchange="OnFieldFilterChanged">
                            <option value="">全部字段</option>
                            @foreach (var field in FilterFields)
                            {
                                <option value="@field" selected="@(string.Equals(field, FieldFilter, StringComparison.OrdinalIgnoreCase))">@field</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="form-label">检查类型</label>
                        <select class="form-select" @onchange="OnCheckFilterChanged">
                            <option value="">全部检查</option>
                            @foreach (var check in FilterChecks)
                            {
                                <option value="@check" selected="@(string.Equals(check, CheckFilter, StringComparison.OrdinalIgnoreCase))">@GetCheckLabel(check)</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="form-label">状态</label>
                        <select class="form-select" @onchange="OnStatusFilterChanged">
                            <option value="">全部状态</option>
                            <option value="Open" selected="@(string.Equals(StatusFilter, "Open", StringComparison.OrdinalIgnoreCase))">待处理</option>
                            <option value="InProgress" selected="@(string.Equals(StatusFilter, "InProgress", StringComparison.OrdinalIgnoreCase))">处理中</option>
                            <option value="Resolved" selected="@(string.Equals(StatusFilter, "Resolved", StringComparison.OrdinalIgnoreCase))">已解决</option>
                            <option value="Ignored" selected="@(string.Equals(StatusFilter, "Ignored", StringComparison.OrdinalIgnoreCase))">已忽略</option>
                        </select>
                    </div>
                    <div>
                        <label class="form-label">责任人</label>
                        <select class="form-select" @onchange="OnOwnerFilterChanged">
                            <option value="">全部责任人</option>
                            <option value="unassigned" selected="@(string.Equals(OwnerFilter, "unassigned", StringComparison.OrdinalIgnoreCase))">未指定</option>
                            @foreach (var owner in FilterOwners)
                            {
                                <option value="@owner" selected="@(string.Equals(owner, OwnerFilter, StringComparison.OrdinalIgnoreCase))">@owner</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <div class="oa-panel oa-issue-table-card">
            <div class="oa-panel-header">
                <div><span class="oa-panel-kicker">Issue Inventory</span><h2>质量问题列表</h2></div>
                <span class="oa-count-pill">@FilteredIssues.Count</span>
            </div>
            @if (FilteredIssues.Count == 0)
            {
                <div class="oa-empty-state">
                    <strong>当前筛选条件下没有标准化质量违规</strong>
                    <span>当前数据质量检查没有发现需要记录的问题。</span>
                </div>
            }
            else
            {
                <div class="oa-table-wrap oa-data-table oa-issue-table-wrap">
                    <table class="table table-hover align-middle mb-0">
                        <thead><tr><th>字段</th><th>检查类型</th><th>次数</th><th>状态</th><th>责任人</th><th>问题说明</th><th class="oa-action-column"></th></tr></thead>
                        <tbody>
                        @foreach (var issue in FilteredIssues)
                        {
                            <tr><td><strong>@issue.FieldName</strong></td><td><span class="oa-badge is-warning">@issue.Check</span></td><td><span class="oa-issue-count">@issue.Count</span></td><td><span class="oa-issue-status @GetStatusClass(issue)">@GetStatusText(issue)</span></td><td>@GetOwner(issue)</td><td>@issue.Message</td><td class="oa-action-column"><a class="btn btn-sm btn-outline-primary" href="@IssueDetailUrl(issue)">查看详情</a></td></tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <div class="oa-analysis-note mt-3">ⓘ 标准化问题表当前保存字段、检查类型、违规次数和问题说明；历史 JSON 中的样本值不再作为问题中心的数据源。</div>
    }
</div>

@code {
    private readonly List<AnalysisJob> _jobs = new();
    private List<QualityIssue> _selectedIssues = new();
    private Dictionary<string, QualityIssueResponsibility> _responsibilities = new(StringComparer.OrdinalIgnoreCase);
    private AnalysisJob? _selectedJob;
    private bool _loading;
    [SupplyParameterFromQuery(Name = "jobId")]\n    public Guid? JobId { get; set; }\n\n    [SupplyParameterFromQuery(Name = "field")]
    public string? FieldFilter { get; set; }

    [SupplyParameterFromQuery(Name = "check")]
    public string? CheckFilter { get; set; }

    [SupplyParameterFromQuery(Name = "status")]
    public string? StatusFilter { get; set; }

    [SupplyParameterFromQuery(Name = "owner")]
    public string? OwnerFilter { get; set; }

    private bool HasActiveFilters =>
        JobId.HasValue ||\n        !string.IsNullOrWhiteSpace(FieldFilter) ||
        !string.IsNullOrWhiteSpace(CheckFilter) ||
        !string.IsNullOrWhiteSpace(StatusFilter) ||
        !string.IsNullOrWhiteSpace(OwnerFilter);

    private IReadOnlyList<string> FilterFields => _selectedIssues
        .Select(x => x.FieldName)
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(x => x, StringComparer.OrdinalIgnoreCase)
        .ToList();

    private IReadOnlyList<string> FilterChecks => _selectedIssues
        .Select(x => x.Check)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(x => x, StringComparer.OrdinalIgnoreCase)
        .ToList();

    private IReadOnlyList<string> FilterOwners => _selectedIssues
        .Select(GetOwner)
        .Where(x => x != "未指定")
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(x => x, StringComparer.OrdinalIgnoreCase)
        .ToList();

    private IReadOnlyList<QualityIssue> FilteredIssues => _selectedIssues
        .Where(MatchesFilters)
        .ToList();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _jobs.Clear();
            _jobs.AddRange((await HistoryStore.GetRecentAsync(100)).Where(x => x.Status == AnalysisJobStatus.Succeeded).OrderByDescending(x => x.StartedAtUtc));
            _selectedJob = JobId.HasValue ? _jobs.FirstOrDefault(x => x.Id == JobId.Value) : _jobs.FirstOrDefault();
            await LoadIssuesAsync(_selectedJob);
        }
        finally { _loading = false; }
    }

    private async Task OnJobChanged(ChangeEventArgs args)
    {
        if (Guid.TryParse(args.Value?.ToString(), out var id))
        {
            _selectedJob = _jobs.FirstOrDefault(x => x.Id == id);
            await LoadIssuesAsync(_selectedJob);
        }
    }

    private string IssueDetailUrl(QualityIssue issue) =>
        $"/issues/detail?jobId={issue.JobId}&field={Uri.EscapeDataString(issue.FieldName)}&check={Uri.EscapeDataString(issue.Check)}";

    private async Task LoadIssuesAsync(AnalysisJob? job)
    {
        _selectedIssues = job is null ? new List<QualityIssue>() : (await QualityIssueQuery.GetByJobAsync(job.Id)).ToList();
        _responsibilities = new Dictionary<string, QualityIssueResponsibility>(StringComparer.OrdinalIgnoreCase);
        if (job is null)
            return;

        foreach (var responsibility in await ResponsibilityStore.GetByJobAsync(job.Id))
            _responsibilities[IssueKey(responsibility.FieldName, responsibility.Check)] = responsibility;
    }

    private bool MatchesFilters(QualityIssue issue)
    {
        if (!string.IsNullOrWhiteSpace(FieldFilter) &&
            !string.Equals(issue.FieldName, FieldFilter, StringComparison.OrdinalIgnoreCase))
            return false;

        if (!string.IsNullOrWhiteSpace(CheckFilter) &&
            !string.Equals(issue.Check, CheckFilter, StringComparison.OrdinalIgnoreCase))
            return false;

        if (!string.IsNullOrWhiteSpace(StatusFilter) &&
            !string.Equals(GetStatusKey(issue), NormalizeStatusFilter(StatusFilter), StringComparison.OrdinalIgnoreCase))
            return false;

        if (!string.IsNullOrWhiteSpace(OwnerFilter))
        {
            var owner = GetOwner(issue);
            if (string.Equals(OwnerFilter, "unassigned", StringComparison.OrdinalIgnoreCase))
            {
                if (owner != "未指定") return false;
            }
            else if (!string.Equals(owner, OwnerFilter, StringComparison.OrdinalIgnoreCase))
            {
                return false;
            }
        }

        return true;
    }

    private static string NormalizeStatusFilter(string value) => value switch
    {
        "待处理" => "Open",
        "处理中" => "InProgress",
        "已解决" => "Resolved",
        "已忽略" => "Ignored",
        _ => value
    };

    private string GetStatusKey(QualityIssue issue)
    {
        if (!_responsibilities.TryGetValue(IssueKey(issue.FieldName, issue.Check), out var responsibility))
            return "Open";

        return responsibility.Status switch
        {
            "InProgress" => "InProgress",
            "Resolved" => "Resolved",
            "Ignored" => "Ignored",
            _ => "Open"
        };
    }

    private string GetStatusText(QualityIssue issue)
    {
        if (!_responsibilities.TryGetValue(IssueKey(issue.FieldName, issue.Check), out var responsibility))
            return "待处理";
        return responsibility.Status switch
        {
            "InProgress" => "处理中",
            "Resolved" => "已解决",
            "Ignored" => "已忽略",
            _ => "待处理"
        };
    }

    private string GetStatusLabel(string? value) => NormalizeStatusFilter(value ?? string.Empty) switch
    {
        "InProgress" => "处理中",
        "Resolved" => "已解决",
        "Ignored" => "已忽略",
        _ => "待处理"
    };

    private string GetCheckLabel(string? check) => check switch
    {
        "enum" => "枚举违规",
        "range" => "数值越界",
        "pattern" => "模式不匹配",
        "required" => "必填缺失",
        "unique" => "唯一性冲突",
        "nullRate" => "null 率超限",
        "rowCount" => "行数不足",
        "duplicateRate" => "重复率超限",
        "duplicateGroups" => "重复对象组",
        "outlierRatio" => "异常值超限",
        _ => check ?? string.Empty
    };

    private string GetOwnerLabel(string? owner) =>
        string.Equals(owner, "unassigned", StringComparison.OrdinalIgnoreCase) ? "未指定" : owner ?? string.Empty;

    private string GetStatusClass(QualityIssue issue)
    {
        if (!_responsibilities.TryGetValue(IssueKey(issue.FieldName, issue.Check), out var responsibility))
            return "is-open";
        return responsibility.Status switch
        {
            "InProgress" => "is-progress",
            "Resolved" => "is-resolved",
            "Ignored" => "is-ignored",
            _ => "is-open"
        };
    }

    private void SetFilter(string name, string? value)
    {
        switch (name)
        {
            case "field": FieldFilter = value; break;
            case "check": CheckFilter = value; break;
            case "status": StatusFilter = value; break;
            case "owner": OwnerFilter = value; break;
        }
    }

    private async Task OnFieldFilterChanged(ChangeEventArgs args)
    {
        SetFilter("field", args.Value?.ToString());
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnCheckFilterChanged(ChangeEventArgs args)
    {
        SetFilter("check", args.Value?.ToString());
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnStatusFilterChanged(ChangeEventArgs args)
    {
        SetFilter("status", args.Value?.ToString());
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnOwnerFilterChanged(ChangeEventArgs args)
    {
        SetFilter("owner", args.Value?.ToString());
        await InvokeAsync(StateHasChanged);
    }

    private string GetOwner(QualityIssue issue) =>
        _responsibilities.TryGetValue(IssueKey(issue.FieldName, issue.Check), out var responsibility) && !string.IsNullOrWhiteSpace(responsibility.Owner)
            ? responsibility.Owner!
            : "未指定";

    private static string IssueKey(string fieldName, string check) => $"{fieldName}\\u001f{check}";
}