@page "/quality/data-lineage"
@using System.Text.Json
@using ObjectAnalyzer.Analysis
@using ObjectAnalyzer.Platform
@using LineageModel = ObjectAnalyzer.Analysis.DataLineage
@inject IAnalysisHistoryStore HistoryStore

<PageTitle>数据血缘</PageTitle>

<div class="oa-analysis-page oa-data-lineage-page">
    <div class="oa-analysis-header">
        <div>
            <div class="oa-eyebrow">DATA LINEAGE</div>
            <h1>数据血缘</h1>
            <p>查看最近一次成功分析生成的对象、集合与字段层级血缘。</p>
        </div>
        <a class="btn btn-outline-secondary" href="/jobs">作业中心</a>
    </div>

    @if (_loading)
    {
        <div class="oa-panel oa-empty-state"><div class="oa-empty-icon">…</div><strong>正在加载最近一次分析结果</strong><span>正在准备数据血缘。</span></div>
    }
    else if (_job is null)
    {
        <div class="oa-panel oa-empty-state"><div class="oa-empty-icon">!</div><strong>暂无成功的分析记录</strong><span>请先执行一次分析，再查看数据血缘。</span></div>
    }
    else if (_lineage is null || _lineage.Nodes.Count == 0)
    {
        <div class="oa-panel oa-empty-state"><div class="oa-empty-icon">∅</div><strong>暂无可展示的数据血缘</strong><span>请先运行包含嵌套对象或对象集合的分析。</span></div>
    }
    else
    {
        <div class="oa-kpi-grid">
            <div class="oa-kpi-card"><span>节点数量</span><strong>@_lineage.Nodes.Count</strong><small>对象、集合与字段节点</small></div>
            <div class="oa-kpi-card"><span>层级节点</span><strong>@_lineage.Nodes.Count(x => x.Kind != "Field")</strong><small>非字段结构节点</small></div>
            <div class="oa-kpi-card"><span>血缘边</span><strong>@_lineage.Edges.Count</strong><small>父子层级关系</small></div>
            <div class="oa-kpi-card"><span>最深层级</span><strong>@_lineage.Nodes.Max(x => x.Depth)</strong><small>当前结果最大嵌套深度</small></div>
        </div>

        <div class="oa-panel mb-4">
            <div class="oa-panel-header">
                <div><div class="oa-panel-kicker">NODES</div><h2>血缘节点</h2></div>
                <span class="oa-count-badge">@_lineage.Nodes.Count 节点</span>
            </div>
            <div class="oa-panel-body oa-lineage-context">
                <span>数据源</span><strong title="@_job.SourceName">@_job.SourceName</strong>
            </div>
            <div class="oa-table-wrap oa-lineage-table-wrap">
                <table class="table table-hover align-middle mb-0 oa-analysis-table">
                    <thead><tr><th>路径</th><th>类型</th><th>深度</th><th>出现次数</th><th>目标字段</th></tr></thead>
                    <tbody>
                    @foreach (var node in _lineage.Nodes.OrderBy(x => x.Path, StringComparer.OrdinalIgnoreCase))
                    {
                        <tr>
                            <td class="oa-lineage-path"><span class="oa-lineage-indent" style="width:@(Math.Max(0, node.Depth - 1) * 20)px"></span>@if (node.Depth > 1) { <span class="text-muted">└─ </span> }<code>@node.Path</code></td>
                            <td><span class="badge @NodeBadge(node.Kind)">@NodeLabel(node.Kind)</span></td>
                            <td>@node.Depth</td><td>@node.OccurrenceCount.ToString("N0")</td>
                            <td class="oa-lineage-targets">@(node.TargetFields.Count == 0 ? "-" : string.Join(", ", node.TargetFields))</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="oa-panel">
            <div class="oa-panel-header">
                <div><div class="oa-panel-kicker">EDGES</div><h2>血缘关系</h2></div>
                <span class="oa-count-badge">@_lineage.Edges.Count 条</span>
            </div>
            @if (_lineage.Edges.Count == 0)
            {
                <div class="oa-empty-state"><div class="oa-empty-icon">∅</div><strong>暂无血缘边</strong><span>当前结果没有可进一步展开的父子血缘关系。</span></div>
            }
            else
            {
                <div class="oa-table-wrap"><table class="table table-hover mb-0 align-middle oa-analysis-table">
                    <thead><tr><th>父节点</th><th>关系</th><th>子节点</th></tr></thead>
                    <tbody>
                    @foreach (var edge in _lineage.Edges.OrderBy(x => x.ParentPath, StringComparer.OrdinalIgnoreCase).ThenBy(x => x.ChildPath, StringComparer.OrdinalIgnoreCase))
                    {
                        <tr><td><code>@edge.ParentPath</code></td><td><span class="badge bg-light text-dark border">@EdgeLabel(edge.Kind)</span></td><td><code>@edge.ChildPath</code></td></tr>
                    }
                    </tbody>
                </table></div>
            }
        </div>
    }
</div>

@code {
    private bool _loading = true;
    private AnalysisJob? _job;
    private LineageModel? _lineage;

    protected override async Task OnInitializedAsync()
    {
        await HistoryStore.InitializeAsync();
        var jobs = await HistoryStore.GetRecentAsync(100);
        _job = jobs.Where(x => x.Status == AnalysisJobStatus.Succeeded && !string.IsNullOrWhiteSpace(x.ResultJson)).OrderByDescending(x => x.StartedAtUtc).FirstOrDefault();
        if (_job is not null)
        {
            try
            {
                var result = JsonSerializer.Deserialize<AnalysisResult>(_job.ResultJson!);
                _lineage = DataLineageBuilder.Build(result?.ObjectRelationships ?? new List<ObjectRelationship>());
            }
            catch (JsonException) { _lineage = null; }
        }
        _loading = false;
    }

    private static string NodeLabel(string kind) => kind switch { "Object" => "对象", "Collection" => "对象集合", "Field" => "字段", _ => kind };
    private static string NodeBadge(string kind) => kind switch { "Collection" => "bg-info text-dark", "Field" => "bg-secondary", _ => "bg-primary" };
    private static string EdgeLabel(string kind) => kind switch { "Contains" => "包含对象", "ContainsCollection" => "包含集合", "ContainsField" => "包含字段", _ => kind };
}