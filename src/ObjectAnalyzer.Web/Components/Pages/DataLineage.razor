@using Microsoft.AspNetCore.Components
@page "/quality/data-lineage"
@using System.Text.Json
@using ObjectAnalyzer.Analysis
@using ObjectAnalyzer.Platform
@using LineageModel = ObjectAnalyzer.Analysis.DataLineage
@inject IAnalysisHistoryStore HistoryStore

<PageTitle>数据血缘</PageTitle>

<div class="oa-analysis-page oa-data-lineage-page">
    <div class="oa-analysis-header">
        <div>
            <div class="oa-eyebrow">DATA LINEAGE</div>
            <h1>数据血缘</h1>
            <p>查看最近一次成功分析生成的对象、集合与字段层级血缘。</p>
        </div>
        <div class="oa-header-actions">
            <a class="btn btn-outline-secondary" href="/jobs">作业中心</a>
            @if (_job is not null)
            {
                <a class="btn btn-outline-primary" href="@($"/jobs/{_job.Id}")">当前作业</a>
            }
        </div>
    </div>

    @if (_loading)
    {
        <div class="oa-panel oa-empty-state"><div class="oa-empty-icon">…</div><strong>正在加载最近一次分析结果</strong><span>正在准备数据血缘。</span></div>
    }
    else if (_job is null)
    {
        <div class="oa-panel oa-empty-state"><div class="oa-empty-icon">!</div><strong>暂无成功的分析记录</strong><span>请先执行一次分析，再查看数据血缘。</span></div>
    }
    else
    {
        <section class="oa-panel oa-lineage-filter-card">
            <div class="oa-panel-body">
                <div class="oa-lineage-filter-grid">
                    <div>
                        <label class="form-label">分析任务</label>
                        <select class="form-select" @onchange="OnJobChanged">
                            @foreach (var job in _jobs)
                            {
                                <option value="@job.Id" selected="@(job.Id == _job?.Id)">@job.SourceName · @job.StartedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="form-label">节点类型</label>
                        <select class="form-select" @onchange="OnKindChanged">
                            <option value="">全部节点</option>
                            <option value="Object" selected="@(KindFilter == "Object")">对象</option>
                            <option value="Collection" selected="@(KindFilter == "Collection")">对象集合</option>
                            <option value="Field" selected="@(KindFilter == "Field")">字段</option>
                        </select>
                    </div>
                    <div>
                        <label class="form-label">路径搜索</label>
                        <input class="form-control" value="@PathFilter" @oninput="OnPathChanged" placeholder="例如 customer.address" />
                    </div>
                </div>
            </div>
        </section>

        @if (_lineage is null || _lineage.Nodes.Count == 0)
        {
            <div class="oa-panel oa-empty-state">
                <div class="oa-empty-icon">∅</div>
                <strong>暂无可展示的数据血缘</strong>
                <span>当前分析没有可识别的对象、集合或字段层级血缘。可以切换上方分析任务继续查看。</span>
            </div>
        }
        else
        {
        <div class="oa-kpi-grid is-4">
            <div class="oa-kpi-card"><span>节点数量</span><strong>@FilteredNodes.Count</strong><small>当前筛选节点 / @_lineage.Nodes.Count 总节点</small></div>
            <div class="oa-kpi-card"><span>层级节点</span><strong>@_lineage.Nodes.Count(x => x.Kind != "Field")</strong><small>非字段结构节点</small></div>
            <div class="oa-kpi-card"><span>血缘边</span><strong>@_lineage.Edges.Count</strong><small>父子层级关系</small></div>
            <div class="oa-kpi-card"><span>最深层级</span><strong>@_lineage.Nodes.Max(x => x.Depth)</strong><small>当前结果最大嵌套深度</small></div>
        </div>

        <div class="oa-panel mb-4">
            <div class="oa-panel-header">
                <div><div class="oa-panel-kicker">NODES</div><h2>血缘节点</h2></div>
                <span class="oa-count-badge">@FilteredNodes.Count 节点</span>
            </div>
            <div class="oa-panel-body oa-lineage-context">
                <span>数据源</span><strong title="@_job!.SourceName">@_job!.SourceName</strong>
            </div>
            <div class="oa-table-wrap oa-lineage-table-wrap">
                <table class="table table-hover align-middle mb-0 oa-analysis-table">
                    <thead><tr><th>路径</th><th>类型</th><th>深度</th><th>出现次数</th><th>目标字段</th></tr></thead>
                    <tbody>
                    @foreach (var node in FilteredNodes.OrderBy(x => x.Path, StringComparer.OrdinalIgnoreCase))
                    {
                        <tr>
                            <td class="oa-lineage-path"><span class="oa-lineage-indent" style="width:@(Math.Max(0, node.Depth - 1) * 20)px"></span>@if (node.Depth > 1) { <span class="oa-lineage-branch">└─</span> }<code>@node.Path</code></td>
                            <td><span class="oa-badge @NodeBadge(node.Kind)">@NodeLabel(node.Kind)</span></td>
                            <td>@node.Depth</td><td>@node.OccurrenceCount.ToString("N0")</td>
                            <td class="oa-lineage-targets">@(node.TargetFields.Count == 0 ? "-" : string.Join(", ", node.TargetFields))</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="oa-panel">
            <div class="oa-panel-header">
                <div><div class="oa-panel-kicker">EDGES</div><h2>血缘关系</h2></div>
                <span class="oa-count-badge">@_lineage.Edges.Count 条</span>
            </div>
            @if (_lineage.Edges.Count == 0)
            {
                <div class="oa-empty-state"><div class="oa-empty-icon">∅</div><strong>暂无血缘边</strong><span>当前结果没有可进一步展开的父子血缘关系。</span></div>
            }
            else
            {
                <div class="oa-table-wrap"><table class="table table-hover mb-0 align-middle oa-analysis-table">
                    <thead><tr><th>父节点</th><th>关系</th><th>子节点</th></tr></thead>
                    <tbody>
                    @foreach (var edge in _lineage.Edges.OrderBy(x => x.ParentPath, StringComparer.OrdinalIgnoreCase).ThenBy(x => x.ChildPath, StringComparer.OrdinalIgnoreCase))
                    {
                        <tr><td><code>@edge.ParentPath</code></td><td><span class="oa-badge is-neutral">@EdgeLabel(edge.Kind)</span></td><td><code>@edge.ChildPath</code></td></tr>
                    }
                    </tbody>
                </table></div>
            }
        </div>
        }
    }
</div>

@code {
    private readonly List<AnalysisJob> _jobs = new();
    private bool _loading = true;
    private AnalysisJob? _job;
    [SupplyParameterFromQuery(Name = "jobId")]
    public Guid? JobId { get; set; }
    private LineageModel? _lineage;
    private string? KindFilter;
    private string? PathFilter;

    private IReadOnlyList<DataLineageNode> FilteredNodes => (_lineage?.Nodes ?? new List<DataLineageNode>())
        .Where(x => string.IsNullOrWhiteSpace(KindFilter) || string.Equals(x.Kind, KindFilter, StringComparison.OrdinalIgnoreCase))
        .Where(x => string.IsNullOrWhiteSpace(PathFilter) || x.Path.Contains(PathFilter, StringComparison.OrdinalIgnoreCase))
        .ToList() ?? Array.Empty<DataLineageNode>();

    protected override async Task OnInitializedAsync()
    {
        await HistoryStore.InitializeAsync();
        var jobs = await HistoryStore.GetRecentAsync(100);
        _jobs.AddRange(jobs.Where(x => x.Status == AnalysisJobStatus.Succeeded && !string.IsNullOrWhiteSpace(x.ResultJson)).OrderByDescending(x => x.StartedAtUtc));
        _job = JobId.HasValue ? _jobs.FirstOrDefault(x => x.Id == JobId.Value) : _jobs.FirstOrDefault();
        if (_job is not null)
        {
            try
            {
                var result = JsonSerializer.Deserialize<AnalysisResult>(_job.ResultJson!);
                _lineage = DataLineageBuilder.Build(result?.ObjectRelationships ?? new List<ObjectRelationship>());
            }
            catch (JsonException) { _lineage = null; }
        }
        _loading = false;
    }

    private async Task OnJobChanged(ChangeEventArgs args)
    {
        if (!Guid.TryParse(args.Value?.ToString(), out var id))
            return;

        _job = _jobs.FirstOrDefault(x => x.Id == id);
        _lineage = null;
        if (_job is not null)
        {
            try
            {
                var result = JsonSerializer.Deserialize<AnalysisResult>(_job.ResultJson!);
                _lineage = DataLineageBuilder.Build(result?.ObjectRelationships ?? new List<ObjectRelationship>());
            }
            catch (JsonException)
            {
                _lineage = null;
            }
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task OnKindChanged(ChangeEventArgs args)
    {
        KindFilter = args.Value?.ToString();
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnPathChanged(ChangeEventArgs args)
    {
        PathFilter = args.Value?.ToString();
        await InvokeAsync(StateHasChanged);
    }

    private static string NodeLabel(string kind) => kind switch { "Object" => "对象", "Collection" => "对象集合", "Field" => "字段", _ => kind };
    private static string NodeBadge(string kind) => kind switch { "Collection" => "is-info", "Field" => "is-neutral", _ => "is-accent" };
    private static string EdgeLabel(string kind) => kind switch { "Contains" => "包含对象", "ContainsCollection" => "包含集合", "ContainsField" => "包含字段", _ => kind };
}