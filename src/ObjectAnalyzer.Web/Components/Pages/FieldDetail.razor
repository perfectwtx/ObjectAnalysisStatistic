@page "/quality/fields"
@using System.Text.Json
@using ObjectAnalyzer.Analysis
@using ObjectAnalyzer.Platform
@inject IAnalysisHistoryStore HistoryStore
@inject IQualityHistoryQuery QualityHistory
@inject IQualityIssueQuery QualityIssues
@inject NavigationManager Navigation

<PageTitle>字段质量详情</PageTitle>

<div class="oa-analysis-page oa-field-detail-page">
    <header class="oa-analysis-header">
        <div class="oa-field-title">
            <div class="oa-eyebrow">Quality Analysis / Fields</div>
            <div class="oa-field-title-row">
                <div><h1>字段质量详情</h1><p>从字段覆盖率、Null、唯一性与质量违规等维度查看字段画像，展开任意字段查看完整细节。</p></div>
                <a class="btn btn-outline-secondary" href="@QualityUrl">返回总览</a>
            </div>
        </div>
    </header>

    @if (_loading)
    {
        <div class="oa-empty-state oa-field-state"><div class="oa-empty-icon">◌</div><strong>正在加载字段质量数据</strong><span>正在准备字段画像。</span></div>
    }
    else if (_jobs.Count == 0)
    {
        <div class="oa-empty-state oa-field-state"><div class="oa-empty-icon">∅</div><strong>暂无成功的分析结果</strong><span>请先执行一次分析，再返回这里查看字段质量。</span></div>
    }
    else
    {
        var selectedJob = _jobs.FirstOrDefault(x => x.Id == _selectedJobId) ?? _jobs.First();

        <section class="oa-dashboard-section">
            <div class="oa-context-grid oa-field-context">
                <div><span>当前数据源</span><strong>@selectedJob.SourceName</strong></div>
                <div><span>分析时间</span><strong>@selectedJob.StartedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</strong></div>
                <div><span>字段数量</span><strong>@_fields.Count.ToString("N0")</strong></div>
                <div><span>问题项</span><strong>@_violations.Count(x => x.Count > 0).ToString("N0")</strong></div>
            </div>
        </section>

        <section class="oa-dashboard-section">
            <div class="oa-dashboard-panel oa-field-selector-panel">
                <div class="oa-panel-header">
                    <div><span class="oa-panel-kicker">Analysis Snapshot</span><h2>分析任务</h2><p>切换历史成功任务，查看对应字段质量快照。</p></div>
                    <span class="oa-badge is-neutral">@FilteredFields.Count / @_fields.Count 个字段</span>
                </div>
                <div class="oa-field-selector-body">
                    <div class="oa-field-filter-grid">
                        <div><label class="form-label">分析任务</label>
                    <select class="form-select" value="@_selectedJobId" @onchange="OnJobChanged">
                        @foreach (var job in _jobs)
                        {
                            <option value="@job.Id">@job.SourceName · @job.StartedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</option>
                        }
                    </select></div>
                        <div><label class="form-label">字段搜索</label><input class="form-control" value="@FieldFilter" @oninput="OnFieldFilterChanged" placeholder="搜索字段名称" /></div>
                        <div><label class="form-label">问题状态</label><select class="form-select" @onchange="OnIssueFilterChanged"><option value="">全部字段</option><option value="Issue" selected="@(IssueFilter == "Issue")">仅有问题</option><option value="Normal" selected="@(IssueFilter == "Normal")">仅正常</option></select></div>
                    </div>
                    <div class="oa-field-selector-hint">质量指标来自标准化字段快照 · 当前显示 @FilteredFields.Count 个字段 · 点击字段名展开详细画像</div>
                </div>
            </div>
        </section>

        <section class="oa-dashboard-section">
            <div class="oa-section-heading"><div><span class="oa-section-kicker">Field Profile</span><h2>字段画像</h2><span>按质量信号快速识别需要关注的字段</span></div></div>
            <div class="oa-dashboard-panel oa-field-table-card">
                <div class="oa-field-table-toolbar"><span>@FilteredFields.Count 个字段</span><span>@FilteredFields.Count(x => GetViolationCount(x.FieldName) > 0) 个问题字段</span><span>点击字段名查看详情</span><a class="btn btn-sm btn-outline-secondary" href="@IssuesUrl">问题中心</a></div>
                <div class="oa-table-wrap">
                    <table class="oa-data-table oa-field-table">
                        <thead><tr><th>字段</th><th>主类型</th><th>语义类型</th><th>覆盖率</th><th>Null率</th><th>唯一性</th><th>问题</th></tr></thead>
                        <tbody>
                        @foreach (var field in FilteredFields)
                        {
                            var normalized = _normalizedFields.FirstOrDefault(x => string.Equals(x.FieldName, field.FieldName, StringComparison.Ordinal));
                            var violationCount = GetViolationCount(field.FieldName);
                            <tr class="@( _selectedField == field.FieldName ? "is-selected" : "")">
                                <td><button class="oa-field-name" @onclick="() => ToggleField(field.FieldName)"><strong>@field.FieldName</strong><span>查看画像</span></button></td>
                                <td><span class="oa-type-text">@field.PrimaryType</span></td>
                                <td>@(field.SemanticType ?? "-")</td>
                                <td><strong>@(normalized is null ? field.Coverage.ToString("P1") : normalized.Coverage.ToString("P1"))</strong></td>
                                <td>@(normalized is null ? "-" : normalized.NullRate.ToString("P1"))</td>
                                <td>@(normalized?.Uniqueness is double uniqueness ? uniqueness.ToString("P1") : field.DistinctCount?.ToString() ?? "-")</td>
                                <td>@if (violationCount > 0){<a class="oa-field-issue-count oa-badge is-danger" href="@IssueFieldUrl(field.FieldName)" @onclick:stopPropagation="true">@violationCount</a>}else{<span class="oa-badge is-success">正常</span>}</td>
                            </tr>
                            @if (_selectedField == field.FieldName)
                            {
                                <tr class="oa-field-detail-row"><td colspan="7"><div class="oa-field-detail">
                                    <div class="oa-detail-grid">
                                        <div><span>出现次数</span><strong>@field.Count</strong></div>
                                        <div><span>Null 次数</span><strong>@field.NullCount</strong></div>
                                        <div><span>默认值</span><strong>@(field.DefaultValueRepresentation ?? "-")</strong></div>
                                        <div><span>数值范围</span><strong>@FormatRange(field)</strong></div>
                                    </div>
                                    <div class="oa-detail-section"><div class="oa-detail-title">标准化质量指标</div>@if (normalized is not null){<div class="oa-metric-line"><span>覆盖率 @normalized.Coverage.ToString("P1")</span><span>Null率 @normalized.NullRate.ToString("P1")</span><span>唯一性 @(normalized.Uniqueness?.ToString("P1") ?? "-")</span><span>异常率 @(normalized.OutlierRatio?.ToString("P1") ?? "-")</span></div>}else{<span class="oa-detail-muted">暂无标准化质量快照。</span>}</div>
                                    <div class="oa-detail-section"><div class="oa-detail-title">类型分布</div><div class="oa-detail-badges">@foreach (var type in field.TypeCounts.OrderByDescending(x => x.Value)){<span class="oa-badge is-neutral">@type.Key: @type.Value</span>}</div></div>
                                    @if (field.ValueCounts.Count > 0){<div class="oa-detail-section"><div class="oa-detail-title">高频值</div><div class="oa-value-list">@foreach (var value in global::ObjectAnalyzer.Reporting.ResultProjection.Values(field).Take(10)){<div><span>@value.Display</span><strong>@value.Count</strong></div>}</div></div>}
                                    @if (GetViolations(field.FieldName).Count > 0){<div class="oa-detail-section oa-violation-section"><div class="oa-detail-title">质量问题</div>@foreach (var violation in GetViolations(field.FieldName)){<div class="oa-field-violation"><span class="oa-badge is-warning">@QualityCheckTypes.Label(violation.Check)</span><p>@violation.Message</p></div>}</div>}
                                </div></td></tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </section>
    }
</div>

@code {
    private bool _loading = true;
    private List<AnalysisJob> _jobs = new();
    private List<FieldStatistic> _fields = new();
    private List<FieldViolation> _violations = new();
    private List<FieldQualitySnapshot> _normalizedFields = new();
    [SupplyParameterFromQuery(Name = "jobId")]
    public Guid? JobId { get; set; }

    private Guid _selectedJobId;
    private string? _selectedField;
    private string? FieldFilter;
    private string? IssueFilter;

    private IReadOnlyList<FieldStatistic> FilteredFields => _fields
        .Where(x => string.IsNullOrWhiteSpace(FieldFilter) || x.FieldName.Contains(FieldFilter, StringComparison.OrdinalIgnoreCase))
        .Where(x => string.IsNullOrWhiteSpace(IssueFilter)
            || (IssueFilter == "Issue" && GetViolationCount(x.FieldName) > 0)
            || (IssueFilter == "Normal" && GetViolationCount(x.FieldName) == 0))
        .ToList();

    private string QualityUrl => _selectedJobId == Guid.Empty ? "/quality" : $"/quality?jobId={_selectedJobId}";

    private string IssuesUrl => _selectedJobId == Guid.Empty
        ? "/issues"
        : $"/issues?jobId={_selectedJobId}";

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        await HistoryStore.InitializeAsync();
        _jobs = (await HistoryStore.GetRecentAsync(100)).Where(x => x.Status == AnalysisJobStatus.Succeeded && !string.IsNullOrWhiteSpace(x.ResultJson)).OrderByDescending(x => x.StartedAtUtc).ToList();
        if (_jobs.Count > 0)
        {
            _selectedJobId = JobId.HasValue && _jobs.Any(x => x.Id == JobId.Value)
                ? JobId.Value
                : _jobs.First().Id;
            await LoadSelectedJobAsync();
        }
        _loading = false;
    }

    private async Task OnJobChanged(ChangeEventArgs args)
    {
        if (Guid.TryParse(args.Value?.ToString(), out var id))
        {
            _selectedJobId = id;
            JobId = id;
            Navigation.NavigateTo($"/quality/fields?jobId={id}", replace: true);
            _selectedField = null;
            await LoadSelectedJobAsync();
        }
    }

    private async Task LoadSelectedJobAsync()
    {
        var job = _jobs.FirstOrDefault(x => x.Id == (_selectedJobId == Guid.Empty ? _jobs.FirstOrDefault()?.Id : _selectedJobId));
        if (job is null || string.IsNullOrWhiteSpace(job.ResultJson)) return;
        _selectedJobId = job.Id;
        try
        {
            var result = global::ObjectAnalyzer.Reporting.ResultProjection.ReadStored(job.ResultJson);
            _fields = result?.FieldStatistics ?? new List<FieldStatistic>();
            _violations = result?.QualityViolations ?? new List<FieldViolation>();
        }
        catch (JsonException)
        {
            _fields = new();
            _violations = new();
        }

        _normalizedFields = (await QualityHistory.GetFieldsByJobAsync(job.Id)).ToList();
        var normalizedIssues = await QualityIssues.GetByJobAsync(job.Id);
        _violations = normalizedIssues.Select(x => new FieldViolation
        {
            Field = x.FieldName,
            Check = x.Check,
            Count = x.Count,
            Message = "Stored issue; raw message omitted in delivery."
        }).ToList();
    }

    private async Task OnFieldFilterChanged(ChangeEventArgs args)
    {
        FieldFilter = args.Value?.ToString();
        if (_selectedField is not null && !FilteredFields.Any(x => string.Equals(x.FieldName, _selectedField, StringComparison.Ordinal)))
            _selectedField = null;
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnIssueFilterChanged(ChangeEventArgs args)
    {
        IssueFilter = args.Value?.ToString();
        if (_selectedField is not null && !FilteredFields.Any(x => string.Equals(x.FieldName, _selectedField, StringComparison.Ordinal)))
            _selectedField = null;
        await InvokeAsync(StateHasChanged);
    }

    private void ToggleField(string field) => _selectedField = _selectedField == field ? null : field;
    private int GetViolationCount(string field) => (int)_violations.Where(x => string.Equals(x.Field, field, StringComparison.Ordinal)).Sum(x => x.Count);
    private List<FieldViolation> GetViolations(string field) => _violations.Where(x => string.Equals(x.Field, field, StringComparison.Ordinal)).ToList();
    private string IssueFieldUrl(string fieldName) => _selectedJobId != Guid.Empty ? $"/issues?jobId={_selectedJobId}&field={Uri.EscapeDataString(fieldName)}" : $"/issues?field={Uri.EscapeDataString(fieldName)}";

    private static string FormatRange(FieldStatistic field) => field.MinNumber.HasValue && field.MaxNumber.HasValue ? $"{field.MinNumber:G6} ~ {field.MaxNumber:G6}" : "-";
}

