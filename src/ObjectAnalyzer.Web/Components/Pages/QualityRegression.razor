@page "/quality/regression"
@using System.Text.Json
@using Microsoft.AspNetCore.Components
@using ObjectAnalyzer.Analysis
@using ObjectAnalyzer.Platform
@inject IAnalysisHistoryStore HistoryStore
@inject NavigationManager Navigation

<PageTitle>质量回归</PageTitle>

<div class="oa-analysis-page oa-regression-page">
    <div class="oa-analysis-header">
        <div class="oa-regression-title">
            <div class="oa-eyebrow">Quality Regression</div>
            <h1>质量回归</h1>
            <p>对比最近两次成功分析，把质量下降、字段退化和新增违规收敛到可执行的回归清单。</p>
        </div>
        <div class="oa-header-actions">
            <a class="btn btn-outline-secondary" href="/jobs">作业中心</a>
            <a class="btn btn-outline-secondary" href="@SchemaImpactUrl">Schema 影响</a>
            <a class="btn btn-outline-secondary" href="@ImpactAnalysisUrl">影响传播</a>
            <a class="btn btn-outline-secondary" href="@IssuesUrl">质量问题</a>
        </div>
    </div>

    @if (_loading)
    {
        <div class="oa-panel oa-empty-state oa-regression-state">
            <div class="oa-empty-icon">…</div>
            <strong>正在加载历史分析数据</strong>
            <span>正在准备最近两次成功分析的比较结果。</span>
        </div>
    }
    else if (_jobs.Count < 2)
    {
        <div class="oa-panel oa-empty-state oa-regression-state">
            <div class="oa-empty-icon">2</div>
            <strong>暂时无法进行回归检测</strong>
            <span>至少需要两次成功分析，才能建立质量变化基线。</span>
        </div>
    }
    else if (_report is null || _currentJob is null || _previousJob is null)
    {
        <div class="oa-panel oa-empty-state oa-regression-state">
            <div class="oa-empty-icon">!</div>
            <strong>没有可比较的结果快照</strong>
            <span>当前选择缺少有效的分析基线或结果数据。</span>
        </div>
    }
    else
    {
        <section class="oa-panel oa-regression-filter-card">
            <div class="oa-panel-body">
                <div class="oa-regression-filter-grid">
                    <div>
                        <label class="form-label">当前快照</label>
                        <select class="form-select" @onchange="OnCurrentJobChanged">
                            @foreach (var job in _jobs)
                            {
                                <option value="@job.Id" selected="@(job.Id == _currentJob?.Id)">@job.SourceName · @job.StartedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="form-label">比较基线</label>
                        <select class="form-select" @onchange="OnPreviousJobChanged">
                            @foreach (var job in _jobs.Where(x => x.Id != _currentJob?.Id))
                            {
                                <option value="@job.Id" selected="@(job.Id == _previousJob?.Id)">@job.SourceName · @job.StartedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="form-label">字段状态</label>
                        <select class="form-select" @onchange="OnFieldStatusChanged">
                            <option value="">全部状态</option>
                            <option value="Severe" selected="@(FieldStatusFilter == "Severe")">严重回归</option>
                            <option value="Regressed" selected="@(FieldStatusFilter == "Regressed")">发生回归</option>
                            <option value="Improved" selected="@(FieldStatusFilter == "Improved")">质量改善</option>
                            <option value="Added" selected="@(FieldStatusFilter == "Added")">新增字段</option>
                            <option value="Removed" selected="@(FieldStatusFilter == "Removed")">字段消失</option>
                        </select>
                    </div>
                    <div>
                        <label class="form-label">字段搜索</label>
                        <input class="form-control" value="@FieldFilter" @oninput="OnFieldChanged" placeholder="搜索字段名称" />
                    </div>
                </div>
            </div>
        </section>

        <section class="oa-context-grid oa-regression-context">
            <div>
                <span>比较基线</span>
                <strong>@_previousJob!.SourceName</strong>
                <small>@_previousJob!.StartedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</small>
            </div>
            <div>
                <span>当前快照</span>
                <strong>@_currentJob!.SourceName</strong>
                <small>@_currentJob.StartedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</small>
            </div>
            <div>
                <span>对象规模</span>
                <strong>@_report.PreviousObjectCount.ToString("N0") → @_report.CurrentObjectCount.ToString("N0")</strong>
                <small>基线 → 当前</small>
            </div>
            <div>
                <span>问题规模</span>
                <strong>@_previousJob.IssueCount.ToString("N0") → @_currentJob.IssueCount.ToString("N0")</strong>
                <small>标准化问题项</small>
            </div>
        </section>

        <section class="oa-kpi-grid is-4 oa-regression-kpis">
            <div class="oa-kpi-card @(_report.ScoreDelta < 0 ? "is-danger" : _report.ScoreDelta > 0 ? "is-success" : "is-info")">
                <span>质量分变化</span>
                <strong class="@ScoreClass(_report.ScoreDelta)">@FormatDelta(_report.ScoreDelta)</strong>
                <small>@_currentJob!.SourceName 相对 @_previousJob!.SourceName</small>
            </div>
            <div class="oa-kpi-card @(_report.IssueDelta > 0 ? "is-danger" : _report.IssueDelta < 0 ? "is-success" : "is-info")">
                <span>问题数变化</span>
                <strong class="@DeltaClass(_report.IssueDelta)">@FormatIntDelta(_report.IssueDelta)</strong>
                <small>标准化问题项变化</small>
            </div>
            <div class="oa-kpi-card @(_report.FieldRegressions.Count > 0 ? "is-warning" : "is-success")">
                <span>回归字段</span>
                <strong>@FilteredRegressedFields.Count</strong>
                <small>发生质量下降的字段</small>
            </div>
            <div class="oa-kpi-card @(_report.ViolationRegressions.Count > 0 ? "is-danger" : "is-success")">
                <span>新增 / 增加违规</span>
                <strong>@FilteredViolations.Count</strong>
                <small>需要进一步关注的违规</small>
            </div>
        </section>

        <section class="oa-panel oa-regression-summary">
            <div class="oa-panel-header">
                <div>
                    <div class="oa-panel-kicker">REGRESSION SIGNAL</div>
                    <h2>回归结论</h2>
                    <p>当前快照与最近一次成功分析的差异摘要。</p>
                </div>
                <span class="oa-badge @StatusClass(_report.Status)">@StatusText(_report.Status)</span>
            </div>
            <div class="oa-panel-body">
                <div class="oa-regression-verdict">
                    <div class="oa-regression-verdict-main">
                        <span>质量分</span>
                        <strong>@FormatScore(_currentJob.QualityScore)</strong>
                        <small>基线 @FormatScore(_previousJob.QualityScore)</small>
                    </div>
                    <div class="oa-regression-verdict-divider"></div>
                    <div class="oa-regression-signal-list">
                        <div><span>字段质量变化</span><strong>@_report!.FieldRegressions.Count(x => MatchesFieldFilter(x)) 项</strong></div>
                        <div><span>违规回归</span><strong>@_report!.ViolationRegressions.Count(x => MatchesViolationFilter(x)) 项</strong></div>
                        <div><span>问题变化</span><strong class="@DeltaClass(_report.IssueDelta)">@FormatIntDelta(_report.IssueDelta)</strong></div>
                    </div>
                </div>
            </div>
        </section>

        @if (FilteredFields.Count > 0)
        {
            <section class="oa-panel oa-regression-panel">
                <div class="oa-panel-header">
                    <div>
                        <div class="oa-panel-kicker">FIELD QUALITY</div>
                        <h2>字段质量变化</h2>
                        <p>优先查看覆盖率、空值率和唯一率出现明显退化的字段。</p>
                    </div>
                    <span class="oa-count-badge">@FilteredFields.Count 项</span>
                </div>
                <div class="oa-table-wrap">
                    <table class="oa-regression-table">
                        <thead>
                            <tr><th>字段</th><th>状态</th><th>覆盖率</th><th>空值率</th><th>唯一率</th><th>回归原因</th></tr>
                        </thead>
                        <tbody>
                        @foreach (var item in FilteredFields)
                        {
                            <tr>
                                <td><code>@item.FieldName</code></td>
                                <td><span class="oa-badge @StatusClass(item.Status)">@StatusText(item.Status)</span></td>
                                <td class="oa-number-value">@FormatDelta(item.CoverageDelta * 100)</td>
                                <td class="oa-number-value">@FormatDelta(item.NullRateDelta * 100)</td>
                                <td class="oa-number-value">@(item.UniquenessDelta.HasValue ? FormatDelta(item.UniquenessDelta.Value * 100) : "-")</td>
                                <td class="oa-regression-reasons">@string.Join("；", item.Reasons)</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
                <div class="oa-analysis-note">变化值均以百分点表示。正负方向需结合指标语义理解，例如空值率上升通常代表质量退化。</div>
            </section>
        }
        else
        {
            <section class="oa-panel oa-regression-panel">
                <div class="oa-panel-header">
                    <div>
                        <div class="oa-panel-kicker">FIELD QUALITY</div>
                        <h2>字段质量变化</h2>
                    </div>
                    <span class="oa-badge is-success">稳定</span>
                </div>
                <div class="oa-success-state oa-regression-success">
                    <div class="oa-success-icon">✓</div>
                    <div><h3>未发现字段质量回归</h3><p>最近两次成功分析的字段质量没有触发回归项。</p></div>
                </div>
            </section>
        }

        <section class="oa-panel oa-regression-panel">
            <div class="oa-panel-header">
                <div>
                    <div class="oa-panel-kicker">VIOLATION REGRESSION</div>
                    <h2>质量违规回归</h2>
                    <p>新增或数量增加的违规项会在这里集中呈现。</p>
                </div>
                <span class="oa-count-badge">@FilteredViolations.Count 项</span>
            </div>
            @if (FilteredViolations.Count > 0)
            {
                <div class="oa-table-wrap">
                    <table class="oa-regression-table oa-violation-table">
                        <thead>
                            <tr><th>字段</th><th>检查类型</th><th>基线</th><th>当前</th><th>增加</th><th>变化</th></tr>
                        </thead>
                        <tbody>
                        @foreach (var item in FilteredViolations)
                        {
                            <tr>
                                <td><code>@(string.IsNullOrWhiteSpace(item.FieldName) ? "数据集" : item.FieldName)</code></td>
                                <td>@item.Check</td>
                                <td class="oa-number-value">@item.PreviousCount</td>
                                <td class="oa-number-value">@item.CurrentCount</td>
                                <td><span class="oa-delta-danger">+@item.Delta</span></td>
                                <td><span class="oa-badge @(item.IsNew ? "is-danger" : "is-warning")">@(item.IsNew ? "新出现" : "违规增加")</span></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="oa-success-state oa-regression-success">
                    <div class="oa-success-icon">✓</div>
                    <div><h3>未发现质量违规增加</h3><p>当前结果没有发现新增或增加的质量违规。</p></div>
                </div>
            }
        </section>
    }
</div>

@code {
    private bool _loading = true;
    private List<AnalysisJob> _jobs = new();
    private AnalysisJob? _currentJob;
    private AnalysisJob? _previousJob;
    private QualityRegressionReport? _report;
    private string? FieldStatusFilter;
    [SupplyParameterFromQuery(Name = "jobId")]
    public Guid? JobId { get; set; }

    private string? FieldFilter;

    private string SchemaImpactUrl => _currentJob is null ? "/quality/schema-impact" : $"/quality/schema-impact?jobId={_currentJob.Id}";
    private string ImpactAnalysisUrl => _currentJob is null ? "/quality/impact-analysis" : $"/quality/impact-analysis?jobId={_currentJob.Id}";
    private string IssuesUrl => _currentJob is null ? "/issues" : $"/issues?jobId={_currentJob.Id}";

    private IReadOnlyList<QualityFieldRegression> FilteredFields => (_report?.FieldRegressions ?? new List<QualityFieldRegression>())
        .Where(MatchesFieldFilter)
        .ToList();

    private IReadOnlyList<QualityFieldRegression> FilteredRegressedFields => FilteredFields
        .Where(x => x.Status == QualityRegressionStatus.Regressed || x.Status == QualityRegressionStatus.Severe)
        .ToList();

    private IReadOnlyList<QualityViolationRegression> FilteredViolations => (_report?.ViolationRegressions ?? new List<QualityViolationRegression>())
        .Where(MatchesViolationFilter)
        .ToList();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        await HistoryStore.InitializeAsync();
        _jobs = (await HistoryStore.GetRecentAsync(100)).Where(x => x.Status == AnalysisJobStatus.Succeeded && !string.IsNullOrWhiteSpace(x.ResultJson)).OrderByDescending(x => x.StartedAtUtc).ToList();
        _currentJob = JobId.HasValue ? _jobs.FirstOrDefault(x => x.Id == JobId.Value) : _jobs.FirstOrDefault();
        _previousJob = FindBaselineJob(_currentJob);
        RebuildReport();
        _loading = false;
    }

    private AnalysisJob? FindBaselineJob(AnalysisJob? current)
    {
        if (current is null) return null;
        return _jobs.Where(x => x.Id != current.Id && x.StartedAtUtc < current.StartedAtUtc).OrderByDescending(x => x.StartedAtUtc).FirstOrDefault()
            ?? _jobs.FirstOrDefault(x => x.Id != current.Id);
    }

    private void RebuildReport()
    {
        _report = null;
        if (_currentJob is null || _previousJob is null)
            return;

        try
        {
            var current = JsonSerializer.Deserialize<AnalysisResult>(_currentJob.ResultJson!);
            var previous = JsonSerializer.Deserialize<AnalysisResult>(_previousJob.ResultJson!);
            if (current is not null && previous is not null)
                _report = QualityRegressionAnalyzer.Analyze(previous, current);
        }
        catch (JsonException)
        {
            _report = null;
        }
    }

    private async Task OnCurrentJobChanged(ChangeEventArgs args)
    {
        if (!Guid.TryParse(args.Value?.ToString(), out var id)) return;
        _currentJob = _jobs.FirstOrDefault(x => x.Id == id);
        if (_currentJob is null) return;
        JobId = _currentJob.Id;
        if (_currentJob.Id == _previousJob?.Id) _previousJob = FindBaselineJob(_currentJob);
        Navigation.NavigateTo($"/quality/regression?jobId={_currentJob.Id}", replace: true);
        RebuildReport();
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnPreviousJobChanged(ChangeEventArgs args)
    {
        if (!Guid.TryParse(args.Value?.ToString(), out var id)) return;
        _previousJob = _jobs.FirstOrDefault(x => x.Id == id);
        RebuildReport();
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnFieldStatusChanged(ChangeEventArgs args)
    {
        FieldStatusFilter = args.Value?.ToString();
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnFieldChanged(ChangeEventArgs args)
    {
        FieldFilter = args.Value?.ToString();
        await InvokeAsync(StateHasChanged);
    }

    private bool MatchesFieldFilter(QualityFieldRegression item)
        => (string.IsNullOrWhiteSpace(FieldStatusFilter) || string.Equals(item.Status.ToString(), FieldStatusFilter, StringComparison.OrdinalIgnoreCase))
            && (string.IsNullOrWhiteSpace(FieldFilter) || item.FieldName.Contains(FieldFilter, StringComparison.OrdinalIgnoreCase));

    private bool MatchesViolationFilter(QualityViolationRegression item)
        => string.IsNullOrWhiteSpace(FieldFilter) || item.FieldName.Contains(FieldFilter, StringComparison.OrdinalIgnoreCase);

    private static string FormatScore(double? value) => value.HasValue ? value.Value.ToString("F1") : "-";
    private static string FormatDelta(double value) => $"{(value >= 0 ? "+" : "")}{value:F1}";
    private static string FormatIntDelta(int value) => $"{(value >= 0 ? "+" : "")}{value:N0}";
    private static string ScoreClass(double value) => value > 0 ? "text-success" : value < 0 ? "text-danger" : "";
    private static string DeltaClass(int value) => value > 0 ? "text-danger" : value < 0 ? "text-success" : "";
    private static string StatusClass(QualityRegressionStatus status) => status switch
    {
        QualityRegressionStatus.Severe => "is-danger", QualityRegressionStatus.Regressed => "is-warning",
        QualityRegressionStatus.Improved => "is-success", QualityRegressionStatus.Added => "is-info",
        QualityRegressionStatus.Removed => "is-neutral", _ => "is-neutral"
    };
    private static string StatusText(QualityRegressionStatus status) => status switch
    {
        QualityRegressionStatus.Severe => "严重回归", QualityRegressionStatus.Regressed => "发生回归",
        QualityRegressionStatus.Improved => "质量改善", QualityRegressionStatus.Added => "新增字段",
        QualityRegressionStatus.Removed => "字段消失", _ => "稳定"
    };
}