@page "/quality/recommendations"
@using System.Text.Json
@using ObjectAnalyzer.Analysis
@using ObjectAnalyzer.Platform
@inject IAnalysisHistoryStore HistoryStore

<PageTitle>质量修复建议</PageTitle>

<div class="oa-analysis-page oa-recommendations-page">
    <header class="oa-analysis-header">
        <div class="oa-recommendation-title">
            <div class="oa-eyebrow">Quality Governance / Recommendations</div>
            <div class="oa-recommendation-title-row">
                <div><h1>质量修复建议</h1><p>把质量问题转换成可执行的治理建议，先建议、后修复，不直接修改源数据。</p></div>
                <div class="oa-header-actions">
                    <a class="btn btn-outline-secondary" href="/issues">问题中心</a>
                    <a class="btn btn-outline-secondary" href="/quality">质量总览</a>
                    <button class="btn btn-outline-secondary oa-recommendation-refresh" @onclick="LoadAsync">刷新数据</button>
                </div>
            </div>
        </div>
    </header>

    @if (_loading)
    {
        <div class="oa-empty-state oa-recommendations-state"><div class="oa-empty-icon">◌</div><strong>正在加载质量问题</strong><span>正在读取最近一次成功的分析结果。</span></div>
    }
    else if (_recommendations.Count == 0)
    {
        <div class="oa-empty-state oa-empty-state-success oa-recommendations-state"><div class="oa-empty-icon">✓</div><strong>当前没有可生成建议的质量问题</strong><span>最近一次成功分析没有发现需要生成治理建议的字段问题。</span></div>
    }
    else
    {
        <section class="oa-dashboard-section">
            <article class="oa-dashboard-panel oa-recommendation-filter-card">
                <div class="oa-panel-header"><div><span class="oa-panel-kicker">RECOMMENDATION FILTERS</span><h2>筛选建议</h2></div><span class="oa-badge is-neutral">@FilteredRecommendations.Count 条</span></div>
                <div class="oa-panel-body">
                    <div class="oa-recommendation-filter-grid">
                        <div><label class="form-label">分析任务</label><select class="form-select" value="@SelectedJobId" @onchange="OnJobChanged">@foreach (var job in _jobs){<option value="@job.Id">@FormatJob(job)</option>}</select></div>
                        <div><label class="form-label">优先级</label><select class="form-select" value="@PriorityFilter" @onchange="OnPriorityChanged"><option value="">全部</option><option value="3">高</option><option value="2">中</option><option value="1">低</option></select></div>
                        <div><label class="form-label">问题类型</label><select class="form-select" value="@CheckFilter" @onchange="OnCheckChanged"><option value="">全部</option>@foreach(var check in _recommendations.Select(x=>x.Check).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x=>x)){<option value="@check">@QualityCheckTypes.Label(check)</option>}</select></div>
                        <div><label class="form-label">字段搜索</label><input class="form-control" value="@FieldFilter" @oninput="OnFieldChanged" placeholder="搜索字段名..." /></div>
                    </div>
                </div>
            </article>
        </section>

        <section class="oa-dashboard-section">
            <div class="oa-context-grid oa-recommendation-context">
                <div><span>当前数据源</span><strong>@_sourceName</strong></div>
                <div><span>分析时间</span><strong>@_jobTime</strong></div>
                <div><span>待治理问题</span><strong>@FilteredRecommendations.Count</strong></div>
                <div><span>涉及字段</span><strong>@FilteredRecommendations.Select(x => x.Field).Distinct(StringComparer.OrdinalIgnoreCase).Count()</strong></div>
            </div>
        </section>

        <section class="oa-dashboard-section">
            <div class="oa-section-heading"><div><span class="oa-section-kicker">Risk Overview</span><h2>治理信号</h2><span>按问题规模与优先级快速识别治理重点</span></div></div>
            <div class="oa-kpi-grid is-3">
                <div class="oa-kpi-card is-danger"><div class="oa-kpi-label">待治理问题</div><div class="oa-kpi-value">@FilteredRecommendations.Count</div><div class="oa-kpi-meta">需要关注的质量问题</div></div>
                <div class="oa-kpi-card is-warning"><div class="oa-kpi-label">涉及字段</div><div class="oa-kpi-value">@FilteredRecommendations.Select(x => x.Field).Distinct(StringComparer.OrdinalIgnoreCase).Count()</div><div class="oa-kpi-meta">存在质量风险的字段</div></div>
                <div class="oa-kpi-card is-info"><div class="oa-kpi-label">违规次数</div><div class="oa-kpi-value">@FilteredRecommendations.Sum(x => x.Count)</div><div class="oa-kpi-meta">所有问题累计影响次数</div></div>
            </div>
        </section>

        <section class="oa-dashboard-section">
            <article class="oa-dashboard-panel oa-recommendations-panel">
                <div class="oa-panel-header">
                    <div><span class="oa-panel-kicker">Action Plan</span><h2>治理建议</h2><p>建议按照优先级处理，不会自动修改源数据。</p></div>
                    <span class="oa-badge is-neutral">@FilteredRecommendations.Count 条建议</span>
                </div>
                <div class="oa-recommendation-list">
                    @if (FilteredRecommendations.Count == 0)
                    {
                        <div class="oa-empty-state"><div class="oa-empty-icon">∅</div><strong>当前筛选条件下没有治理建议</strong><span>可以调整优先级、问题类型或字段搜索条件。</span></div>
                    }
                    @foreach (var (item, index) in FilteredRecommendations.OrderByDescending(x => x.Priority).ThenByDescending(x => x.Count).Select((item, index) => (item, index + 1)))
                    {
                        <article class="oa-recommendation-item">
                            <div class="oa-recommendation-item-head">
                                <div class="oa-recommendation-field-wrap"><span class="oa-recommendation-index">@(index.ToString("D2"))</span><strong class="oa-recommendation-field">@item.Field</strong></div>
                                <span class="oa-badge @(item.Priority >= 3 ? "is-danger" : item.Priority == 2 ? "is-warning" : "is-neutral")">@(item.PriorityText)优先</span>
                            </div>
                            <div class="oa-recommendation-grid">
                                <div><span>问题类型</span><strong>@QualityCheckTypes.Label(item.Check)</strong><p>@item.Message</p></div>
                                <div><span>影响次数</span><strong class="oa-recommendation-count">@item.Count.ToString("N0")</strong><p>当前分析快照</p></div>
                                <div><span>建议动作</span><strong>@item.Action</strong></div>
                                <div><span>建议规则</span><code>@item.Rule</code></div>
                            </div>
                        </article>
                    }
                </div>
                <div class="oa-dashboard-note oa-governance-note"><strong>治理边界</strong><span>这些建议用于辅助治理决策，系统不会根据建议直接修改源数据。具体规则仍需结合业务口径确认。</span></div>
            </article>
        </section>
    }
</div>

@code {
    private bool _loading = true;
    private readonly List<Recommendation> _recommendations = new();
    private List<AnalysisJob> _jobs = new();
    private Guid? SelectedJobId;
    private string? PriorityFilter;
    private string? CheckFilter;
    private string? FieldFilter;

    private IReadOnlyList<Recommendation> FilteredRecommendations => _recommendations
        .Where(x => string.IsNullOrWhiteSpace(PriorityFilter) || x.Priority.ToString() == PriorityFilter)
        .Where(x => string.IsNullOrWhiteSpace(CheckFilter) || string.Equals(x.Check, CheckFilter, StringComparison.OrdinalIgnoreCase))
        .Where(x => string.IsNullOrWhiteSpace(FieldFilter) || x.Field.Contains(FieldFilter, StringComparison.OrdinalIgnoreCase))
        .ToList();
    private string _sourceName = "";
    private string _jobTime = "";

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _recommendations.Clear();
        await HistoryStore.InitializeAsync();
        _jobs = (await HistoryStore.GetRecentAsync(100))
            .Where(x => x.Status == AnalysisJobStatus.Succeeded && !string.IsNullOrWhiteSpace(x.ResultJson))
            .OrderByDescending(x => x.StartedAtUtc)
            .ToList();

        if (SelectedJobId is null || !_jobs.Any(x => x.Id == SelectedJobId.Value))
            SelectedJobId = _jobs.FirstOrDefault()?.Id;

        var job = _jobs.FirstOrDefault(x => x.Id == SelectedJobId); 
        if (job is not null)
        {
            _sourceName = job.SourceName;
            _jobTime = job.StartedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss");
            try
            {
                using var document = JsonDocument.Parse(job.ResultJson!);
                if (document.RootElement.TryGetProperty("qualityViolations", out var violations) && violations.ValueKind == JsonValueKind.Array)
                {
                    foreach (var item in violations.EnumerateArray())
                    {
                        var check = GetString(item, "check");
                        var field = GetString(item, "field");
                        if (string.IsNullOrWhiteSpace(field) || field == "-") continue;
                        _recommendations.Add(BuildRecommendation(field, check, GetLong(item, "count"), GetString(item, "message")));
                    }
                }
            }
            catch (JsonException) { }
        }
        _loading = false;
    }

    private async Task OnJobChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var id))
        {
            SelectedJobId = id;
            await LoadAsync();
        }
    }

    private void OnPriorityChanged(ChangeEventArgs e) => PriorityFilter = e.Value?.ToString();
    private void OnCheckChanged(ChangeEventArgs e) => CheckFilter = e.Value?.ToString();
    private void OnFieldChanged(ChangeEventArgs e) => FieldFilter = e.Value?.ToString();

    private string FormatJob(AnalysisJob job) => $"{job.StartedAtUtc.ToLocalTime():yyyy-MM-dd HH:mm} · {job.SourceName}";

    private static Recommendation BuildRecommendation(string field, string check, long count, string message)
    {
        var (action, rule, priority) = check switch
        {
            QualityCheckTypes.Required => ("补齐缺失值，或明确允许为空", "required: true", 3),
            QualityCheckTypes.NullRate => ("排查空值来源并降低字段空值率", "nullRate: < 当前阈值", 3),
            QualityCheckTypes.Range => ("检查异常数值来源，并设置合理上下界", "minValue / maxValue", 3),
            QualityCheckTypes.Pattern => ("统一格式并增加模式校验", "pattern: <正则表达式>", 2),
            QualityCheckTypes.EnumValues => ("统一枚举编码，清理非法枚举值", "enumValues: [允许值]", 2),
            QualityCheckTypes.Unique => ("去除重复数据并确认唯一键设计", "unique: true", 3),
            QualityCheckTypes.OutlierRatio => ("检查异常值来源，必要时增加异常值处理策略", "outlierRatio: < 当前阈值", 2),
            _ => ("根据问题说明检查数据来源并增加针对性质量规则", "配置对应质量规则", 1)
        };
        return new Recommendation(field, check, count, message, action, rule, priority);
    }

    private static string GetString(JsonElement item, string name) => item.TryGetProperty(name, out var value) && value.ValueKind != JsonValueKind.Null ? value.ToString() : "-";
    private static long GetLong(JsonElement item, string name) => item.TryGetProperty(name, out var value) && value.TryGetInt64(out var number) ? number : 0;

    private sealed record Recommendation(string Field, string Check, long Count, string Message, string Action, string Rule, int Priority)
    {
        public string PriorityText => Priority >= 3 ? "高" : Priority == 2 ? "中" : "低";
    }
}

