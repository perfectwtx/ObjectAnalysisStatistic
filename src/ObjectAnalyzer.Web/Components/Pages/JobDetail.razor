@page "/jobs/{JobId:guid}"
@using System.Text.Json
@using ObjectAnalyzer.Analysis
@using ObjectAnalyzer.Analysis.Gates
@using ObjectAnalyzer.Platform
@inject IAnalysisHistoryStore HistoryStore
@inject IQualityIssueQuery QualityIssueQuery

<PageTitle>分析作业详情</PageTitle>

<div class="oa-analysis-page oa-job-detail">
    <div class="oa-analysis-header">
        <div>
            <div class="oa-eyebrow">ANALYSIS RUN</div>
            <h1>分析作业详情</h1>
            <p>查看一次分析执行的完整结果、质量基线、质量门禁与问题。</p>
        </div>
        <a class="btn btn-outline-secondary" href="/jobs">返回作业中心</a>
    </div>

    @if (_loading)
    {
        <div class="oa-empty-state oa-panel"><div class="oa-empty-icon">…</div><strong>正在加载作业</strong><span>正在读取分析结果和质量问题。</span></div>
    }
    else if (_job is null)
    {
        <div class="oa-empty-state oa-panel"><div class="oa-empty-icon">!</div><h2>未找到指定的分析作业</h2><p>该作业可能已被删除，或当前历史记录中不存在。</p></div>
    }
    else
    {
        <div class="oa-job-hero mb-4">
            <div class="oa-job-hero-main"><div class="oa-job-kicker">ANALYSIS JOB</div><div class="oa-job-title-row"><h2>@_job.SourceName</h2><span class="oa-status-badge oa-status-@_job.Status.ToString().ToLowerInvariant()">@_job.Status</span></div><div class="oa-job-meta"><span>@_job.SourceType</span><span>·</span><span class="oa-date">@_job.StartedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</span></div></div>
            <div class="oa-job-score"><span>质量总分</span><strong>@FormatScore(_job.QualityScore)</strong></div>
        </div>

        <div class="oa-summary-grid mb-4 oa-job-summary-grid">
            <div class="oa-summary-card"><span>质量问题</span><strong>@_job.IssueCount</strong><small>标准化问题项</small></div><div class="oa-summary-card"><span>分析对象</span><strong>@_job.TotalObjects.ToString("N0")</strong><small>本次分析对象数</small></div><div class="oa-summary-card"><span>字段数量</span><strong>@_job.FieldCount</strong><small>参与分析的字段</small></div><div class="oa-summary-card"><span>执行耗时</span><strong>@FormatDuration(_job.DurationMs)</strong><small>从开始到完成</small></div>
        </div>

        <div class="oa-section-heading"><div><h2>作业信息</h2><p>本次分析的来源与执行上下文。</p></div></div>
        <div class="oa-panel oa-detail-card mb-4"><div class="oa-panel-body"><div class="oa-info-grid"><div class="oa-info-item oa-info-wide"><span>Job ID</span><strong class="oa-mono">@_job.Id</strong></div><div class="oa-info-item"><span>数据源</span><strong>@_job.SourceName</strong></div><div class="oa-info-item"><span>类型</span><strong>@_job.SourceType</strong></div><div class="oa-info-item"><span>开始时间</span><strong class="oa-date">@_job.StartedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</strong></div><div class="oa-info-item"><span>完成时间</span><strong class="oa-date">@(_job.CompletedAtUtc?.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss") ?? "-")</strong></div></div>@if (!string.IsNullOrWhiteSpace(_job.ErrorMessage)) { <div class="alert alert-danger mt-4 mb-0">@_job.ErrorMessage</div> }</div></div>

        @if (_result is not null)
        {
            <div class="oa-section-heading"><div><h2>质量维度</h2><p>从完整性、有效性、唯一性、一致性与异常控制观察本次数据质量。</p></div></div>
            <div class="oa-metric-grid mb-4">@foreach (var metric in _metrics) { <div class="oa-metric-card"><span>@metric.Name</span><strong>@metric.Value.ToString("F1")</strong><div class="progress" role="progressbar" aria-valuenow="@metric.Value" aria-valuemin="0" aria-valuemax="100"><div class="progress-bar" style="width:@($"{Math.Clamp(metric.Value, 0, 100):F0}%")"></div></div></div> }</div>

            <div class="oa-two-column mb-4">
                <div class="oa-panel oa-detail-card h-100"><div class="oa-panel-header"><div><div class="oa-panel-kicker">BASELINE</div><h2>质量基线</h2></div>@if (_baselineEvaluation is null) { <span class="oa-badge is-neutral">未配置基线</span> } else if (_baselineEvaluation.Passed) { <span class="oa-badge is-success">✓ 达标</span> } else { <span class="oa-badge is-danger">未达标</span> }</div><div class="oa-panel-body">@if (_baselineEvaluation is null) { <span class="text-muted">该数据源本次分析没有保存质量基线评估结果。</span> } else if (_baselineEvaluation.Passed) { <div class="oa-state-message oa-state-success"><span>✓</span><div><strong>基线检查通过</strong><p>本次分析满足 <strong>@_baselineEvaluation.SourceName</strong> 的全部最低质量要求。</p></div></div> } else { <div class="oa-table-wrap"><table class="table table-sm align-middle mb-0 oa-analysis-table"><thead><tr><th>指标</th><th>实际值</th><th>最低要求</th><th>差值</th></tr></thead><tbody>@foreach (var failure in _baselineEvaluation.Failures) { <tr><td>@MetricLabel(failure.Metric)</td><td>@failure.Actual.ToString("F1")</td><td>@failure.Minimum.ToString("F1")</td><td class="text-danger">@((failure.Actual - failure.Minimum).ToString("F1"))</td></tr> }</tbody></table></div> }</div></div>
                <div class="oa-panel oa-detail-card h-100"><div class="oa-panel-header"><div><div class="oa-panel-kicker">QUALITY GATES</div><h2>质量门禁</h2></div>@if (_gates.Any(x => x.Triggered)) { <span class="oa-badge is-danger">未通过</span> } else if (_gates.Count > 0) { <span class="oa-badge is-success">全部通过</span> } else { <span class="oa-badge is-neutral">无历史结果</span> }</div><div class="oa-panel-body">@if (_gates.Count == 0) { <span class="text-muted">该作业没有保存门禁执行结果。</span> } else { <div class="oa-gate-list">@foreach (var gate in _gates) { <div class="oa-gate-item"><div class="d-flex justify-content-between gap-2"><strong>@gate.Name</strong><span class="badge @(gate.Triggered ? "bg-danger" : "bg-success")">@(gate.Triggered ? "未通过" : "通过")</span></div><div class="small text-muted mt-2">ExitCode: @gate.ExitCode</div>@if (gate.Triggered) { <div class="small text-danger mt-1">@gate.FailureMessage</div> }</div> }</div> }</div></div>
            </div>

            <div class="oa-section-heading"><div><h2>质量问题</h2><p>按违规次数降序展示当前作业发现的问题。</p></div><span class="oa-count-pill">@_issues.Count 项</span></div>
            <div class="oa-panel oa-detail-card oa-issue-table-card mb-4"><div class="oa-panel-body p-0">@if (_issues.Count == 0) { <div class="oa-success-state"><div class="oa-success-icon">✓</div><div><h3>当前作业没有标准化质量问题</h3><p>本次数据质量检查没有记录违规项。</p></div></div> } else { <div class="oa-table-wrap"><table class="table table-hover mb-0 oa-analysis-table"><thead><tr><th>字段</th><th>检查项</th><th>数量</th><th>消息</th></tr></thead><tbody>@foreach (var issue in _issues) { <tr><td><strong>@(string.IsNullOrWhiteSpace(issue.FieldName) ? "数据集" : issue.FieldName)</strong></td><td><span class="oa-badge is-warning">@QualityCheckTypes.Label(issue.Check)</span></td><td><span class="oa-issue-count">@issue.Count</span></td><td>@issue.Message</td></tr> }</tbody></table></div> }</div></div>

            <div class="oa-section-heading"><div><h2>结构分析</h2><p>快速查看 Schema、字段关系与对象关系分析结果。</p></div></div>
            <div class="oa-three-column"><div class="oa-panel oa-detail-card h-100"><div class="oa-panel-header"><h2>Schema 影响</h2></div><div class="oa-panel-body">@if (_result.SchemaDiff is null) { <span class="text-muted">未产生 Schema Diff。</span> } else { <div class="oa-stat-strip"><div><strong>@_result.SchemaDiff.AddedFields.Count</strong><span>新增</span></div><div><strong>@_result.SchemaDiff.ChangedFields.Count</strong><span>变更</span></div><div><strong>@_result.SchemaDiff.RemovedFields.Count</strong><span>删除</span></div></div> }</div></div><div class="oa-panel oa-detail-card h-100"><div class="oa-panel-header"><h2>字段关系</h2></div><div class="oa-panel-body">@if (_result.CorrelationMatrix is null) { <span class="text-muted">未产生字段相关性结果。</span> } else { <div class="oa-stat-strip"><div><strong>@_result.CorrelationMatrix.Fields.Count</strong><span>字段</span></div><div><strong>@_result.CorrelationMatrix.Samples</strong><span>样本</span></div><div><strong>@_result.CorrelationMatrix.StrongPairs.Count</strong><span>强相关</span></div></div> }</div></div><div class="oa-panel oa-detail-card h-100"><div class="oa-panel-header"><h2>对象关系</h2></div><div class="oa-panel-body">@if (_result.ObjectRelationships is null || _result.ObjectRelationships.Count == 0) { <span class="text-muted">未发现嵌套对象关系。</span> } else { <div class="oa-stat-strip"><div><strong>@_result.ObjectRelationships.Count</strong><span>关系</span></div><div><strong>@_result.ObjectRelationships.Count(x => x.Kind == "Object")</strong><span>对象</span></div><div><strong>@_result.ObjectRelationships.Count(x => x.Kind == "Collection")</strong><span>集合</span></div></div><div class="d-flex gap-2 flex-wrap mt-4"><a class="btn btn-sm btn-outline-primary" href="/quality/object-relationships">对象关系</a><a class="btn btn-sm btn-outline-success" href="/quality/data-lineage">数据血缘</a><a class="btn btn-sm btn-outline-danger" href="/quality/impact-analysis">影响分析</a></div> }</div></div></div>
        }
    }
</div>

@code {
    [Parameter] public Guid JobId { get; set; }
    private bool _loading = true;
    private AnalysisJob? _job;
    private AnalysisResult? _result;
    private QualityBaselineEvaluation? _baselineEvaluation;
    private List<QualityIssue> _issues = new();
    private List<QualityGateResult> _gates = new();
    private List<QualityMetric> _metrics = new();
    protected override async Task OnParametersSetAsync() => await LoadAsync();
    private async Task LoadAsync()
    {
        _loading = true; await HistoryStore.InitializeAsync(); _job = await HistoryStore.GetAsync(JobId); _result = null; _baselineEvaluation = null; _issues.Clear(); _gates.Clear(); _metrics.Clear();
        if (_job is not null)
        {
            _issues = (await QualityIssueQuery.GetByJobAsync(_job.Id)).OrderByDescending(x => x.Count).ThenBy(x => x.FieldName).ToList();
            if (!string.IsNullOrWhiteSpace(_job.ResultJson)) { try { _result = JsonSerializer.Deserialize<AnalysisResult>(_job.ResultJson); if (!string.IsNullOrWhiteSpace(_job.GateResultsJson)) { var gates = JsonSerializer.Deserialize<List<QualityGateResult>>(_job.GateResultsJson); if (gates is not null) _gates = gates; } if (!string.IsNullOrWhiteSpace(_job.QualityBaselineEvaluationJson)) _baselineEvaluation = JsonSerializer.Deserialize<QualityBaselineEvaluation>(_job.QualityBaselineEvaluationJson); } catch (JsonException) { _result = null; _baselineEvaluation = null; } }
            if (_result is not null) { var metrics = QualityMetricsCalculator.Calculate(_result); _metrics = new() { new("完整性", metrics.Completeness), new("有效性", metrics.Validity), new("唯一性", metrics.Uniqueness), new("一致性", metrics.Consistency), new("异常控制", metrics.AnomalyControl) }; }
        }
        _loading = false;
    }
    private static string MetricLabel(string metric) => metric switch { "OverallScore" => "综合质量分", "Completeness" => "完整性", "Validity" => "有效性", "Uniqueness" => "唯一性", "Consistency" => "一致性", "AnomalyControl" => "异常控制", _ => metric };
    private static string FormatScore(double? score) => score.HasValue ? score.Value.ToString("F1") : "-";
    private static string FormatDuration(long milliseconds) => milliseconds <= 0 ? "-" : milliseconds < 1000 ? $"{milliseconds:N0} ms" : $"{TimeSpan.FromMilliseconds(milliseconds):hh\\:mm\\:ss}";
    private sealed record QualityMetric(string Name, double Value);
}