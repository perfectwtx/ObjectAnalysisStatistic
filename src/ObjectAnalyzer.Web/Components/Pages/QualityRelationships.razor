@page "/quality/relationships"
@using System.Text.Json
@using ObjectAnalyzer.Analysis
@using ObjectAnalyzer.Platform
@inject IAnalysisHistoryStore HistoryStore

<PageTitle>字段关系分析</PageTitle>

<div class="oa-analysis-page">
    <div class="oa-analysis-header">
        <div>
            <div class="oa-eyebrow">Quality Analysis</div>
            <h1>字段关系分析</h1>
            <p>基于最近一次成功分析结果，查看字段之间的统计相关性与强相关关系。</p>
        </div>
        <button class="btn btn-outline-secondary" @onclick="LoadAsync">刷新</button>
    </div>

    @if (_loading)
    {
        <div class="alert alert-info">正在加载最近一次分析结果...</div>
    }
    else if (_job is null)
    {
        <div class="card"><div class="oa-empty-state"><strong>暂无成功的分析记录</strong>请先执行一次分析，再返回这里查看字段关系。</div></div>
    }
    else if (_matrix is null)
    {
        <div class="card"><div class="oa-empty-state"><strong>暂无字段相关性结果</strong>最近一次分析没有生成字段关系数据，请在分析配置中启用字段关系分析后重新执行。</div></div>
    }
    else
    {
        <div class="row g-3 mb-4">
            <div class="col-sm-6 col-xl-3"><div class="card oa-analysis-kpi h-100"><div class="card-body"><div class="oa-kpi-label">参与字段</div><div class="oa-kpi-value">@_matrix.Fields.Count</div><div class="oa-kpi-meta">纳入相关性计算的字段</div></div></div></div>
            <div class="col-sm-6 col-xl-3"><div class="card oa-analysis-kpi h-100"><div class="card-body"><div class="oa-kpi-label">样本数</div><div class="oa-kpi-value">@_matrix.Samples</div><div class="oa-kpi-meta">本次相关性分析样本</div></div></div></div>
            <div class="col-sm-6 col-xl-3"><div class="card oa-analysis-kpi h-100"><div class="card-body"><div class="oa-kpi-label">强相关关系</div><div class="oa-kpi-value">@_matrix.StrongPairs.Count</div><div class="oa-kpi-meta">达到当前强相关阈值</div></div></div></div>
            <div class="col-sm-6 col-xl-3"><div class="card oa-analysis-kpi h-100"><div class="card-body"><div class="oa-kpi-label">数据源</div><div class="oa-kpi-value fs-5 text-truncate" title="@_job.SourceName">@_job.SourceName</div><div class="oa-kpi-meta">最近一次成功分析</div></div></div></div>
        </div>

        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>强相关字段对</span><span class="badge bg-primary">@_matrix.StrongPairs.Count</span>
            </div>
            <div class="card-body p-0">
                @if (_matrix.StrongPairs.Count == 0)
                {
                    <div class="oa-empty-state"><strong>没有强相关字段对</strong>当前没有达到强相关阈值的字段组合。</div>
                }
                else
                {
                    <div class="table-responsive"><table class="table table-hover align-middle mb-0">
                        <thead><tr><th>字段 A</th><th>字段 B</th><th>Pearson</th><th>Spearman</th><th>样本数</th><th>关系</th></tr></thead>
                        <tbody>
                        @foreach (var pair in _matrix.StrongPairs.OrderByDescending(x => Math.Abs(x.Pearson ?? 0d)))
                        {
                            <tr>
                                <td><strong>@pair.FieldA</strong></td>
                                <td><strong>@pair.FieldB</strong></td>
                                <td>@(pair.Pearson?.ToString("0.000") ?? "-")</td>
                                <td>@(pair.Spearman?.ToString("0.000") ?? "-")</td>
                                <td>@pair.Samples</td>
                                <td><span class="badge @((pair.Pearson ?? 0) < 0 ? "bg-warning text-dark" : "bg-primary")">@((pair.Pearson ?? 0) < 0 ? "负相关" : "正相关")</span></td>
                            </tr>
                        }
                        </tbody>
                    </table></div>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-header">相关性矩阵</div>
            <div class="oa-matrix-wrap">
                @if (_matrix.Fields.Count == 0)
                {
                    <div class="oa-empty-state">没有可展示的字段。</div>
                }
                else
                {
                    <div class="table-responsive"><table class="table table-sm table-bordered mb-0 align-middle text-center">
                        <thead><tr><th>字段</th>@foreach (var field in _matrix.Fields){<th class="text-nowrap">@field</th>}</tr></thead>
                        <tbody>
                        @for (var i = 0; i < _matrix.Fields.Count; i++)
                        {
                            var row = i;
                            <tr><th class="text-nowrap">@_matrix.Fields[row]</th>@for (var j = 0; j < _matrix.Fields.Count; j++){<td>@FormatCoefficient(_matrix.Pearson, row, j)</td>}</tr>
                        }
                        </tbody>
                    </table></div>
                }
            </div>
            <div class="oa-analysis-note">Pearson 越接近 1 表示强正相关，越接近 -1 表示强负相关，接近 0 表示线性相关性较弱。强相关字段对默认要求绝对相关系数至少 0.7 且样本数至少 30。</div>
        </div>
    }
</div>

@code {
    private bool _loading = true;
    private AnalysisJob? _job;
    private FieldCorrelationMatrix? _matrix;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        await HistoryStore.InitializeAsync();
        var jobs = await HistoryStore.GetRecentAsync(100);
        _job = jobs.Where(x => x.Status == AnalysisJobStatus.Succeeded && !string.IsNullOrWhiteSpace(x.ResultJson)).OrderByDescending(x => x.StartedAtUtc).FirstOrDefault();

        if (_job is not null)
        {
            try
            {
                var result = JsonSerializer.Deserialize<AnalysisResult>(_job.ResultJson!);
                _matrix = result?.CorrelationMatrix;
            }
            catch (JsonException)
            {
                _matrix = null;
            }
        }
        else
        {
            _matrix = null;
        }

        _loading = false;
    }

    private static string FormatCoefficient(IReadOnlyList<List<double?>> matrix, int row, int column)
    {
        if (row < 0 || row >= matrix.Count || column < 0 || column >= matrix[row].Count || matrix[row][column] is null)
            return "-";
        return matrix[row][column]!.Value.ToString("0.00");
    }
}