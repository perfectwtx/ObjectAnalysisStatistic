@page "/alert-rules"
@using ObjectAnalyzer.Platform
@inject IAlertRuleStore RuleStore

<PageTitle>Quality Alert Rules</PageTitle>

<div class="oa-analysis-page oa-alert-page">
    <div class="oa-analysis-header">
        <div>
            <div class="oa-eyebrow">Governance</div>
            <h1>质量告警规则</h1>
            <p>配置质量分、完整性、质量回归、严重问题和 Schema 变更告警。</p>
        </div>
        <button class="btn btn-primary" @onclick="CreateRuleAsync">新增规则</button>
    </div>

    @if (_loading)
    {
        <div class="card oa-analysis-card">
            <div class="card-body oa-analysis-empty">
                <div class="oa-empty-icon">◌</div>
                <strong>正在加载告警规则</strong>
                <span>正在读取当前质量告警配置，请稍候。</span>
            </div>
        </div>
    }
    else if (_rules.Count == 0)
    {
        <div class="card oa-analysis-card">
            <div class="card-body oa-analysis-empty">
                <div class="oa-empty-icon">◌</div>
                <strong>暂无告警规则</strong>
                <span>点击右上角“新增规则”创建第一条质量告警规则。</span>
            </div>
        </div>
    }
    else
    {
        <div class="oa-rule-list">
            @foreach (var rule in _rules)
            {
                <div class="card oa-rule-card">
                    <div class="card-body">
                        <div class="oa-rule-head">
                            <div class="min-w-0">
                                <div class="oa-rule-title-row">
                                    <h2>@rule.Name</h2>
                                    <span class="oa-badge @(rule.Enabled ? "is-success" : "is-neutral")">
                                        @(rule.Enabled ? "已启用" : "已停用")
                                    </span>
                                </div>
                                <div class="oa-rule-subtitle">质量监控触发条件</div>
                            </div>
                            <div class="d-flex gap-2 flex-shrink-0">
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => EditAsync(rule)">编辑</button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(rule.Id)">删除</button>
                            </div>
                        </div>

                        <div class="oa-rule-conditions">
                            @if (rule.QualityScoreBelow is double score)
                            {
                                <span class="oa-condition oa-condition-warning">质量分 &lt; @score:F2</span>
                            }
                            @if (rule.QualityRegressionBelow is double regression)
                            {
                                <span class="oa-condition oa-condition-danger">质量回归 ≥ @regression:F2 分</span>
                            }
                            @if (rule.CompletenessBelow is double completeness)
                            {
                                <span class="oa-condition oa-condition-warning">完整性 &lt; @completeness:F2%</span>
                            }
                            @if (rule.CriticalIssue)
                            {
                                <span class="oa-condition oa-condition-danger">严重问题</span>
                            }
                            @if (rule.BreakingSchemaChange)
                            {
                                <span class="oa-condition oa-condition-danger">Breaking Schema</span>
                            }
                            @if (rule.DistributionDriftAbove is double drift)
                            {
                                <span class="oa-condition oa-condition-warning">分布漂移 &gt; @drift:F2%</span>
                            }
                            @if (!HasConditions(rule))
                            {
                                <span class="text-muted small">未配置触发条件</span>
                            }
                        </div>

                        @if (!string.IsNullOrWhiteSpace(rule.WebhookUrl))
                        {
                            <div class="oa-webhook">
                                <span>Webhook</span>
                                <code>@rule.WebhookUrl</code>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }

    @if (_editing is not null)
    {
        <div class="card oa-editor-card">
            <div class="card-header">
                <div>
                    <div class="oa-eyebrow">Rule Editor</div>
                    <h2>@(_editing.Id == Guid.Empty ? "新增规则" : "编辑规则")</h2>
                </div>
                <button class="btn btn-sm btn-outline-secondary" @onclick="CancelEdit">取消</button>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-lg-6">
                        <label class="form-label">规则名称</label>
                        <input class="form-control" @bind="_editing.Name" />
                    </div>
                    <div class="col-lg-3 d-flex align-items-end">
                        <label class="oa-switch-field">
                            <input type="checkbox" @bind="_editing.Enabled" />
                            <span>启用规则</span>
                        </label>
                    </div>
                    <div class="col-lg-3">
                        <label class="form-label">质量分低于</label>
                        <InputNumber class="form-control" @bind-Value="_editing.QualityScoreBelow" />
                    </div>
                    <div class="col-lg-3">
                        <label class="form-label">质量回归达到</label>
                        <InputNumber class="form-control" @bind-Value="_editing.QualityRegressionBelow" />
                        <div class="form-text">例如 5 表示较上一次下降 5 分或以上。</div>
                    </div>
                    <div class="col-lg-3">
                        <label class="form-label">完整性低于</label>
                        <InputNumber class="form-control" @bind-Value="_editing.CompletenessBelow" />
                    </div>
                    <div class="col-lg-3">
                        <label class="form-label">分布漂移高于</label>
                        <InputNumber class="form-control" @bind-Value="_editing.DistributionDriftAbove" />
                    </div>
                    <div class="col-lg-3 d-flex align-items-end">
                        <label class="oa-check-field"><input type="checkbox" @bind="_editing.CriticalIssue" /><span>严重问题</span></label>
                    </div>
                    <div class="col-lg-3 d-flex align-items-end">
                        <label class="oa-check-field"><input type="checkbox" @bind="_editing.BreakingSchemaChange" /><span>Breaking Schema</span></label>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Webhook 地址</label>
                        <input class="form-control" @bind="_editing.WebhookUrl" placeholder="https://..." />
                    </div>
                </div>

                <div class="oa-editor-actions">
                    <button class="btn btn-primary" @onclick="SaveAsync">保存规则</button>
                    <button class="btn btn-outline-secondary" @onclick="CancelEdit">取消</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private readonly List<AlertRule> _rules = new();
    private bool _loading;
    private AlertRule? _editing;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _rules.Clear();
            _rules.AddRange(await RuleStore.GetAllAsync());
        }
        finally
        {
            _loading = false;
        }
    }

    private Task CreateRuleAsync()
    {
        _editing = new AlertRule
        {
            Name = $"质量规则 {DateTime.Now:HHmmss}",
            Enabled = true,
            QualityScoreBelow = 80,
            QualityRegressionBelow = 5,
            CriticalIssue = true
        };
        return Task.CompletedTask;
    }

    private void EditAsync(AlertRule rule)
    {
        _editing = new AlertRule
        {
            Id = rule.Id,
            Name = rule.Name,
            Enabled = rule.Enabled,
            QualityScoreBelow = rule.QualityScoreBelow,
            QualityRegressionBelow = rule.QualityRegressionBelow,
            CompletenessBelow = rule.CompletenessBelow,
            DistributionDriftAbove = rule.DistributionDriftAbove,
            CriticalIssue = rule.CriticalIssue,
            BreakingSchemaChange = rule.BreakingSchemaChange,
            WebhookUrl = rule.WebhookUrl
        };
    }

    private async Task SaveAsync()
    {
        if (_editing is null || string.IsNullOrWhiteSpace(_editing.Name)) return;
        if (_editing.Id == Guid.Empty) _editing.Id = Guid.NewGuid();
        await RuleStore.SaveAsync(_editing);
        _editing = null;
        await LoadAsync();
    }

    private void CancelEdit() => _editing = null;

    private async Task DeleteAsync(Guid id)
    {
        await RuleStore.DeleteAsync(id);
        if (_editing?.Id == id) _editing = null;
        await LoadAsync();
    }

    private static bool HasConditions(AlertRule rule) =>
        rule.QualityScoreBelow.HasValue ||
        rule.QualityRegressionBelow.HasValue ||
        rule.CompletenessBelow.HasValue ||
        rule.CriticalIssue ||
        rule.BreakingSchemaChange ||
        rule.DistributionDriftAbove.HasValue;
}
