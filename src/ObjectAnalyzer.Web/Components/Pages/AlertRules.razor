@page "/alert-rules"
@using ObjectAnalyzer.Platform
@inject IAlertRuleStore RuleStore

<PageTitle>Quality Alert Rules</PageTitle>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>质量告警规则</h1>
            <p class="text-muted mb-0">配置质量分、完整性、质量回归、严重问题和 Schema 变更告警</p>
        </div>
        <button class="btn btn-primary" @onclick="CreateRuleAsync">新增规则</button>
    </div>

    @if (_loading)
    {
        <p>加载中...</p>
    }
    else if (_rules.Count == 0)
    {
        <div class="alert alert-info">暂无告警规则。</div>
    }
    else
    {
        @foreach (var rule in _rules)
        {
            <div class="card mb-3">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start gap-3">
                        <div>
                            <h5 class="card-title mb-1">@rule.Name</h5>
                            <div class="text-muted small">@(rule.Enabled ? "已启用" : "已停用")</div>
                        </div>
                        <div class="d-flex gap-2">
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => EditAsync(rule)">编辑</button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(rule.Id)">删除</button>
                        </div>
                    </div>
                    <div class="mt-3 row g-2">
                        @if (rule.QualityScoreBelow is double score)
                        {
                            <div class="col-md-3"><span class="badge text-bg-warning">质量分 &lt; @score:F2</span></div>
                        }
                        @if (rule.QualityRegressionBelow is double regression)
                        {
                            <div class="col-md-3"><span class="badge text-bg-danger">质量回归 ≥ @regression:F2 分</span></div>
                        }
                        @if (rule.CompletenessBelow is double completeness)
                        {
                            <div class="col-md-3"><span class="badge text-bg-warning">完整性 &lt; @completeness:F2%</span></div>
                        }
                        @if (rule.CriticalIssue)
                        {
                            <div class="col-md-3"><span class="badge text-bg-danger">严重问题</span></div>
                        }
                        @if (rule.BreakingSchemaChange)
                        {
                            <div class="col-md-3"><span class="badge text-bg-danger">Breaking Schema</span></div>
                        }
                        @if (rule.DistributionDriftAbove is double drift)
                        {
                            <div class="col-md-3"><span class="badge text-bg-warning">分布漂移 &gt; @drift:F2%</span></div>
                        }
                        @if (!string.IsNullOrWhiteSpace(rule.WebhookUrl))
                        {
                            <div class="col-12 small text-muted">Webhook: @rule.WebhookUrl</div>
                        }
                    </div>
                </div>
            </div>
        }
    }

    @if (_editing is not null)
    {
        <div class="card mt-4">
            <div class="card-body">
                <h4>@(_editing.Id == Guid.Empty ? "新增规则" : "编辑规则")</h4>
                <div class="row g-3 mt-1">
                    <div class="col-md-6">
                        <label class="form-label">规则名称</label>
                        <input class="form-control" @bind="_editing.Name" />
                    </div>
                    <div class="col-md-3 form-check mt-4 ms-2">
                        <input class="form-check-input" type="checkbox" @bind="_editing.Enabled" />
                        <label class="form-check-label">启用</label>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">质量分低于</label>
                        <InputNumber class="form-control" @bind-Value="_editing.QualityScoreBelow" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">质量回归达到</label>
                        <InputNumber class="form-control" @bind-Value="_editing.QualityRegressionBelow" />
                        <div class="form-text">例如 5 表示较上一次下降 5 分或以上</div>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">完整性低于</label>
                        <InputNumber class="form-control" @bind-Value="_editing.CompletenessBelow" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">分布漂移高于</label>
                        <InputNumber class="form-control" @bind-Value="_editing.DistributionDriftAbove" />
                    </div>
                    <div class="col-md-3 form-check mt-4 ms-2">
                        <input class="form-check-input" type="checkbox" @bind="_editing.CriticalIssue" />
                        <label class="form-check-label">严重问题</label>
                    </div>
                    <div class="col-md-3 form-check mt-4 ms-2">
                        <input class="form-check-input" type="checkbox" @bind="_editing.BreakingSchemaChange" />
                        <label class="form-check-label">Breaking Schema</label>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Webhook 地址</label>
                        <input class="form-control" @bind="_editing.WebhookUrl" />
                    </div>
                </div>
                <div class="mt-3 d-flex gap-2">
                    <button class="btn btn-primary" @onclick="SaveAsync">保存</button>
                    <button class="btn btn-outline-secondary" @onclick="CancelEdit">取消</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private readonly List<AlertRule> _rules = new();
    private bool _loading;
    private AlertRule? _editing;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _rules.Clear();
            _rules.AddRange(await RuleStore.GetAllAsync());
        }
        finally
        {
            _loading = false;
        }
    }

    private Task CreateRuleAsync()
    {
        _editing = new AlertRule
        {
            Name = $"质量规则 {DateTime.Now:HHmmss}",
            Enabled = true,
            QualityScoreBelow = 80,
            QualityRegressionBelow = 5,
            CriticalIssue = true
        };
        return Task.CompletedTask;
    }

    private void EditAsync(AlertRule rule)
    {
        _editing = new AlertRule
        {
            Id = rule.Id,
            Name = rule.Name,
            Enabled = rule.Enabled,
            QualityScoreBelow = rule.QualityScoreBelow,
            QualityRegressionBelow = rule.QualityRegressionBelow,
            CompletenessBelow = rule.CompletenessBelow,
            DistributionDriftAbove = rule.DistributionDriftAbove,
            CriticalIssue = rule.CriticalIssue,
            BreakingSchemaChange = rule.BreakingSchemaChange,
            WebhookUrl = rule.WebhookUrl
        };
    }

    private async Task SaveAsync()
    {
        if (_editing is null || string.IsNullOrWhiteSpace(_editing.Name)) return;
        if (_editing.Id == Guid.Empty) _editing.Id = Guid.NewGuid();
        await RuleStore.SaveAsync(_editing);
        _editing = null;
        await LoadAsync();
    }

    private void CancelEdit() => _editing = null;

    private async Task DeleteAsync(Guid id)
    {
        await RuleStore.DeleteAsync(id);
        if (_editing?.Id == id) _editing = null;
        await LoadAsync();
    }
}
