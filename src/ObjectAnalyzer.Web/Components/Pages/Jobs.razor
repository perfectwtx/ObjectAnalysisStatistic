@page "/jobs"
@using ObjectAnalyzer.Platform
@inject IAnalysisHistoryStore HistoryStore

<PageTitle>分析作业中心</PageTitle>

<div class="oa-analysis-page oa-jobs-page">
    <div class="oa-analysis-header">
        <div>
            <div class="oa-eyebrow">ANALYSIS OPERATIONS</div>
            <h1>分析作业中心</h1>
            <p>查看历史分析作业及其质量结果。</p>
        </div>
        <button class="btn btn-outline-secondary" @onclick="LoadAsync"><span aria-hidden="true">↻</span> 刷新</button>
    </div>

    @if (_loading)
    {
        <div class="oa-empty-state oa-panel">
            <div class="oa-empty-icon">…</div>
            <strong>正在加载分析作业</strong>
            <span>正在读取最近 100 次分析记录。</span>
        </div>
    }
    else if (_jobs.Count == 0)
    {
        <div class="oa-empty-state oa-panel">
            <div class="oa-empty-icon">◌</div>
            <h2>暂无历史作业</h2>
            <p>完成一次分析后，作业记录和质量结果会显示在这里。</p>
        </div>
    }
    else
    {
        <div class="oa-summary-grid mb-4">
            <div class="oa-summary-card">
                <span>历史作业</span>
                <strong>@_jobs.Count</strong>
                <small>最近 100 次记录</small>
            </div>
            <div class="oa-summary-card">
                <span>已完成</span>
                <strong>@_jobs.Count(x => x.Status == AnalysisJobStatus.Succeeded)</strong>
                <small>成功分析作业</small>
            </div>
            <div class="oa-summary-card">
                <span>质量问题</span>
                <strong>@_jobs.Sum(x => x.IssueCount)</strong>
                <small>累计标准化问题</small>
            </div>
            <div class="oa-summary-card">
                <span>最近质量分</span>
                <strong>@(_jobs.FirstOrDefault()?.QualityScore?.ToString("F1") ?? "-")</strong>
                <small>最新一条分析结果</small>
            </div>
        </div>

        <section class="oa-panel">
            <div class="oa-panel-header">
                <div>
                    <div class="oa-panel-kicker">RECENT RUNS</div>
                    <h2>最近分析</h2>
                </div>
                <span class="oa-count-badge">@_jobs.Count 条</span>
            </div>
            <div class="oa-table-wrap">
                <table class="table table-hover align-middle mb-0 oa-analysis-table oa-jobs-table">
                    <thead>
                        <tr>
                            <th>时间</th><th>数据源</th><th>状态</th><th>对象数</th><th>字段数</th><th>质量分</th><th>问题数</th><th>耗时</th><th>操作</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var job in _jobs)
                    {
                        <tr>
                            <td><span class="oa-date">@job.StartedAtUtc.ToLocalTime().ToString("yyyy-MM-dd")</span><small>@job.StartedAtUtc.ToLocalTime().ToString("HH:mm:ss")</small></td>
                            <td><strong>@job.SourceName</strong><small>@job.SourceType</small></td>
                            <td><span class="oa-status-badge oa-status-@job.Status.ToString().ToLowerInvariant()">@job.Status</span></td>
                            <td>@job.TotalObjects.ToString("N0")</td>
                            <td>@job.FieldCount.ToString("N0")</td>
                            <td><strong class="oa-score">@(job.QualityScore?.ToString("F2") ?? "-")</strong></td>
                            <td><span class="oa-issue-count">@job.IssueCount</span></td>
                            <td>@(job.DurationMs > 0 ? $"{job.DurationMs:N0} ms" : "-")</td>
                            <td><a class="btn btn-sm btn-outline-secondary" href="/jobs/@job.Id">查看详情</a></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>
    }
</div>

@code {
    private readonly List<AnalysisJob> _jobs = new();
    private bool _loading;

    protected override async Task OnInitializedAsync()
    {
        await HistoryStore.InitializeAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _jobs.Clear();
            _jobs.AddRange(await HistoryStore.GetRecentAsync(100));
        }
        finally
        {
            _loading = false;
        }
    }
}
