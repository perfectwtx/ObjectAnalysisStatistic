    private static void DeleteQuietly(string? path)
    {
        if (path == null) return;
        try { File.Delete(path); } catch { }
    }

    private static List<string>? SplitFields(string? fields)
    {
        if (string.IsNullOrWhiteSpace(fields))
            return null;
        return fields.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private static string FormatPercent(double coverage)
    {
        return $"{coverage * 100:F1}%";
    }

    private static string TruncatePlain(string s, int maxLen)
    {
        if (string.IsNullOrEmpty(s)) return "";
        return s.Length <= maxLen ? s : s.Substring(0, maxLen - 1) + "…";
    }

    // ── P3：DateTime / Outlier / Schema Diff 辅助 ──

    /// <summary>根据时间跨度的紧凑展示（自动切档：时分秒 / MM-dd / yyyy-MM-dd / yyyy-MM / yyyy）。</summary>
    internal static string FormatDate(DateTimeOffset? value)
    {
        if (!value.HasValue) return "—";
        var d = value.Value;
        var span = d - DateTimeOffset.UtcNow;
        // 接近当前时间的相对格式；否则按紧凑绝对格式
        if (Math.Abs(span.TotalDays) < 1)
        {
            return d.ToString("HH:mm:ss");
        }
        if (Math.Abs(span.TotalDays) < 365)
        {
            return d.ToString("MM-dd HH:mm");
        }
        return d.ToString("yyyy-MM-dd");
    }

    /// <summary>格式化为人类可读的跨度字符串（如 "3 天 4 小时"、"2 个月 15 天"）。</summary>
    internal static string FormatDateTimeSpan(DateTimeOffset? min, DateTimeOffset? max)
    {
        if (!min.HasValue || !max.HasValue) return "—";
        var span = max.Value - min.Value;
        if (span.TotalSeconds < 0) return "—";
        if (span.TotalDays >= 365) return $"{(int)(span.TotalDays / 365)} 年 {(int)((span.TotalDays % 365) / 30)} 天";
        if (span.TotalDays >= 30) return $"{(int)(span.TotalDays / 30)} 个月 {(int)(span.TotalDays % 30)} 天";
        if (span.TotalDays >= 1) return $"{(int)span.TotalDays} 天 {(int)span.TotalHours % 24} 小时";
        if (span.TotalHours >= 1) return $"{(int)span.TotalHours} 小时 {(int)span.TotalMinutes % 60} 分";
        if (span.TotalMinutes >= 1) return $"{(int)span.TotalMinutes} 分 {(int)span.TotalSeconds % 60} 秒";
        return $"{(int)span.TotalSeconds} 秒";
    }

    /// <summary>将一组数值渲染为内联 SVG sparkline（柱状图），用于紧凑展示时间分布。无值时返回空。</summary>
    internal static string RenderSparkline(double[] values, int width = 80, int height = 18)
    {
        if (values == null || values.Length == 0) return "";
        double max = values.Max();
        if (max <= 0) return "";
        int n = values.Length;
        double barW = Math.Max(1.0, (width - (n - 1) * 1.0) / n);
        var sb = new System.Text.StringBuilder();
        sb.Append($"<svg width=\"{width}\" height=\"{height}\" viewBox=\"0 0 {width} {height}\" xmlns=\"http://www.w3.org/2000/svg\" preserveAspectRatio=\"none\">");
        for (int i = 0; i < n; i++)
        {
            double v = values[i];
            if (v <= 0) continue; // 跳过空桶
            double h = Math.Max(1.0, (v / max) * height);
            double x = i * (barW + 1.0);
            double y = height - h;
            sb.Append($"<rect x=\"{x:F1}\" y=\"{y:F1}\" width=\"{barW:F1}\" height=\"{h:F1}\" fill=\"currentColor\" opacity=\"0.75\"/>");
        }
        sb.Append("</svg>");
        return sb.ToString();
    }

    /// <summary>上传 Schema 快照基线 → 校验 → 计算 diff（不重新跑分析）。</summary>
    private async Task HandleBaselineUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        CancelActiveAnalysis();
        DeleteQuietly(State.BaselineSnapshotPath);
        var tempPath = Path.Combine(Path.GetTempPath(), $"{Guid.NewGuid()}.json");
        await using (var fs = File.Create(tempPath))
        {
            await file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).CopyToAsync(fs);
        }

        State.BaselineSnapshotPath = tempPath;
        State.BaselineSnapshotName = file.Name;
        State.BaselineError = null;
        State.ComputedSchemaDiff = null;

        if (State.Result == null)
        {
            // 基线先于分析上传：暂存，等分析完成后再计算 diff
            return;
        }

        await ComputeBaselineDiffAsync(tempPath);
    }

    private async Task ComputeBaselineDiffAsync(string baselinePath)
    {
        try
        {
            var json = await File.ReadAllTextAsync(baselinePath);
            var loadOptions = new System.Text.Json.JsonSerializerOptions
            {
                PropertyNameCaseInsensitive = true
            };
            var baseline = System.Text.Json.JsonSerializer.Deserialize<Core.Analysis.SchemaSnapshot>(json, loadOptions);
            if (baseline == null || string.IsNullOrEmpty(baseline.SnapshotVersion))
            {
                State.BaselineError = Loc["ErrInvalidBaseline"];
                State.ComputedSchemaDiff = null;
                return;
            }
            var current = Core.Analysis.SchemaSnapshotExporter.Build(State.Result!, State.FileName);
            State.ComputedSchemaDiff = Core.Analysis.SchemaDiffer.Compute(baseline, current);
            State.BaselineError = null;
        }
        catch (Exception ex)
        {
            State.BaselineError = ErrorSanitizer.Format(ex);
            State.ComputedSchemaDiff = null;
        }
    }

    private void ClearBaseline()
    {
        CancelActiveAnalysis();
        DeleteQuietly(State.BaselineSnapshotPath);
        State.BaselineSnapshotPath = null;
        State.BaselineSnapshotName = null;
        State.ComputedSchemaDiff = null;
        State.BaselineError = null;
    }

    /// <summary>将当前分析结果导出为 canonical Schema 快照 JSON 文件（下载到浏览器）。</summary>
    private async Task DownloadCurrentSnapshot()
    {
        if (State.Result == null) return;
        var snapshot = Core.Analysis.SchemaSnapshotExporter.Build(State.Result, State.FileName);
        var options = new System.Text.Json.JsonSerializerOptions
        {
            WriteIndented = true,
            Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping,
            DefaultIgnoreCondition = System.Text.Json.Serialization.JsonIgnoreCondition.WhenWritingNull
        };
        var json = System.Text.Json.JsonSerializer.Serialize(snapshot, options);
        var stamp = DateTime.Now.ToString("yyyyMMdd-HHmmss");
        await Js.InvokeVoidAsync("objectAnalyzer.downloadTextFile",
            $"schema-snapshot-{stamp}.json", json, "application/json;charset=utf-8");
    }
