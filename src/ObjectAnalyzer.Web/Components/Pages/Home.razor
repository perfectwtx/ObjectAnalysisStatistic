    private const int PreviewRowCount = 8;
    private const int PreviewColumnCount = 8;
    private static readonly System.Text.Json.JsonSerializerOptions PreviewJsonOptions = new()
    {
        Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping
    };
    private Core.Analysis.AnalysisResult? _lastChartResult;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _darkTheme = await Js.InvokeAsync<bool>("objectAnalyzer.isDarkTheme");
            StateHasChanged();
        }

        // 结果对象变化时重绘图表（Blazor 重新渲染时避免重复实例化）
        if (State.Result != null && !ReferenceEquals(_lastChartResult, State.Result))
        {
            _lastChartResult = State.Result;
            await RenderCharts(State.Result);
        }
    }

    private async Task RenderCharts(Core.Analysis.AnalysisResult result)
    {
        var topFields = result.FieldStatistics
            .OrderByDescending(f => f.Count)
            .Take(15)
            .ToList();

        var fieldNames = topFields.Select(f => f.FieldName).ToArray();
        var coverages = topFields.Select(f => Math.Round(f.Coverage * 100, 1)).ToArray();
        await Js.InvokeVoidAsync("objectAnalyzer.renderCoverageChart", fieldNames, coverages);

        var typeTop = topFields.Take(10).ToList();
        var typeLabels = typeTop.Select(f => f.FieldName).ToArray();
        var allTypes = typeTop
            .SelectMany(f => f.TypeCounts.Keys)
            .Distinct()
            .ToList();
        var colors = new[]
        {
            "rgba(54,162,235,0.7)", "rgba(255,99,132,0.7)", "rgba(75,192,192,0.7)",
            "rgba(255,205,86,0.7)", "rgba(153,102,255,0.7)", "rgba(255,159,64,0.7)"
        };
        var datasets = allTypes
            .Select((t, i) => new
            {
                label = t,
                data = typeTop.Select(f => f.TypeCounts.GetValueOrDefault(t, 0)).ToArray(),
                backgroundColor = colors[i % colors.Length]
            })
            .ToArray();
        await Js.InvokeVoidAsync("objectAnalyzer.renderTypeChart", typeLabels, datasets);
    }

    private List<string> GetAllPreviewFields()
    {
        var result = new List<string>();
        var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        if (State.Preview != null)
        {
            foreach (var row in State.Preview)
            {
                foreach (var key in row.Keys)
                {
                    if (seen.Add(key)) result.Add(key);
                }
            }
        }
        return result;
    }

    private readonly HashSet<string> _selectedPreviewColumns = new(StringComparer.OrdinalIgnoreCase);

    private void SeedPreviewSelection()
    {
        _selectedPreviewColumns.Clear();
        foreach (var f in GetAllPreviewFields().Take(PreviewColumnCount))
        {
            _selectedPreviewColumns.Add(f);
        }
    }

    private bool IsPreviewColumnSelected(string field) => _selectedPreviewColumns.Contains(field);

    private void TogglePreviewColumn(string field)
    {
        if (!_selectedPreviewColumns.Add(field))
        {
            _selectedPreviewColumns.Remove(field);
        }
    }

    private void SelectAllPreviewColumns()
    {
        foreach (var f in GetAllPreviewFields())
        {
            _selectedPreviewColumns.Add(f);
        }
    }

    private void ClearPreviewColumns()
    {
        _selectedPreviewColumns.Clear();
    }

    internal static string FormatPreviewCell(Dictionary<string, object?> row, string field)
    {
        // 该字段在行中从未出现 → 显示空；字段出现但值为 null → 显示 "null"
        return row.TryGetValue(field, out var value) ? FormatPreviewValue(value) : "";
    }

    internal static string FormatPreviewValue(object? value)
    {
        if (value == null) return "null";
        if (value is string s) return s.Length <= 80 ? s : s[..77] + "...";

        // 非标量（嵌套对象/数组/强类型集合）以原始值的 JSON 展示，而不是类型名
        if (!IsScalar(value))
        {
            try
            {
                string json = JsonSerializer.Serialize(value, PreviewJsonOptions);
                return json.Length <= 80 ? json : json[..77] + "...";
            }
            catch
            {
                // 个别自定义类型无法序列化时，退回类型名兜底
            }
        }

        return value.ToString() ?? "null";
    }

    private static bool IsScalar(object value)
    {
        Type type = value.GetType();
        return type.IsPrimitive
            || type.IsEnum
            || value is string or decimal or DateTime or DateTimeOffset or Guid or TimeSpan or char;
    }

    private async Task DownloadJsonReport() => await DownloadReport(".json", "application/json;charset=utf-8");

    private async Task DownloadHtmlReport() => await DownloadReport(".html", "text/html;charset=utf-8");

    private async Task DownloadMarkdownReport() => await DownloadReport(".md", "text/markdown;charset=utf-8");

    private async Task DownloadCsvReport() => await DownloadReport(".csv", "text/csv;charset=utf-8");

    private async Task DownloadReport(string ext, string mime)
    {
        if (State.Result == null) return;
        var temp = Path.Combine(Path.GetTempPath(), $"{Guid.NewGuid()}{ext}");
        try
        {
            await Task.Run(() => Core.Reporting.ReportExporter.Save(State.Result, temp));
            string content = await File.ReadAllTextAsync(temp);
            var fileName = $"analysis-{DateTime.Now:yyyyMMdd-HHmmss}{ext}";
            await Js.InvokeVoidAsync("objectAnalyzer.downloadTextFile", fileName, content, mime);
        }
        finally
        {
            DeleteQuietly(temp);
        }
    }

    private async Task DownloadSchema(string format)
    {
        if (State.Result == null) return;
        var stamp = DateTime.Now.ToString("yyyyMMdd-HHmmss");
        (string fileName, string content, string mime) = format switch
        {
            "csharp" => ($"schema-{stamp}.cs", Core.Reporting.SchemaExporter.GenerateCSharp(State.Result), "text/plain;charset=utf-8"),
            "typescript" => ($"schema-{stamp}.d.ts", Core.Reporting.SchemaExporter.GenerateTypeScript(State.Result), "text/plain;charset=utf-8"),
            "sql" => SchemaSqlDialect switch
            {
                "mysql" => ($"schema-{stamp}.mysql.sql", Core.Reporting.SchemaExporter.GenerateSql(State.Result, "mysql"), "application/sql;charset=utf-8"),
                "sqlite" => ($"schema-{stamp}.sqlite.sql", Core.Reporting.SchemaExporter.GenerateSql(State.Result, "sqlite"), "application/sql;charset=utf-8"),
                "sqlserver" => ($"schema-{stamp}.sqlserver.sql", Core.Reporting.SchemaExporter.GenerateSql(State.Result, "sqlserver"), "application/sql;charset=utf-8"),
                _ => ($"schema-{stamp}.postgres.sql", Core.Reporting.SchemaExporter.GenerateSql(State.Result, "postgres"), "application/sql;charset=utf-8")
            },
            _ => ($"schema-{stamp}.schema.json", Core.Reporting.SchemaExporter.GenerateJsonSchema(State.Result), "application/json;charset=utf-8")
        };
        await Js.InvokeVoidAsync("objectAnalyzer.downloadTextFile", fileName, content, mime);
    }

    private string SchemaSqlDialect { get; set; } = "postgres";

    private async Task DownloadViolations()
