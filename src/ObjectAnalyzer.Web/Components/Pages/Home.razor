    /// <summary>通用文件上传辅助：写到 %TEMP% 临时文件，捕获异常并清空旧文件。</summary>
    private async Task SaveUploadedFileAsync(
        Microsoft.AspNetCore.Components.Forms.IBrowserFile? file,
        string extension,
        Action<string, string> apply)
    {
        if (file == null) return;
        CancelActiveAnalysis();
        var tempPath = Path.Combine(Path.GetTempPath(), $"{Guid.NewGuid()}{extension}");
        try
        {
            await using (var fs = File.Create(tempPath))
            {
                await file.OpenReadStream(maxAllowedSize: 64 * 1024 * 1024).CopyToAsync(fs);
            }
            apply(tempPath, file.Name);
            State.ErrorMessage = null;
        }
        catch (Exception ex)
        {
            DeleteQuietly(tempPath);
            State.ErrorMessage = ErrorSanitizer.Format(ex);
        }
    }

