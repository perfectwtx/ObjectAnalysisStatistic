@page "/"
@using Core = global::ObjectAnalyzer
@using global::ObjectAnalyzer.Analysis
@using Microsoft.AspNetCore.Components.Forms
@using System.Net
@using System.Text.Json
@inject AnalysisState State
@inject IJSRuntime Js
@inject LocalizationService Loc
@inject WebAnalysisExecutionService AnalysisExecutionService
@implements IDisposable
@rendermode InteractiveServer

<PageTitle>ObjectAnalyzer - @Loc["PageTitleText"]</PageTitle>

@* ── 方案 B：规则文件预检模态框（开始分析前若规则字段与数据样本完全不匹配，提示用户） ── *@
@if (State.ShowPreflightModal)
{
    <div class="preflight-backdrop" role="dialog" aria-modal="true" aria-labelledby="preflight-title">
        <div class="preflight-modal">
            <h3 id="preflight-title">⚠ @Loc["PreflightTitle"]</h3>
            <p class="preflight-explain">@Loc["PreflightExplain"]</p>
            <div class="preflight-fields">
                <div class="preflight-col">
                    <div class="preflight-col-title">@Loc["PreflightRuleFields"]</div>
                    @if (State.PreflightRuleFields.Count == 0)
                    {
                        <span class="preflight-empty">—</span>
                    }
                    else
                    {
                        <ul class="preflight-chips">
                            @foreach (var f in State.PreflightRuleFields)
                            {
                                <li class="preflight-chip rule-chip"><code>@f</code></li>
                            }
                        </ul>
                    }
                </div>
                <div class="preflight-col">
                    <div class="preflight-col-title">@Loc["PreflightSampleFields"]</div>
                    @if (State.PreflightSampleFields.Count == 0)
                    {
                        <span class="preflight-empty">—</span>
                    }
                    else
                    {
                        <ul class="preflight-chips">
                            @foreach (var f in State.PreflightSampleFields)
                            {
                                <li class="preflight-chip sample-chip"><code>@f</code></li>
                            }
                        </ul>
                        @if (State.PreflightSampleFields.Count >= Core.Analysis.PreflightChecker.MaxDisplayedSampleFields)
                        {
                            <p class="preflight-hint">@Loc["PreflightSampleFieldsTruncated"]</p>
                        }
                    }
                </div>
            </div>
            <div class="preflight-actions">
                <button class="btn btn-primary" @onclick="ConfirmPreflight">@Loc["PreflightContinue"]</button>
                <button class="btn btn-outline" @onclick="CancelPreflight">@Loc["PreflightCancel"]</button>
            </div>
        </div>
    </div>
}

<div class="app-shell">
    <aside class="sidebar">
    <div class="side-brand">
            <span class="brand-icon" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 3v18h18" />
                    <rect x="7" y="12" width="3" height="6" rx="0.8" fill="currentColor" stroke="none" />
                    <rect x="12" y="8" width="3" height="10" rx="0.8" fill="currentColor" stroke="none" />
                    <rect x="17" y="4" width="3" height="14" rx="0.8" fill="currentColor" stroke="none" />
                </svg>
            </span>
            <div>
                <h1>ObjectAnalyzer</h1>
                <p class="brand-sub">@Loc["AppBrandSub"]</p>
            </div>
        </div>
        <div class="side-scroll">
            <div class="side-group">
                <div class="side-group-title">@Loc["SideSourceTitle"]</div>

            <div class="config-fields" style="pointer-events:@(State.IsLoading ? "none" : "auto");opacity:@(State.IsLoading ? 0.6 : 1)">
            <div class="upload-area">
                <InputFile OnChange="HandleFileUpload" accept=".json,.jsonl,.csv,.xlsx,.xml,.yaml,.yml" />
                <p>@Loc["UploadHint"]<br/>
                   <small>@Loc["UploadSupported"]</small>
                </p>
                @if (State.HasData)
                {
                    <div class="uploaded-file">
                        <span class="file-ok">@Loc.Get("FileSelected", State.FileName)</span>
                        <button class="clear-btn" @onclick="ClearDataFile" title="@Loc["ClearFile"]">✕</button>
                    </div>
                }
            </div>
            </div>
            </div>

            <div class="side-group side-group-run">
                <div class="config-actions">
                    <button class="btn btn-primary btn-lg" @onclick="RunAnalysis"
                            disabled="@State.IsLoading">
                        @(State.IsLoading ? Loc["Analyzing"] : Loc["StartAnalysis"])
                    </button>
                    @if (State.IsLoading)
                    {
                        <button class="btn btn-outline" @onclick="CancelAnalysis">@Loc["Cancel"]</button>
                    }
                </div>
                @if (State.IsLoading && !string.IsNullOrEmpty(State.ProgressText))
                {
                    <div class="progress-status" aria-live="polite">
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        <span>@State.ProgressText</span>
                    </div>
                }
            </div>

            <div class="side-group">
                <div class="side-group-title">@Loc["SideOptionsTitle"]</div>
            <div class="config-fields" style="pointer-events:@(State.IsLoading ? "none" : "auto");opacity:@(State.IsLoading ? 0.6 : 1)">
            <div class="options-grid">
                <div class="side-subgroup-title">@Loc["GroupParsing"]</div>
                <label class="option-item checkbox-item">
                    <input type="checkbox" checked="@State.Flatten" @onchange="OnFlattenChange" />
                    <span>@Loc["OptFlatten"]</span>
                </label>
                <label class="option-item checkbox-item">
                    <input type="checkbox" checked="@State.CsvInferNumbers" @onchange="OnCsvInferNumbersChange" title="@Loc["OptCsvInferNumbersTitle"]" />
                    <span>@Loc["OptCsvInferNumbers"]</span>
                </label>
                <label class="option-item">
                    <span>@Loc["OptMaxValues"]</span>
                    <input type="number" value="@State.MaxValuesToShow" @oninput="OnMaxValuesChange" min="1" max="100" />
                </label>
                <label class="option-item">
                    <span>@Loc["OptParallel"]</span>
                    <input type="number" value="@State.MaxDegreeOfParallelism" @oninput="OnParallelChange" min="-1" max="64" placeholder="-1" title="@Loc["OptParallelTitle"]" />
                </label>
                <div class="side-subgroup-title">@Loc["GroupDeepAnalysis"]</div>
                <label class="option-item checkbox-item">
                    <input type="checkbox" checked="@State.EnableCorrelation" @onchange="OnEnableCorrelationChange" title="@Loc["OptEnableCorrelationTitle"]" />
                    <span>@Loc["OptEnableCorrelation"]</span>
                </label>
                <label class="option-item checkbox-item">
                    <input type="checkbox" checked="@State.EnableStringPatterns" @onchange="OnEnableStringPatternsChange" title="@Loc["OptEnableStringPatternsTitle"]" />
                    <span>@Loc["OptEnableStringPatterns"]</span>
                </label>
                <label class="option-item checkbox-item">
                    <input type="checkbox" checked="@State.EnableUnicodeHygiene" @onchange="OnEnableUnicodeHygieneChange" title="@Loc["OptEnableUnicodeHygieneTitle"]" />
                    <span>@Loc["OptEnableUnicodeHygiene"]</span>
                </label>
                <label class="option-item checkbox-item">
                    <input type="checkbox" checked="@State.EnableTimeSeries" @onchange="OnEnableTimeSeriesChange" title="@Loc["OptEnableTimeSeriesTitle"]" />
                    <span>@Loc["OptEnableTimeSeries"]</span>
                </label>
                <label class="option-item checkbox-item">
                    <input type="checkbox" checked="@State.EnableDistributionSnapshot" @onchange="OnEnableDistributionSnapshotChange" title="@Loc["OptEnableDistributionSnapshotTitle"]" />
                    <span>@Loc["OptEnableDistributionSnapshot"]</span>
                </label>
                <label class="option-item">
                    <span>@Loc["OptFuzzyDedupField"]</span>
                    <input type="text" value="@State.FuzzyDedupField" @oninput="OnFuzzyDedupFieldChange" placeholder="name" title="@Loc["OptFuzzyDedupFieldTitle"]" />
                </label>
                <label class="option-item">
                    <span>@Loc["OptCorrelationReservoir"]</span>
                    <input type="number" value="@State.CorrelationReservoir" @oninput="OnCorrelationReservoirChange" min="100" max="1000000" title="@Loc["OptCorrelationReservoirTitle"]" />
                </label>
                <div class="side-subgroup-title">@Loc["GroupFieldsFilter"]</div>
                <label class="option-item">
                    <span>@Loc["OptFields"]</span>
                    <input type="text" value="@State.Fields" @oninput="OnFieldsChange" placeholder="@Loc["OptFieldsPlaceholder"]" />
                </label>
                <label class="option-item">
                    <span>@Loc["OptWhere"]</span>
                    <input type="text" value="@State.Filter" @oninput="OnFilterChange" placeholder="@Loc["OptWherePlaceholder"]" />
                </label>
                <label class="option-item">
                    <span>@Loc["OptRootPath"]</span>
                    <input type="text" value="@State.RootPath" @oninput="OnRootPathChange" placeholder="@Loc["OptRootPathPlaceholder"]" />
                </label>
                <label class="option-item">
                    <span>@Loc["OptRecordPath"]</span>
                    <input type="text" value="@State.RecordPath" @oninput="OnRecordPathChange" placeholder="@Loc["OptRecordPathPlaceholder"]" />
                </label>
                <div class="side-subgroup-title">@Loc["GroupSampling"]</div>
                <label class="option-item">
                    <span>@Loc["OptSampleReservoir"]</span>
                    <input type="number" value="@State.SampleReservoir" @oninput="OnSampleReservoirChange" min="0" placeholder="0" title="@Loc["OptSampleTitle"]" />
                </label>
                <label class="option-item">
                    <span>@Loc["OptSampleStep"]</span>
                    <input type="number" value="@State.SampleStep" @oninput="OnSampleStepChange" min="0" placeholder="0" title="@Loc["OptSampleTitle"]" />
                </label>
                <details class="option-advanced">
                    <summary>@Loc["GroupSamplingAdvanced"]</summary>
                    <label class="option-item">
                        <span>@Loc["OptLowConfidenceWidth"]</span>
                        <input type="number" step="0.05" value="@State.LowConfidenceWidth" @oninput="OnLowConfidenceWidthChange" min="0" max="1" title="@Loc["OptLowConfidenceWidthTitle"]" />
                    </label>
                    <label class="option-item">
                        <span>@Loc["OptMemoryFallbackSampleSize"]</span>
                        <input type="number" value="@State.MemoryFallbackSampleSize" @oninput="OnMemoryFallbackSampleSizeChange" min="100" title="@Loc["OptMemoryFallbackSampleSizeTitle"]" />
                    </label>
                </details>
                <div class="side-subgroup-title">@Loc["GroupAudit"]</div>
                <label class="option-item">
                    <span>@Loc["OptAuditLog"]</span>
                    <input type="text" value="@State.AuditLogPath" @oninput="OnAuditLogPathChange" placeholder="@Loc["OptAuditLogPlaceholder"]" />
                </label>
                <label class="option-item">
                    <span>@Loc["OptOperator"]</span>
                    <input type="text" value="@State.Operator" @oninput="OnOperatorChange" placeholder="@Loc["OptOperatorPlaceholder"]" />
                </label>
            </div>
            </div>

            <div class="side-group">
                <div class="side-group-title">@Loc["SideRulesTitle"]</div>
                <div class="option-item">
                    <span>@Loc["OptRulesFile"]</span>
                    <div class="file-field">
                        <InputFile OnChange="HandleRulesFileUpload" accept=".json" />
                        @if (State.RulesFileName != null)
                        {
                            <span class="file-ok">✓ @State.RulesFileName</span>
                            <button class="clear-btn" @onclick="ClearRulesFile" title="@Loc["ClearRulesFile"]">✕</button>
                        }
                    </div>
                </div>
                <RuleEditor OnApply="ApplyEditorRules" />
                <label class="option-item">
                    <span>@Loc["RulesPasteTitle"]</span>
                    <textarea class="rules-textarea" rows="9" value="@_rulesText" @oninput="OnRulesTextChange" placeholder='{"fields": { "age": { "primaryType": "Number", "minValue": 0 } }}' spellcheck="false"></textarea>
                </label>
                @if (_rulesPasteStatus != null)
                {
                    <div class="ed-status @(_rulesPasteOk ? "ed-ok" : "ed-error")">@_rulesPasteStatus</div>
                }
                <div class="side-row">
                    <button class="btn btn-primary btn-sm" @onclick="ApplyRulesText">@Loc["RulesApply"]</button>
                    <button class="btn btn-outline btn-sm" @onclick="ClearRulesText">@Loc["ClearRulesFile"]</button>
                    @if (State.RulesFilePath != null)
                    {
                        <span class="file-ok">✓ @Loc["RulesApplied"]</span>
                    }
                </div>
                <label class="option-item checkbox-item">
                    <input type="checkbox" checked="@State.AllowUnknownRules" @onchange="OnAllowUnknownRulesChange" title="@Loc["OptAllowUnknownRulesTitle"]" />
                    <span>@Loc["OptAllowUnknownRules"]</span>
                </label>
                <details class="option-group">
                    <summary>
                        <span class="opt-group-title">@Loc["RulesDocTitle"]</span>
                    </summary>
                    <div class="rules-doc">
                        <p class="rules-doc-hint">规则文件就是告诉分析器「每个字段应该长什么样」。分析时会逐条核对，不符合的记为违规；配合命令行的 --fail-on-violations 可以在 CI 里直接阻断。</p>
                        <p class="rules-doc-strong">最小示例（可直接粘贴到上面的输入框试一下）：</p>
                        <pre>@((MarkupString)RulesExampleJson)</pre>
                        <p class="rules-doc-strong">常用规则（写在 fields 的字段名下面）：</p>
                        <ul>
                            <li><code>primaryType</code><span>这个字段应该是什么类型：String 文本、Number 数字、Boolean 是/否、DateTime 日期时间。对不上时报告会提示。</span></li>
                            <li><code>enumValues</code><span>只允许出现的几个值。比如性别填 ["Male", "Female"]，出现列表之外的值就记一次违规。</span></li>
                            <li><code>defaultValue</code><span>某条记录缺这个字段时，按这个值补齐。</span></li>
                            <li><code>required</code><span>打开后每条记录都必须有这个字段，缺了记违规。</span></li>
                            <li><code>pattern</code><span>正则表达式，字段值必须匹配。比如手机号填 "^1[3-9]\d{9}$"。</span></li>
                            <li><code>minValue</code> / <code>maxValue</code><span>数字字段的下限和上限，超出范围记违规。</span></li>
                            <li><code>unique</code><span>打开后整个字段的值不允许重复（适合订单号、编号）。</span></li>
                            <li><code>nullRateMax</code><span>空值最多允许占多少比例，0.2 表示最多 20% 可以为空。</span></li>
                            <li><code>maxOutlierRatio</code><span>离群值（异常大/小的数字）最多占多少比例，0.05 表示最多 5%。</span></li>
                        </ul>
                        <p class="rules-doc-strong">进阶用法：</p>
                        <ul>
                            <li><code>redact</code><span>设为 false：这个字段只是长得像敏感信息，不要自动打码。</span></li>
                            <li><code>pii</code><span>把业务字段标记为敏感信息，并指定打码格式。</span></li>
                            <li><code>transform</code><span>统计前先做转换：jwt / aes / base64 / url / sm4 / sm2；加 parse: "json" 可以把转换结果再展开成新字段。</span></li>
                            <li><code>runtime.selectedFields</code> / <code>runtime.filter</code><span>只统计选定的字段 / 只统计满足条件的记录（写在 runtime 节点，等价于 --fields 和 --where）。</span></li>
                            <li><code>expectations</code><span>对整个文件提要求：minRowCount 最少行数、maxDuplicateRate 重复率上限。</span></li>
                            <li><code>runtime.flatten</code> / <code>valueParsers</code><span>是否展开嵌套字段 / 把指定 Excel 列按 JSON 解析（Excel 多列 JSON 场景）。</span></li>
                            <li><code>runtime.deepAnalysis</code><span>深度分析开关：correlation 相关性、stringPatterns 模式归纳、timeSeries 时间序列等（默认全关）。</span></li>
                        </ul>
                    </div>
                </details>
            </div>

            @* P6 配置区：进度条、增量分析 / 断点续跑 / 基线合并、内存预算 *@
            <details class="option-group p6-config-group" open="@P6ConfigOpen">
                <summary @onclick="ToggleP6Config" @onclick:preventDefault="false">
                    <span class="opt-group-title">@Loc["P6GroupTitle"]</span>
                    <span class="opt-group-hint">@Loc["P6GroupHint"]</span>
                </summary>
                <div class="options-grid">
                    <label class="option-item checkbox-item">
                        <input type="checkbox" checked="@State.ShowProgress" @onchange="OnShowProgressChange" />
                        <span>@Loc["OptShowProgress"]</span>
                    </label>
                    <label class="option-item">
                        <span>@Loc["OptMaxMemory"]</span>
                        <input type="number" value="@State.MaxMemoryMB" @oninput="OnMaxMemoryChange" min="0" placeholder="0" title="@Loc["OptMaxMemoryTitle"]" />
                    </label>
                    <label class="option-item">
                        <span>@Loc["OptMaxMemoryMode"]</span>
                        <select @bind="State.MaxMemoryMode" title="@Loc["OptMaxMemoryModeTitle"]">
                            <option value="soft">@Loc["OptMaxMemoryModeSoft"]</option>
                            <option value="hard">@Loc["OptMaxMemoryModeHard"]</option>
                        </select>
                    </label>
                    <div class="option-item file-option">
                        <span>@Loc["OptResume"]</span>
                        <div class="file-field">
                            <InputFile OnChange="HandleResumeFileUpload" accept=".snapshot,.json" />
                            @if (State.ResumeFileName != null)
                            {
                                <span class="file-ok">✓ @State.ResumeFileName</span>
                                <button class="clear-btn" @onclick="ClearResumeFile" title="@Loc["ClearResumeFile"]">✕</button>
                            }
                        </div>
                    </div>
                    <div class="option-item file-option">
                        <span>@Loc["OptBaseline"]</span>
                        <div class="file-field">
                            <InputFile OnChange="HandleBaselineAnalysisFileUpload" accept=".json" />
                            @if (State.BaselineFileName != null)
                            {
                                <span class="file-ok">✓ @State.BaselineFileName</span>
                                <button class="clear-btn" @onclick="ClearBaselineAnalysisFile" title="@Loc["ClearBaselineFile"]">✕</button>
                            }
                        </div>
                    </div>
                    <div class="option-item file-option">
                        <span>@Loc["OptCheckpoint"]</span>
                        <div class="file-field">
                            <InputFile OnChange="HandleCheckpointFileUpload" accept=".snapshot" />
                            @if (State.CheckpointFileName != null)
                            {
                                <span class="file-ok">✓ @State.CheckpointFileName</span>
                                <button class="clear-btn" @onclick="ClearCheckpointFile" title="@Loc["ClearCheckpointFile"]">✕</button>
                            }
                        </div>
                    </div>
                </div>
            </details>

            @* P6.3 内存预算告警（soft 模式警告 + hard 模式错误均会写入 MemoryWarning）*@
            @if (!string.IsNullOrEmpty(State.MemoryWarning))
            {
                <div class="memory-warning">⚠ @State.MemoryWarning</div>
            }

            @if (State.ErrorMessage != null)
            {
                <div class="error">@State.ErrorMessage</div>
            }

            @* P6.2 检查点下载：分析成功且生成了检查点时显示 *@
            @if (State.LastCheckpointServerPath != null)
            {
                <div class="checkpoint-info">
                    <span>✓ @Loc.Get("CheckpointReady", Path.GetFileName(State.LastCheckpointServerPath), State.LastCheckpointSize)</span>
                    <a class="btn btn-sm btn-outline" href="/api/checkpoint/@Uri.EscapeDataString(State.LastCheckpointServerPath!)" download>
                        @Loc["DownloadCheckpoint"]
                    </a>
                </div>
            }
            </div>
    </div>
    </aside>

    <div class="side-handle" role="separator" aria-orientation="vertical" title="拖动调整宽度"></div>

    <main class="main-area">
        <div class="topbar">
            @if (State.Result != null)
            {
                <span class="file-chip" title="@State.FileName">📄 @State.FileName</span>
            }
            <div class="header-actions">
                <button class="theme-toggle"
                        title="@(_darkTheme ? Loc["ThemeLightTitle"] : Loc["ThemeDarkTitle"])"
                        aria-label="@(_darkTheme ? Loc["ThemeLightTitle"] : Loc["ThemeDarkTitle"])"
                        @onclick="ToggleTheme">
                    @if (_darkTheme)
                    {
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="12" cy="12" r="4" />
                            <path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.4-11.4 1.4-1.4" />
                        </svg>
                    }
                    else
                    {
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
                        </svg>
                    }
                </button>
                <div class="lang-switcher" role="group" aria-label="Language">
                    <button class="lang-btn @(Loc.CurrentLanguage == "zh-CN" ? "active" : "")"
                            @onclick='() => SetLanguage("zh-CN")'>中文</button>
                    <button class="lang-btn @(Loc.CurrentLanguage == "en" ? "active" : "")"
                            @onclick='() => SetLanguage("en")'>EN</button>
                </div>
            </div>
        </div>

        @if (State.Result == null && !State.IsLoading)
        {
            <div class="empty-state">
                <span class="empty-icon" aria-hidden="true">📊</span>
                <h2>@Loc["EmptyStateTitle"]</h2>
                <p>@Loc["EmptyStateHint"]</p>
            </div>
        }

        @* 结果区域 *@
    @if (State.Result != null)
    {
        <div class="results-section" data-tab="@_activeTab">
            @* ── 方案 D：结果页兜底警告（分析完成后再次校验规则字段是否出现） ── *@
            @if (!string.IsNullOrEmpty(State.ResultWarning))
            {
                <div class="result-warning" role="alert">
                    <div class="result-warning-title">⚠ @Loc["ResultWarningTitle"]</div>
                    <div class="result-warning-text">@State.ResultWarning</div>
                </div>
            }
            @* 结果标题栏 *@
            <div class="results-header">
                <h2>@Loc["ResultsTitle"] <span class="result-file">@State.FileName</span></h2>
                <div class="header-actions">
                    <div class="download-group">
                        <span class="download-label">@Loc["ReportDownload"]</span>
                        <button class="btn btn-outline btn-sm" @onclick="DownloadJsonReport">JSON</button>
                        <button class="btn btn-outline btn-sm" @onclick="DownloadHtmlReport">HTML</button>
                        <button class="btn btn-outline btn-sm" @onclick="DownloadMarkdownReport">MD</button>
                        <button class="btn btn-outline btn-sm" @onclick="DownloadCsvReport">CSV</button>
                        <button class="btn btn-outline btn-sm" @onclick="DownloadExcelReport">Excel</button>
                        <button class="btn btn-outline btn-sm" @onclick="DownloadPdfReport">PDF</button>
                        @if (State.Result.FieldStatistics.Any(f => f.EnumViolations.Count > 0))
                        {
                            <button class="btn btn-outline btn-sm" @onclick="DownloadViolations">@Loc["ViolationsDownload"]</button>
                        }
                    </div>
                    <div class="download-group">
                        <span class="download-label">@Loc["SchemaDownload"]</span>
                        <button class="btn btn-outline btn-sm" @onclick='() => DownloadSchema("csharp")'>C#</button>
                        <button class="btn btn-outline btn-sm" @onclick='() => DownloadSchema("typescript")'>TS</button>
                        <button class="btn btn-outline btn-sm" @onclick='() => DownloadSchema("json-schema")'>JSON Schema</button>
                        <button class="btn btn-outline btn-sm" @onclick='() => DownloadSchema("openapi")'>OpenAPI (YAML)</button>
                        <button class="btn btn-outline btn-sm" @onclick='() => DownloadSchema("openapi-json")'>OpenAPI (JSON)</button>
                        <button class="btn btn-outline btn-sm" @onclick='() => DownloadSchema("protobuf")'>Protobuf</button>
                        <select class="select-sm" @bind="SchemaSqlDialect" aria-label="SQL dialect">
                            <option value="postgres">PostgreSQL</option>
                            <option value="mysql">MySQL</option>
                            <option value="sqlite">SQLite</option>
                            <option value="sqlserver">SQL Server</option>
                        </select>
                        <button class="btn btn-outline btn-sm" @onclick='() => DownloadSchema("sql")'>SQL</button>
                    </div>
                </div>
            </div>

            @* 摘要卡片 *@
            <div class="summary-cards">
                <div class="card blue">
                    <div class="card-value">@State.Result.TotalObjects</div>
                    <div class="card-label">@Loc["TotalObjects"]</div>
                </div>
                <div class="card green">
                    <div class="card-value">@State.Result.TotalUniqueObjects</div>
                    <div class="card-label">@Loc["UniqueObjects"]</div>
                </div>
                <div class="card orange">
                    <div class="card-value">@State.Result.TotalDuplicateGroups</div>
                    <div class="card-label">@Loc["DuplicateGroups"]</div>
                </div>
                <div class="card purple">
                    <div class="card-value">@State.Result.FieldStatistics.Count</div>
                    <div class="card-label">@Loc["FieldCount"]</div>
                </div>
            </div>

            @* 图表区域 *@
            <div class="charts-section">
                <div class="chart-box">
                    <h3>@Loc["FieldCoverageChart"]</h3>
                    <canvas id="coverageChart"></canvas>
                </div>
                <div class="chart-box">
                    <h3>@Loc["FieldTypeChart"]</h3>
                    <canvas id="typeChart"></canvas>
                </div>
            </div>

            @* 明细选项卡 *@
            <div class="detail-tabs" role="tablist">
                <button class="detail-tab @(_activeTab == "fields" ? "active" : "")" role="tab" aria-selected="@(_activeTab == "fields")" @onclick='() => SetTab("fields")'>@Loc["TabFields"]</button>
                <button class="detail-tab @(_activeTab == "deep" ? "active" : "")" role="tab" aria-selected="@(_activeTab == "deep")" @onclick='() => SetTab("deep")'>@Loc["TabDeep"]</button>
                <button class="detail-tab @(_activeTab == "dups" ? "active" : "")" role="tab" aria-selected="@(_activeTab == "dups")" @onclick='() => SetTab("dups")'>@Loc["TabDuplicates"]</button>
                <button class="detail-tab @(_activeTab == "preview" ? "active" : "")" role="tab" aria-selected="@(_activeTab == "preview")" @onclick='() => SetTab("preview")'>@Loc["TabPreview"]</button>
            </div>

            @* 数据预览 *@
            @if (State.Preview is { Count: > 0 })
            {
                var allFields = GetAllPreviewFields();
                var selectedFields = allFields.Where(IsPreviewColumnSelected).ToList();
                var previewRows = State.Preview.Take(PreviewRowCount);
                <div class="preview-section">
                    <h3>@Loc["DataPreview"] <span class="preview-note">@Loc.Get("PreviewNote", PreviewRowCount, selectedFields.Count)</span></h3>
                    <div class="preview-col-select">
                        <span class="preview-col-label">@Loc["PreviewColumns"]</span>
                        <button class="minibtn" @onclick="SelectAllPreviewColumns">@Loc["SelectAll"]</button>
                        <button class="minibtn" @onclick="ClearPreviewColumns">@Loc["ClearAll"]</button>
                        @foreach (var f in allFields)
                        {
                            <label class="preview-col-toggle @(IsPreviewColumnSelected(f) ? "selected" : "")">
                                <input type="checkbox" checked="@IsPreviewColumnSelected(f)" @onchange="() => TogglePreviewColumn(f)" />
                                <code>@f</code>
                            </label>
                        }
                    </div>
                    @if (selectedFields.Count > 0)
                    {
                        <div class="table-scroll">
                            <table>
                                <thead>
                                    <tr>
                                        @foreach (var f in selectedFields)
                                        {
                                            <th>@f</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in previewRows)
                                    {
                                        <tr>
                                            @foreach (var f in selectedFields)
                                            {
                                                <td>@((MarkupString)FormatPreviewCell(row, f))</td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="preview-empty">@Loc["PreviewNoColumns"]</p>
                    }
                </div>
            }

            @* 工具栏 *@
            <div class="toolbar">
                <input type="text" placeholder="@Loc["SearchPlaceholder"]"
                       value="@State.SearchText"
                       @oninput="OnSearchInput" />
                <select value="@State.SortField" @onchange="OnSortFieldChange">
                    <option value="Count">@Loc["SortByCount"]</option>
                    <option value="Name">@Loc["SortByName"]</option>
                    <option value="Coverage">@Loc["SortByCoverage"]</option>
                    <option value="PrimaryType">@Loc["SortByType"]</option>
                    <option value="Semantic">@Loc["SortBySemantic"]</option>
                </select>
                <button @onclick="ToggleSortDirection">
                    @(State.SortAscending ? Loc["SortAsc"] : Loc["SortDesc"])
                </button>
            </div>

            @* 字段表格 *@
            <div class="field-table">
                <table>
                    <thead>
                        <tr>
                            <th>@Loc["FieldName"]</th>
                            <th>@Loc["SemanticType"]</th>
                            <th>@Loc["Coverage"]</th>
                            <th>@Loc["PrimaryType"]</th>
                            <th>@Loc["DateRange"]</th>
                            <th>@Loc["Outliers"]</th>
                            <th>@Loc["DefaultValue"]</th>
                            <th>@Loc["UniqueValues"]</th>
                            <th>@Loc["Rules"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var field in State.GetPageFields())
                        {
                            <tr>
                                <td class="field-name"><code>@field.FieldName</code></td>
                                <td>
                                    @if (!string.IsNullOrEmpty(field.SemanticType))
                                    {
                                        <span class="semantic-badge">@field.SemanticType</span>
                                    }
                                    else
                                    {
                                        <span class="na">—</span>
                                    }
                                </td>
                                <td>
                                    @{
                                        // 覆盖率三段拆分：实际（非空）= Count - NullCount；null 覆盖率 = NullCount；缺失 = Total - Count
                                        var cov = FieldCoverageMath.Compute(field, State.Result.TotalObjects);
                                    }
                                    <div class="coverage-bar">
                                        <div class="coverage-fill" style="width: @cov.ActualPercent%"></div>
                                        @if (field.NullCount > 0)
                                        {
                                            <div class="coverage-fill-null" style="left: @cov.ActualPercent%; width: @cov.NullPercent%"></div>
                                        }
                                        <span>@field.Count/@State.Result.TotalObjects (@FormatPercent(field.Coverage))</span>
                                    </div>
                                    @if (cov.HasUncovered)
                                    {
                                        <div class="coverage-breakdown">
                                            <span class="coverage-actual">@Loc["ActualCoverage"] @FormatPercent(cov.ActualPercent)（@cov.NonNullCount/@State.Result.TotalObjects）</span>
                                            @if (field.NullCount > 0)
                                            {
                                                <span class="coverage-null">@Loc.Get("CoverageNullRate", cov.NullPercent, field.NullCount)</span>
                                            }
                                            @if (cov.MissingCount > 0)
                                            {
                                                <span class="coverage-missing">@Loc.Get("CoverageMissingRate", cov.MissingPercent, cov.MissingCount)</span>
                                            }
                                        </div>
                                    }
                                </td>
                                <td>
                                    @foreach (var tc in field.TypeCounts.OrderByDescending(t => t.Value))
                                    {
                                        <span class="type-badge">@tc.Key (@tc.Value)</span>
                                    }
                                </td>
                                <td>
                                    @* 时间范围 (P3)：仅当 DateTimeCount > 0 时显示 *@
                                    @if (field.DateTimeCount is long dtCount && dtCount > 0)
                                    {
                                        <div class="datetime-range" title="@Loc.Get("DatetimeSpan", FormatDateTimeSpan(field.MinDateTime, field.MaxDateTime))">
                                            <div class="datetime-min">@FormatDate(field.MinDateTime)</div>
                                            <div class="datetime-sep">~</div>
                                            <div class="datetime-max">@FormatDate(field.MaxDateTime)</div>
                                            @if (field.DateHistogram is { Count: > 0 })
                                            {
                                                <div class="datetime-spark" aria-hidden="true">
                                                    @((MarkupString)RenderSparkline(field.DateHistogram.Select(b => (double)b.Count).ToArray()))
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="na">—</span>
                                    }
                                </td>
                                <td>
                                    @* 异常值 (P3)：仅当 OutlierCount 存在时显示 *@
                                    @if (field.OutlierCount is long oc)
                                    {
                                        @if (oc == 0)
                                        {
                                            <span class="outlier-clean">@Loc["OutlierZero"]</span>
                                        }
                                        else
                                        {
                                            <span class="outlier-badge" title="@Loc.Get("OutlierBoundsHint", field.OutlierBounds ?? "")">
                                                @Loc.Get("OutlierCountFmt", oc, field.OutlierRatio ?? 0)
                                            </span>
                                            @if (!string.IsNullOrEmpty(field.OutlierBounds))
                                            {
                                                <div class="outlier-bounds">@field.OutlierBounds</div>
                                            }
                                        }
                                    }
                                    else
                                    {
                                        <span class="na">—</span>
                                    }
                                </td>
                                <td>
                                    @if (field.DefaultValueRepresentation != null)
                                    {
                                        var cssClass = field.DefaultValueRepresentation switch
                                        {
                                            "null" => "null-val",
                                            "0" => "number-val",
                                            "false" => "bool-val",
                                            _ => ""
                                        };
                                        <code class="default-val @cssClass">@field.DefaultValueRepresentation</code>
                                    }
                                    else
                                    {
                                        <span class="na">—</span>
                                    }
                                </td>
                                <td>
                                    @field.ValueCounts.Count
                                    @if (field.ValueCountsTruncated)
                                    {
                                        <span class="truncated-hint">@Loc["Truncated"]</span>
                                    }
                                </td>
                                <td>
                                    @if (field.AppliedRule != null)
                                    {
                                        <span class="rule-badge">@Loc["Applied"]</span>
                                    }
                                    @if (field.EnumViolations.Count > 0)
                                    {
                                        <div class="enum-violations">
                                            @foreach (var v in field.EnumViolations)
                                            {
                                                <span class="violation">@v</span>
                                            }
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                @* 分页 *@
                @if (State.TotalPages > 1)
                {
                    <div class="pagination">
                        <button @onclick="PrevPage" disabled="@(State.PageIndex <= 0)">@Loc["PrevPage"]</button>
                        <span>@Loc.Get("PageXofY", State.PageIndex + 1, State.TotalPages)</span>
                        <button @onclick="NextPage" disabled="@(State.PageIndex >= State.TotalPages - 1)">@Loc["NextPage"]</button>
                    </div>
                }
            </div>

            @* 重复对象 *@
            @if (State.Result.TotalDuplicateGroups > 0)
            {
                <div class="duplicates-section">
                    <h3>@Loc.Get("DuplicatesTitle", State.Result.TotalDuplicateGroups)</h3>
                    @foreach (var dup in State.GetVisibleDuplicates())
                    {
                        <div class="dup-item">
                            <span class="dup-count">×@dup.Count</span>
                            <code>@dup.ObjectJson</code>
                        </div>
                    }
                    @if (State.HiddenDuplicateCount > 0)
                    {
                        <p class="duplicates-note">@Loc.Get("DuplicatesMore", State.HiddenDuplicateCount)</p>
                    }
                </div>
            }

            @* P3 高级分析 section：时间序列 + 异常值 + Schema 演进 *@
            <div class="p3-section">
                <div class="p3-header">
                    <h2>🔬 @Loc["P3InsightsTitle"]</h2>
                    <p class="p3-hint">@Loc["P3InsightsHint"]</p>
                </div>

                <div class="p3-grid">
                    @* 时间序列卡片 *@
                    <div class="p3-card">
                        <h3>📈 @Loc["TimeSeriesCard"]</h3>
                        @{
                            var dtFields = State.Result.FieldStatistics
                                .Where(f => f.DateTimeCount is long c && c > 0)
                                .ToList();
                        }
                        @if (dtFields.Count == 0)
                        {
                            <p class="p3-empty">@Loc["NoDateTimeFields"]</p>
                        }
                        else
                        {
                            <div class="p3-card-stats">
                                <span class="p3-stat-num">@dtFields.Count</span>
                                <span class="p3-stat-label">fields</span>
                            </div>
                            <ul class="p3-list">
                                @foreach (var f in dtFields.Take(8))
                                {
                                    <li>
                                        <code class="p3-field">@f.FieldName</code>
                                        <span class="p3-meta">@FormatDate(f.MinDateTime) → @FormatDate(f.MaxDateTime)</span>
                                        @if (f.DateHistogram is { Count: > 0 })
                                        {
                                            <div class="p3-spark" aria-hidden="true">
                                                @((MarkupString)RenderSparkline(f.DateHistogram.Select(b => (double)b.Count).ToArray(), 120, 24))
                                            </div>
                                            <div class="p3-meta-sub">@Loc.Get("HistogramBars", f.DateHistogram.Count)</div>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                    </div>

                    @* 异常值卡片 *@
                    <div class="p3-card">
                        <h3>⚠️ @Loc["OutliersCard"]</h3>
                        @{
                            var outlierFields = State.Result.FieldStatistics
                                .Where(f => f.OutlierCount is long c && c > 0)
                                .OrderByDescending(f => f.OutlierRatio ?? 0)
                                .ToList();
                        }
                        @if (outlierFields.Count == 0)
                        {
                            <p class="p3-empty">@Loc["NoOutlierFields"]</p>
                        }
                        else
                        {
                            <div class="p3-card-stats">
                                <span class="p3-stat-num">@outlierFields.Count</span>
                                <span class="p3-stat-label">flagged</span>
                            </div>
                            <ul class="p3-list">
                                @foreach (var f in outlierFields.Take(8))
                                {
                                    <li>
                                        <code class="p3-field">@f.FieldName</code>
                                        <span class="outlier-badge">@Loc.Get("OutlierCountFmt", f.OutlierCount ?? 0, f.OutlierRatio ?? 0)</span>
                                        @if (!string.IsNullOrEmpty(f.OutlierBounds))
                                        {
                                            <div class="p3-meta-sub">@f.OutlierBounds</div>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                    </div>

                    @* Schema 演进卡片 *@
                    <div class="p3-card p3-card-wide">
                        <h3>🔄 @Loc["SchemaDiffCard"]</h3>

                        <div class="p3-baseline-row">
                            <InputFile OnChange="HandleBaselineUpload" accept=".json" />
                            @if (State.BaselineSnapshotName != null)
                            {
                                <span class="file-ok">✓ @State.BaselineSnapshotName</span>
                                <button class="clear-btn" @onclick="ClearBaseline" title="@Loc["ClearBaseline"]">✕</button>
                            }
                            <button class="btn btn-outline btn-sm" @onclick="DownloadCurrentSnapshot" title="@Loc["ExportCurrentSnapshotHint"]">
                                💾 @Loc["ExportCurrentSnapshot"]
                            </button>
                        </div>

                        @if (State.BaselineError != null)
                        {
                            <div class="error">@State.BaselineError</div>
                        }
                        else if (State.BaselineSnapshotPath == null)
                        {
                            <p class="p3-empty">@Loc["NoBaselineUploaded"]</p>
                        }
                        else if (State.ComputedSchemaDiff != null)
                        {
                            var d = State.ComputedSchemaDiff;
                            <div class="p3-diff-summary">
                                <span class="p3-stat-num">@Loc.Get("DiffSummary", d.AddedFields.Count, d.RemovedFields.Count, d.ChangedFields.Count)</span>
                                @if (d.HasBreakingChanges)
                                {
                                    <span class="breaking-badge">@Loc["DiffBreakingBadge"]</span>
                                }
                                else
                                {
                                    <span class="safe-badge">@Loc["DiffSafeBadge"]</span>
                                }
                            </div>

                            @if (d.AddedFields.Count > 0)
                            {
                                <details class="p3-diff-group" open>
                                    <summary>🟢 @Loc.Get("DiffAddedTitle", d.AddedFields.Count)</summary>
                                    <ul class="p3-list">
                                        @foreach (var f in d.AddedFields)
                                        {
                                            <li>
                                                <code class="p3-field">@f.Path</code>
                                                <span class="p3-meta">@f.PrimaryType @if (!string.IsNullOrEmpty(f.SemanticType)) { <text>(@f.SemanticType)</text> }</span>
                                            </li>
                                        }
                                    </ul>
                                </details>
                            }

                            @if (d.RemovedFields.Count > 0)
                            {
                                <details class="p3-diff-group" open>
                                    <summary>🔴 @Loc.Get("DiffRemovedTitle", d.RemovedFields.Count)</summary>
                                    <ul class="p3-list">
                                        @foreach (var f in d.RemovedFields)
                                        {
                                            <li>
                                                <code class="p3-field">@f.Path</code>
                                                <span class="p3-meta">@f.PrimaryType</span>
                                            </li>
                                        }
                                    </ul>
                                </details>
                            }

                            @if (d.ChangedFields.Count > 0)
                            {
                                <details class="p3-diff-group">
                                    <summary>🟡 @Loc.Get("DiffChangedTitle", d.ChangedFields.Count)</summary>
                                    <ul class="p3-list p3-changes">
                                        @foreach (var c in d.ChangedFields)
                                        {
                                            <li>
                                                <code class="p3-field">@c.Path</code>
                                                @if (c.Breaking)
                                                {
                                                    <span class="breaking-badge breaking-mini">break</span>
                                                }
                                                <ul class="p3-change-items">
                                                    @foreach (var item in c.Changes)
                                                    {
                                                        <li class="@(item.Breaking ? "change-breaking" : "change-info")">
                                                            <span class="change-prop">@item.Property</span>
                                                            <span class="change-desc">@item.Description</span>
                                                        </li>
                                                    }
                                                </ul>
                                            </li>
                                        }
                                    </ul>
                                </details>
                            }
                        }
                    </div>
                </div>
            </div>

            @* 深度分析 section：相关性 + 模式 + Unicode 卫生 + 模糊去重 + 采样置信 + 分布漂移 *@
            <div class="deep-section">
                <div class="deep-header">
                    <h2>🧬 @Loc["DeepAnalysisInsightsTitle"]</h2>
                    <p class="deep-hint">@Loc["DeepAnalysisInsightsHint"]</p>
                </div>

                <div class="deep-grid">
                    @* 字段相关性矩阵卡片 *@
                    <div class="deep-card">
                        <h3>🔗 @Loc["CorrelationCard"]</h3>
                        @{
                            var corr = State.Result.CorrelationMatrix;
                        }
                        @if (corr == null || corr.Fields.Count == 0)
                        {
                            <p class="deep-empty">@Loc["NoCorrelation"]</p>
                        }
                        else
                        {
                            <div class="deep-card-stats">
                                <span class="deep-stat-num">@corr.Fields.Count</span>
                                <span class="deep-stat-label">@Loc["FieldsLabel"]</span>
                                <span class="deep-meta-sep">·</span>
                                <span class="deep-stat-num">@corr.Samples</span>
                                <span class="deep-stat-label">@Loc["SamplesLabel"]</span>
                            </div>
                            @if (corr.StrongPairs.Count > 0)
                            {
                                <ul class="deep-list">
                                    @foreach (var p in corr.StrongPairs.Take(6))
                                    {
                                        var pColor = (p.Pearson ?? 0) >= 0.7 ? "corr-pos" : (p.Pearson ?? 0) <= -0.7 ? "corr-neg" : "";
                                        <li>
                                            <code class="deep-field">@p.FieldA</code>
                                            <span class="deep-arrow">↔</span>
                                            <code class="deep-field">@p.FieldB</code>
                                            <span class="deep-corr @pColor">r = @p.Pearson?.ToString("F2")</span>
                                        </li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <p class="deep-empty">@Loc["NoStrongPairs"]</p>
                            }
                        }
                    </div>

                    @* 字符串模式归纳卡片 *@
                    <div class="deep-card">
                        <h3>🔤 @Loc["StringPatternsCard"]</h3>
                        @{
                            var sp = State.Result.StringPatterns;
                        }
                        @if (sp == null || sp.Count == 0)
                        {
                            <p class="deep-empty">@Loc["NoStringPatterns"]</p>
                        }
                        else
                        {
                            <div class="deep-card-stats">
                                <span class="deep-stat-num">@sp.Count</span>
                                <span class="deep-stat-label">@Loc["FieldsLabel"]</span>
                            </div>
                            <ul class="deep-list">
                                @foreach (var (field, profile) in sp.OrderByDescending(p => p.Value.TotalSamples).Take(6))
                                {
                                    <li>
                                        <code class="deep-field">@field</code>
                                        @if (profile.DominantPattern != null)
                                        {
                                            <code class="pattern-template">@profile.DominantPattern.Template</code>
                                            <span class="deep-meta">@Loc.Get("PatternCountFmt", profile.DominantPattern.Count, profile.TotalSamples)</span>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                    </div>

                    @* Unicode 卫生检查卡片 *@
                    <div class="deep-card">
                        <h3>🧹 @Loc["UnicodeHygieneCard"]</h3>
                        @{
                            var uh = State.Result.UnicodeHygiene;
                            var dirtyFields = uh != null
                                ? uh.Where(p => p.Value.HygieneScore.HasValue && p.Value.HygieneScore.Value < 90)
                                    .OrderBy(p => p.Value.HygieneScore ?? 100.0)
                                    .Take(20)
                                    .ToList()
                                : new List<KeyValuePair<string, global::ObjectAnalyzer.Analysis.UnicodeHygieneReport>>();
                        }
                        @if (uh == null || uh.Count == 0)
                        {
                            <p class="deep-empty">@Loc["NoHygieneIssues"]</p>
                        }
                        else if (dirtyFields.Count == 0)
                        {
                            <p class="deep-empty" style="color:#15803d">✅ @Loc["HygieneAllClean"]</p>
                        }
                        else
                        {
                            <div class="deep-card-stats">
                                <span class="deep-stat-num">@dirtyFields.Count</span>
                                <span class="deep-stat-label">@Loc["HygieneDirtyLabel"]</span>
                            </div>
                            <ul class="deep-list">
                                @foreach (var (field, r) in dirtyFields.Take(6))
                                {
                                    var flags = new List<string>();
                                    if (r.FullwidthCount > 0 && r.HalfwidthCount > 0)
                                        flags.Add(Loc.Get("HygieneMixedFullHalf", r.FullwidthCount, r.HalfwidthCount));
                                    if (r.InvisibleCount > 0)
                                        flags.Add(Loc.Get("HygieneInvisible", r.InvisibleCount));
                                    if (r.ControlCharCount > 0)
                                        flags.Add(Loc.Get("HygieneControl", r.ControlCharCount));
                                    if (r.SurroundingWhitespaceCount > 0)
                                        flags.Add(Loc.Get("HygieneSurroundingWs", r.SurroundingWhitespaceCount));
                                    if (r.MixedCaseCount > 0)
                                        flags.Add(Loc.Get("HygieneMixedCase", r.MixedCaseCount));
                                    string flagStr = flags.Count > 0 ? string.Join("; ", flags) : "—";
                                    <li>
                                        <code class="deep-field">@field</code>
                                        <span class="deep-score @(r.HygieneScore >= 70 ? "score-mid" : "score-low")">@Loc.Get("HygieneScoreFmt", r.HygieneScore ?? 0)</span>
                                        <div class="deep-meta-sub">@flagStr</div>
                                    </li>
                                }
                            </ul>
                        }
                    </div>

                    @* 模糊去重卡片 *@
                    <div class="deep-card">
                        <h3>👥 @Loc["FuzzyDedupCard"]</h3>
                        @{
                            var fd = State.Result.FuzzyDuplicates;
                        }
                        @if (fd == null)
                        {
                            <p class="deep-empty">@Loc["NoFuzzyDedup"]</p>
                        }
                        else
                        {
                            <div class="deep-card-stats">
                                <span class="deep-stat-num">@fd.GroupCount</span>
                                <span class="deep-stat-label">@Loc["FuzzyGroupsLabel"]</span>
                                <span class="deep-meta-sep">·</span>
                                <span class="deep-stat-num">@fd.SimilarDuplicates</span>
                                <span class="deep-stat-label">@Loc["FuzzySimLabel"]</span>
                            </div>
                            @if (fd.Groups.Count > 0)
                            {
                                <ul class="deep-list">
                                    @foreach (var g in fd.Groups.Take(6))
                                    {
                                        <li>
                                            <code class="deep-field">@TruncatePlain(g.CanonicalKey, 40)</code>
                                            <span class="deep-meta">@Loc.Get("FuzzyGroupSizeFmt", g.Count)</span>
                                            @if (g.Examples.Count > 1)
                                            {
                                                <div class="deep-meta-sub">
                                                    @string.Join(", ", g.Examples.Take(3).Select(e => $"\"{TruncatePlain(e, 20)}\""))
                                                </div>
                                            }
                                        </li>
                                    }
                                </ul>
                            }
                        }
                    </div>

                    @* 时间序列深度分析卡片 *@
                    <div class="deep-card">
                        <h3>📊 @Loc["TimeSeriesDeepCard"]</h3>
                        @{
                            var ts = State.Result.TimeSeriesAnalyses;
                        }
                        @if (ts == null || ts.Count == 0)
                        {
                            <p class="deep-empty">@Loc["NoTimeSeriesDeep"]</p>
                        }
                        else
                        {
                            <ul class="deep-list">
                                @foreach (var (field, t) in ts.Take(6))
                                {
                                    var trendColor = t.Trend == "rising" ? "trend-up" : t.Trend == "falling" ? "trend-down" : "trend-flat";
                                    <li>
                                        <code class="deep-field">@field</code>
                                        <span class="deep-trend @trendColor">@Loc.Get("TimeSeriesTrendFmt", t.Trend)</span>
                                        @if (t.DetectedPeriod.HasValue)
                                        {
                                            <span class="deep-meta">@Loc.Get("TimeSeriesPeriodFmt", t.DetectedPeriod)</span>
                                        }
                                        <div class="deep-meta-sub">@Loc.Get("TimeSeriesSpanFmt", t.BucketCount, t.BucketSpan)</div>
                                    </li>
                                }
                            </ul>
                        }
                    </div>

                    @* 采样置信度卡片 *@
                    <div class="deep-card">
                        <h3>🎯 @Loc["SamplingConfidenceCard"]</h3>
                        @{
                            var sc = State.Result.SamplingConfidence;
                        }
                        @if (sc == null)
                        {
                            <p class="deep-empty">@Loc["NoSamplingConfidence"]</p>
                        }
                        else
                        {
                            <div class="deep-card-stats">
                                <span class="deep-stat-num">@sc.EffectiveSampleSize</span>
                                <span class="deep-stat-label">@Loc["EffectiveNLabel"]</span>
                            </div>
                            <p class="deep-summary">@sc.Summary</p>
                            @if (sc.LowConfidenceFields.Count > 0)
                            {
                                <ul class="deep-list">
                                    @foreach (var f in sc.LowConfidenceFields.Take(6))
                                    {
                                        <li>
                                            <code class="deep-field">@f</code>
                                            @if (sc.CoverageIntervals.TryGetValue(f, out var ci))
                                            {
                                                <span class="deep-meta">@Loc.Get("ConfidenceRangeFmt", ci.Lower, ci.Upper)</span>
                                            }
                                        </li>
                                    }
                                </ul>
                            }
                        }
                    </div>

                    @* 分布漂移卡片（与 Schema Diff 类似但基于草图对比） *@
                    <div class="deep-card deep-card-wide">
                        <h3>📉 @Loc["DistributionDiffCard"]</h3>

                        <div class="p3-baseline-row">
                            <InputFile OnChange="HandleDistributionBaselineUpload" accept=".json" title="@Loc["LblDistributionBaselineTitle"]" />
                            @if (State.DistributionBaselineName != null)
                            {
                                <span class="file-ok">✓ @State.DistributionBaselineName</span>
                                <button class="clear-btn" @onclick="ClearDistributionBaseline" title="@Loc["ClearBaseline"]">✕</button>
                            }
                        </div>

                        @{
                            var dd = State.Result.DistributionDiff;
                        }
                        @if (dd == null)
                        {
                            <p class="deep-empty">@Loc["NoDistributionDiff"]</p>
                        }
                        else
                        {
                            <div class="deep-card-stats">
                                <span class="deep-stat-num">@dd.SignificantDriftCount</span>
                                <span class="deep-stat-label">@Loc["DriftCountLabel"]</span>
                            </div>
                            <div class="deep-row">
                                <span class="deep-meta">@Loc["BaselineLabel"]:</span>
                                <code>@dd.BaselineSource</code>
                            </div>
                            <div class="deep-row">
                                <span class="deep-meta">@Loc["CurrentLabel"]:</span>
                                <code>@dd.CurrentSource</code>
                            </div>
                            @if (dd.NumericDrifts.Count > 0)
                            {
                                <details class="deep-diff-group" open>
                                    <summary>🔢 @Loc.Get("NumericDriftTitle", dd.NumericDrifts.Count)</summary>
                                    <ul class="deep-list">
                                        @foreach (var d in dd.NumericDrifts.Take(8))
                                        {
                                            var sevClass = d.MeanShiftSigma >= 2 ? "drift-high" : d.MeanShiftSigma >= 1 ? "drift-mid" : "";
                                            <li>
                                                <code class="deep-field">@d.Path</code>
                                                <span class="deep-meta">@Loc.Get("DriftMeanFmt", d.BaselineMean ?? 0, d.CurrentMean ?? 0)</span>
                                                @if (d.MeanShiftSigma.HasValue)
                                                {
                                                    <span class="deep-shift @sevClass">@Loc.Get("DriftSigmaFmt", d.MeanShiftSigma.Value)</span>
                                                }
                                            </li>
                                        }
                                    </ul>
                                </details>
                            }
                            @if (dd.DistinctDrifts.Count > 0)
                            {
                                <details class="deep-diff-group">
                                    <summary>🔠 @Loc.Get("DistinctDriftTitle", dd.DistinctDrifts.Count)</summary>
                                    <ul class="deep-list">
                                        @foreach (var d in dd.DistinctDrifts.Take(8))
                                        {
                                            <li>
                                                <code class="deep-field">@d.Path</code>
                                                @if (d.Jaccard.HasValue)
                                                {
                                                    <span class="deep-meta">@Loc.Get("DriftJaccardFmt", d.Jaccard.Value)</span>
                                                }
                                            </li>
                                        }
                                    </ul>
                                </details>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    </main>

    <footer class="app-footer">
        ObjectAnalyzer · @Loc["AppBrandSub"] · <a href="https://github.com/perfectwtx/ObjectAnalysisStatistic" target="_blank" rel="noopener">GitHub</a>
    </footer>
</div>

@code {
    private string _activeTab = "fields";

    /// <summary>规则字段说明里的最小示例（MarkupString 渲染，避免 Razor 转义正则中的 @）。</summary>
    private const string RulesExampleJson = """
{
  "fields": {
    "age": {
      "primaryType": "Number",
      "minValue": 0,
      "maxValue": 150,
      "required": true
    },
    "gender": {
      "enumValues": ["Male", "Female"],
      "defaultValue": "Unknown"
    },
    "email": {
      "pattern": "^[^@]+@[^@]+$",
      "unique": true
    }
  },
  "runtime": {
    "gates": { "failOnViolations": true }
  }
}
""";

    private CancellationTokenSource? _analysisCts;
    private bool _suppressCancelMessage;
    private bool _darkTheme;

    /// <summary>P6 配置子区段（增量分析 / 内存预算 / 进度条）默认展开。便于用户首次发现 P6 能力。</summary>
    private bool P6ConfigOpen = true;

    private void ToggleP6Config()
    {
        P6ConfigOpen = !P6ConfigOpen;
    }

    protected override void OnInitialized()
    {
        Loc.OnLanguageChanged += StateHasChanged;
    }

    public void Dispose()
    {
        Loc.OnLanguageChanged -= StateHasChanged;
    }

    private void SetLanguage(string culture)
    {
        Loc.SetLanguage(culture);
    }

    /// <summary>主题切换（浅色/深色），通过 JS 设置 data-bs-theme 并持久化到 localStorage。</summary>
    private async Task ToggleTheme()
    {
        _darkTheme = !_darkTheme;
        await Js.InvokeVoidAsync("objectAnalyzer.setTheme", _darkTheme ? "dark" : "light");
    }

    /// <summary>取消正在运行的分析（不显示"分析已取消"，用于文件被替换/清除时）。</summary>
    private void CancelActiveAnalysis()
    {
        if (_analysisCts != null)
        {
            _analysisCts.Cancel();
            _suppressCancelMessage = true;
        }
    }

    private void SetTab(string tab) => _activeTab = tab;

    private string? _rulesText;
    private string? _rulesPasteStatus;
    private bool _rulesPasteOk;

    /// <summary>手动粘贴的规则 JSON → 输入即实时校验（语法 + 未知键 + 往返反序列化），应用后写入临时文件。</summary>
    private void OnRulesTextChange(ChangeEventArgs e)
    {
        _rulesText = e.Value?.ToString();
        ValidateRulesTextLive();
    }

    /// <summary>实时校验：未知键与语法错误在输入时即刻可见，不必等到点「应用规则」才发现。</summary>
    private void ValidateRulesTextLive()
    {
        _rulesPasteStatus = null;
        _rulesPasteOk = false;
        if (string.IsNullOrWhiteSpace(_rulesText))
            return;

        var unknowns = Core.Analysis.Rules.RulesLint.Scan(_rulesText);
        if (unknowns.Count > 0)
        {
            _rulesPasteStatus = Core.Analysis.Rules.RulesLint.Describe(unknowns);
            return;
        }

        try
        {
            var parsed = System.Text.Json.JsonSerializer.Deserialize<Core.Analysis.AnalysisRules>(_rulesText, Core.Analysis.AnalysisRules.RulesJsonOptions);
            _rulesPasteOk = true;
            _rulesPasteStatus = Loc.Get("EdPasteOk", parsed?.Fields.Count ?? 0);
        }
        catch (Exception ex)
        {
            _rulesPasteStatus = ErrorSanitizer.Format(ex);
        }
    }

    /// <summary>表单编辑器产出 → 同步进粘贴框（便于查看/微调）→ 走与粘贴完全相同的应用路径。</summary>
    private void ApplyEditorRules(string rulesJson)
    {
        _rulesText = rulesJson;
        ValidateRulesTextLive();
        ApplyRulesText();
    }

    private void ApplyRulesText()
    {
        if (string.IsNullOrWhiteSpace(_rulesText))
        {
            State.ErrorMessage = Loc["ErrRulesEmpty"];
            return;
        }
        try
        {
            var parsed = System.Text.Json.JsonSerializer.Deserialize<Core.Analysis.AnalysisRules>(_rulesText, Core.Analysis.AnalysisRules.RulesJsonOptions)
                ?? throw new InvalidDataException(Loc["ErrInvalidRules"]);
            _ = parsed.Fields;
        }
        catch (Exception ex)
        {
            State.ErrorMessage = ErrorSanitizer.Format(ex);
            return;
        }

        CancelActiveAnalysis();
        DeleteQuietly(State.RulesFilePath);
        var tempPath = Path.Combine(Path.GetTempPath(), $"oa-rules-{Guid.NewGuid():N}.json");
        File.WriteAllText(tempPath, _rulesText);
        State.RulesFilePath = tempPath;
        State.RulesFileName = Loc["RulesPastedName"];
        State.ErrorMessage = null;
    }

    private void ClearRulesText()
    {
        CancelActiveAnalysis();
        DeleteQuietly(State.RulesFilePath);
        _rulesText = null;
        State.RulesFilePath = null;
        State.RulesFileName = null;
        State.ErrorMessage = null;
    }

    private async Task HandleFileUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        // 替换旧数据临时文件；先取消进行中的分析，避免后台读取已删除的临时文件
        CancelActiveAnalysis();
        DeleteQuietly(State.DataFilePath);
        var tempPath = Path.Combine(Path.GetTempPath(), $"{Guid.NewGuid()}{Path.GetExtension(file.Name)}");
        await using (var fs = File.Create(tempPath))
        {
            await file.OpenReadStream(maxAllowedSize: 100 * 1024 * 1024).CopyToAsync(fs);
        }

        State.DataFilePath = tempPath;
        State.FileName = file.Name;
        State.ErrorMessage = null;
        State.Result = null;
        State.Preview = null;
        _selectedPreviewColumns.Clear();
        State.PageIndex = 0;
        // 数据源变更 → 旧基线与 diff 不再有效
        State.BaselineSnapshotPath = null;
        State.BaselineSnapshotName = null;
        State.ComputedSchemaDiff = null;
        State.BaselineError = null;
        // 分布漂移基线：与 schema baseline 同源——旧数据对应的基线失去意义，强制重传
        State.DistributionBaselinePath = null;
        State.DistributionBaselineName = null;
    }

    private void ClearDataFile()
    {
        CancelActiveAnalysis();
        DeleteQuietly(State.DataFilePath);
        State.DataFilePath = null;
        State.FileName = "";
        State.Result = null;
        State.Preview = null;
        _selectedPreviewColumns.Clear();
        State.ErrorMessage = null;
    }

    private async Task RunAnalysis()
    {
        if (State.DataFilePath == null)
        {
            State.ErrorMessage = Loc["ErrSelectDataFile"];
            return;
        }

        // 取消上一次未完成的分析
        _analysisCts?.Cancel();
        _analysisCts?.Dispose();
        _analysisCts = new CancellationTokenSource();
        _suppressCancelMessage = false;

        // 捕获当前配置快照，避免后台线程与 UI 状态竞争
        string dataFilePath = State.DataFilePath!;
        bool flatten = State.Flatten;
        bool csvInferNumbers = State.CsvInferNumbers;
        string? rulesFilePath = State.RulesFilePath;
        bool allowUnknownRules = State.AllowUnknownRules;
        string fieldsText = State.Fields;
        string filterText = State.Filter;
        int maxDegreeOfParallelism = State.MaxDegreeOfParallelism;
        int sampleReservoir = State.SampleReservoir;
        int sampleStep = State.SampleStep;
        double lowConfidenceWidth = State.LowConfidenceWidth;
        int memoryFallbackSampleSize = State.MemoryFallbackSampleSize;
        // 深度分析开关：任一为真才构造 AdvancedAnalysisOptions 走对应分支
        bool enableCorrelation = State.EnableCorrelation;
        bool enableStringPatterns = State.EnableStringPatterns;
        bool enableUnicodeHygiene = State.EnableUnicodeHygiene;
        bool enableTimeSeries = State.EnableTimeSeries;
        bool enableDistributionSnapshot = State.EnableDistributionSnapshot;
        string? fuzzyDedupField = State.FuzzyDedupField;
        int correlationReservoir = State.CorrelationReservoir;
        // P3 分布漂移基线（与 schema baseline 同源：用户上传的临时文件路径）
        string? distributionBaselinePath = State.DistributionBaselinePath;
        // P6 快照：进度条 / 增量 / 内存预算
        bool showProgress = State.ShowProgress;
        string? resumeFromPath = State.ResumeFrom;
        string? baselinePath = State.BaselinePath;
        string? checkpointFileName = State.CheckpointFileName;
        long maxMemoryMB = State.MaxMemoryMB;
        Core.Analysis.MaxMemoryMode maxMemoryMode =
            string.Equals(State.MaxMemoryMode, "hard", StringComparison.OrdinalIgnoreCase)
                ? Core.Analysis.MaxMemoryMode.Hard
                : Core.Analysis.MaxMemoryMode.Soft;
        // 捕获 JSONPath 投影参数
        string rootPathText = State.RootPath;
        string recordPathText = State.RecordPath;

        Core.Analysis.AnalysisRules? rules = null;
        if (rulesFilePath != null)
        {
            var rulesJson = File.ReadAllText(rulesFilePath);
            // 与 /api/analyze 同源：未勾选"容忍未知键"时把拼错/已废弃的键拦下，避免规则看似生效实则被静默忽略
            if (!allowUnknownRules)
            {
                var unknown = Core.Analysis.Rules.RulesLint.Scan(rulesJson);
                if (unknown.Count > 0)
                {
                    var unknownList = string.Join(", ", unknown);
                    _analysisCts?.Dispose();
                    _analysisCts = null;
                    State.ErrorMessage = Loc.Get("ErrUnknownRules", unknownList);
                    return;
                }
            }
            rules = System.Text.Json.JsonSerializer.Deserialize<Core.Analysis.AnalysisRules>(rulesJson, Core.Analysis.AnalysisRules.RulesJsonOptions);
        }

        // valueParsers 优先于扩展名推断（与下方 effectiveFormat 计算同源）
        IReadOnlyList<Core.Analysis.ValueParserConfig> effectiveValueParsers = rules?.ValueParsers is { Count: > 0 }
            ? rules.ValueParsers
            : Array.Empty<Core.Analysis.ValueParserConfig>();
        string effectiveFormat = effectiveValueParsers.Count > 0
            ? "excel-json"
            : Core.Parsing.FileParsers.DetectFormat(dataFilePath);

        // record-path 必须看到嵌套子对象才能正确投影；与 CLI 行为一致
        bool effectiveFlatten = flatten;
        if (!string.IsNullOrWhiteSpace(recordPathText))
        {
            effectiveFlatten = false;
        }

        // ── 方案 B：预检 ──
        // 用与正式分析一致的解析选项探测前 N 条记录的字段名；若规则字段完全没匹配上，
        // 把"用错规则文件"这件事在分析开始前告诉用户。
        // 仅在用户上传了规则文件时才做预检（无规则文件不属于本方案的覆盖范围）。
        if (rules != null && rules.Fields.Count > 0)
        {
            var preflightOptions = new Core.Parsing.ParseOptions
            {
                Flatten = effectiveFlatten,
                ValueParsers = effectiveValueParsers,
                CsvInferNumbers = csvInferNumbers
            };
            var preflight = Core.Analysis.PreflightChecker.Check(
                dataFilePath, rules, preflightOptions, effectiveFormat);

            if (preflight.HasWarning)
            {
                // 预检命中：把本次配置固化为快照，等用户确认后再真正启动分析
                State.PreflightWarning = Loc["PreflightExplain"];
                State.PreflightRuleFields = preflight.RuleFields.ToList();
                State.PreflightSampleFields = preflight.SampleFields.ToList();
                State.PendingPreflight = new PreflightSnapshot(
                    DataFilePath: dataFilePath,
                    Format: effectiveFormat,
                    ParseOptions: preflightOptions,
                    Rules: rules,
                    AllowUnknownRules: allowUnknownRules,
                    FieldsText: fieldsText,
                    FilterText: filterText,
                    MaxDegreeOfParallelism: maxDegreeOfParallelism,
                    SampleReservoir: sampleReservoir,
                    SampleStep: sampleStep,
                    LowConfidenceWidth: lowConfidenceWidth,
                    MemoryFallbackSampleSize: memoryFallbackSampleSize,
                    EnableCorrelation: enableCorrelation,
                    EnableStringPatterns: enableStringPatterns,
                    EnableUnicodeHygiene: enableUnicodeHygiene,
                    EnableTimeSeries: enableTimeSeries,
                    EnableDistributionSnapshot: enableDistributionSnapshot,
                    FuzzyDedupField: fuzzyDedupField,
                    CorrelationReservoir: correlationReservoir,
                    DistributionBaselinePath: distributionBaselinePath,
                    ShowProgress: showProgress,
                    ResumeFromPath: resumeFromPath,
                    BaselinePath: baselinePath,
                    CheckpointFileName: checkpointFileName,
                    MaxMemoryMB: maxMemoryMB,
                    MaxMemoryMode: maxMemoryMode,
                    RootPathText: rootPathText,
                    RecordPathText: recordPathText,
                    EffectiveValueParsers: effectiveValueParsers);
                _analysisCts?.Dispose();
                _analysisCts = null;
                State.ShowPreflightModal = true;
                return;
            }
        }

        // 无规则文件 或 预检无警告：直接进入正式分析
        var snapshot = new PreflightSnapshot(
            DataFilePath: dataFilePath,
            Format: effectiveFormat,
            ParseOptions: new Core.Parsing.ParseOptions
            {
                Flatten = effectiveFlatten,
                ValueParsers = effectiveValueParsers,
                CsvInferNumbers = csvInferNumbers
            },
            Rules: rules,
            AllowUnknownRules: allowUnknownRules,
            FieldsText: fieldsText,
            FilterText: filterText,
            MaxDegreeOfParallelism: maxDegreeOfParallelism,
            SampleReservoir: sampleReservoir,
            SampleStep: sampleStep,
            LowConfidenceWidth: lowConfidenceWidth,
            MemoryFallbackSampleSize: memoryFallbackSampleSize,
            EnableCorrelation: enableCorrelation,
            EnableStringPatterns: enableStringPatterns,
            EnableUnicodeHygiene: enableUnicodeHygiene,
            EnableTimeSeries: enableTimeSeries,
            EnableDistributionSnapshot: enableDistributionSnapshot,
            FuzzyDedupField: fuzzyDedupField,
            CorrelationReservoir: correlationReservoir,
            DistributionBaselinePath: distributionBaselinePath,
            ShowProgress: showProgress,
            ResumeFromPath: resumeFromPath,
            BaselinePath: baselinePath,
            CheckpointFileName: checkpointFileName,
            MaxMemoryMB: maxMemoryMB,
            MaxMemoryMode: maxMemoryMode,
            RootPathText: rootPathText,
            RecordPathText: recordPathText,
            EffectiveValueParsers: effectiveValueParsers);
        await RunAnalysisCore(snapshot);
    }

    /// <summary>
    /// 用户在预检模态框点击"仍然继续分析"时调用：消费已固化的快照，正式启动后台分析。
    /// 模态框仅展示提示，不阻塞其它 UI 状态；进入此处后即与正常分析路径一致。
    /// </summary>
    private async Task ConfirmPreflight()
    {
        var snapshot = State.PendingPreflight;
        State.ShowPreflightModal = false;
        State.PreflightWarning = null;
        State.PreflightRuleFields = new();
        State.PreflightSampleFields = new();
        State.PendingPreflight = null;
        if (snapshot == null) return;
        await RunAnalysisCore(snapshot);
    }

    /// <summary>
    /// 用户在预检模态框点击"取消并修改规则"时调用：仅关闭模态框，UI 提示用户去侧栏换规则文件。
    /// </summary>
    private void CancelPreflight()
    {
        State.ShowPreflightModal = false;
        State.PreflightWarning = null;
        State.PreflightRuleFields = new();
        State.PreflightSampleFields = new();
        State.PendingPreflight = null;
    }

    /// <summary>
    /// 实际驱动后台分析的私有方法：从 <paramref name="snapshot"/> 读取所有可调参数，避免
    /// 在后台线程与 UI 状态之间竞争。该方法只被 <see cref="RunAnalysis"/> 与
    /// <see cref="ConfirmPreflight"/> 调用。
    /// </summary>
    private async Task RunAnalysisCore(PreflightSnapshot snapshot)
    {
        State.IsLoading = true;
        State.ErrorMessage = null;
        State.MemoryWarning = null;
        State.ResultWarning = null;
        State.ProgressText = "";
        State.LastCheckpointServerPath = null;
        State.LastCheckpointSize = 0;
        State.PageIndex = 0;

        _analysisCts?.Dispose();
        _analysisCts = new CancellationTokenSource();
        var token = _analysisCts.Token;
        _suppressCancelMessage = false;

        // 解包快照到本地变量（与原 RunAnalysis 行为保持一致，避免回填影响快照）
        string dataFilePath = snapshot.DataFilePath;
        bool flatten = snapshot.ParseOptions.Flatten;
        bool csvInferNumbers = snapshot.ParseOptions.CsvInferNumbers;
        string? rulesFilePath = snapshot.Rules != null ? State.RulesFilePath : null;
        bool allowUnknownRules = snapshot.AllowUnknownRules;
        string fieldsText = snapshot.FieldsText;
        string filterText = snapshot.FilterText;
        int maxDegreeOfParallelism = snapshot.MaxDegreeOfParallelism;
        int sampleReservoir = snapshot.SampleReservoir;
        int sampleStep = snapshot.SampleStep;
        double lowConfidenceWidth = snapshot.LowConfidenceWidth;
        int memoryFallbackSampleSize = snapshot.MemoryFallbackSampleSize;
        bool enableCorrelation = snapshot.EnableCorrelation;
        bool enableStringPatterns = snapshot.EnableStringPatterns;
        bool enableUnicodeHygiene = snapshot.EnableUnicodeHygiene;
        bool enableTimeSeries = snapshot.EnableTimeSeries;
        bool enableDistributionSnapshot = snapshot.EnableDistributionSnapshot;
        string? fuzzyDedupField = snapshot.FuzzyDedupField;
        int correlationReservoir = snapshot.CorrelationReservoir;
        string? distributionBaselinePath = snapshot.DistributionBaselinePath;
        bool showProgress = snapshot.ShowProgress;
        string? resumeFromPath = snapshot.ResumeFromPath;
        string? baselinePath = snapshot.BaselinePath;
        string? checkpointFileName = snapshot.CheckpointFileName;
        long maxMemoryMB = snapshot.MaxMemoryMB;
        Core.Analysis.MaxMemoryMode maxMemoryMode = snapshot.MaxMemoryMode;
        string rootPathText = snapshot.RootPathText;
        string recordPathText = snapshot.RecordPathText;
        Core.Analysis.AnalysisRules? rules = snapshot.Rules;
        string effectiveFormat = snapshot.Format;

        string safeCheckpointName = P6PostAnalysis.SanitizeCheckpointName(checkpointFileName);
        List<Dictionary<string, object?>>? previewedPreview = null;

        // W1 统一管线：构造 AnalysisOptions（IR）——Web UI 显式值优先，rules.runtime 经
        // RulesToOptionsConverter 合并（与 CLI / API 同源、同优先级链；合并只覆盖"默认"字段，
        // UI 已显式设置的值不会被覆盖）。解析/投影/转换/采样/统计全部交给 AnalysisPipeline。
        var analysisOptions = new Core.Analysis.AnalysisOptions
        {
            Input =
            {
                InputPath = dataFilePath,
                RootPath = string.IsNullOrWhiteSpace(rootPathText) ? null : rootPathText,
                RecordPath = string.IsNullOrWhiteSpace(recordPathText) ? null : recordPathText
            },
            Parse =
            {
                Flatten = flatten,
                CsvInferNumbers = csvInferNumbers,
                MaxValuesToShow = 5,
                MaxDegreeOfParallelism = maxDegreeOfParallelism
            },
            Rules = { RulesFile = rulesFilePath, AllowUnknownRules = allowUnknownRules },
            FieldSelection =
            {
                Fields = string.IsNullOrWhiteSpace(fieldsText) ? null : fieldsText,
                Filter = string.IsNullOrWhiteSpace(filterText) ? null : filterText
            },
            Sampling =
            {
                SampleReservoir = sampleReservoir,
                SampleStep = sampleStep,
                LowConfidenceWidth = lowConfidenceWidth,
                MemoryFallbackSampleSize = memoryFallbackSampleSize
            },
            Progress = { ShowProgress = showProgress },
            Advanced =
            {
                EnableCorrelation = enableCorrelation,
                EnableStringPatterns = enableStringPatterns,
                EnableUnicodeHygiene = enableUnicodeHygiene,
                EnableTimeSeries = enableTimeSeries,
                EnableDistributionSnapshot = enableDistributionSnapshot,
                FuzzyDedupField = fuzzyDedupField,
                CorrelationReservoir = correlationReservoir
            },
            Distribution = { DiffDistributionBaseline = distributionBaselinePath },
            Incremental =
            {
                ResumeFrom = resumeFromPath,
                BaselinePath = baselinePath,
                CheckpointPath = string.IsNullOrWhiteSpace(safeCheckpointName) ? null : safeCheckpointName
            },
            Memory = { MaxMemoryMB = maxMemoryMB, MaxMemoryMode = maxMemoryMode }
        };
        if (rules != null)
        {
            Core.Analysis.RulesToOptionsConverter.Apply(analysisOptions, rules);
        }
        // 把 options 合并后回填到本地变量（供采样校验与 checkpoint 提示使用）
        sampleReservoir = analysisOptions.Sampling.SampleReservoir;
        sampleStep = analysisOptions.Sampling.SampleStep;
        maxDegreeOfParallelism = analysisOptions.Parse.MaxDegreeOfParallelism;

        try
        {
            // 采样参数校验（蓄水池与等距互斥、参数合法性）
            Core.Analysis.Sampling.Validate(sampleReservoir, sampleStep);

            // ── P6.1 进度回调：IProgress<long> → State.ProgressText（Progress<T> 自动捕获 SynchronizationContext 切回 UI 线程）──
            // ── P6.3 内存预算：Check 保留在 Web 侧进度桥接（P6ProgressReporter），维持内存告警 UI 语义；hard 抛错在分析结束后统一执行 ──
            var memoryBudget = new Core.Analysis.MemoryBudget(maxMemoryMB, maxMemoryMode);
            var progress = new Progress<long>(P6ProgressReporter.Build(
                showProgress: showProgress,
                budget: memoryBudget,
                progressTextSink: text => State.ProgressText = text,
                memoryWarningSink: warning => State.MemoryWarning ??= warning,
                localize: Loc.Get));

            // W1 统一分析管线：解析 → JSONPath 投影 → 字段选择/转换/过滤 → 采样 → 统计。
            // Web 只注入进度桥接与预览捕获，不再维护自有流程（与 CLI / API 同一条计算路径）。
            var runContext = new Core.Analysis.Pipeline.AnalysisRunContext
            {
                ProgressBridge = progress,
                PreviewSink = list => previewedPreview = list.ToList(),
                PreviewLimit = 20
            };

            var pipelineResult = await AnalysisExecutionService.ExecuteAsync(
                State.FileName,
                effectiveFormat,
                analysisOptions,
                rules,
                runContext,
                token);

            Core.Analysis.AnalysisResult result = pipelineResult.Result;
            // P6.3 内存预算 hard 模式：分析循环结束后由本机检查点统一抛错（避免在 progress 回调线程上抛）
            memoryBudget.ThrowIfHardExceeded();
            effectiveFormat = runContext.EffectiveFormat ?? effectiveFormat;

            State.Preview = previewedPreview;
            SeedPreviewSelection();
            State.Result = result;
            State.ProgressText = "";
            _activeTab = "fields";

            // ── 方案 D：结果页兜底警告 ──
            // 再次校验：本次结果里是否出现任意规则字段？若完全没有，说明规则文件与数据不匹配。
            // 仅在用户上传了规则文件时计算；预检未触发（例如部分匹配）时也兜底。
            // 关键点：当规则字段带 parse:json 时，FieldTransformProcessor 会把值展平成 A.body.foo / A.body.bar
            // 等子字段，原始的 A.body 名字已被替换；此时不能只看完全相等，要允许"规则字段是结果字段的父路径"。
            if (rules != null && rules.Fields.Count > 0 && result.FieldStatistics.Count > 0)
            {
                var observed = new HashSet<string>(
                    result.FieldStatistics.Select(f => f.FieldName),
                    StringComparer.OrdinalIgnoreCase);
                bool anyMatched = false;
                foreach (var field in rules.Fields.Keys)
                {
                    if (string.IsNullOrWhiteSpace(field)) continue;
                    if (observed.Contains(field)) { anyMatched = true; break; }
                    // 规则字段是某个结果字段的父路径（A.body → A.body.foo）
                    string prefix = field + ".";
                    foreach (var stat in observed)
                    {
                        if (stat.StartsWith(prefix, StringComparison.OrdinalIgnoreCase))
                        {
                            anyMatched = true;
                            break;
                        }
                    }
                    if (anyMatched) break;
                }
                if (!anyMatched)
                {
                    State.ResultWarning = Loc["ResultWarningExplain"];
                }
            }

            // ── P6.2 增量分析 / 断点续跑 / 基线合并：分析成功后的合并阶段 ──
            // 限制：Web 端不跳读源文件位置（仅合并聚合结果）；如需真正从源文件中间续跑请用 CLI。
            // 核心逻辑已拆到 P6PostAnalysis.Apply（独立可测），此处只负责把返回值落到 State。
            var p6Outcome = P6PostAnalysis.Apply(new P6PostAnalysisInput
            {
                Result = result,
                ResumeFromPath = resumeFromPath,
                BaselinePath = baselinePath,
                CheckpointFileName = safeCheckpointName,
                SourcePath = dataFilePath,
                SourceFormat = effectiveFormat
            });
            if (p6Outcome.LastCheckpointServerPath != null)
            {
                State.LastCheckpointServerPath = p6Outcome.LastCheckpointServerPath;
                State.LastCheckpointSize = p6Outcome.LastCheckpointSize;
            }
            if (p6Outcome.ResumeErrorMessage != null)
            {
                State.ErrorMessage = Loc.Get("ErrResumeFailed", p6Outcome.ResumeErrorMessage);
            }
            if (p6Outcome.BaselineErrorMessage != null)
            {
                State.ErrorMessage = Loc.Get("ErrBaselineFailed", p6Outcome.BaselineErrorMessage);
            }
            if (p6Outcome.CheckpointErrorMessage != null)
            {
                State.ErrorMessage = Loc.Get("ErrCheckpointFailed", p6Outcome.CheckpointErrorMessage);
            }

            // 数据血缘审计：仅在用户填写了 --audit-log 路径时写入一条 analysis_finish 事件
            // Web UI 不复用 AnalysisRunner.Run（其内置自有流式管道），故此处直接调用 AuditLogger。
            // 异常被吞掉：审计失败不应阻塞 UI 反馈。
            TryWriteWebAuditLog(result, exitCode: 0, message: null);

            // 若分析前已上传基线快照，异步计算 diff（不阻塞 UI）
            if (State.BaselineSnapshotPath != null)
            {
                await ComputeBaselineDiffAsync(State.BaselineSnapshotPath);
            }
        }
        catch (OperationCanceledException)
        {
            if (!_suppressCancelMessage)
            {
                State.ErrorMessage = Loc["ErrCancelled"];
            }
            State.ProgressText = "";
            TryWriteWebAuditLog(State.Result, exitCode: 2, message: "用户取消");
        }
        catch (Core.Analysis.MaxMemoryExceededException ex)
        {
            // P6.3 hard 模式超限：作为单独错误类型向用户展示，提示降低数据规模或调高阈值
            State.ErrorMessage = Loc.Get("ErrMemoryHardExceeded", ex.Message);
            State.MemoryWarning = ex.Message;
            State.ProgressText = "";
            TryWriteWebAuditLog(State.Result, exitCode: 1, message: ex.Message);
        }
        catch (Exception ex)
        {
            State.ErrorMessage = ErrorSanitizer.Format(ex);
            State.ProgressText = "";
            TryWriteWebAuditLog(State.Result, exitCode: 1, message: ex.Message);
        }
        finally
        {
            _analysisCts?.Dispose();
            _analysisCts = null;
            State.IsLoading = false;
        }
    }

    /// <summary>
    /// Web 端审计日志写入：用户在"配置"区填了 AuditLogPath 时，向该文件追加一行 NDJSON
    /// 事件。内容仅含 inputHash / operator / 选项快照 / 结果摘要，不含字段值与密钥。
    /// 失败仅记到控制台（开发可见），不影响 UI 反馈。
    /// </summary>
    private void TryWriteWebAuditLog(Core.Analysis.AnalysisResult? result, int exitCode, string? message)
    {
        if (!State.HasAuditLog) return;
        try
        {
            var sw = System.Diagnostics.Stopwatch.StartNew();
            var auditOptions = new Core.Analysis.AnalysisOptions
            {
                Input =
                {
                    InputPath = State.DataFilePath ?? "",
                    RootPath = string.IsNullOrWhiteSpace(State.RootPath) ? null : State.RootPath,
                    RecordPath = string.IsNullOrWhiteSpace(State.RecordPath) ? null : State.RecordPath
                },
                Rules = { RulesFile = State.RulesFilePath },
                Parse =
                {
                    Flatten = State.Flatten,
                    MaxValuesToShow = State.MaxValuesToShow,
                    MaxDegreeOfParallelism = State.MaxDegreeOfParallelism
                },
                FieldSelection =
                {
                    Fields = string.IsNullOrWhiteSpace(State.Fields) ? null : State.Fields,
                    Filter = string.IsNullOrWhiteSpace(State.Filter) ? null : State.Filter
                },
                Sampling = { SampleReservoir = State.SampleReservoir, SampleStep = State.SampleStep },
                // P6 配置同步：审计时只记录选项，不含文件值
                Progress = { ShowProgress = State.ShowProgress },
                Incremental =
                {
                    CheckpointPath = string.IsNullOrWhiteSpace(State.CheckpointPath) ? null : State.CheckpointPath,
                    ResumeFrom = string.IsNullOrWhiteSpace(State.ResumeFrom) ? null : State.ResumeFrom,
                    BaselinePath = string.IsNullOrWhiteSpace(State.BaselinePath) ? null : State.BaselinePath
                },
                Memory =
                {
                    MaxMemoryMB = State.MaxMemoryMB,
                    MaxMemoryMode = string.Equals(State.MaxMemoryMode, "hard", StringComparison.OrdinalIgnoreCase)
                        ? Core.Analysis.MaxMemoryMode.Hard
                        : Core.Analysis.MaxMemoryMode.Soft
                }
            };

            Core.Analysis.AnalysisRules? rules = null;
            if (!string.IsNullOrEmpty(State.RulesFilePath) && File.Exists(State.RulesFilePath))
            {
                try
                {
                    rules = System.Text.Json.JsonSerializer.Deserialize<Core.Analysis.AnalysisRules>(
                        File.ReadAllText(State.RulesFilePath), Core.Analysis.AnalysisRules.RulesJsonOptions);
                }
                catch { /* 规则解析失败时审计仅记录无 transform 摘要 */ }
            }

            var entry = new Core.Analysis.AuditLogEntry
            {
                Timestamp = Core.Analysis.AuditLogger.FormatTimestamp(DateTime.UtcNow),
                Event = exitCode switch
                {
                    0 => "analysis_finish",
                    2 => "analysis_cancel",
                    _ => "analysis_error"
                },
                RunId = Guid.NewGuid().ToString("N"),
                Operator = string.IsNullOrWhiteSpace(State.Operator) ? "anonymous" : State.Operator,
                ToolVersion = "web",
                InputSource = State.DataFilePath ?? "",
                InputHash = Core.Analysis.AuditLogger.ComputeFileHash(State.DataFilePath),
                InputBytes = Core.Analysis.AuditLogger.GetFileSize(State.DataFilePath),
                Options = Core.Analysis.AuditLogger.Snapshot(auditOptions, rules),
                Result = result == null ? null : Core.Analysis.AuditLogger.Summarize(result, null),
                Message = message,
                ExitCode = exitCode
            };
            using var logger = new Core.Analysis.AuditLogger(State.AuditLogPath);
            logger.Write(entry);
            sw.Stop();
        }
        catch (Exception ex)
        {
            // 审计失败仅在服务端控制台留痕，不暴露给浏览器用户
            Console.Error.WriteLine($"[audit] 写入审计日志失败: {ex.Message}");
        }
    }

