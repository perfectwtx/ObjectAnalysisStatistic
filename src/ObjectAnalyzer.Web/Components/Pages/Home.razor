    private Core.Analysis.AnalysisResult? _lastChartResult;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _darkTheme = await Js.InvokeAsync<bool>("objectAnalyzer.isDarkTheme");
            await Js.InvokeVoidAsync("objectAnalyzer.initSplitter", ".app-shell", ".side-handle", "oa-sidebar-width");
            StateHasChanged();
        }

        // 结果对象变化时重绘图表（Blazor 重新渲染时避免重复实例化）
        if (State.Result != null && !ReferenceEquals(_lastChartResult, State.Result))
        {
            _lastChartResult = State.Result;
            await RenderCharts(State.Result);
        }
    }

    private async Task RenderCharts(Core.Analysis.AnalysisResult result)
    {
        var topFields = result.FieldStatistics
            .OrderByDescending(f => f.Count)
            .Take(15)
            .ToList();

        var fieldNames = topFields.Select(f => f.FieldName).ToArray();
        // 图表口径与字段表格一致：实际覆盖率 = 非空记录数 / 总数（null 与键缺失不计入）
        var coverages = topFields.Select(f => result.TotalObjects > 0
            ? Math.Round(Math.Max(0, f.Count - f.NullCount) * 100.0 / result.TotalObjects, 1)
            : 0).ToArray();
        await Js.InvokeVoidAsync("objectAnalyzer.renderCoverageChart", fieldNames, coverages);

        var typeTop = topFields.Take(10).ToList();
        var typeLabels = typeTop.Select(f => f.FieldName).ToArray();
        var allTypes = typeTop
            .SelectMany(f => f.TypeCounts.Keys)
            .Distinct()
            .ToList();
        var colors = new[]
        {
            "rgba(54,162,235,0.7)", "rgba(255,99,132,0.7)", "rgba(75,192,192,0.7)",
            "rgba(255,205,86,0.7)", "rgba(153,102,255,0.7)", "rgba(255,159,64,0.7)"
        };
        var datasets = allTypes
            .Select((t, i) => new
            {
                label = t,
                data = typeTop.Select(f => f.TypeCounts.GetValueOrDefault(t, 0)).ToArray(),
                backgroundColor = colors[i % colors.Length]
            })
            .ToArray();
        await Js.InvokeVoidAsync("objectAnalyzer.renderTypeChart", typeLabels, datasets);
    }

    private List<string> GetAllPreviewFields()
    {
        var result = new List<string>();
        var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        if (State.Preview != null)
        {
            foreach (var row in State.Preview)
            {
                foreach (var key in row.Keys)
                {
                    if (seen.Add(key)) result.Add(key);
                }
            }
        }
        return result;
    }

    private readonly HashSet<string> _selectedPreviewColumns = new(StringComparer.OrdinalIgnoreCase);

    private void SeedPreviewSelection()
    {
        _selectedPreviewColumns.Clear();
        foreach (var f in GetAllPreviewFields().Take(PreviewColumnCount))
        {
            _selectedPreviewColumns.Add(f);
        }
    }

    private bool IsPreviewColumnSelected(string field) => _selectedPreviewColumns.Contains(field);

    private void TogglePreviewColumn(string field)
    {
        if (!_selectedPreviewColumns.Add(field))
        {
            _selectedPreviewColumns.Remove(field);
        }
    }

    private void SelectAllPreviewColumns()
    {
        foreach (var f in GetAllPreviewFields())
        {
            _selectedPreviewColumns.Add(f);
        }
    }

    private void ClearPreviewColumns()
    {
        _selectedPreviewColumns.Clear();
    }

    internal static string FormatPreviewCell(Dictionary<string, object?> row, string field)
    {
        // 该字段在行中从未出现 → 显示空；字段出现但值为 null → 显示 "null"
        return row.TryGetValue(field, out var value) ? FormatPreviewValue(value) : "";
    }

    internal static string FormatPreviewValue(object? value)
    {
        if (value == null) return "null";

        var jsonTree = TryRenderJsonTree(value);
        if (jsonTree != null)
            return jsonTree;

        if (value is string s)
            return WebUtility.HtmlEncode(s.Length <= 80 ? s : s[..77] + "...");

        if (!IsScalar(value))
        {
            try
            {
                string json = JsonSerializer.Serialize(value, PreviewJsonOptions);
                return json.Length <= 80 ? WebUtility.HtmlEncode(json) : WebUtility.HtmlEncode(json[..77] + "...");
            }
            catch
            {
                // 个别自定义类型无法序列化时，退回类型名兜底
            }
        }

        return WebUtility.HtmlEncode(value.ToString() ?? "null");
    }

    private static string? TryRenderJsonTree(object? value)
    {
        if (value is not string s)
        {
            if (value is IDictionary<string, object?> dict)
                return BuildObjectTreeHtml(dict);

            if (value is System.Collections.IEnumerable enumerable && value is not string)
            {
                var list = new List<object?>();
                foreach (var item in enumerable) list.Add(item);
                return BuildArrayTreeHtml(list);
            }

            return null;
        }

        var trimmed = s.Trim();
        if (trimmed.Length == 0)
            return null;

        try
        {
            using var doc = JsonDocument.Parse(trimmed);
            string summary = SummarizeJson(doc.RootElement);
            return $"<span class=\"json-preview\" data-tooltip=\"{WebUtility.HtmlEncode(trimmed)}\"><span class=\"json-pill\">JSON</span>{WebUtility.HtmlEncode(summary)}</span>";
        }
        catch (JsonException)
        {
            return null;
        }
    }

    private static string SummarizeJson(JsonElement element)
    {
        if (element.ValueKind == JsonValueKind.Object)
        {
            var props = element.EnumerateObject().Take(3).Select(p => $"{p.Name}: {SummarizeScalar(p.Value)}").ToArray();
            var content = props.Length > 0 ? string.Join(", ", props) : "{}";
            return props.Length == 3 && element.EnumerateObject().Count() > 3 ? $"{{ {content}, ... }}" : $"{{ {content} }}";
        }

        if (element.ValueKind == JsonValueKind.Array)
        {
            var items = element.EnumerateArray().Take(3).Select(SummarizeScalar).ToArray();
            var content = items.Length > 0 ? string.Join(", ", items) : "";
            return items.Length == 3 && element.GetArrayLength() > 3 ? $"[{content}, ...]" : $"[{content}]";
        }

        return JsonSerializer.Serialize(element);
    }

    private static string SummarizeScalar(JsonElement element)
    {
        return element.ValueKind switch
        {
            JsonValueKind.String => $"\"{element.GetString()}\"",
            JsonValueKind.Number or JsonValueKind.True or JsonValueKind.False or JsonValueKind.Null => element.GetRawText(),
            JsonValueKind.Object => "{...}",
            JsonValueKind.Array => "[...]",
            _ => element.GetRawText()
        };
    }

    private static string BuildObjectTreeHtml(IDictionary<string, object?> dict)
    {
        var items = new List<string>();
        foreach (var kvp in dict)
        {
            items.Add($"<div class=\"json-item\"><span class=\"json-key\">{WebUtility.HtmlEncode(kvp.Key)}</span><span class=\"json-colon\">:</span>{BuildObjectValueHtml(kvp.Value)}</div>");
        }
        return $"<div class=\"json-tree\">{string.Join(string.Empty, items)}</div>";
    }

    private static string BuildArrayTreeHtml(List<object?> items)
    {
        var rendered = new List<string>();
        for (int i = 0; i < items.Count; i++)
        {
            rendered.Add($"<div class=\"json-item\"><span class=\"json-index\">[{i}]</span><span class=\"json-colon\">:</span>{BuildObjectValueHtml(items[i])}</div>");
        }
        return $"<div class=\"json-tree\">{string.Join(string.Empty, rendered)}</div>";
    }

    private static string BuildObjectValueHtml(object? value)
    {
        if (value == null)
            return "<span class=\"json-value json-null\">null</span>";

        if (value is string s)
        {
            var trimmed = s.Trim();
            try
            {
                using var doc = JsonDocument.Parse(trimmed);
                return $"<span class=\"json-preview\" data-tooltip=\"{WebUtility.HtmlEncode(trimmed)}\"><span class=\"json-pill\">JSON</span>{WebUtility.HtmlEncode(SummarizeJson(doc.RootElement))}</span>";
            }
            catch (JsonException)
            {
                return $"<span class=\"json-value json-string\">\"{WebUtility.HtmlEncode(s)}\"</span>";
            }
        }

        if (value is IDictionary<string, object?> dict)
            return BuildObjectTreeHtml(dict);

        if (value is System.Collections.IEnumerable enumerable && value is not string)
        {
            var list = new List<object?>();
            foreach (var item in enumerable) list.Add(item);
            return BuildArrayTreeHtml(list);
        }

        return $"<span class=\"json-value json-scalar\">{WebUtility.HtmlEncode(value.ToString() ?? "null")}</span>";
    }

    private static bool IsScalar(object value)
    {
        Type type = value.GetType();
        return type.IsPrimitive
            || type.IsEnum
            || value is string or decimal or DateTime or DateTimeOffset or Guid or TimeSpan or char;
    }

