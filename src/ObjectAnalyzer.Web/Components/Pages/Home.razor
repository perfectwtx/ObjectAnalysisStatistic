    // ── P6 运行时：分析后处理（断点续跑 / 基线合并 / 检查点落盘）──

    /// <summary>
    /// 把 <c>--resume</c> / <c>--baseline</c> 提供的历史结果合并到本次 <paramref name="result"/>，
    /// 并在用户填写了 <c>--checkpoint</c> 文件名时落盘 AnalyzerSnapshot 到服务器临时目录。
    /// 异常被吞掉并写到 <see cref="AnalysisState.ErrorMessage"/>：增量步骤失败不应阻塞本次主分析结果。
    /// </summary>
    private void ApplyP6PostAnalysis(
        Core.Analysis.AnalysisResult result,
        string? resumeFromPath,
        string? baselinePath,
        string? safeCheckpointName)
    {
        // P6.2 断点续跑：把历史 AnalyzerSnapshot.Result 合并进当前 result
        if (!string.IsNullOrEmpty(resumeFromPath) && File.Exists(resumeFromPath))
        {
            try
            {
                var snapshot = Core.Analysis.AnalyzerSnapshot.LoadFrom(resumeFromPath);
                result.MergeFrom(snapshot.Result);
            }
            catch (Exception ex)
            {
                State.ErrorMessage = Loc.Get("ErrResumeFailed", ex.Message);
            }
        }

        // P6.2 基线合并：把历史 AnalysisResult JSON 合并进当前 result
        if (!string.IsNullOrEmpty(baselinePath) && File.Exists(baselinePath))
        {
            try
            {
                var baselineJson = File.ReadAllText(baselinePath);
                var baselineResult = System.Text.Json.JsonSerializer.Deserialize<Core.Analysis.AnalysisResult>(baselineJson);
                if (baselineResult != null)
                {
                    result.MergeFrom(baselineResult);
                }
            }
            catch (Exception ex)
            {
                State.ErrorMessage = Loc.Get("ErrBaselineFailed", ex.Message);
            }
        }

        // P6.2 检查点落盘：把当前 result 写入 %TEMP%/objectanalyzer-checkpoints/<safe-name>.snapshot
        if (!string.IsNullOrEmpty(safeCheckpointName))
        {
            try
            {
                var dir = Path.Combine(Path.GetTempPath(), "objectanalyzer-checkpoints");
                Directory.CreateDirectory(dir);
                var fullPath = Path.Combine(dir, safeCheckpointName);
                var snapshot = new Core.Analysis.AnalyzerSnapshot
                {
                    SourcePath = State.DataFilePath ?? "",
                    SourceFormat = Core.Parsing.FileParsers.DetectFormat(State.DataFilePath ?? ""),
                    Result = result
                };
                snapshot.SaveTo(fullPath);
                State.LastCheckpointServerPath = fullPath;
                State.LastCheckpointSize = new FileInfo(fullPath).Length;
            }
            catch (Exception ex)
            {
                State.ErrorMessage = Loc.Get("ErrCheckpointFailed", ex.Message);
            }
        }
    }

    /// <summary>
    /// 把用户在 UI 上填写的检查点名称规整为安全的服务器文件名：去路径分隔符、空白、引号等，
    /// 并强制 .snapshot 后缀。失败时回退为 session-{guid}.snapshot。
    /// </summary>
    private static string SanitizeCheckpointName(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return "";
        var name = raw.Trim();
        // 去掉路径分隔符与控制字符，仅保留字母数字 - _ . 与 CJK
        var invalid = Path.GetInvalidFileNameChars();
        var sb = new System.Text.StringBuilder(name.Length);
        foreach (var c in name)
        {
            if (Array.IndexOf(invalid, c) >= 0) sb.Append('_');
            else if (c == Path.DirectorySeparatorChar || c == Path.AltDirectorySeparatorChar) sb.Append('_');
            else sb.Append(c);
        }
        var cleaned = sb.ToString();
        if (string.IsNullOrWhiteSpace(cleaned))
        {
            return $"session-{Guid.NewGuid():N}.snapshot";
        }
        if (!cleaned.EndsWith(".snapshot", StringComparison.OrdinalIgnoreCase))
        {
            cleaned += ".snapshot";
        }
        // Windows 文件名长度上限 255
        if (cleaned.Length > 240)
        {
            cleaned = cleaned.Substring(0, 240) + ".snapshot";
        }
        return cleaned;
    }

