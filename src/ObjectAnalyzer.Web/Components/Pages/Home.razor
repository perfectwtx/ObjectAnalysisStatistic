@page "/"
@using Core = global::ObjectAnalyzer
@using Microsoft.AspNetCore.Components.Forms
@inject AnalysisState State
@inject IJSRuntime Js
@rendermode InteractiveServer

<PageTitle>ObjectAnalyzer - 对象分析工具</PageTitle>

<div class="analyzer-app">
    @* 顶部应用栏 *@
    <header class="app-header">
        <div class="app-brand">
            <span class="brand-icon" aria-hidden="true">📊</span>
            <div>
                <h1>ObjectAnalyzer</h1>
                <p class="brand-sub">对象字段分析统计</p>
            </div>
        </div>
        @if (State.Result != null)
        {
            <div class="header-actions">
                <span class="file-chip" title="@State.FileName">📄 @State.FileName</span>
                <button class="btn btn-outline" @onclick="ToggleConfig">@(ShowConfig ? "收起设置" : "修改设置")</button>
            </div>
        }
    </header>

    @* 上传与设置面板（可折叠） *@
    @if (ShowConfig)
    {
        <section class="config-panel">
            <div class="upload-area">
                <InputFile OnChange="HandleFileUpload" accept=".json,.jsonl,.csv,.xlsx,.xml,.yaml,.yml" />
                <p>拖放文件或点击选择<br/>
                   <small>支持 JSON, JSONL, CSV, Excel, XML, YAML</small>
                </p>
                @if (State.HasData)
                {
                    <div class="uploaded-file">
                        <span class="file-ok">已选择: @State.FileName</span>
                        <button class="clear-btn" @onclick="ClearDataFile" title="清除文件">✕</button>
                    </div>
                }
            </div>

            <div class="options-grid">
                <label class="option-item">
                    <span>格式</span>
                    <select value="@(State.Format ?? "")" @onchange="OnFormatChange">
                        <option value="">自动检测</option>
                        <option value="json">JSON</option>
                        <option value="jsonl">JSONL</option>
                        <option value="csv">CSV</option>
                        <option value="excel">Excel</option>
                        <option value="xml">XML</option>
                        <option value="yaml">YAML</option>
                        <option value="excel-json">Excel-JSON</option>
                    </select>
                </label>
                <label class="option-item checkbox-item">
                    <input type="checkbox" checked="@State.Flatten" @onchange="OnFlattenChange" />
                    <span>展平嵌套</span>
                </label>
                <label class="option-item">
                    <span>最大展示值</span>
                    <input type="number" value="@State.MaxValuesToShow" @oninput="OnMaxValuesChange" min="1" max="100" />
                </label>
                <label class="option-item">
                    <span>并行线程</span>
                    <input type="number" value="@State.MaxDegreeOfParallelism" @oninput="OnParallelChange" min="-1" max="64" placeholder="-1" title="最大并行线程数，-1 = 全部核心" />
                </label>
                <label class="option-item">
                    <span>Excel-JSON 列</span>
                    <input type="text" value="@State.ExcelJsonColumn" @oninput="OnExcelColumnChange" maxlength="3" placeholder="A" />
                </label>
                <label class="option-item">
                    <span>目标类名</span>
                    <input type="text" value="@State.TypeName" @oninput="OnTypeNameChange" placeholder="可选" />
                </label>
                <div class="option-item file-option">
                    <span>类型定义 (.cs)</span>
                    <div class="file-field">
                        <InputFile OnChange="HandleTypeFileUpload" accept=".cs" />
                        @if (State.TypeFileName != null)
                        {
                            <span class="file-ok">✓ @State.TypeFileName</span>
                            <button class="clear-btn" @onclick="ClearTypeFile" title="清除类型定义">✕</button>
                        }
                    </div>
                </div>
                <div class="option-item file-option">
                    <span>规则文件 (.json)</span>
                    <div class="file-field">
                        <InputFile OnChange="HandleRulesFileUpload" accept=".json" />
                        @if (State.RulesFileName != null)
                        {
                            <span class="file-ok">✓ @State.RulesFileName</span>
                            <button class="clear-btn" @onclick="ClearRulesFile" title="清除规则文件">✕</button>
                        }
                    </div>
                </div>
            </div>

            <div class="config-actions">
                <button class="btn btn-primary btn-lg" @onclick="RunAnalysis"
                        disabled="@(!State.HasData || State.IsLoading)">
                    @(State.IsLoading ? "分析中..." : "开始分析")
                </button>
            </div>

            @if (State.ErrorMessage != null)
            {
                <div class="error">@State.ErrorMessage</div>
            }
        </section>
    }

    @* 结果区域 *@
    @if (State.Result != null)
    {
        <div class="results-section">
            @* 结果标题栏 *@
            <div class="results-header">
                <h2>分析结果 <span class="result-file">@State.FileName</span></h2>
                @if (State.Result.FieldStatistics.Any(f => f.EnumViolations.Count > 0))
                {
                    <button class="btn btn-outline btn-sm" @onclick="DownloadViolations">导出违规 JSON</button>
                }
            </div>

            @* 摘要卡片 *@
            <div class="summary-cards">
                <div class="card blue">
                    <div class="card-value">@State.Result.TotalObjects</div>
                    <div class="card-label">总对象数</div>
                </div>
                <div class="card green">
                    <div class="card-value">@State.Result.TotalUniqueObjects</div>
                    <div class="card-label">唯一对象</div>
                </div>
                <div class="card orange">
                    <div class="card-value">@State.Result.DuplicateObjects.Count</div>
                    <div class="card-label">重复组</div>
                </div>
                <div class="card purple">
                    <div class="card-value">@State.Result.FieldStatistics.Count</div>
                    <div class="card-label">字段数</div>
                </div>
            </div>

            @* 工具栏 *@
            <div class="toolbar">
                <input type="text" placeholder="搜索字段名..."
                       value="@State.SearchText"
                       @oninput="OnSearchInput" />
                <select value="@State.SortField" @onchange="OnSortFieldChange">
                    <option value="Count">按频次排序</option>
                    <option value="Name">按名称排序</option>
                    <option value="Coverage">按覆盖率排序</option>
                    <option value="PrimaryType">按类型排序</option>
                </select>
                <button @onclick="ToggleSortDirection">
                    @(State.SortAscending ? "↑ 升序" : "↓ 降序")
                </button>
            </div>

            @* 字段表格 *@
            <div class="field-table">
                <table>
                    <thead>
                        <tr>
                            <th>字段名</th>
                            <th>覆盖率</th>
                            <th>主导类型</th>
                            <th>默认值</th>
                            <th>唯一值</th>
                            <th>规则</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var field in State.GetPageFields())
                        {
                            <tr>
                                <td class="field-name"><code>@field.FieldName</code></td>
                                <td>
                                    <div class="coverage-bar">
                                        <div class="coverage-fill" style="width: @(field.Coverage * 100)%"></div>
                                        <span>@field.Count/@State.Result.TotalObjects (@FormatPercent(field.Coverage))</span>
                                    </div>
                                </td>
                                <td>
                                    @foreach (var tc in field.TypeCounts.OrderByDescending(t => t.Value))
                                    {
                                        <span class="type-badge">@tc.Key (@tc.Value)</span>
                                    }
                                </td>
                                <td>
                                    @if (field.DefaultValueRepresentation != null)
                                    {
                                        var cssClass = field.DefaultValueRepresentation switch
                                        {
                                            "null" => "null-val",
                                            "0" => "number-val",
                                            "false" => "bool-val",
                                            _ => ""
                                        };
                                        <code class="default-val @cssClass">@field.DefaultValueRepresentation</code>
                                    }
                                    else
                                    {
                                        <span class="na">—</span>
                                    }
                                </td>
                                <td>
                                    @field.ValueCounts.Count
                                    @if (field.ValueCountsTruncated)
                                    {
                                        <span class="truncated-hint">+ (已截断)</span>
                                    }
                                </td>
                                <td>
                                    @if (field.AppliedRule != null)
                                    {
                                        <span class="rule-badge">已应用</span>
                                    }
                                    @if (field.EnumViolations.Count > 0)
                                    {
                                        <div class="enum-violations">
                                            @foreach (var v in field.EnumViolations)
                                            {
                                                <span class="violation">@v</span>
                                            }
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                @* 分页 *@
                @if (State.TotalPages > 1)
                {
                    <div class="pagination">
                        <button @onclick="PrevPage" disabled="@(State.PageIndex <= 0)">← 上一页</button>
                        <span>第 @(State.PageIndex + 1) / @State.TotalPages 页</span>
                        <button @onclick="NextPage" disabled="@(State.PageIndex >= State.TotalPages - 1)">下一页 →</button>
                    </div>
                }
            </div>

            @* 重复对象 *@
            @if (State.Result.DuplicateObjects.Count > 0)
            {
                <div class="duplicates-section">
                    <h3>重复对象 (@State.Result.DuplicateObjects.Count 组)</h3>
                    @foreach (var dup in State.GetVisibleDuplicates())
                    {
                        <div class="dup-item">
                            <span class="dup-count">×@dup.Count</span>
                            <code>@dup.ObjectJson</code>
                        </div>
                    }
                    @if (State.HiddenDuplicateCount > 0)
                    {
                        <p class="duplicates-note">... 还有 @State.HiddenDuplicateCount 组未展示</p>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    private bool ShowConfig = true;

    private void ToggleConfig()
    {
        ShowConfig = !ShowConfig;
    }

    private async Task HandleFileUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        // 替换旧数据临时文件
        DeleteQuietly(State.DataFilePath);
        var tempPath = Path.Combine(Path.GetTempPath(), $"{Guid.NewGuid()}{Path.GetExtension(file.Name)}");
        await using (var fs = File.Create(tempPath))
        {
            await file.OpenReadStream(maxAllowedSize: 100 * 1024 * 1024).CopyToAsync(fs);
        }

        State.DataFilePath = tempPath;
        State.FileName = file.Name;
        State.ErrorMessage = null;
        State.Result = null;
        State.PageIndex = 0;
    }

    private void ClearDataFile()
    {
        DeleteQuietly(State.DataFilePath);
        State.DataFilePath = null;
        State.FileName = "";
        State.Result = null;
        State.ErrorMessage = null;
    }

    private async Task RunAnalysis()
    {
        if (State.DataFilePath == null) return;

        State.IsLoading = true;
        State.ErrorMessage = null;
        State.PageIndex = 0;

        try
        {
            List<Dictionary<string, object?>> objects;

            // 如果指定了类型文件，使用强类型反序列化
            if (State.TypeFilePath != null)
            {
                var compileResult = Core.TypeLoader.Compile(State.TypeFilePath, State.TypeName);
                try
                {
                    var typedResult = Core.TypedFileParser.ParseJson(State.DataFilePath, compileResult.type);
                    objects = typedResult.Objects;
                    if (typedResult.Errors.Count > 0)
                    {
                        State.ErrorMessage = $"存在 {typedResult.Errors.Count} 条属性读取错误: {typedResult.Errors[0]}";
                    }
                }
                finally
                {
                    compileResult.context.Dispose();
                }
            }
            else
            {
                // 自动检测或指定格式解析
                var format = string.IsNullOrEmpty(State.Format)
                    ? Core.FileParsers.DetectFormat(State.DataFilePath)
                    : State.Format;
                var parseOptions = new Core.ParseOptions
                {
                    Flatten = State.Flatten,
                    ExcelJsonColumn = State.ExcelJsonColumn
                };
                objects = Core.FileParsers.ParseByFormat(State.DataFilePath, format, parseOptions).ToList();
            }

            // 加载规则文件
            Core.AnalysisRules? rules = null;
            if (State.RulesFilePath != null)
            {
                var rulesJson = await File.ReadAllTextAsync(State.RulesFilePath);
                rules = System.Text.Json.JsonSerializer.Deserialize<Core.AnalysisRules>(rulesJson);
            }

            // 分析
            var parallelOptions = new ParallelOptions
            {
                MaxDegreeOfParallelism = State.MaxDegreeOfParallelism >= 1
                    ? State.MaxDegreeOfParallelism
                    : Environment.ProcessorCount
            };
            State.Result = Core.ObjectAnalyzer.Analyze(objects, rules, parallelOptions);
            ShowConfig = false;
        }
        catch (Exception ex)
        {
            State.ErrorMessage = ErrorSanitizer.Format(ex);
        }
        finally
        {
            State.IsLoading = false;
        }
    }

    private void PrevPage()
    {
        if (State.PageIndex > 0) State.PageIndex--;
    }

    private void NextPage()
    {
        if (State.PageIndex < State.TotalPages - 1) State.PageIndex++;
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        State.SearchText = e.Value?.ToString() ?? "";
        State.PageIndex = 0;
    }

    private void OnSortFieldChange(ChangeEventArgs e)
    {
        State.SortField = e.Value?.ToString() ?? "Count";
        State.PageIndex = 0;
    }

    private void ToggleSortDirection()
    {
        State.SortAscending = !State.SortAscending;
        State.PageIndex = 0;
    }

    private void OnFlattenChange(ChangeEventArgs e)
    {
        State.Flatten = e.Value is true;
    }

    private void OnFormatChange(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        State.Format = string.IsNullOrEmpty(val) ? null : val;
    }

    private void OnMaxValuesChange(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int val) && val > 0)
        {
            State.MaxValuesToShow = val;
        }
    }

    private void OnExcelColumnChange(ChangeEventArgs e)
    {
        var val = e.Value?.ToString()?.Trim().ToUpperInvariant() ?? "A";
        State.ExcelJsonColumn = string.IsNullOrEmpty(val) ? "A" : val;
    }

    private void OnParallelChange(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int val) && val >= -1)
        {
            State.MaxDegreeOfParallelism = val;
        }
    }

    private void ClearTypeFile()
    {
        DeleteQuietly(State.TypeFilePath);
        State.TypeFilePath = null;
        State.TypeFileName = null;
        State.TypeName = null;
        State.ErrorMessage = null;
    }

    private void ClearRulesFile()
    {
        DeleteQuietly(State.RulesFilePath);
        State.RulesFilePath = null;
        State.RulesFileName = null;
        State.ErrorMessage = null;
    }

    private async Task DownloadViolations()
    {
        var fileName = $"violations-{DateTime.Now:yyyyMMdd-HHmmss}.json";
        await Js.InvokeVoidAsync("objectAnalyzer.downloadTextFile",
            fileName, State.GetViolationsJson(), "application/json;charset=utf-8");
    }

    private async Task HandleTypeFileUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        // 替换旧临时文件（流式写入磁盘，避免在内存中缓存大文件）
        DeleteQuietly(State.TypeFilePath);
        var tempPath = Path.Combine(Path.GetTempPath(), $"{Guid.NewGuid()}.cs");
        await using (var fs = File.Create(tempPath))
        {
            await file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).CopyToAsync(fs);
        }
        State.TypeFilePath = tempPath;
        State.TypeFileName = file.Name;
        State.ErrorMessage = null;
    }

    private async Task HandleRulesFileUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        DeleteQuietly(State.RulesFilePath);
        var tempPath = Path.Combine(Path.GetTempPath(), $"{Guid.NewGuid()}.json");
        await using (var fs = File.Create(tempPath))
        {
            await file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).CopyToAsync(fs);
        }

        // 上传时即时校验规则文件格式，失败则清除并提示
        try
        {
            await using var verify = File.OpenRead(tempPath);
            var rules = await System.Text.Json.JsonSerializer.DeserializeAsync<Core.AnalysisRules>(verify);
            if (rules == null)
            {
                throw new InvalidDataException("规则文件内容为空或格式无效。");
            }
            State.RulesFilePath = tempPath;
            State.RulesFileName = file.Name;
            State.ErrorMessage = null;
        }
        catch (Exception ex)
        {
            DeleteQuietly(tempPath);
            State.RulesFilePath = null;
            State.RulesFileName = null;
            State.ErrorMessage = ErrorSanitizer.Format(ex);
        }
    }

    private void OnTypeNameChange(ChangeEventArgs e)
    {
        var val = e.Value?.ToString()?.Trim();
        State.TypeName = string.IsNullOrEmpty(val) ? null : val;
    }

    private static void DeleteQuietly(string? path)
    {
        if (path == null) return;
        try { File.Delete(path); } catch { }
    }

    private static string FormatPercent(double coverage)
    {
        return $"{coverage * 100:F1}%";
    }
}
