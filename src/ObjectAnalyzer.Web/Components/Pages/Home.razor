    private async Task DownloadSchema(string format)
    {
        if (State.Result == null) return;
        var stamp = DateTime.Now.ToString("yyyyMMdd-HHmmss");
        (string fileName, string content, string mime) = format switch
        {
            "csharp" => ($"schema-{stamp}.cs", Core.Reporting.SchemaExporter.GenerateCSharp(State.Result), "text/plain;charset=utf-8"),
            "typescript" => ($"schema-{stamp}.d.ts", Core.Reporting.SchemaExporter.GenerateTypeScript(State.Result), "text/plain;charset=utf-8"),
            "openapi" => ($"schema-{stamp}.openapi.yaml", Core.Reporting.SchemaExporter.GenerateOpenApiYaml(State.Result), "application/x-yaml;charset=utf-8"),
            "openapi-json" => ($"schema-{stamp}.openapi.json", Core.Reporting.SchemaExporter.GenerateOpenApiJson(State.Result), "application/json;charset=utf-8"),
            "protobuf" or "proto" => ($"schema-{stamp}.proto", Core.Reporting.SchemaExporter.GenerateProtobuf(State.Result), "text/plain;charset=utf-8"),
            "sql" => SchemaSqlDialect switch
            {
                "mysql" => ($"schema-{stamp}.mysql.sql", Core.Reporting.SchemaExporter.GenerateSql(State.Result, "mysql"), "application/sql;charset=utf-8"),
                "sqlite" => ($"schema-{stamp}.sqlite.sql", Core.Reporting.SchemaExporter.GenerateSql(State.Result, "sqlite"), "application/sql;charset=utf-8"),
                "sqlserver" => ($"schema-{stamp}.sqlserver.sql", Core.Reporting.SchemaExporter.GenerateSql(State.Result, "sqlserver"), "application/sql;charset=utf-8"),
                _ => ($"schema-{stamp}.postgres.sql", Core.Reporting.SchemaExporter.GenerateSql(State.Result, "postgres"), "application/sql;charset=utf-8")
            },
            _ => ($"schema-{stamp}.schema.json", Core.Reporting.SchemaExporter.GenerateJsonSchema(State.Result), "application/json;charset=utf-8")
        };
        await Js.InvokeVoidAsync("objectAnalyzer.downloadTextFile", fileName, content, mime);
    }

