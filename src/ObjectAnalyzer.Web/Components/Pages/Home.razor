    private async Task HandleRulesFileUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        CancelActiveAnalysis();
        DeleteQuietly(State.RulesFilePath);
        var tempPath = Path.Combine(Path.GetTempPath(), $"{Guid.NewGuid()}.json");
        await using (var fs = File.Create(tempPath))
        {
            await file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).CopyToAsync(fs);
        }

        // 上传时即时校验规则文件格式，失败则清除并提示
        try
        {
            await using var verify = File.OpenRead(tempPath);
            var rules = await System.Text.Json.JsonSerializer.DeserializeAsync<Core.Analysis.AnalysisRules>(verify);
            if (rules == null)
            {
                throw new InvalidDataException(Loc["ErrInvalidRules"]);
            }
            State.RulesFilePath = tempPath;
            State.RulesFileName = file.Name;
            State.ErrorMessage = null;
        }
        catch (Exception ex)
        {
            DeleteQuietly(tempPath);
            State.RulesFilePath = null;
            State.RulesFileName = null;
            State.ErrorMessage = ErrorSanitizer.Format(ex);
        }
    }

