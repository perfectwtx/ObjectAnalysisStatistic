    private async Task DownloadBinaryReport(string ext, string mime)
    {
        if (State.Result == null) return;
        var temp = Path.Combine(Path.GetTempPath(), $"{Guid.NewGuid()}{ext}");
        try
        {
            await Task.Run(() => Core.Reporting.ReportExporter.Save(State.Result, temp));
            byte[] bytes = await File.ReadAllBytesAsync(temp);
            string base64 = Convert.ToBase64String(bytes);
            var fileName = $"analysis-{DateTime.Now:yyyyMMdd-HHmmss}{ext}";
            await Js.InvokeVoidAsync("objectAnalyzer.downloadBinaryFile", fileName, base64, mime);
        }
        finally
        {
            DeleteQuietly(temp);
        }
    }

