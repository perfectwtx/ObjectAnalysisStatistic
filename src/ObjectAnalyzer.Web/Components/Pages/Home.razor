    }

    private async Task HandleTypeFileUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        // 替换旧临时文件（流式写入磁盘，避免在内存中缓存大文件）
        CancelActiveAnalysis();
        DeleteQuietly(State.TypeFilePath);
        var tempPath = Path.Combine(Path.GetTempPath(), $"{Guid.NewGuid()}.cs");
        await using (var fs = File.Create(tempPath))
        {
            await file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).CopyToAsync(fs);
        }
        State.TypeFilePath = tempPath;
        State.TypeFileName = file.Name;
        State.ErrorMessage = null;
    }

    private async Task HandleRulesFileUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        CancelActiveAnalysis();
        DeleteQuietly(State.RulesFilePath);
        var tempPath = Path.Combine(Path.GetTempPath(), $"{Guid.NewGuid()}.json");
        await using (var fs = File.Create(tempPath))
        {
            await file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).CopyToAsync(fs);
        }

        // 上传时即时校验规则文件格式，失败则清除并提示
        try
        {
            await using var verify = File.OpenRead(tempPath);
            var rules = await System.Text.Json.JsonSerializer.DeserializeAsync<Core.Analysis.AnalysisRules>(verify);
            if (rules == null)
            {
                throw new InvalidDataException(Loc["ErrInvalidRules"]);
            }
            State.RulesFilePath = tempPath;
            State.RulesFileName = file.Name;
            State.ErrorMessage = null;
        }
        catch (Exception ex)
        {
            DeleteQuietly(tempPath);
            State.RulesFilePath = null;
            State.RulesFileName = null;
            State.ErrorMessage = ErrorSanitizer.Format(ex);
        }
    }

    private void OnTypeNameChange(ChangeEventArgs e)
    {
        var val = e.Value?.ToString()?.Trim();
        State.TypeName = string.IsNullOrEmpty(val) ? null : val;
    }

    private static void DeleteQuietly(string? path)
    {
        if (path == null) return;
        try { File.Delete(path); } catch { }
    }

    private static List<string>? SplitFields(string? fields)
    {
        if (string.IsNullOrWhiteSpace(fields))
            return null;
        return fields.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private static string FormatPercent(double coverage)
    {
        return $"{coverage * 100:F1}%";
    }
