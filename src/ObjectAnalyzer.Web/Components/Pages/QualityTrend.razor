@page "/quality/trend"
@using ObjectAnalyzer.Platform
@inject IQualityHistoryQuery QualityHistory

<PageTitle>质量趋势</PageTitle>

<div class="oa-analysis-page oa-quality-trend-page">
    <div class="oa-analysis-header">
        <div>
            <div class="oa-eyebrow">Quality Analysis</div>
            <h1>质量趋势</h1>
            <p>从历史质量快照观察整体质量分与核心质量维度的变化。</p>
        </div>
        <button class="btn btn-outline-secondary" @onclick="LoadAsync">刷新</button>
    </div>

    @if (_loading)
    {
        <div class="card oa-analysis-card">
            <div class="card-body oa-analysis-empty">
                <div class="oa-empty-icon">◌</div>
                <strong>正在加载质量历史数据</strong>
                <span>正在读取最近一次成功分析结果，请稍候。</span>
            </div>
        </div>
    }
    else if (_snapshots.Count == 0)
    {
        <div class="card oa-analysis-card">
            <div class="card-body oa-analysis-empty">
                <div class="oa-empty-icon">∅</div>
                <strong>暂无质量历史数据</strong>
                <span>完成至少一次成功分析后，这里会显示标准化质量快照。</span>
            </div>
        </div>
    }
    else
    {
        var latest = _snapshots[0];
        var average = _snapshots.Average(x => x.Metrics.OverallScore);
        var delta = _snapshots.Count >= 2 ? latest.Metrics.OverallScore - _snapshots[1].Metrics.OverallScore : 0;

        <section class="oa-dashboard-section">
            <div class="oa-section-heading">
                <div>
                    <h2>趋势概览</h2>
                    <span>最近一次分析与历史窗口的关键指标</span>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="card oa-analysis-kpi h-100">
                        <div class="card-body">
                            <div class="oa-kpi-label">分析次数</div>
                            <div class="oa-kpi-value">@_snapshots.Count</div>
                            <div class="oa-kpi-meta">最近 100 次质量快照</div>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="card oa-analysis-kpi h-100">
                        <div class="card-body">
                            <div class="oa-kpi-label">最新质量分</div>
                            <div class="oa-kpi-value">@FormatScore(latest.Metrics.OverallScore)</div>
                            <div class="oa-kpi-meta">@latest.SourceName</div>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="card oa-analysis-kpi h-100">
                        <div class="card-body">
                            <div class="oa-kpi-label">平均质量分</div>
                            <div class="oa-kpi-value">@FormatScore(average)</div>
                            <div class="oa-kpi-meta">当前历史窗口平均值</div>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="card oa-analysis-kpi h-100">
                        <div class="card-body">
                            <div class="oa-kpi-label">较上次变化</div>
                            <div class="oa-kpi-value">@(_snapshots.Count >= 2 ? $"{(delta >= 0 ? "+" : "")}{delta:F1}" : "-")</div>
                            <div class="oa-kpi-meta">@(_snapshots.Count >= 2 ? "相邻快照" : "需要更多数据")</div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="oa-dashboard-section">
            <div class="card oa-analysis-card oa-trend-chart-card">
                <div class="card-body">
                    <div class="oa-card-heading">
                        <div>
                            <h2>质量分走势</h2>
                            <span>按时间从早到晚展示最近 30 次快照</span>
                        </div>
                        <span class="oa-count-pill">窗口 @_snapshots.Count 次</span>
                    </div>

                    <div class="oa-trend-chart">
                        @foreach (var snapshot in _snapshots.AsEnumerable().Reverse().Take(30))
                        {
                            <div class="oa-trend-point" title="@snapshot.OccurredAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss") · @snapshot.Metrics.OverallScore.ToString("F1")">
                                <div class="oa-trend-bar-track">
                                    <div class="oa-trend-bar" style="@($"height:{Math.Clamp(snapshot.Metrics.OverallScore, 0, 100):F0}%")"></div>
                                </div>
                                <strong>@snapshot.Metrics.OverallScore.ToString("F0")</strong>
                                <span>@snapshot.OccurredAtUtc.ToLocalTime().ToString("MM-dd")</span>
                            </div>
                        }
                    </div>
                    <div class="oa-trend-axis"><span>较早</span><span>最近</span></div>
                </div>
            </div>
        </section>

        <section class="oa-dashboard-section">
            <div class="card oa-analysis-card">
                <div class="card-body">
                    <div class="oa-card-heading">
                        <div>
                            <h2>质量快照</h2>
                            <span>质量分、问题数与核心质量维度</span>
                        </div>
                        <span class="oa-count-pill">@_snapshots.Count</span>
                    </div>

                    <div class="table-responsive">
                        <table class="table align-middle mb-0 oa-data-table">
                            <thead><tr><th>时间</th><th>数据源</th><th>质量分</th><th>问题数</th><th>对象数</th><th>完整性</th><th>有效性</th><th>唯一性</th></tr></thead>
                            <tbody>
                            @foreach (var snapshot in _snapshots)
                            {
                                <tr>
                                    <td class="text-nowrap">@snapshot.OccurredAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                                    <td>@snapshot.SourceName</td>
                                    <td><span class="badge @ScoreBadge(snapshot.Metrics.OverallScore)">@snapshot.Metrics.OverallScore.ToString("F1")</span></td>
                                    <td>@snapshot.IssueCount</td>
                                    <td>@snapshot.TotalObjects</td>
                                    <td>@snapshot.Metrics.Completeness.ToString("F1")</td>
                                    <td>@snapshot.Metrics.Validity.ToString("F1")</td>
                                    <td>@snapshot.Metrics.Uniqueness.ToString("F1")</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </section>

        <section class="oa-dashboard-section">
            <div class="row g-3">
                <div class="col-12 col-xl-7">
                    <div class="card oa-analysis-card h-100">
                        <div class="card-body">
                            <div class="oa-card-heading">
                                <div>
                                    <h2>最近质量变化</h2>
                                    <span>对比最近两次质量快照</span>
                                </div>
                            </div>

                            @if (_snapshots.Count >= 2)
                            {
                                var previous = _snapshots[1];
                                <div class="oa-trend-summary">
                                    <div class="oa-trend-main">
                                        <span class="oa-trend-label">整体质量分</span>
                                        <strong>@FormatScore(latest.Metrics.OverallScore)</strong>
                                        <span class="oa-trend-delta">@(delta >= 0 ? "+" : "")@delta.ToString("F1")</span>
                                    </div>
                                    <div class="oa-trend-compare">上一快照：@FormatScore(previous.Metrics.OverallScore)</div>
                                </div>
                                <div class="oa-dimension-list">
                                    <div><span>完整性</span><strong>@latest.Metrics.Completeness.ToString("F1")</strong></div>
                                    <div><span>有效性</span><strong>@latest.Metrics.Validity.ToString("F1")</strong></div>
                                    <div><span>唯一性</span><strong>@latest.Metrics.Uniqueness.ToString("F1")</strong></div>
                                </div>
                            }
                            else
                            {
                                <div class="oa-analysis-empty oa-analysis-empty-compact">
                                    <strong>趋势数据不足</strong>
                                    <span>至少需要两次质量快照才能计算相邻变化。</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div class="col-12 col-xl-5">
                    <div class="card oa-analysis-card h-100">
                        <div class="card-body">
                            <div class="oa-card-heading">
                                <div>
                                    <h2>趋势说明</h2>
                                    <span>数据口径</span>
                                </div>
                            </div>
                            <div class="oa-analysis-note oa-analysis-note-inline">
                                <strong>标准化质量快照</strong>
                                <span>走势使用最近 30 次快照，完整表格保留当前 100 次历史窗口，便于结合问题数与质量维度进行对照。</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    }
</div>

@code {
    private bool _loading = true;
    private List<QualitySnapshot> _snapshots = new();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _snapshots = (await QualityHistory.GetSnapshotsAsync(limit: 100)).ToList();
        _loading = false;
    }

    private static string FormatScore(double score) => score.ToString("F1");

    private static string ScoreBadge(double score)
        => score >= 90 ? "bg-success" : score >= 70 ? "bg-warning text-dark" : "bg-danger";
}
