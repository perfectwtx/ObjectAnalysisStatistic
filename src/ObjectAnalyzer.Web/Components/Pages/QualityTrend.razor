@page "/quality/trend"
@using ObjectAnalyzer.Platform
@inject IQualityHistoryQuery QualityHistory

<PageTitle>质量趋势</PageTitle>

<div class="oa-analysis-page oa-quality-trend-page">
    <header class="oa-analysis-header">
        <div class="oa-trend-title">
            <div class="oa-eyebrow">Quality Analysis / Trend</div>
            <div class="oa-trend-title-row">
                <div>
                    <h1>质量趋势</h1>
                    <p>从历史质量快照观察整体质量分与核心质量维度的变化。</p>
                </div>
                <div class="oa-header-actions"><a class="btn btn-outline-secondary" href="/quality">质量总览</a><a class="btn btn-outline-secondary" href="/quality/regression">质量回归</a><a class="btn btn-outline-secondary" href="/issues">问题中心</a><button class="btn btn-outline-secondary oa-trend-refresh" @onclick="LoadAsync">刷新数据</button></div>
            </div>
        </div>
    </header>

    @if (_loading)
    {
        <div class="oa-empty-state oa-trend-state"><div class="oa-empty-icon">◌</div><strong>正在加载质量历史数据</strong><span>正在读取最近一次成功分析结果，请稍候。</span></div>
    }
    else if (_snapshots.Count == 0)
    {
        <div class="oa-empty-state oa-trend-state"><div class="oa-empty-icon">∅</div><strong>暂无质量历史数据</strong><span>完成至少一次成功分析后，这里会显示标准化质量快照。</span></div>
    }
    else
    {
        var latest = _snapshots[0];
        var average = _snapshots.Average(x => x.Metrics.OverallScore);
        var delta = _snapshots.Count >= 2 ? latest.Metrics.OverallScore - _snapshots[1].Metrics.OverallScore : 0;

        <section class="oa-dashboard-section">
            <div class="oa-dashboard-panel oa-trend-filter-card"><div class="oa-panel-body"><div class="oa-trend-filter-grid"><div><label class="form-label">数据源</label><select class="form-select" @onchange="OnSourceChanged"><option value="">全部数据源</option>@foreach (var source in Sources){<option value="@source" selected="@(string.Equals(source, SourceFilter, StringComparison.OrdinalIgnoreCase))">@source</option>}</select></div><div><label class="form-label">历史窗口</label><select class="form-select" @onchange="OnWindowChanged"><option value="30">最近 30 次</option><option value="60">最近 60 次</option><option value="100">最近 100 次</option></select></div></div><div class="oa-trend-filter-hint">当前显示 @FilteredSnapshots.Count 次快照</div></div></div>
            <div class="oa-section-heading"><div><span class="oa-section-kicker">Overview</span><h2>趋势概览</h2><span>当前历史窗口的核心指标</span></div></div>
            <div class="oa-kpi-grid is-4">
                <div class="oa-kpi-card is-info"><div class="oa-kpi-label">分析次数</div><div class="oa-kpi-value">@FilteredSnapshots.Count</div><div class="oa-kpi-meta">最近 100 次质量快照</div></div>
                <div class="oa-kpi-card is-accent"><div class="oa-kpi-label">最新质量分</div><div class="oa-kpi-value">@FormatScore(latest.Metrics.OverallScore)</div><div class="oa-kpi-meta">@latest.SourceName</div></div>
                <div class="oa-kpi-card"><div class="oa-kpi-label">平均质量分</div><div class="oa-kpi-value">@FormatScore(average)</div><div class="oa-kpi-meta">当前历史窗口平均值</div></div>
                <div class="oa-kpi-card @(delta < 0 ? "is-danger" : "is-success")"><div class="oa-kpi-label">较上次变化</div><div class="oa-kpi-value">@(_snapshots.Count >= 2 ? $"{(delta >= 0 ? "+" : "")}{delta:F1}" : "-")</div><div class="oa-kpi-meta">@(_snapshots.Count >= 2 ? "相邻快照" : "需要更多数据")</div></div>
            </div>
        </section>

        <section class="oa-dashboard-section">
            <article class="oa-dashboard-panel oa-trend-chart-panel">
                <div class="oa-panel-header">
                    <div><span class="oa-panel-kicker">History</span><h2>质量分走势</h2><p>按时间从早到晚展示最近 30 次快照</p></div>
                    <span class="oa-badge is-neutral">窗口 @_snapshots.Count 次</span>
                </div>
                <div class="oa-trend-chart">
                    @foreach (var snapshot in _snapshots.AsEnumerable().Reverse().Take(30))
                    {
                        <div class="oa-trend-point" title="@snapshot.OccurredAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss") · @snapshot.Metrics.OverallScore.ToString("F1")">
                            <div class="oa-trend-bar-track"><div class="oa-trend-bar" style="@($"height:{Math.Clamp(snapshot.Metrics.OverallScore, 0, 100):F0}%")"></div></div>
                            <strong>@snapshot.Metrics.OverallScore.ToString("F0")</strong>
                            <span>@snapshot.OccurredAtUtc.ToLocalTime().ToString("MM-dd")</span>
                        </div>
                    }
                </div>
                <div class="oa-trend-axis"><span>较早</span><span>最近</span></div>
            </article>
        </section>

        <section class="oa-dashboard-section">
            <article class="oa-dashboard-panel oa-snapshot-panel">
                <div class="oa-panel-header">
                    <div><span class="oa-panel-kicker">Snapshots</span><h2>质量快照</h2><p>质量分、问题数与核心质量维度</p></div>
                    <span class="oa-badge is-neutral">@FilteredSnapshots.Count 条</span>
                </div>
                <div class="oa-table-wrap">
                    <table class="oa-data-table oa-trend-snapshot-table">
                        <thead><tr><th>时间</th><th>数据源</th><th>质量分</th><th>问题数</th><th>对象数</th><th>完整性</th><th>有效性</th><th>唯一性</th></tr></thead>
                        <tbody>
                        @foreach (var snapshot in FilteredSnapshots)
                        {
                            <tr>
                                <td>@snapshot.OccurredAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td>@snapshot.SourceName</td>
                                <td><span class="oa-badge @ScoreBadge(snapshot.Metrics.OverallScore)">@snapshot.Metrics.OverallScore.ToString("F1")</span></td>
                                <td>@snapshot.IssueCount</td>
                                <td>@snapshot.TotalObjects.ToString("N0")</td>
                                <td>@snapshot.Metrics.Completeness.ToString("F1")</td>
                                <td>@snapshot.Metrics.Validity.ToString("F1")</td>
                                <td>@snapshot.Metrics.Uniqueness.ToString("F1")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </article>
        </section>

        <section class="oa-dashboard-section oa-trend-insight-grid">
            <article class="oa-dashboard-panel">
                <div class="oa-panel-header"><div><span class="oa-panel-kicker">Comparison</span><h2>最近质量变化</h2><p>对比最近两次质量快照</p></div></div>
                @if (_snapshots.Count >= 2)
                {
                    var previous = _snapshots[1];
                    <div class="oa-trend-insight">
                        <div class="oa-trend-score"><span>整体质量分</span><strong>@FormatScore(latest.Metrics.OverallScore)</strong><b class="@(delta < 0 ? "is-down" : "is-up")">@(delta >= 0 ? "+" : "")@delta.ToString("F1")</b></div>
                        <div class="oa-trend-compare">上一快照：@FormatScore(previous.Metrics.OverallScore)</div>
                        <div class="oa-dimension-list">
                            <div><span>完整性</span><strong>@latest.Metrics.Completeness.ToString("F1")</strong></div>
                            <div><span>有效性</span><strong>@latest.Metrics.Validity.ToString("F1")</strong></div>
                            <div><span>唯一性</span><strong>@latest.Metrics.Uniqueness.ToString("F1")</strong></div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="oa-dashboard-note">至少需要两次质量快照才能计算相邻变化。</div>
                }
            </article>

            <article class="oa-dashboard-panel">
                <div class="oa-panel-header"><div><span class="oa-panel-kicker">Method</span><h2>趋势说明</h2><p>数据口径</p></div></div>
                <div class="oa-dashboard-note oa-trend-method"><strong>标准化质量快照</strong><span>走势使用最近 30 次快照，完整表格保留当前 100 次历史窗口，便于结合问题数与质量维度进行对照。</span></div>
            </article>
        </section>
    }
</div>

@code {
    private bool _loading = true;
    private List<QualitySnapshot> _snapshots = new();
    private string? SourceFilter;
    private int WindowSize = 30;

    private IReadOnlyList<string> Sources => _snapshots.Select(x => x.SourceName).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x, StringComparer.OrdinalIgnoreCase).ToList();
    private IReadOnlyList<QualitySnapshot> FilteredSnapshots => _snapshots
        .Where(x => string.IsNullOrWhiteSpace(SourceFilter) || string.Equals(x.SourceName, SourceFilter, StringComparison.OrdinalIgnoreCase))
        .Take(WindowSize)
        .ToList();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _snapshots = (await QualityHistory.GetSnapshotsAsync(limit: 100)).ToList();
        _loading = false;
    }

    private async Task OnSourceChanged(ChangeEventArgs args) { SourceFilter = args.Value?.ToString(); await InvokeAsync(StateHasChanged); }
    private async Task OnWindowChanged(ChangeEventArgs args) { if (int.TryParse(args.Value?.ToString(), out var size)) WindowSize = size; await InvokeAsync(StateHasChanged); }

    private static string FormatScore(double score) => score.ToString("F1");

    private static string ScoreBadge(double score)
        => score >= 90 ? "is-success" : score >= 70 ? "is-warning" : "is-danger";
}

