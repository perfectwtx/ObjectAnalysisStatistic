@page "/quality"
@page "/quality/dashboard"
@using System.Text.Json
@using ObjectAnalyzer.Analysis
@using ObjectAnalyzer.Analysis.Gates
@using Microsoft.AspNetCore.Components
@using ObjectAnalyzer.Platform
@inject IAnalysisHistoryStore HistoryStore
@inject IQualityHistoryQuery QualityHistory
@inject IQualityIssueQuery QualityIssueQuery

<PageTitle>数据质量总览</PageTitle>

<div class="oa-analysis-page oa-quality-dashboard-page">
    <header class="oa-analysis-header">
        <div class="oa-dashboard-title">
            <div class="oa-eyebrow">Data Quality / Overview</div>
            <div class="oa-dashboard-title-row">
                <div>
                    <h1>数据质量总览</h1>
                    <p>把最近一次成功分析拆成质量评分、质量维度、门禁与风险摘要，快速定位需要处理的区域。</p>
                </div>
                <div class="oa-header-actions"><a class="btn btn-outline-secondary" href="@FieldsUrl">字段质量</a><a class="btn btn-outline-secondary" href="@TrendUrl">质量趋势</a><a class="btn btn-outline-secondary" href="@IssuesUrl">问题中心</a><button class="btn btn-outline-secondary oa-dashboard-refresh" @onclick="LoadAsync">刷新数据</button></div>
            </div>
        </div>
    </header>

    @if (_loading)
    {
        <div class="oa-empty-state oa-dashboard-state">
            <div class="oa-empty-icon">◌</div>
            <strong>正在加载质量数据</strong>
            <span>正在读取最近一次成功分析结果，请稍候。</span>
        </div>
    }
    else if (_job is null || _result is null)
    {
        <div class="oa-empty-state oa-dashboard-state">
            <div class="oa-empty-icon">∅</div>
            <strong>暂无可用的成功分析记录</strong>
            <span>请先执行一次数据分析，完成后这里会展示质量总览。</span>
        </div>
    }
    else
    {
        <section class="oa-dashboard-context">
            <div class="oa-context-grid">
                <div><span>当前数据源</span><strong>@_job.SourceName</strong></div>
                <div><span>分析时间</span><strong>@((_job.CompletedAtUtc ?? _job.StartedAtUtc).ToLocalTime().ToString("yyyy-MM-dd HH:mm"))</strong></div>
                <div><span>分析对象</span><strong>@_job.TotalObjects.ToString("N0")</strong></div>
                <div><span>字段</span><strong>@_job.FieldCount.ToString("N0")</strong></div>
            </div>
        </section>

        <section class="oa-dashboard-section oa-dashboard-overview">
            <div class="oa-section-heading">
                <div><span class="oa-section-kicker">Overview</span><h2>质量概览</h2><span>当前分析结果的关键健康信号</span></div>
            </div>
            <div class="oa-kpi-grid is-4">
                <div class="oa-kpi-card is-accent"><div class="oa-kpi-label">质量总分</div><div class="oa-kpi-value">@FormatScore(_job.QualityScore)</div><div class="oa-kpi-meta">@GetScoreText(_job.QualityScore)</div></div>
                <div class="oa-kpi-card @(_job.IssueCount > 0 ? "is-danger" : "is-success")"><div class="oa-kpi-label">质量问题</div><div class="oa-kpi-value">@_job.IssueCount.ToString("N0")</div><div class="oa-kpi-meta">最近一次分析发现</div></div>
                <div class="oa-kpi-card is-info"><div class="oa-kpi-label">分析对象</div><div class="oa-kpi-value">@_job.TotalObjects.ToString("N0")</div><div class="oa-kpi-meta">覆盖 @_job.FieldCount.ToString("N0") 个字段</div></div>
                <div class="oa-kpi-card @(_result.SchemaDiff?.HasBreakingChanges == true ? "is-danger" : "is-success")"><div class="oa-kpi-label">Schema 状态</div><div class="oa-kpi-value oa-kpi-symbol">@GetSchemaStatusIcon()</div><div class="oa-kpi-meta">@GetSchemaStatusText()</div></div>
            </div>
        </section>

        <section class="oa-dashboard-section">
            <div class="oa-section-heading">
                <div><span class="oa-section-kicker">Dimensions</span><h2>质量维度</h2><span>五个维度共同构成当前质量画像</span></div>
            </div>
            <div class="oa-quality-dimension-grid">
                @foreach (var metric in _qualityMetrics)
                {
                    <div class="oa-quality-dimension">
                        <div class="oa-quality-dimension-head"><span>@metric.Name</span><strong>@metric.Value.ToString("F1")</strong></div>
                        <div class="oa-progress-track" aria-label="@metric.Name @metric.Value.ToString("F1")"><div class="oa-progress-value" style="width:@GetProgressWidth(metric.Value)"></div></div>
                        <div class="oa-quality-dimension-foot"><span>质量得分</span><span>@GetMetricState(metric.Value)</span></div>
                    </div>
                }
            </div>
        </section>

        <section class="oa-dashboard-section">
            <article class="oa-dashboard-panel oa-gate-panel">
                <div class="oa-panel-header">
                    <div><span class="oa-panel-kicker">Quality Gate</span><h2>质量门禁</h2><p>本次分析是否触发质量控制规则</p></div>
                    @if (_gateResults.Count == 0) { <span class="oa-badge is-neutral">历史记录未保存门禁结果</span> }
                    else if (_gateResults.Any(x => x.Triggered)) { <span class="oa-badge is-danger">未通过</span> }
                    else { <span class="oa-badge is-success">全部通过</span> }
                </div>
                @if (_gateResults.Count == 0)
                {
                    <div class="oa-dashboard-note">该作业是在质量门禁历史持久化之前产生的，因此无法还原当时的实际门禁配置。重新执行分析后会记录准确结果。</div>
                }
                else
                {
                    <div class="oa-gate-grid">
                        @foreach (var gate in _gateResults)
                        {
                            <div class="oa-gate-card">
                                <div class="oa-gate-heading"><strong>@gate.Name</strong>@if (gate.Triggered) { <span class="oa-badge is-danger">未通过</span> } else { <span class="oa-badge is-success">通过</span> }</div>
                                <div class="oa-gate-meta">ExitCode: @gate.ExitCode</div>
                                @if (gate.Triggered) { <div class="oa-gate-error">@gate.FailureMessage</div> }
                            </div>
                        }
                    </div>
                }
            </article>
        </section>

        <section class="oa-dashboard-section oa-dashboard-main-grid">
            <article class="oa-dashboard-panel oa-trend-panel">
                <div class="oa-panel-header">
                    <div><span class="oa-panel-kicker">History</span><h2>最近质量趋势</h2><p>最近 8 次质量快照</p></div>
                    <a class="btn btn-sm btn-outline-secondary" href="@TrendUrl">查看趋势</a>
                </div>
                @if (_recentSnapshots.Count == 0)
                {
                    <div class="oa-empty-state oa-dashboard-panel-empty"><span>暂无质量趋势快照。</span></div>
                }
                else
                {
                    <div class="oa-trend-list">
                        @foreach (var snapshot in _recentSnapshots.Take(8).Reverse())
                        {
                            <div class="oa-trend-row">
                                <span class="oa-trend-date">@snapshot.OccurredAtUtc.ToLocalTime().ToString("MM-dd")</span>
                                <div class="oa-trend-track"><span style="width:@GetProgressWidth(snapshot.Metrics.OverallScore)"></span></div>
                                <strong>@snapshot.Metrics.OverallScore.ToString("F1")</strong>
                                <span class="oa-trend-issues">@snapshot.IssueCount 问题</span>
                            </div>
                        }
                    </div>
                }
            </article>

            <article class="oa-dashboard-panel oa-issues-panel">
                <div class="oa-panel-header">
                    <div><span class="oa-panel-kicker">Risk</span><h2>Top Issues</h2><p>数量最多的质量问题</p></div>
                    <a class="btn btn-sm btn-outline-secondary" href="@IssuesUrl">问题中心</a>
                </div>
                @if (_topIssues.Count == 0)
                {
                    <div class="oa-empty-state oa-dashboard-panel-empty"><strong>✓ 当前没有质量违规</strong><span>最近一次分析未发现标准化质量问题。</span></div>
                }
                else
                {
                    <div class="oa-issue-list">
                        @foreach (var issue in _topIssues)
                        {
                            <div class="oa-issue-row"><div class="oa-issue-content"><strong>@(string.IsNullOrWhiteSpace(issue.FieldName) ? "数据集" : issue.FieldName)</strong><span>@QualityCheckTypes.Label(issue.Check)</span></div><a class="oa-dashboard-issue-count oa-badge is-danger" href="@IssueUrl(issue)">@issue.Count</a></div>
                        }
                    </div>
                }
            </article>
        </section>

        <section class="oa-dashboard-section oa-dashboard-main-grid">
            <article class="oa-dashboard-panel">
                <div class="oa-panel-header">
                    <div><span class="oa-panel-kicker">Schema</span><h2>Schema 影响</h2><p>最近一次分析检测到的结构变化</p></div>
                    <a class="btn btn-sm btn-outline-secondary" href="@SchemaImpactUrl">查看详情</a>
                </div>
                @if (_result.SchemaDiff is null)
                {
                    <div class="oa-dashboard-note">未产生 Schema Diff。</div>
                }
                else
                {
                    <div class="oa-mini-stats"><div><strong>@_result.SchemaDiff.AddedFields.Count</strong><span>新增字段</span></div><div><strong>@_result.SchemaDiff.ChangedFields.Count</strong><span>变更字段</span></div><div><strong>@_result.SchemaDiff.RemovedFields.Count</strong><span>删除字段</span></div></div>
                }
            </article>

            <article class="oa-dashboard-panel">
                <div class="oa-panel-header">
                    <div><span class="oa-panel-kicker">Relationships</span><h2>字段关系</h2><p>相关性矩阵与强相关字段对</p></div>
                    <a class="btn btn-sm btn-outline-secondary" href="@FieldRelationshipsUrl">字段关系</a><a class="btn btn-sm btn-outline-secondary" href="@ObjectRelationshipsUrl">对象关系</a>
                </div>
                @if (_result.CorrelationMatrix is null)
                {
                    <div class="oa-dashboard-note">未产生字段相关性结果。</div>
                }
                else
                {
                    <div class="oa-mini-stats"><div><strong>@_result.CorrelationMatrix.Fields.Count</strong><span>参与字段</span></div><div><strong>@_result.CorrelationMatrix.Samples.ToString("N0")</strong><span>样本数量</span></div><div><strong>@_result.CorrelationMatrix.StrongPairs.Count</strong><span>强相关</span></div></div>
                }
            </article>
        </section>
    }
</div>

@code {
    private bool _loading = true;
    private AnalysisJob? _job;
    private AnalysisResult? _result;
    private List<QualitySnapshot> _recentSnapshots = new();
    private List<QualityMetric> _qualityMetrics = new();
    private List<QualityIssue> _topIssues = new();
    private List<QualityGateResult> _gateResults = new();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        await HistoryStore.InitializeAsync();
        var recentJobs = (await HistoryStore.GetRecentAsync(100)).Where(x => x.Status == AnalysisJobStatus.Succeeded).OrderByDescending(x => x.CompletedAtUtc ?? x.StartedAtUtc).ToList();
        _job = JobId.HasValue
            ? recentJobs.FirstOrDefault(x => x.Id == JobId.Value && !string.IsNullOrWhiteSpace(x.ResultJson))
            : recentJobs.FirstOrDefault(x => !string.IsNullOrWhiteSpace(x.ResultJson));
        _recentSnapshots = (await QualityHistory.GetSnapshotsAsync(limit: 8)).ToList();
        _topIssues = _job is null ? new List<QualityIssue>() : (await QualityIssueQuery.GetByJobAsync(_job.Id)).OrderByDescending(x => x.Count).ThenBy(x => x.FieldName).Take(5).ToList();
        _result = null; _gateResults.Clear();
        if (_job?.ResultJson is not null)
        {
            try
            {
                _result = JsonSerializer.Deserialize<AnalysisResult>(_job.ResultJson);
                if (!string.IsNullOrWhiteSpace(_job.GateResultsJson))
                {
                    var gates = JsonSerializer.Deserialize<List<QualityGateResult>>(_job.GateResultsJson);
                    if (gates is not null) _gateResults = gates;
                }
            }
            catch (JsonException) { }
        }
        if (_result is not null)
        {
            var metrics = QualityMetricsCalculator.Calculate(_result);
            _qualityMetrics = new() { new("完整性", metrics.Completeness), new("有效性", metrics.Validity), new("唯一性", metrics.Uniqueness), new("一致性", metrics.Consistency), new("异常控制", metrics.AnomalyControl) };
        }
        else { _qualityMetrics.Clear(); _topIssues.Clear(); }
        _loading = false;
    }

    [SupplyParameterFromQuery(Name = "jobId")]
    public Guid? JobId { get; set; }

    private string FieldsUrl => _job is null ? "/quality/fields" : $"/quality/fields?jobId={_job.Id}";
    private string TrendUrl => _job is null ? "/quality/trend" : $"/quality/trend?jobId={_job.Id}";
    private string IssuesUrl => _job is null ? "/issues" : $"/issues?jobId={_job.Id}";
    private string SchemaImpactUrl => _job is null ? "/quality/schema-impact" : $"/quality/schema-impact?jobId={_job.Id}";
    private string FieldRelationshipsUrl => _job is null ? "/quality/relationships" : $"/quality/relationships?jobId={_job.Id}";
    private string ObjectRelationshipsUrl => _job is null ? "/quality/object-relationships" : $"/quality/object-relationships?jobId={_job.Id}";

    private string IssueUrl(QualityIssue issue) => string.IsNullOrWhiteSpace(issue.FieldName)
        ? $"/issues?jobId={issue.JobId}"
        : $"/issues?jobId={issue.JobId}&field={Uri.EscapeDataString(issue.FieldName)}&check={Uri.EscapeDataString(issue.Check)}";

    private string GetSchemaStatusIcon() => _result?.SchemaDiff switch { null => "-", { HasBreakingChanges: true } => "⚠", _ => "✓" };
    private string GetSchemaStatusText() => _result?.SchemaDiff switch { null => "未产生 Schema Diff", { HasBreakingChanges: true } => "存在破坏性变更", _ => "无破坏性变更" };
    private static string GetProgressWidth(double value) => $"{Math.Clamp(value, 0d, 100d):F0}%";
    private static string GetMetricState(double value) => value >= 90 ? "良好" : value >= 70 ? "关注" : "风险";
    private static string FormatScore(double? score) => score.HasValue ? score.Value.ToString("F1") : "-";
    private static string GetScoreText(double? score) => !score.HasValue ? "未计算" : score >= 90 ? "优秀" : score >= 70 ? "需要关注" : "质量风险";
    private static string ScoreBadge(double score) => score >= 90 ? "is-success" : score >= 70 ? "is-warning" : "is-danger";
    private sealed record QualityMetric(string Name, double Value);
}
