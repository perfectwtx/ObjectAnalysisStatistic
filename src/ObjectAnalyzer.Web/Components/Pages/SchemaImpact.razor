@page "/quality/schema-impact"
@using System.Text.Json
@using ObjectAnalyzer.Platform
@using ObjectAnalyzer.Analysis
@inject IAnalysisHistoryStore HistoryStore

<PageTitle>Schema 影响分析</PageTitle>

<div class="oa-analysis-page">
    <div class="oa-analysis-header">
        <div>
            <div class="oa-eyebrow">Quality Analysis</div>
            <h1>Schema 影响分析</h1>
            <p>对比最近一次分析与基线 Schema，快速定位新增、删除及字段变更。</p>
        </div>
        <a class="btn btn-outline-secondary" href="/quality/impact-analysis">影响传播</a>
    </div>

    @if (_loading)
    {
        <div class="alert alert-info">正在加载最近一次分析结果...</div>
    }
    else if (_job is null)
    {
        <div class="card"><div class="oa-empty-state"><strong>暂无成功的分析记录</strong>请先执行一次分析，再返回这里查看 Schema 变化。</div></div>
    }
    else if (_diff is null)
    {
        <div class="card"><div class="oa-empty-state"><strong>暂无 Schema Diff</strong>请先配置基线 Schema 并执行一次分析。</div></div>
    }
    else
    {
        <div class="row g-3 mb-4">
            <div class="col-md-3"><div class="card h-100 oa-analysis-kpi"><div class="card-body"><div class="oa-kpi-label">破坏性变更</div><div class="oa-kpi-value">@(_diff.HasBreakingChanges ? "是" : "否")</div><div class="oa-kpi-meta">需要重点检查下游契约</div></div></div></div>
            <div class="col-md-3"><div class="card h-100 oa-analysis-kpi"><div class="card-body"><div class="oa-kpi-label">新增字段</div><div class="oa-kpi-value">@_diff.AddedFields.Count</div><div class="oa-kpi-meta">基线中不存在</div></div></div></div>
            <div class="col-md-3"><div class="card h-100 oa-analysis-kpi"><div class="card-body"><div class="oa-kpi-label">删除字段</div><div class="oa-kpi-value">@_diff.RemovedFields.Count</div><div class="oa-kpi-meta">当前 Schema 中不存在</div></div></div></div>
            <div class="col-md-3"><div class="card h-100 oa-analysis-kpi"><div class="card-body"><div class="oa-kpi-label">变更字段</div><div class="oa-kpi-value">@_diff.ChangedFields.Count</div><div class="oa-kpi-meta">存在属性变化</div></div></div></div>
        </div>

        <div class="card mb-4">
            <div class="card-header">分析上下文</div>
            <div class="card-body">
                <div class="oa-context-grid">
                    <div><span>数据源</span><strong>@_job.SourceName</strong></div>
                    <div><span>分析时间</span><strong>@_job.StartedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</strong></div>
                    <div><span>基线</span><strong>@(_diff.BaselineSource ?? "未记录")</strong></div>
                    <div><span>当前</span><strong>@(_diff.CurrentSource ?? _job.SourceName)</strong></div>
                </div>
                @if (_diff.HasBreakingChanges)
                {
                    <div class="alert alert-danger mt-3 mb-0">检测到破坏性 Schema 变更。建议重点检查下游接口、数据库映射和数据契约。</div>
                }
                else
                {
                    <div class="alert alert-success mt-3 mb-0">未检测到破坏性 Schema 变更。</div>
                }
            </div>
        </div>

        @if (_diff.RemovedFields.Count > 0)
        {
            <div class="card mb-4"><div class="card-header"><div class="oa-card-title-row"><span>删除字段</span><span class="oa-count-pill">@_diff.RemovedFields.Count</span></div></div><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>字段</th><th>类型</th><th>影响</th></tr></thead><tbody>@foreach (var field in _diff.RemovedFields){<tr><td>@field.Path</td><td>@GetTypeName(field)</td><td><span class="badge bg-danger">破坏性</span></td></tr>}</tbody></table></div></div>
        }

        @if (_diff.AddedFields.Count > 0)
        {
            <div class="card mb-4"><div class="card-header"><div class="oa-card-title-row"><span>新增字段</span><span class="oa-count-pill">@_diff.AddedFields.Count</span></div></div><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>字段</th><th>类型</th><th>影响</th></tr></thead><tbody>@foreach (var field in _diff.AddedFields){<tr><td>@field.Path</td><td>@GetTypeName(field)</td><td><span class="badge bg-success">非破坏性</span></td></tr>}</tbody></table></div></div>
        }

        @if (_diff.ChangedFields.Count > 0)
        {
            <div class="card mb-4"><div class="card-header"><div class="oa-card-title-row"><span>字段变更</span><span class="oa-count-pill">@_diff.ChangedFields.Count</span></div></div><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>字段</th><th>级别</th><th>变更项</th></tr></thead><tbody>
            @foreach (var change in _diff.ChangedFields)
            {
                <tr><td>@change.Path</td><td><span class="badge @(change.Breaking ? "bg-danger" : "bg-secondary")">@(change.Breaking ? "破坏性" : "普通")</span></td><td>@if (change.Changes.Count == 0){<span class="text-muted">无详细变更</span>}else{<ul class="mb-0 ps-3">@foreach (var item in change.Changes){<li>@item.Property：@item.Description</li>}</ul>}</td></tr>
            }
            </tbody></table></div></div>
        }

        @if (_diff.AddedFields.Count == 0 && _diff.RemovedFields.Count == 0 && _diff.ChangedFields.Count == 0)
        {
            <div class="card"><div class="oa-empty-state"><strong>Schema 与基线完全一致</strong>本次分析没有发现字段层面的 Schema 变化。</div></div>
        }
    }
</div>

@code {
    private bool _loading = true;
    private AnalysisJob? _job;
    private SchemaDiff? _diff;

    protected override async Task OnInitializedAsync()
    {
        await HistoryStore.InitializeAsync();
        var jobs = await HistoryStore.GetRecentAsync(100);
        _job = jobs.Where(x => x.Status == AnalysisJobStatus.Succeeded && !string.IsNullOrWhiteSpace(x.ResultJson)).OrderByDescending(x => x.StartedAtUtc).FirstOrDefault();

        if (_job is not null)
        {
            try
            {
                var result = JsonSerializer.Deserialize<AnalysisResult>(_job.ResultJson!);
                _diff = result?.SchemaDiff;
            }
            catch (JsonException)
            {
                _diff = null;
            }
        }

        _loading = false;
    }

    private static string GetTypeName(SchemaSnapshotField field)
        => string.IsNullOrWhiteSpace(field.PrimaryType) ? "-" : field.PrimaryType;
}
