@page "/quality/schema-impact"
@using System.Text.Json
@using ObjectAnalyzer.Platform
@using ObjectAnalyzer.Analysis
@inject IAnalysisHistoryStore HistoryStore

<PageTitle>Schema 影响分析</PageTitle>

<h1 class="mb-4">Schema 影响分析</h1>

@if (_loading)
{
    <div class="alert alert-info">正在加载最近一次分析结果...</div>
}
else if (_job is null)
{
    <div class="alert alert-secondary">暂无成功的分析记录。</div>
}
else if (_diff is null)
{
    <div class="alert alert-secondary">最近一次分析没有 Schema Diff。请先配置基线 Schema 并执行一次分析。</div>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-md-3"><div class="card h-100"><div class="card-body"><div class="text-muted">破坏性变更</div><div class="display-6">@(_diff.HasBreakingChanges ? "是" : "否")</div></div></div></div>
        <div class="col-md-3"><div class="card h-100"><div class="card-body"><div class="text-muted">新增字段</div><div class="display-6">@_diff.AddedFields.Count</div></div></div></div>
        <div class="col-md-3"><div class="card h-100"><div class="card-body"><div class="text-muted">删除字段</div><div class="display-6">@_diff.RemovedFields.Count</div></div></div></div>
        <div class="col-md-3"><div class="card h-100"><div class="card-body"><div class="text-muted">变更字段</div><div class="display-6">@_diff.ChangedFields.Count</div></div></div></div>
    </div>

    <div class="card mb-4">
        <div class="card-header">影响摘要</div>
        <div class="card-body">
            <div><strong>数据源：</strong>@_job.SourceName</div>
            <div><strong>分析时间：</strong>@_job.StartedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</div>
            <div><strong>基线：</strong>@(_diff.BaselineSource ?? "未记录")</div>
            <div><strong>当前：</strong>@(_diff.CurrentSource ?? _job.SourceName)</div>
            @if (_diff.HasBreakingChanges)
            {
                <div class="alert alert-danger mt-3 mb-0">检测到破坏性 Schema 变更。下游接口、数据库映射和数据契约需要重点检查。</div>
            }
            else
            {
                <div class="alert alert-success mt-3 mb-0">未检测到破坏性 Schema 变更。</div>
            }
        </div>
    </div>

    @if (_diff.RemovedFields.Count > 0)
    {
        <div class="card mb-4"><div class="card-header">删除字段 <span class="badge bg-danger">@_diff.RemovedFields.Count</span></div><div class="card-body p-0"><div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>字段</th><th>类型</th><th>影响</th></tr></thead><tbody>@foreach (var field in _diff.RemovedFields){<tr><td>@field.Path</td><td>@GetTypeName(field)</td><td><span class="badge bg-danger">破坏性</span></td></tr>}</tbody></table></div></div></div>
    }

    @if (_diff.AddedFields.Count > 0)
    {
        <div class="card mb-4"><div class="card-header">新增字段 <span class="badge bg-success">@_diff.AddedFields.Count</span></div><div class="card-body p-0"><div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>字段</th><th>类型</th><th>影响</th></tr></thead><tbody>@foreach (var field in _diff.AddedFields){<tr><td>@field.Path</td><td>@GetTypeName(field)</td><td><span class="badge bg-success">非破坏性</span></td></tr>}</tbody></table></div></div></div>
    }

    @if (_diff.ChangedFields.Count > 0)
    {
        <div class="card mb-4"><div class="card-header">字段变更 <span class="badge bg-warning text-dark">@_diff.ChangedFields.Count</span></div><div class="card-body p-0"><div class="table-responsive"><table class="table table-sm align-middle mb-0"><thead><tr><th>字段</th><th>级别</th><th>变更项</th></tr></thead><tbody>
        @foreach (var change in _diff.ChangedFields)
        {
            <tr><td>@change.Path</td><td><span class="badge @(change.Breaking ? "bg-danger" : "bg-secondary")">@(change.Breaking ? "破坏性" : "普通")</span></td><td>@if (change.Changes.Count == 0){<span class="text-muted">无详细变更</span>}else{<ul class="mb-0 ps-3">@foreach (var item in change.Changes){<li>@item.Property：@item.Description</li>}</ul>}</td></tr>
        }
        </tbody></table></div></div></div>
    }

    @if (_diff.AddedFields.Count == 0 && _diff.RemovedFields.Count == 0 && _diff.ChangedFields.Count == 0)
    {
        <div class="alert alert-success">Schema 与基线完全一致。</div>
    }
}

@code {
    private bool _loading = true;
    private AnalysisJob? _job;
    private SchemaDiff? _diff;

    protected override async Task OnInitializedAsync()
    {
        await HistoryStore.InitializeAsync();
        var jobs = await HistoryStore.GetRecentAsync(100);
        _job = jobs.Where(x => x.Status == AnalysisJobStatus.Succeeded && !string.IsNullOrWhiteSpace(x.ResultJson)).OrderByDescending(x => x.StartedAtUtc).FirstOrDefault();

        if (_job is not null)
        {
            try
            {
                var result = JsonSerializer.Deserialize<AnalysisResult>(_job.ResultJson!);
                _diff = result?.SchemaDiff;
            }
            catch (JsonException)
            {
                _diff = null;
            }
        }

        _loading = false;
    }

    private static string GetTypeName(SchemaSnapshotField field)
        => string.IsNullOrWhiteSpace(field.PrimaryType) ? "-" : field.PrimaryType;
}
