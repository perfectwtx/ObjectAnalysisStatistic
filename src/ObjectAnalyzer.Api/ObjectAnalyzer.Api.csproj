<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ObjectAnalyzer.Api</RootNamespace>
    <Description>ObjectAnalyzer Mini API — 为 React 前端提供 HTTP 分析接口。</Description>
    <!-- 生成 XML 文档注释供 OpenAPI 读取参数/端点描述 -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ObjectAnalyzer.Core\ObjectAnalyzer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- OpenAPI 文档生成 + Scalar 文档界面 -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.*" />
    <!-- 覆盖 Microsoft.AspNetCore.OpenApi 传递引用的 2.0.0（存在已知高危漏洞 NU1903） -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.*" />
  </ItemGroup>

</Project>
