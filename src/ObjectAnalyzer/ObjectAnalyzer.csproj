<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ObjectAnalyzer</AssemblyName>
    <RootNamespace>ObjectAnalyzer</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>ObjectAnalyzer Contributors</Authors>
    <Description>ObjectAnalyzer CLI for object analysis and data quality assessment across structured and semi-structured data.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>objectanalyzer</ToolCommandName>
    <PackageId>ObjectAnalyzer.Tool</PackageId>
    <PackageOutputPath>../../artifacts/packages</PackageOutputPath>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>object-analysis;data-quality;json;jsonl;csv;excel;xml;yaml;statistics;schema</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ObjectAnalyzer.Core\ObjectAnalyzer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
  </ItemGroup>

</Project>
