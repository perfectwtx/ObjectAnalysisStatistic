<Window x:Class="ObjectAnalyzer.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Object Analyzer"
        Width="1100"
        Height="720"
        MinWidth="900"
        MinHeight="600"
        Background="#F5F7FA"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,22">
            <StackPanel>
                <TextBlock Text="Object Analyzer" FontSize="30" FontWeight="SemiBold" Foreground="#182230"/>
                <TextBlock Text="本地对象分析与数据质量检查" FontSize="14" Foreground="#667085" Margin="0,5,0,0"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="White" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="分析文件" FontWeight="SemiBold" Foreground="#344054"/>
                    <TextBox x:Name="InputPathTextBox" Margin="0,8,12,0" Height="36" FontSize="14" VerticalContentAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1" Content="选择文件" Click="SelectFile_Click" VerticalAlignment="Bottom" Height="36"/>
                <Button Grid.Column="2" x:Name="AnalyzeButton" Content="开始分析" Click="Analyze_Click" VerticalAlignment="Bottom" Height="36" Background="#2563EB" Foreground="White"/>
            </Grid>
        </Border>

        <TabControl Grid.Row="2">
            <TabItem Header="概览">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <UniformGrid Columns="4" Margin="0,0,0,14">
                        <Border Background="White" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="对象数" Foreground="#667085"/><TextBlock x:Name="TotalObjectsText" Text="-" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border>
                        <Border Background="White" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="字段数" Foreground="#667085"/><TextBlock x:Name="FieldCountText" Text="-" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border>
                        <Border Background="White" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="重复组" Foreground="#667085"/><TextBlock x:Name="DuplicateGroupsText" Text="-" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border>
                        <Border Background="White" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="8" Padding="14"><StackPanel><TextBlock Text="质量问题" Foreground="#667085"/><TextBlock x:Name="QualityIssuesText" Text="-" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border>
                    </UniformGrid>
                    <Border Grid.Row="1" Background="White" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="10" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock Text="字段概览" FontSize="17" FontWeight="SemiBold" Foreground="#182230" Margin="0,0,0,10"/>
                            <DataGrid Grid.Row="1" x:Name="FieldGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False" GridLinesVisibility="Horizontal">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="字段" Binding="{Binding FieldName}" Width="2*"/>
                                    <DataGridTextColumn Header="类型" Binding="{Binding PrimaryType}" Width="*"/>
                                    <DataGridTextColumn Header="覆盖率" Binding="{Binding CoverageText}" Width="*"/>
                                    <DataGridTextColumn Header="非空" Binding="{Binding Count}" Width="*"/>
                                    <DataGridTextColumn Header="空值" Binding="{Binding NullCount}" Width="*"/>
                                    <DataGridTextColumn Header="唯一值" Binding="{Binding DistinctCount}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="分析输出">
                <Border Margin="0,12,0,0" Background="White" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="10" Padding="18">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="分析输出" FontSize="17" FontWeight="SemiBold" Foreground="#182230"/>
                        <ProgressBar Grid.Row="1" x:Name="AnalysisProgress" Height="8" Margin="0,14,0,14" Minimum="0" Maximum="100"/>
                        <TextBox Grid.Row="2" x:Name="OutputTextBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" BorderThickness="0" Background="#0F172A" Foreground="#E2E8F0" FontFamily="Cascadia Mono" FontSize="13" Padding="12"/>
                    </Grid>
                </Border>
            </TabItem>
            <TabItem Header="质量问题">
                <Border Margin="0,12,0,0" Background="White" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="10" Padding="18">
                    <StackPanel><TextBlock Text="质量问题" FontSize="17" FontWeight="SemiBold" Foreground="#182230"/>
                        <TextBlock Text="当前本地模式直接读取分析结果中的质量违规。" Foreground="#667085" Margin="0,8,0,12"/>
                        <ListView x:Name="IssueList" Height="300"><ListView.View><GridView>
                            <GridViewColumn Header="字段" DisplayMemberBinding="{Binding FieldName}" Width="220"/>
                            <GridViewColumn Header="规则" DisplayMemberBinding="{Binding Check}" Width="150"/>
                            <GridViewColumn Header="次数" DisplayMemberBinding="{Binding Count}" Width="100"/>
                            <GridViewColumn Header="说明" DisplayMemberBinding="{Binding Message}" Width="500"/>
                        </GridView></ListView.View></ListView>
                    </StackPanel>
                </Border>
            </TabItem>
            <TabItem Header="任务与报告">
                <Border Margin="0,12,0,0" Background="White" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="10" Padding="18">
                    <StackPanel><TextBlock Text="当前任务" FontSize="17" FontWeight="SemiBold" Foreground="#182230"/>
                        <TextBlock x:Name="StatusTextBlock" Text="等待选择文件" Foreground="#667085" Margin="0,8,0,18"/>
                        <TextBlock Text="报告文件" FontWeight="SemiBold" Foreground="#344054"/>
                        <TextBlock x:Name="ReportPathTextBlock" Text="分析完成后自动生成 JSON 报告" TextWrapping="Wrap" Foreground="#667085" Margin="0,6,0,18"/>
                        <Button x:Name="OpenReportButton" Content="打开报告目录" Click="OpenReport_Click" IsEnabled="False"/>
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>
        <TextBlock Grid.Row="3" x:Name="FooterTextBlock"
                   Text="Object Analyzer Desktop · .NET 10 · WPF"
                   Foreground="#98A2B3"
                   Margin="2,14,0,0"/>
    </Grid>
</Window>
