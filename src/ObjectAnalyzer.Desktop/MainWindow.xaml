<Window x:Class="ObjectAnalyzer.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Object Analyzer" Width="1180" Height="760" MinWidth="980" MinHeight="620"
        Background="#F5F7FA" WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Object Analyzer" FontSize="30" FontWeight="SemiBold" Foreground="#182230"/>
            <TextBlock Text="本地对象分析与数据质量工作台" FontSize="14" Foreground="#667085" Margin="0,5,0,0"/>
        </StackPanel>
        <Border Grid.Row="1" Background="White" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0"><TextBlock Text="分析文件" FontWeight="SemiBold" Foreground="#344054"/>
                    <TextBox x:Name="InputPathTextBox" Margin="0,7,12,0" Height="36" FontSize="14" VerticalContentAlignment="Center"/></StackPanel>
                <Button Grid.Column="1" Content="选择文件" Click="SelectFile_Click" VerticalAlignment="Bottom" Height="36"/>
                <Button Grid.Column="2" x:Name="AnalyzeButton" Content="开始分析" Click="Analyze_Click" VerticalAlignment="Bottom" Height="36" Background="#2563EB" Foreground="White"/>
            </Grid>
        </Border>
        <TabControl Grid.Row="2">
            <TabItem Header="概览">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <UniformGrid Columns="4" Margin="0,0,0,12">
                        <Border Background="White" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="对象数" Foreground="#667085"/><TextBlock x:Name="TotalObjectsText" Text="-" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border>
                        <Border Background="White" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="字段数" Foreground="#667085"/><TextBlock x:Name="FieldCountText" Text="-" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border>
                        <Border Background="White" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="重复组" Foreground="#667085"/><TextBlock x:Name="DuplicateGroupsText" Text="-" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border>
                        <Border Background="White" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="8" Padding="14"><StackPanel><TextBlock Text="质量问题" Foreground="#667085"/><TextBlock x:Name="QualityIssuesText" Text="-" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border>
                    </UniformGrid>
                    <Border Grid.Row="1" Background="White" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="10" Padding="12">
                        <DataGrid x:Name="FieldGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="字段" Binding="{Binding FieldName}" Width="2*"/><DataGridTextColumn Header="类型" Binding="{Binding PrimaryType}" Width="*"/>
                                <DataGridTextColumn Header="覆盖率" Binding="{Binding CoverageText}" Width="*"/><DataGridTextColumn Header="非空" Binding="{Binding Count}" Width="*"/>
                                <DataGridTextColumn Header="空值" Binding="{Binding NullCount}" Width="*"/><DataGridTextColumn Header="唯一值" Binding="{Binding DistinctCount}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Schema">
                <Border Margin="0,10,0,0" Background="White" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="10" Padding="16">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel><TextBlock Text="Schema / 字段结构" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="查看字段类型、覆盖率与 Schema 演进结果。" Foreground="#667085" Margin="0,6,0,12"/></StackPanel>
                        <DataGrid Grid.Row="1" x:Name="SchemaGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                            <DataGrid.Columns><DataGridTextColumn Header="字段" Binding="{Binding FieldName}" Width="2*"/><DataGridTextColumn Header="类型" Binding="{Binding PrimaryType}" Width="*"/>
                            <DataGridTextColumn Header="覆盖率" Binding="{Binding CoverageText}" Width="*"/><DataGridTextColumn Header="非空" Binding="{Binding Count}" Width="*"/><DataGridTextColumn Header="空值" Binding="{Binding NullCount}" Width="*"/></DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>
            <TabItem Header="重复分析">
                <Border Margin="0,10,0,0" Background="White" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="10" Padding="16">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel><TextBlock Text="重复分析" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="DuplicateSummaryText" Text="暂无重复对象结果。" Foreground="#667085" Margin="0,6,0,12"/></StackPanel>
                        <DataGrid Grid.Row="1" x:Name="DuplicateGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                            <DataGrid.Columns><DataGridTextColumn Header="对象哈希" Binding="{Binding Key}" Width="2*"/><DataGridTextColumn Header="重复次数" Binding="{Binding Count}" Width="*"/></DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>
            <TabItem Header="深度分析">
                <Grid Margin="0,10,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,10">
                        <Button Content="相关性" Click="ShowCorrelation_Click"/><Button Content="模糊去重" Click="ShowFuzzy_Click"/><Button Content="字符串模式" Click="ShowPatterns_Click"/>
                        <Button Content="Unicode" Click="ShowUnicode_Click"/><Button Content="时间序列" Click="ShowTimeSeries_Click"/><Button Content="分布漂移" Click="ShowDistribution_Click"/>
                        <Button Content="采样置信度" Click="ShowSampling_Click"/>
                    </WrapPanel>
                    <TextBox Grid.Row="1" x:Name="DeepAnalysisTextBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             Background="White" BorderBrush="#D0D5DD" Padding="14" FontFamily="Cascadia Mono"/>
                </Grid>
            </TabItem>
            <TabItem Header="质量问题">
                <Border Margin="0,10,0,0" Background="White" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="10" Padding="16">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="问题中心" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <ListView Grid.Row="1" x:Name="IssueList"><ListView.View><GridView>
                            <GridViewColumn Header="字段" DisplayMemberBinding="{Binding FieldName}" Width="220"/><GridViewColumn Header="规则" DisplayMemberBinding="{Binding Check}" Width="150"/>
                            <GridViewColumn Header="次数" DisplayMemberBinding="{Binding Count}" Width="90"/><GridViewColumn Header="说明" DisplayMemberBinding="{Binding Message}" Width="560"/>
                        </GridView></ListView.View></ListView>
                    </Grid>
                </Border>
            </TabItem>
            <TabItem Header="血缘 / 影响 / 回归">
                <Grid Margin="0,10,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,10">
                        <Button Content="数据血缘" Click="ShowLineage_Click"/><Button Content="影响分析" Click="ShowImpact_Click"/><Button Content="Schema Impact" Click="ShowSchemaImpact_Click"/><Button Content="回归分析" Click="ShowRegression_Click"/>
                    </WrapPanel>
                    <TextBox Grid.Row="1" x:Name="InsightTextBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="White" BorderBrush="#D0D5DD" Padding="14" FontFamily="Cascadia Mono"/>
                </Grid>
            </TabItem>
            <TabItem Header="任务与报告">
                <Grid Margin="0,10,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="作业与报告" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock x:Name="StatusTextBlock" Text="等待选择文件" Foreground="#667085" Margin="0,6,0,8"/>
                        <TextBlock Text="当前报告" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ReportPathTextBlock" Text="分析完成后自动生成 JSON 报告" TextWrapping="Wrap" Foreground="#667085" Margin="0,5,0,10"/>
                        <WrapPanel><Button x:Name="OpenReportButton" Content="打开报告目录" Click="OpenReport_Click" IsEnabled="False"/><Button Content="刷新历史报告" Click="RefreshReports_Click"/><Button Content="导出字段 CSV" Click="ExportCsv_Click" IsEnabled="False" x:Name="ExportCsvButton"/></WrapPanel>
                    </StackPanel>
                    <ListView Grid.Row="1" x:Name="ReportHistoryList" Margin="0,12,0,0" MouseDoubleClick="ReportHistory_DoubleClick">
                        <ListView.View><GridView><GridViewColumn Header="报告" DisplayMemberBinding="{Binding Name}" Width="420"/><GridViewColumn Header="时间" DisplayMemberBinding="{Binding TimeText}" Width="180"/><GridViewColumn Header="大小" DisplayMemberBinding="{Binding SizeText}" Width="100"/></GridView></ListView.View>
                    </ListView>
                </Grid>
            </TabItem>
            <TabItem Header="分析输出">
                <Border Margin="0,10,0,0" Background="White" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="10" Padding="16">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="分析输出" FontSize="17" FontWeight="SemiBold"/><ProgressBar Grid.Row="1" x:Name="AnalysisProgress" Height="8" Margin="0,12,0,12" Minimum="0" Maximum="100"/>
                        <TextBox Grid.Row="2" x:Name="OutputTextBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#0F172A" Foreground="#E2E8F0" FontFamily="Cascadia Mono" Padding="12"/>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>
        <TextBlock Grid.Row="3" x:Name="FooterTextBlock" Text="Object Analyzer Desktop · .NET 10 · WPF" Foreground="#98A2B3" Margin="2,12,0,0"/>
    </Grid>
</Window>