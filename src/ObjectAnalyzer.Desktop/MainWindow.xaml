<ui:FluentWindow x:Class="ObjectAnalyzer.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{DynamicResource Str.AppTitle}"
        Width="1360" Height="860"
        MinWidth="1100" MinHeight="700"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Bg}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="AppTitleBar"
                     Grid.Row="0"
                     Title="{DynamicResource Str.AppTitle}"
                     ShowMaximize="True"
                     ShowMinimize="True"/>

        <Grid Grid.Row="1" Margin="16,8,16,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Margin="0,0,12,0">
                <StackPanel Margin="8,12,8,10">
                    <TextBlock Text="MENU"
                               Style="{StaticResource HudBadge}"
                               Margin="12,0,0,6"/>
                    <ui:NavigationView x:Name="RootNavigation"
                                       PaneDisplayMode="Left"
                                       OpenPaneLength="220"
                                       IsPaneOpen="True"
                                       IsBackButtonVisible="Collapsed"
                                       IsPaneToggleVisible="False"
                                       Background="Transparent">
                        <ui:NavigationView.MenuItems>
                            <ui:NavigationViewItemHeader Text="{DynamicResource Str.Nav.Workbench}"/>
                            <ui:NavigationViewItem x:Name="NavAnalyze" Content="{DynamicResource Str.StartAnalysis}" Tag="analyze">
                                <ui:NavigationViewItem.Icon>
                                    <ui:SymbolIcon Symbol="Play24"/>
                                </ui:NavigationViewItem.Icon>
                            </ui:NavigationViewItem>

                            <ui:NavigationViewItemHeader Text="{DynamicResource Str.Group.Analysis}"/>
                            <ui:NavigationViewItem Content="{DynamicResource Str.Tab.Overview}" Tag="overview">
                                <ui:NavigationViewItem.Icon>
                                    <ui:SymbolIcon Symbol="DataHistogram24"/>
                                </ui:NavigationViewItem.Icon>
                            </ui:NavigationViewItem>
                            <ui:NavigationViewItem Content="{DynamicResource Str.Tab.Schema}" Tag="schema">
                                <ui:NavigationViewItem.Icon>
                                    <ui:SymbolIcon Symbol="Table24"/>
                                </ui:NavigationViewItem.Icon>
                            </ui:NavigationViewItem>
                            <ui:NavigationViewItem Content="{DynamicResource Str.Tab.Duplicates}" Tag="duplicates">
                                <ui:NavigationViewItem.Icon>
                                    <ui:SymbolIcon Symbol="Copy24"/>
                                </ui:NavigationViewItem.Icon>
                            </ui:NavigationViewItem>
                            <ui:NavigationViewItem Content="{DynamicResource Str.Tab.DeepAnalysis}" Tag="deep">
                                <ui:NavigationViewItem.Icon>
                                    <ui:SymbolIcon Symbol="Search24"/>
                                </ui:NavigationViewItem.Icon>
                            </ui:NavigationViewItem>
                            <ui:NavigationViewItem Content="{DynamicResource Str.Tab.Insights}" Tag="insights">
                                <ui:NavigationViewItem.Icon>
                                    <ui:SymbolIcon Symbol="BranchFork24"/>
                                </ui:NavigationViewItem.Icon>
                            </ui:NavigationViewItem>
                            <ui:NavigationViewItem Content="{DynamicResource Str.Tab.Output}" Tag="output">
                                <ui:NavigationViewItem.Icon>
                                    <ui:SymbolIcon Symbol="Code24"/>
                                </ui:NavigationViewItem.Icon>
                            </ui:NavigationViewItem>

                            <ui:NavigationViewItemHeader Text="{DynamicResource Str.Group.Quality}"/>
                            <ui:NavigationViewItem Content="{DynamicResource Str.Tab.Issues}" Tag="issues">
                                <ui:NavigationViewItem.Icon>
                                    <ui:SymbolIcon Symbol="Warning24"/>
                                </ui:NavigationViewItem.Icon>
                            </ui:NavigationViewItem>
                            <ui:NavigationViewItem Content="{DynamicResource Str.Tab.QualityBaseline}" Tag="quality">
                                <ui:NavigationViewItem.Icon>
                                    <ui:SymbolIcon Symbol="HeartPulse24"/>
                                </ui:NavigationViewItem.Icon>
                            </ui:NavigationViewItem>

                            <ui:NavigationViewItemHeader Text="{DynamicResource Str.Group.History}"/>
                            <ui:NavigationViewItem Content="{DynamicResource Str.Tab.Jobs}" Tag="jobs">
                                <ui:NavigationViewItem.Icon>
                                    <ui:SymbolIcon Symbol="History24"/>
                                </ui:NavigationViewItem.Icon>
                            </ui:NavigationViewItem>
                            <ui:NavigationViewItem Content="{DynamicResource Str.Tab.Reports}" Tag="reports">
                                <ui:NavigationViewItem.Icon>
                                    <ui:SymbolIcon Symbol="Document24"/>
                                </ui:NavigationViewItem.Icon>
                            </ui:NavigationViewItem>
                            <ui:NavigationViewItem Content="{DynamicResource Str.Tab.Workspace}" Tag="workspace">
                                <ui:NavigationViewItem.Icon>
                                    <ui:SymbolIcon Symbol="Folder24"/>
                                </ui:NavigationViewItem.Icon>
                            </ui:NavigationViewItem>
                        </ui:NavigationView.MenuItems>
                    </ui:NavigationView>
                </StackPanel>
            </Border>

            <ContentControl x:Name="PageHost"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"/>
        </Grid>
    </Grid>
</ui:FluentWindow>
