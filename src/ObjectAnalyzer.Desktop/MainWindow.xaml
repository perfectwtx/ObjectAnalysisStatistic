<Window x:Class="ObjectAnalyzer.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ObjectAnalyzer.Desktop.Views"
        Title="Object Analyzer"
        Width="1360" Height="860"
        MinWidth="1100" MinHeight="700"
        Background="{DynamicResource Brush.Bg}"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="28,24,28,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <Button x:Name="ThemeToggleButton"
                    DockPanel.Dock="Right"
                    Content="深色模式"
                    Click="ThemeToggle_Click"
                    VerticalAlignment="Center"
                    MinWidth="96"
                    Margin="0"
                    ToolTip="切换到深色主题"/>
            <StackPanel>
                <TextBlock Text="Object Analyzer" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="本地对象分析与数据质量工作台" Style="{StaticResource PageSubtitle}"/>
            </StackPanel>
        </DockPanel>

        <!-- Input bar -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="分析文件" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="InputPathTextBox"
                             Text="{Binding InputPath, UpdateSourceTrigger=PropertyChanged}"
                             Height="36"
                             FontSize="13"
                             VerticalContentAlignment="Center"
                             AllowDrop="True"
                             DragOver="InputPathTextBox_DragOver"
                             Drop="InputPathTextBox_Drop"
                             ToolTip="支持 JSON / JSONL / CSV / Excel / XML / YAML 及压缩文件，可直接拖入"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="最近文件"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Margin="0,0,10,0"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding RecentFiles}"
                                  SelectionChanged="RecentFiles_SelectionChanged"
                                  MaxDropDownHeight="240"
                                  ToolTip="选择最近分析过的文件（最多 10 条）"/>
                    </Grid>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="选择文件"
                        Click="SelectFile_Click"
                        VerticalAlignment="Bottom"
                        Height="36"
                        Margin="0,0,8,0"/>
                <Button Grid.Column="2"
                        x:Name="AnalyzeButton"
                        Content="开始分析"
                        Style="{StaticResource PrimaryButton}"
                        Click="Analyze_Click"
                        VerticalAlignment="Bottom"
                        Height="36"
                        Margin="0,0,8,0"/>
                <Button Grid.Column="3"
                        x:Name="CancelButton"
                        Content="取消分析"
                        Style="{StaticResource DangerButton}"
                        Click="CancelAnalysis_Click"
                        VerticalAlignment="Bottom"
                        Height="36"
                        Margin="0"
                        IsEnabled="False"/>
            </Grid>
        </Border>

        <!-- Status bar -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,24,0" MinWidth="160">
                    <TextBlock Text="当前任务" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="{Binding Status}"
                               Foreground="{DynamicResource Brush.TextSecondary}"
                               FontSize="13"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}"/>
                    <TextBlock Text="{Binding ReportPath}"
                               Foreground="{DynamicResource Brush.TextMuted}"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,6,0,0"/>
                </StackPanel>

                <Button Grid.Column="2"
                        Content="打开报告"
                        Click="OpenReport_Click"
                        IsEnabled="{Binding HasReport}"
                        Height="34"
                        Padding="16,0"
                        Margin="20,0,0,0"/>
            </Grid>
        </Border>

        <!-- Grouped tabs: 分析 / 质量 / 历史 -->
        <TabControl Grid.Row="3" Style="{StaticResource GroupTabControl}">
            <TabItem Header="分析" Style="{StaticResource GroupTabItem}">
                <TabControl>
                    <TabItem Header="概览"><views:OverviewView/></TabItem>
                    <TabItem Header="Schema"><views:SchemaView/></TabItem>
                    <TabItem Header="重复分析"><views:DuplicateView/></TabItem>
                    <TabItem Header="深度分析"><views:DeepAnalysisView/></TabItem>
                    <TabItem Header="血缘 / 影响 / 回归">
                        <views:InsightsView x:Name="InsightsViewControl"/>
                    </TabItem>
                    <TabItem Header="分析输出"><views:OutputView/></TabItem>
                </TabControl>
            </TabItem>

            <TabItem Header="质量" Style="{StaticResource GroupTabItem}">
                <TabControl>
                    <TabItem Header="质量问题"><views:QualityIssuesView/></TabItem>
                    <TabItem Header="质量基线与趋势">
                        <views:QualityView x:Name="QualityViewControl"/>
                    </TabItem>
                </TabControl>
            </TabItem>

            <TabItem Header="历史" Style="{StaticResource GroupTabItem}">
                <TabControl>
                    <TabItem Header="作业中心"><views:JobsView x:Name="JobsViewControl"/></TabItem>
                    <TabItem Header="报告"><views:ReportsView x:Name="ReportsViewControl"/></TabItem>
                    <TabItem Header="工作区"><views:WorkspaceView/></TabItem>
                </TabControl>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="4"
                   Text="本地分析 · Object Analyzer Desktop"
                   Foreground="{DynamicResource Brush.TextMuted}"
                   FontSize="11"
                   Margin="2,10,0,0"/>
    </Grid>
</Window>
