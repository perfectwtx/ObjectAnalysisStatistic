<Window x:Class="ObjectAnalyzer.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Object Analyzer" Width="1320" Height="840" MinWidth="1080" MinHeight="680"
        Background="#F5F7FA" WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Object Analyzer" FontSize="30" FontWeight="SemiBold" Foreground="#182230"/>
            <TextBlock Text="本地对象分析与数据质量工作台" FontSize="14" Foreground="#667085" Margin="0,5,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="White" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="分析文件" FontWeight="SemiBold" Foreground="#344054"/>
                    <TextBox x:Name="InputPathTextBox" Text="{Binding InputPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,7,12,0" Height="36" FontSize="14" VerticalContentAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1" Content="选择文件" Click="SelectFile_Click" VerticalAlignment="Bottom" Height="36" Margin="0,0,8,0"/>
                <Button Grid.Column="2" x:Name="AnalyzeButton" Content="开始分析" Click="Analyze_Click" VerticalAlignment="Bottom" Height="36" Padding="18,0" Background="#2563EB" Foreground="White"/>
            </Grid>
        </Border>

        <TabControl Grid.Row="2">
            <TabItem Header="概览">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <UniformGrid Columns="4" Margin="0,0,0,12">
                        <Border Background="White" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="对象数" Foreground="#667085"/><TextBlock x:Name="TotalObjectsText" Text="-" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border>
                        <Border Background="White" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="字段数" Foreground="#667085"/><TextBlock x:Name="FieldCountText" Text="-" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border>
                        <Border Background="White" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="重复组" Foreground="#667085"/><TextBlock x:Name="DuplicateGroupsText" Text="-" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border>
                        <Border Background="White" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="8" Padding="14"><StackPanel><TextBlock Text="质量问题" Foreground="#667085"/><TextBlock x:Name="QualityIssuesText" Text="-" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border>
                    </UniformGrid>
                    <Border Grid.Row="1" Background="White" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="10" Padding="12">
                        <DataGrid x:Name="FieldGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="字段" Binding="{Binding FieldName}" Width="2*"/><DataGridTextColumn Header="类型" Binding="{Binding PrimaryType}" Width="*"/>
                                <DataGridTextColumn Header="覆盖率" Binding="{Binding CoverageText}" Width="*"/><DataGridTextColumn Header="非空" Binding="{Binding Count}" Width="*"/>
                                <DataGridTextColumn Header="空值" Binding="{Binding NullCount}" Width="*"/><DataGridTextColumn Header="唯一值" Binding="{Binding DistinctCount}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Schema">
                <Border Margin="0,10,0,0" Background="White" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="10" Padding="16">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel><TextBlock Text="Schema / 字段结构" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="查看字段类型、覆盖率与 Schema 演进结果。" Foreground="#667085" Margin="0,6,0,12"/></StackPanel>
                        <DataGrid Grid.Row="1" x:Name="SchemaGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                            <DataGrid.Columns><DataGridTextColumn Header="字段" Binding="{Binding FieldName}" Width="2*"/><DataGridTextColumn Header="类型" Binding="{Binding PrimaryType}" Width="*"/>
                            <DataGridTextColumn Header="覆盖率" Binding="{Binding CoverageText}" Width="*"/><DataGridTextColumn Header="非空" Binding="{Binding Count}" Width="*"/><DataGridTextColumn Header="空值" Binding="{Binding NullCount}" Width="*"/></DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Header="重复分析">
                <Border Margin="0,10,0,0" Background="White" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="10" Padding="16">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel><TextBlock Text="重复分析" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="DuplicateSummaryText" Text="暂无重复对象结果。" Foreground="#667085" Margin="0,6,0,12"/></StackPanel>
                        <DataGrid Grid.Row="1" x:Name="DuplicateGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                            <DataGrid.Columns><DataGridTextColumn Header="对象哈希/摘要" Binding="{Binding Key}" Width="3*"/><DataGridTextColumn Header="重复次数" Binding="{Binding Count}" Width="*"/></DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Header="深度分析">
                <Grid Margin="0,10,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,10">
                        <Button Content="相关性" Click="ShowCorrelation_Click"/><Button Content="模糊去重" Click="ShowFuzzy_Click"/><Button Content="字符串模式" Click="ShowPatterns_Click"/>
                        <Button Content="Unicode" Click="ShowUnicode_Click"/><Button Content="时间序列" Click="ShowTimeSeries_Click"/><Button Content="分布漂移" Click="ShowDistribution_Click"/><Button Content="采样置信度" Click="ShowSampling_Click"/>
                    </WrapPanel>
                    <TextBox Grid.Row="1" x:Name="DeepAnalysisTextBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="White" BorderBrush="#D0D5DD" Padding="14" FontFamily="Cascadia Mono"/>
                </Grid>
            </TabItem>

            <TabItem Header="质量问题">
                <Border Margin="0,10,0,0" Background="White" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="10" Padding="16">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="问题中心" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <ListView Grid.Row="1" x:Name="IssueList"><ListView.View><GridView>
                            <GridViewColumn Header="字段" DisplayMemberBinding="{Binding FieldName}" Width="220"/><GridViewColumn Header="规则" DisplayMemberBinding="{Binding Check}" Width="150"/>
                            <GridViewColumn Header="次数" DisplayMemberBinding="{Binding Count}" Width="90"/><GridViewColumn Header="说明" DisplayMemberBinding="{Binding Message}" Width="640"/>
                        </GridView></ListView.View></ListView>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Header="质量">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="2*"/><RowDefinition Height="3*"/></Grid.RowDefinitions>
                    <Border Background="White" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <StackPanel><TextBlock Text="质量基线" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="按数据源保存最低质量阈值，并可立即评估当前分析结果。" Foreground="#667085" Margin="0,5,0,10"/></StackPanel>
                            <Grid Grid.Row="1" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding BaselineSourceName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,6" ToolTip="数据源名称"/>
                                <TextBox Grid.Column="1" Text="{Binding MinimumOverallScore, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,6" ToolTip="Overall"/>
                                <TextBox Grid.Column="2" Text="{Binding MinimumCompleteness, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,6" ToolTip="Completeness"/>
                                <TextBox Grid.Column="3" Text="{Binding MinimumValidity, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,6" ToolTip="Validity"/>
                                <TextBox Grid.Column="4" Text="{Binding MinimumUniqueness, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,6" ToolTip="Uniqueness"/>
                                <TextBox Grid.Column="5" Text="{Binding MinimumConsistency, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,6" ToolTip="Consistency"/>
                                <TextBox Grid.Column="6" Text="{Binding MinimumAnomalyControl, UpdateSourceTrigger=PropertyChanged}" ToolTip="AnomalyControl"/>
                            </Grid>
                            <WrapPanel Grid.Row="2" VerticalAlignment="Top">
                                <TextBlock Text="数据源 / Overall / 完整性 / 有效性 / 唯一性 / 一致性 / 异常控制" Foreground="#667085" Margin="0,7,12,0"/>
                                <Button Content="读取基线" Click="LoadBaseline_Click"/><Button Content="保存基线" Click="SaveBaseline_Click"/><Button Content="删除基线" Click="DeleteBaseline_Click"/><Button Content="评估当前结果" Click="EvaluateBaseline_Click"/>
                            </WrapPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Background="White" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="10" Padding="12">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock Text="质量趋势" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <DataGrid Grid.Row="1" x:Name="QualityTrendGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="时间" Binding="{Binding TimeText}" Width="150"/><DataGridTextColumn Header="数据源" Binding="{Binding SourceName}" Width="220"/>
                                    <DataGridTextColumn Header="总分" Binding="{Binding OverallText}" Width="80"/><DataGridTextColumn Header="完整性" Binding="{Binding CompletenessText}" Width="80"/>
                                    <DataGridTextColumn Header="有效性" Binding="{Binding ValidityText}" Width="80"/><DataGridTextColumn Header="唯一性" Binding="{Binding UniquenessText}" Width="80"/>
                                    <DataGridTextColumn Header="一致性" Binding="{Binding ConsistencyText}" Width="80"/><DataGridTextColumn Header="异常控制" Binding="{Binding AnomalyControlText}" Width="90"/>
                                    <DataGridTextColumn Header="对象数" Binding="{Binding TotalObjects}" Width="90"/><DataGridTextColumn Header="问题数" Binding="{Binding IssueCount}" Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="血缘 / 影响 / 回归">
                <Grid Margin="0,10,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,10">
                        <Button Content="数据血缘" Click="ShowLineage_Click"/><Button Content="影响分析" Click="ShowImpact_Click"/><Button Content="Schema Impact" Click="ShowSchemaImpact_Click"/><Button Content="回归分析" Click="ShowRegression_Click"/>
                    </WrapPanel>
                    <TextBox Grid.Row="1" x:Name="InsightTextBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="White" BorderBrush="#D0D5DD" Padding="14" FontFamily="Cascadia Mono"/>
                </Grid>
            </TabItem>

            <TabItem Header="作业中心">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,10"><TextBlock Text="作业历史" FontSize="17" FontWeight="SemiBold" Margin="0,5,16,0"/><Button Content="刷新作业" Click="RefreshJobs_Click"/></WrapPanel>
                    <DataGrid Grid.Row="1" x:Name="JobGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MouseDoubleClick="JobGrid_DoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="开始时间" Binding="{Binding StartedText}" Width="150"/><DataGridTextColumn Header="数据源" Binding="{Binding SourceName}" Width="230"/>
                            <DataGridTextColumn Header="类型" Binding="{Binding SourceType}" Width="80"/><DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="80"/>
                            <DataGridTextColumn Header="对象数" Binding="{Binding TotalObjects}" Width="90"/><DataGridTextColumn Header="字段数" Binding="{Binding FieldCount}" Width="80"/>
                            <DataGridTextColumn Header="质量分" Binding="{Binding QualityScoreText}" Width="80"/><DataGridTextColumn Header="问题数" Binding="{Binding IssueCount}" Width="80"/>
                            <DataGridTextColumn Header="耗时" Binding="{Binding DurationText}" Width="100"/><DataGridTextColumn Header="错误" Binding="{Binding ErrorMessage}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2" x:Name="JobDetailsTextBlock" Text="双击作业查看详细信息。" Foreground="#667085" TextWrapping="Wrap" Margin="4,10,4,0"/>
                </Grid>
            </TabItem>

            <TabItem Header="报告">
                <Grid Margin="0,10,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <WrapPanel>
                        <TextBlock Text="报告历史" FontSize="17" FontWeight="SemiBold" Margin="0,5,16,0"/><Button Content="刷新历史报告" Click="RefreshReports_Click"/><Button Content="打开报告目录" Click="OpenReport_Click" IsEnabled="False" x:Name="OpenReportButton"/><Button Content="导出字段 CSV" Click="ExportCsv_Click" IsEnabled="False" x:Name="ExportCsvButton"/>
                    </WrapPanel>
                    <ListView Grid.Row="1" x:Name="ReportHistoryList" Margin="0,12,0,0" MouseDoubleClick="ReportHistory_DoubleClick" SelectionChanged="ReportHistory_SelectionChanged">
                        <ListView.View><GridView><GridViewColumn Header="报告" DisplayMemberBinding="{Binding Name}" Width="420"/><GridViewColumn Header="时间" DisplayMemberBinding="{Binding TimeText}" Width="180"/><GridViewColumn Header="大小" DisplayMemberBinding="{Binding SizeText}" Width="100"/></GridView></ListView.View>
                    </ListView>
                    <TextBlock Grid.Row="2" x:Name="ReportDetailsTextBlock" Text="请选择报告查看详情。" Foreground="#667085" TextWrapping="Wrap" Margin="4,10,4,0"/>
                </Grid>
            </TabItem>

            <TabItem Header="分析输出">
                <Border Margin="0,10,0,0" Background="White" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="10" Padding="16">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="分析输出" FontSize="17" FontWeight="SemiBold"/><ProgressBar Grid.Row="1" x:Name="AnalysisProgress" Height="8" Margin="0,12,0,12" Minimum="0" Maximum="100"/>
                        <TextBox Grid.Row="2" x:Name="OutputTextBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#0F172A" Foreground="#E2E8F0" FontFamily="Cascadia Mono" Padding="12"/>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="3" x:Name="FooterTextBlock" Text="{Binding Status}" Foreground="#98A2B3" Margin="2,12,0,0"/>
    </Grid>
</Window>
