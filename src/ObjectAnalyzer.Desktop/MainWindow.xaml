<Window x:Class="ObjectAnalyzer.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ObjectAnalyzer.Desktop.Views"
        Title="Object Analyzer" Width="1320" Height="840" MinWidth="1080" MinHeight="680"
        Background="#F5F7FA" WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Object Analyzer" FontSize="30" FontWeight="SemiBold" Foreground="#182230"/>
            <TextBlock Text="本地对象分析与数据质量工作台" FontSize="14" Foreground="#667085" Margin="0,5,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="White" BorderBrush="#D0D5DD" BorderThickness="1"
                CornerRadius="10" Padding="16" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="分析文件" FontWeight="SemiBold" Foreground="#344054"/>
                    <TextBox x:Name="InputPathTextBox"
                             Text="{Binding InputPath, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,7,12,0" Height="36" FontSize="14"
                             VerticalContentAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1" Content="选择文件" Click="SelectFile_Click"
                        VerticalAlignment="Bottom" Height="36" Margin="0,0,8,0"/>
                <Button Grid.Column="2" x:Name="AnalyzeButton" Content="开始分析"
                        Click="Analyze_Click" VerticalAlignment="Bottom" Height="36"
                        Padding="18,0" Background="#2563EB" Foreground="White"/>
                <Button Grid.Column="3" x:Name="CancelButton" Content="取消分析"
                        Click="CancelAnalysis_Click" VerticalAlignment="Bottom" Height="36"
                        Margin="8,0,0,0" IsEnabled="False"/>
            </Grid>
        </Border>

        <TabControl Grid.Row="2">
            <TabItem Header="概览"><views:OverviewView/></TabItem>
            <TabItem Header="Schema"><views:SchemaView/></TabItem>
            <TabItem Header="重复分析"><views:DuplicateView/></TabItem>
            <TabItem Header="深度分析"><views:DeepAnalysisView/></TabItem>
            <TabItem Header="质量问题"><views:QualityIssuesView/></TabItem>
            <TabItem Header="质量"><views:QualityView x:Name="QualityViewControl"/></TabItem>
            <TabItem Header="血缘 / 影响 / 回归">
                <views:InsightsView x:Name="InsightsViewControl"/>
            </TabItem>
            <TabItem Header="作业中心"><views:JobsView x:Name="JobsViewControl"/></TabItem>
            <TabItem Header="报告"><views:ReportsView x:Name="ReportsViewControl"/></TabItem>
            <TabItem Header="分析输出"><views:OutputView/></TabItem>
        </TabControl>

        <TextBlock Grid.Row="3" Text="{Binding Status}" Foreground="#98A2B3" Margin="2,12,0,0"/>
    </Grid>
</Window>