<ui:FluentWindow x:Class="ObjectAnalyzer.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:ObjectAnalyzer.Desktop.Views"
        Title="Object Analyzer"
        Width="1360" Height="860"
        MinWidth="1100" MinHeight="700"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="Object Analyzer"
                     ShowMaximize="True"
                     ShowMinimize="True"/>

        <Grid Grid.Row="1" Margin="28,12,28,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Grid.Row="0" Margin="0,0,0,16">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Str.Language}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"
                               Foreground="{DynamicResource Brush.TextSecondary}"
                               FontSize="12"/>
                    <ComboBox x:Name="LanguageComboBox"
                              Width="110"
                              Margin="0,0,16,0"
                              SelectionChanged="LanguageComboBox_SelectionChanged"/>
                    <TextBlock Text="{DynamicResource Str.Theme}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"
                               Foreground="{DynamicResource Brush.TextSecondary}"
                               FontSize="12"/>
                    <ComboBox x:Name="ThemeComboBox"
                              Width="120"
                              SelectionChanged="ThemeComboBox_SelectionChanged"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str.AppTitle}" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="{DynamicResource Str.AppSubtitle}" Style="{StaticResource PageSubtitle}"/>
                </StackPanel>
            </DockPanel>

            <!-- Input bar -->
            <ui:Card Grid.Row="1" Margin="0,0,0,12" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="{DynamicResource Str.AnalyzeFile}" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="InputPathTextBox"
                                 Style="{StaticResource PathTextBox}"
                                 Text="{Binding InputPath, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{DynamicResource Str.FilePathTooltip}"
                                 AllowDrop="True"
                                 DragOver="InputPathTextBox_DragOver"
                                 Drop="InputPathTextBox_Drop"/>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Str.RecentFiles}"
                                       Foreground="{DynamicResource Brush.TextSecondary}"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Margin="0,0,10,0"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding RecentFiles}"
                                      SelectionChanged="RecentFiles_SelectionChanged"
                                      MaxDropDownHeight="240"
                                      ToolTip="{DynamicResource Str.RecentFilesTooltip}"/>
                        </Grid>
                    </StackPanel>

                    <ui:Button Grid.Column="1"
                            Content="{DynamicResource Str.SelectFile}"
                            Click="SelectFile_Click"
                            VerticalAlignment="Bottom"
                            Height="36"
                            Margin="0,0,8,0"
                            Icon="{ui:SymbolIcon FolderOpen24}"/>
                    <ui:Button Grid.Column="2"
                            x:Name="AnalyzeButton"
                            Content="{DynamicResource Str.StartAnalysis}"
                            Appearance="Primary"
                            Click="Analyze_Click"
                            VerticalAlignment="Bottom"
                            Height="36"
                            Margin="0,0,8,0"
                            Icon="{ui:SymbolIcon Play24}"/>
                    <ui:Button Grid.Column="3"
                            x:Name="CancelButton"
                            Content="{DynamicResource Str.CancelAnalysis}"
                            Appearance="Danger"
                            Click="CancelAnalysis_Click"
                            VerticalAlignment="Bottom"
                            Height="36"
                            Margin="0"
                            IsEnabled="False"
                            Icon="{ui:SymbolIcon Dismiss24}"/>
                </Grid>
            </ui:Card>

            <!-- Status bar -->
            <ui:Card Grid.Row="2" Padding="16,12" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,24,0" MinWidth="160">
                        <TextBlock Text="{DynamicResource Str.CurrentTask}" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding Status}"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   FontSize="13"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" Height="8"/>
                        <TextBlock Text="{Binding ReportPath}"
                                   Foreground="{DynamicResource Brush.TextMuted}"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,6,0,0"
                                   ToolTip="{Binding ReportPath}"/>
                    </StackPanel>

                    <ui:Button Grid.Column="2"
                            Content="{DynamicResource Str.OpenReport}"
                            Click="OpenReport_Click"
                            IsEnabled="{Binding HasReport}"
                            Height="34"
                            Padding="16,0"
                            Margin="20,0,0,0"
                            Icon="{ui:SymbolIcon Document24}"/>
                </Grid>
            </ui:Card>

            <!-- Grouped tabs -->
            <TabControl Grid.Row="3" Style="{StaticResource GroupTabControl}">
                <TabItem Header="{DynamicResource Str.Group.Analysis}" Style="{StaticResource GroupTabItem}">
                    <TabControl>
                        <TabItem Header="{DynamicResource Str.Tab.Overview}"><views:OverviewView/></TabItem>
                        <TabItem Header="{DynamicResource Str.Tab.Schema}"><views:SchemaView/></TabItem>
                        <TabItem Header="{DynamicResource Str.Tab.Duplicates}"><views:DuplicateView/></TabItem>
                        <TabItem Header="{DynamicResource Str.Tab.DeepAnalysis}"><views:DeepAnalysisView/></TabItem>
                        <TabItem Header="{DynamicResource Str.Tab.Insights}">
                            <views:InsightsView x:Name="InsightsViewControl"/>
                        </TabItem>
                        <TabItem Header="{DynamicResource Str.Tab.Output}"><views:OutputView/></TabItem>
                    </TabControl>
                </TabItem>

                <TabItem Header="{DynamicResource Str.Group.Quality}" Style="{StaticResource GroupTabItem}">
                    <TabControl>
                        <TabItem Header="{DynamicResource Str.Tab.Issues}"><views:QualityIssuesView/></TabItem>
                        <TabItem Header="{DynamicResource Str.Tab.QualityBaseline}">
                            <views:QualityView x:Name="QualityViewControl"/>
                        </TabItem>
                    </TabControl>
                </TabItem>

                <TabItem Header="{DynamicResource Str.Group.History}" Style="{StaticResource GroupTabItem}">
                    <TabControl>
                        <TabItem Header="{DynamicResource Str.Tab.Jobs}"><views:JobsView x:Name="JobsViewControl"/></TabItem>
                        <TabItem Header="{DynamicResource Str.Tab.Reports}"><views:ReportsView x:Name="ReportsViewControl"/></TabItem>
                        <TabItem Header="{DynamicResource Str.Tab.Workspace}"><views:WorkspaceView/></TabItem>
                    </TabControl>
                </TabItem>
            </TabControl>

            <TextBlock Grid.Row="4"
                       Text="{DynamicResource Str.Footer}"
                       Foreground="{DynamicResource Brush.TextMuted}"
                       FontSize="11"
                       Margin="2,10,0,0"/>
        </Grid>
    </Grid>
</ui:FluentWindow>
