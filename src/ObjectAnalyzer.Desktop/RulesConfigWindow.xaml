<Window x:Class="ObjectAnalyzer.Desktop.RulesConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="规则与运行配置"
        Width="1120" Height="840"
        MinWidth="960" MinHeight="700"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{DynamicResource Brush.Bg}"
        Foreground="{DynamicResource Brush.TextPrimary}">
    <Window.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="Themes/RulesConfigStyles.xaml"/>
        </ResourceDictionary.MergedDictionaries>
        <DataTemplate x:Key="OptionTemplate">
            <Grid Margin="0,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding DisplayName}" ToolTip="{Binding Path}" Foreground="{DynamicResource Brush.TextLabel}"
                           VerticalAlignment="Top" TextWrapping="Wrap" Margin="0,9,24,0"/>
                <StackPanel Grid.Column="1" HorizontalAlignment="Left" Width="{Binding EditorWidth}">
                    <TextBox Height="34" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding Path}">
                        <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Style.Triggers>
                            <DataTrigger Binding="{Binding HasChoices}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                            <DataTrigger Binding="{Binding IsNumeric}" Value="True"><Setter Property="AllowDrop" Value="False"/><Setter Property="InputMethod.IsInputMethodEnabled" Value="False"/></DataTrigger>
                        </Style.Triggers></Style></TextBox.Style>
                    </TextBox>
                    <ComboBox Height="34" SelectedValue="{Binding Text, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Value" DisplayMemberPath="Label" ItemsSource="{Binding Choices}" ToolTip="{Binding Path}">
                        <ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
                            <DataTrigger Binding="{Binding HasChoices}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                        </Style.Triggers></Style></ComboBox.Style>

                    </ComboBox>
                    <TextBlock Text="{Binding Hint}" Foreground="{DynamicResource Brush.TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="规则与运行配置" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}"
                       Text="配置运行参数、字段规则、值解析器与质量门槛。留空沿用默认值；高级 JSONC 与表单双向同步。"/>
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,4,0,18">
            <Button Content="加载模板" Click="Template_Click" Padding="14,6" Margin="0,0,8,0"/>
            <Button Content="导入规则…" Click="Import_Click" Padding="14,6" Margin="0,0,8,0"/>
            <Button Content="校验规则" Click="Validate_Click" Padding="14,6" Margin="0,0,8,0"/>
            <Button Content="保存到…" Click="SaveAs_Click" Padding="14,6"/>
        </WrapPanel>

        <TabControl x:Name="ConfigTabs" Grid.Row="2" SelectionChanged="ConfigTabs_SelectionChanged">
            <TabItem Header="运行配置">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" ClipToBounds="True">
                    <StackPanel Margin="16">
                        <TextBlock Text="数据解析与展开" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <CheckBox x:Name="FlattenCheckBox" Content="展开嵌套对象字段" ToolTip="runtime.flatten" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,10"/>
                        <StackPanel x:Name="RuntimeOptionsPanel"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="字段规则">
                <Grid Margin="16" ClipToBounds="True">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="字段列表" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="选择字段，在右侧编辑详细规则" Margin="0,6,0,0" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}"/>
                        </StackPanel>
                        <WrapPanel Grid.Row="1" Margin="0,0,0,12">
                            <Button Content="新增字段" Click="AddField_Click" Padding="10,5" Margin="0,0,8,0"/>
                            <Button Content="删除" Click="RemoveField_Click" Padding="10,5"/>
                        </WrapPanel>
                        <DataGrid x:Name="FieldsGrid" Grid.Row="2" AutoGenerateColumns="False" SelectionChanged="FieldsGrid_SelectionChanged"
                                  CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" SelectionMode="Single" MinHeight="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="字段路径" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                    <Border Grid.Column="1" Width="1" Background="{DynamicResource Brush.Border}"/>
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="字段详细规则" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock x:Name="FieldDetailsTitle" Text="请先选择一个字段" Margin="0,6,0,0" Foreground="{DynamicResource Brush.Primary}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <ScrollViewer x:Name="FieldDetailsScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" ClipToBounds="True">
                            <StackPanel DataContext="{Binding SelectedItem, ElementName=FieldsGrid}" Margin="0,0,12,0">
                                <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers>
                                    <DataTrigger Binding="{Binding}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                </Style.Triggers></Style></StackPanel.Style>
                                <Expander Header="质量约束" IsExpanded="True" Margin="0,0,0,12">
                                    <StackPanel>
                                        <WrapPanel Margin="0,10,0,12">
                                            <CheckBox Content="必填" IsChecked="{Binding Required}" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,24,0"/>
                                            <CheckBox Content="唯一" IsChecked="{Binding Unique}" Foreground="{DynamicResource Brush.TextPrimary}"/>
                                        </WrapPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <TextBlock Text="最小值" VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="1" Text="{Binding MinValue, UpdateSourceTrigger=PropertyChanged}" Tag="Number" Height="34" AllowDrop="False" InputMethod.IsInputMethodEnabled="False" Width="150" HorizontalAlignment="Left" Margin="0,4"/>
                                            <TextBlock Grid.Row="1" Text="最大值" VerticalAlignment="Center"/>
                                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MaxValue, UpdateSourceTrigger=PropertyChanged}" Tag="Number" Height="34" AllowDrop="False" InputMethod.IsInputMethodEnabled="False" Width="150" HorizontalAlignment="Left" Margin="0,4"/>
                                            <TextBlock Grid.Row="2" Text="空值率上限（0～1）" VerticalAlignment="Center"/>
                                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding NullRateMax, UpdateSourceTrigger=PropertyChanged}" Tag="Number" Height="34" AllowDrop="False" InputMethod.IsInputMethodEnabled="False" Width="150" HorizontalAlignment="Left" Margin="0,4"/>
                                            <TextBlock Grid.Row="3" Text="正则表达式" VerticalAlignment="Center"/>
                                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}" Height="34" Width="300" HorizontalAlignment="Left" Margin="0,4"/>
                                        </Grid>
                                    </StackPanel>
                                </Expander>
                                <ItemsControl ItemsSource="{Binding OptionGroups}">
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <Expander Header="{Binding Name}" Margin="0,0,0,12">
                                            <Expander.Style><Style TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}"><Style.Triggers>
                                                <DataTrigger Binding="{Binding Name}" Value="类型与取值"><Setter Property="IsExpanded" Value="True"/></DataTrigger>
                                            </Style.Triggers></Style></Expander.Style>
                                            <ItemsControl ItemsSource="{Binding Options}" ItemTemplate="{StaticResource OptionTemplate}"/>
                                        </Expander>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="质量与解析">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" ClipToBounds="True">
                    <StackPanel Margin="16">
                        <TextBlock Text="数据集质量门槛" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="180"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="最小行数" ToolTip="minRowCount" VerticalAlignment="Center" Margin="0,0,12,12"/>
                            <TextBox x:Name="MinRowCountTextBox" Tag="Integer" AllowDrop="False" InputMethod.IsInputMethodEnabled="False" Grid.Row="0" Grid.Column="1" Margin="0,0,0,12" Padding="6,4"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="最大重复率（0～1）" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBox x:Name="MaxDuplicateRateTextBox" Tag="Number" AllowDrop="False" InputMethod.IsInputMethodEnabled="False" Grid.Row="1" Grid.Column="1" Padding="6,4"/>
                        </Grid>
                        <TextBlock Margin="0,24,0,8" Text="值解析器（Excel / CSV 列解析）" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="source：列名或列字母；parseType：none / auto / json / json-string；header：表头行号，0 表示无表头；flatten 留空沿用全局设置。" TextWrapping="Wrap" Opacity="0.7"/>
                        <Button Content="新增解析器" Click="AddParser_Click" HorizontalAlignment="Left" Margin="0,8" Padding="12,5"/>
                        <ItemsControl x:Name="ParsersList">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <GroupBox Header="值解析器" Margin="0,4" Padding="8">
                                    <StackPanel>
                                        <Button Content="删除此解析器" Click="RemoveParser_Click" HorizontalAlignment="Right" Padding="10,4"/>
                                        <ItemsControl ItemsSource="{Binding Options}" ItemTemplate="{StaticResource OptionTemplate}"/>
                                    </StackPanel>
                                </GroupBox>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="高级 JSONC">
                <Grid Margin="8">
                    <DockPanel>
                        <Button DockPanel.Dock="Top" Content="从 JSONC 同步到表单" Click="SyncJsonToForm_Click"
                                HorizontalAlignment="Left" Padding="12,5" Margin="0,0,0,8"/>
                        <TextBox x:Name="RulesTextBox" TextChanged="RulesTextBox_TextChanged"
                             FontFamily="Consolas" FontSize="15" VerticalContentAlignment="Top"
                             AcceptsReturn="True" AcceptsTab="True"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             SpellCheck.IsEnabled="False"
                             Padding="12"
                             Background="{DynamicResource Brush.Surface}"
                             Foreground="{DynamicResource Brush.TextPrimary}"/>
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="3" Margin="0,10,0,0" Padding="10" CornerRadius="6"
                Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
            <TextBlock x:Name="ValidationTextBlock" Text="请先校验规则，再保存并应用。" TextWrapping="Wrap"/>
        </Border>

        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="PathTextBlock" VerticalAlignment="Center" Margin="0,0,20,0"
                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.TextMuted}"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="取消" IsCancel="True" Padding="18,7" Margin="0,0,8,0"/>
                <Button Content="保存并应用" Click="SaveAndApply_Click" Padding="18,7" Style="{StaticResource ConfigPrimaryButton}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
