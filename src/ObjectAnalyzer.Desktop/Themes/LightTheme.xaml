<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Cool tech light: slate canvas + cyan energy -->
    <SolidColorBrush x:Key="Brush.Bg" Color="#E8EEF6"/>
    <SolidColorBrush x:Key="Brush.Surface" Color="#F8FBFF"/>
    <SolidColorBrush x:Key="Brush.Border" Color="#A8C0D8"/>
    <SolidColorBrush x:Key="Brush.BorderSubtle" Color="#D0DEEC"/>
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#0B1A2E"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#3D5A7A"/>
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#7A93AD"/>
    <SolidColorBrush x:Key="Brush.TextLabel" Color="#1E3A5F"/>
    <SolidColorBrush x:Key="Brush.Primary" Color="#0891B2"/>
    <SolidColorBrush x:Key="Brush.PrimaryHover" Color="#0E7490"/>
    <SolidColorBrush x:Key="Brush.Danger" Color="#E11D48"/>
    <SolidColorBrush x:Key="Brush.DangerBorder" Color="#FECDD3"/>
    <SolidColorBrush x:Key="Brush.Success" Color="#059669"/>
    <SolidColorBrush x:Key="Brush.RowAlt" Color="#F0F6FC"/>
    <SolidColorBrush x:Key="Brush.HeaderBg" Color="#E4EEF8"/>
    <SolidColorBrush x:Key="Brush.Selection" Color="#CFFAFE"/>
    <SolidColorBrush x:Key="Brush.ProgressTrack" Color="#C5D8EA"/>
    <SolidColorBrush x:Key="Brush.ConsoleBg" Color="#0B1220"/>
    <SolidColorBrush x:Key="Brush.ConsoleFg" Color="#67E8F9"/>
    <SolidColorBrush x:Key="Brush.InputBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.AccentGlow" Color="#B2EBF2"/>

</ResourceDictionary>
