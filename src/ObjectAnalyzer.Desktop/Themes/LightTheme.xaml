<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Cool slate + electric cyan accents -->
    <SolidColorBrush x:Key="Brush.Bg" Color="#EEF2F7"/>
    <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Border" Color="#C5D0DE"/>
    <SolidColorBrush x:Key="Brush.BorderSubtle" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#0F172A"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#475569"/>
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#94A3B8"/>
    <SolidColorBrush x:Key="Brush.TextLabel" Color="#334155"/>
    <SolidColorBrush x:Key="Brush.Primary" Color="#0891B2"/>
    <SolidColorBrush x:Key="Brush.PrimaryHover" Color="#0E7490"/>
    <SolidColorBrush x:Key="Brush.Danger" Color="#E11D48"/>
    <SolidColorBrush x:Key="Brush.DangerBorder" Color="#FECDD3"/>
    <SolidColorBrush x:Key="Brush.Success" Color="#059669"/>
    <SolidColorBrush x:Key="Brush.RowAlt" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="Brush.HeaderBg" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="Brush.Selection" Color="#CFFAFE"/>
    <SolidColorBrush x:Key="Brush.ProgressTrack" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="Brush.ConsoleBg" Color="#0F172A"/>
    <SolidColorBrush x:Key="Brush.ConsoleFg" Color="#A5F3FC"/>
    <SolidColorBrush x:Key="Brush.InputBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.AccentGlow" Color="#E0F7FA"/>

</ResourceDictionary>
