<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Clean data-workbench light theme with restrained green actions -->
    <SolidColorBrush x:Key="Brush.Bg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Border" Color="#D5D5D5"/>
    <SolidColorBrush x:Key="Brush.BorderSubtle" Color="#EAEAEA"/>
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#202020"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#52525B"/>
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#737373"/>
    <SolidColorBrush x:Key="Brush.TextLabel" Color="#3F3F46"/>
    <SolidColorBrush x:Key="Brush.Primary" Color="#48A878"/>
    <SolidColorBrush x:Key="Brush.PrimaryHover" Color="#378D61"/>
    <SolidColorBrush x:Key="Brush.Danger" Color="#DC2626"/>
    <SolidColorBrush x:Key="Brush.DangerBorder" Color="#FECACA"/>
    <SolidColorBrush x:Key="Brush.Success" Color="#059669"/>
    <SolidColorBrush x:Key="Brush.RowAlt" Color="#FAFAFA"/>
    <SolidColorBrush x:Key="Brush.HeaderBg" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="Brush.Selection" Color="#E8F4EC"/>
    <SolidColorBrush x:Key="Brush.ProgressTrack" Color="#D5D8DE"/>
    <SolidColorBrush x:Key="Brush.ConsoleBg" Color="#18181B"/>
    <SolidColorBrush x:Key="Brush.ConsoleFg" Color="#9AC8AA"/>
    <SolidColorBrush x:Key="Brush.InputBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.AccentGlow" Color="#D8EBDD"/>

</ResourceDictionary>
