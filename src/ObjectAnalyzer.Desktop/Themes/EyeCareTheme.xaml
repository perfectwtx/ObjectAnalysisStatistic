<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Soft paper / olive eye-care palette -->
    <SolidColorBrush x:Key="Brush.Bg" Color="#E8E4D4"/>
    <SolidColorBrush x:Key="Brush.Surface" Color="#F3EEDF"/>
    <SolidColorBrush x:Key="Brush.Border" Color="#C5BDA8"/>
    <SolidColorBrush x:Key="Brush.BorderSubtle" Color="#D9D2BE"/>
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#2C2A24"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#5C584C"/>
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#8A8474"/>
    <SolidColorBrush x:Key="Brush.TextLabel" Color="#3F3C34"/>
    <SolidColorBrush x:Key="Brush.Primary" Color="#5B7C4E"/>
    <SolidColorBrush x:Key="Brush.PrimaryHover" Color="#4A6740"/>
    <SolidColorBrush x:Key="Brush.Danger" Color="#B54A3A"/>
    <SolidColorBrush x:Key="Brush.DangerBorder" Color="#E8C4BC"/>
    <SolidColorBrush x:Key="Brush.Success" Color="#4F7A45"/>
    <SolidColorBrush x:Key="Brush.RowAlt" Color="#EDE8D8"/>
    <SolidColorBrush x:Key="Brush.HeaderBg" Color="#E0DAC8"/>
    <SolidColorBrush x:Key="Brush.Selection" Color="#D4E0C8"/>
    <SolidColorBrush x:Key="Brush.ProgressTrack" Color="#D0C9B4"/>
    <SolidColorBrush x:Key="Brush.ConsoleBg" Color="#2A2924"/>
    <SolidColorBrush x:Key="Brush.ConsoleFg" Color="#E8E2D0"/>
    <SolidColorBrush x:Key="Brush.InputBg" Color="#F7F3E8"/>

    <!-- Align common WPF-UI / system brushes so content area follows eye-care -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#E8E4D4"/>
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#F3EEDF"/>
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#EDE8D8"/>
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#C5BDA8"/>
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#2C2A24"/>
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#5C584C"/>
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#F3EEDF"/>
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#F3EEDF"/>
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#E8E4D4"/>
    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#F3EEDF"/>

</ResourceDictionary>
