<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Soft green / warm paper palette to reduce eye strain -->
    <SolidColorBrush x:Key="Brush.Bg" Color="#E8F0E4"/>
    <SolidColorBrush x:Key="Brush.Surface" Color="#F4F7F0"/>
    <SolidColorBrush x:Key="Brush.Border" Color="#C5D4BC"/>
    <SolidColorBrush x:Key="Brush.BorderSubtle" Color="#D7E2D0"/>
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#2C3A2A"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#5A6B56"/>
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#7E8F79"/>
    <SolidColorBrush x:Key="Brush.TextLabel" Color="#3D4F3A"/>
    <SolidColorBrush x:Key="Brush.Primary" Color="#4A7C59"/>
    <SolidColorBrush x:Key="Brush.PrimaryHover" Color="#3D684A"/>
    <SolidColorBrush x:Key="Brush.Danger" Color="#B85C38"/>
    <SolidColorBrush x:Key="Brush.DangerBorder" Color="#E8C4B4"/>
    <SolidColorBrush x:Key="Brush.Success" Color="#3D8B5A"/>
    <SolidColorBrush x:Key="Brush.RowAlt" Color="#EEF3EA"/>
    <SolidColorBrush x:Key="Brush.HeaderBg" Color="#E0EAD9"/>
    <SolidColorBrush x:Key="Brush.Selection" Color="#D4E5D0"/>
    <SolidColorBrush x:Key="Brush.ProgressTrack" Color="#D0DCC9"/>
    <SolidColorBrush x:Key="Brush.ConsoleBg" Color="#2A3328"/>
    <SolidColorBrush x:Key="Brush.ConsoleFg" Color="#E4EDE0"/>
    <SolidColorBrush x:Key="Brush.InputBg" Color="#FAFCF8"/>

</ResourceDictionary>
