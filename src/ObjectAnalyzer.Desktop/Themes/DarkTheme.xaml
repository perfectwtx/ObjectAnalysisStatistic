<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Charcoal tool chrome + steel-blue accent -->
    <SolidColorBrush x:Key="Brush.Bg" Color="#0C0D10"/>
    <SolidColorBrush x:Key="Brush.Surface" Color="#14151A"/>
    <SolidColorBrush x:Key="Brush.Border" Color="#2A2D38"/>
    <SolidColorBrush x:Key="Brush.BorderSubtle" Color="#1C1E25"/>
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#E8EAED"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#A1A1AA"/>
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#71717A"/>
    <SolidColorBrush x:Key="Brush.TextLabel" Color="#D4D4D8"/>
    <SolidColorBrush x:Key="Brush.Primary" Color="#6B9DFF"/>
    <SolidColorBrush x:Key="Brush.PrimaryHover" Color="#8BB1FF"/>
    <SolidColorBrush x:Key="Brush.Danger" Color="#E06C75"/>
    <SolidColorBrush x:Key="Brush.DangerBorder" Color="#3F1D1D"/>
    <SolidColorBrush x:Key="Brush.Success" Color="#7FD99A"/>
    <SolidColorBrush x:Key="Brush.RowAlt" Color="#101114"/>
    <SolidColorBrush x:Key="Brush.HeaderBg" Color="#12141A"/>
    <SolidColorBrush x:Key="Brush.Selection" Color="#1A2744"/>
    <SolidColorBrush x:Key="Brush.ProgressTrack" Color="#1C1E25"/>
    <SolidColorBrush x:Key="Brush.ConsoleBg" Color="#08090C"/>
    <SolidColorBrush x:Key="Brush.ConsoleFg" Color="#9EC1FF"/>
    <SolidColorBrush x:Key="Brush.InputBg" Color="#0C0D10"/>
    <SolidColorBrush x:Key="Brush.AccentGlow" Color="#152033"/>

</ResourceDictionary>
