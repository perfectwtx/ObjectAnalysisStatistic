<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Premium zinc dark + soft indigo accent (Linear / Vercel inspired) -->
    <SolidColorBrush x:Key="Brush.Bg" Color="#09090B"/>
    <SolidColorBrush x:Key="Brush.Surface" Color="#111113"/>
    <SolidColorBrush x:Key="Brush.Border" Color="#2A2A2E"/>
    <SolidColorBrush x:Key="Brush.BorderSubtle" Color="#1C1C1F"/>
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#FAFAFA"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#A1A1AA"/>
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#71717A"/>
    <SolidColorBrush x:Key="Brush.TextLabel" Color="#D4D4D8"/>
    <SolidColorBrush x:Key="Brush.Primary" Color="#818CF8"/>
    <SolidColorBrush x:Key="Brush.PrimaryHover" Color="#A5B4FC"/>
    <SolidColorBrush x:Key="Brush.Danger" Color="#F87171"/>
    <SolidColorBrush x:Key="Brush.DangerBorder" Color="#3F1D1D"/>
    <SolidColorBrush x:Key="Brush.Success" Color="#34D399"/>
    <SolidColorBrush x:Key="Brush.RowAlt" Color="#0E0E10"/>
    <SolidColorBrush x:Key="Brush.HeaderBg" Color="#141416"/>
    <SolidColorBrush x:Key="Brush.Selection" Color="#1E1B4B"/>
    <SolidColorBrush x:Key="Brush.ProgressTrack" Color="#1C1C1F"/>
    <SolidColorBrush x:Key="Brush.ConsoleBg" Color="#050506"/>
    <SolidColorBrush x:Key="Brush.ConsoleFg" Color="#C4B5FD"/>
    <SolidColorBrush x:Key="Brush.InputBg" Color="#0C0C0E"/>
    <SolidColorBrush x:Key="Brush.AccentGlow" Color="#1A1830"/>

</ResourceDictionary>
