<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Near-black instrument chrome + steel-blue accent -->
    <SolidColorBrush x:Key="Brush.Bg" Color="#090B10"/>
    <SolidColorBrush x:Key="Brush.Surface" Color="#12151C"/>
    <SolidColorBrush x:Key="Brush.Border" Color="#262B36"/>
    <SolidColorBrush x:Key="Brush.BorderSubtle" Color="#1C2028"/>
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#F4F6FB"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#A3ABBA"/>
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#7B8496"/>
    <SolidColorBrush x:Key="Brush.TextLabel" Color="#D5DAE4"/>
    <SolidColorBrush x:Key="Brush.Primary" Color="#8EB0FF"/>
    <SolidColorBrush x:Key="Brush.PrimaryHover" Color="#B7CDFF"/>
    <SolidColorBrush x:Key="Brush.Danger" Color="#E07A82"/>
    <SolidColorBrush x:Key="Brush.DangerBorder" Color="#3F1D1D"/>
    <SolidColorBrush x:Key="Brush.Success" Color="#86D9A4"/>
    <SolidColorBrush x:Key="Brush.RowAlt" Color="#0E1116"/>
    <SolidColorBrush x:Key="Brush.HeaderBg" Color="#12151C"/>
    <SolidColorBrush x:Key="Brush.Selection" Color="#1B2744"/>
    <SolidColorBrush x:Key="Brush.ProgressTrack" Color="#1C2028"/>
    <SolidColorBrush x:Key="Brush.ConsoleBg" Color="#07080C"/>
    <SolidColorBrush x:Key="Brush.ConsoleFg" Color="#B7CDFF"/>
    <SolidColorBrush x:Key="Brush.InputBg" Color="#090B10"/>
    <SolidColorBrush x:Key="Brush.AccentGlow" Color="#1B2744"/>

</ResourceDictionary>
