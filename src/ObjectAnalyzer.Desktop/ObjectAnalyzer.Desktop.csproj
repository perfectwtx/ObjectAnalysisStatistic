<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ObjectAnalyzer.Desktop</RootNamespace>
    <AssemblyName>ObjectAnalyzer.Desktop</AssemblyName>
    <ApplicationIcon Condition="Exists('Assets\\app.ico')">Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ObjectAnalyzer.Core\ObjectAnalyzer.Core.csproj" />
    <ProjectReference Include="../ObjectAnalyzer.Parsing/ObjectAnalyzer.Parsing.csproj" />
    <ProjectReference Include="../ObjectAnalyzer.Exporting/ObjectAnalyzer.Exporting.csproj" />
    <ProjectReference Include="../ObjectAnalyzer.Application/ObjectAnalyzer.Application.csproj" />
    <ProjectReference Include="../ObjectAnalyzer.Platform/ObjectAnalyzer.Platform.csproj" />
    <ProjectReference Include="../ObjectAnalyzer.Infrastructure/ObjectAnalyzer.Infrastructure.csproj" />
    <ProjectReference Include="../ObjectAnalyzer.Hosting/ObjectAnalyzer.Hosting.csproj" />
  </ItemGroup>

  <!-- Materialize Assets/app.ico from GenerateAppIcon.ps1 before compile -->
  <Target Name="GenerateAppIcon" BeforeTargets="BeforeCompile">
    <Exec Command='powershell -NoProfile -ExecutionPolicy Bypass -File "$(MSBuildProjectDirectory)\Assets\GenerateAppIcon.ps1"'
          Condition="'$(OS)' == 'Windows_NT' And Exists('$(MSBuildProjectDirectory)\Assets\GenerateAppIcon.ps1') And !Exists('$(MSBuildProjectDirectory)\Assets\app.ico')"
          IgnoreExitCode="false" />
  </Target>

</Project>
