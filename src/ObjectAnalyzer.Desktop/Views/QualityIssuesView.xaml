<UserControl x:Class="ObjectAnalyzer.Desktop.Views.QualityIssuesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ObjectAnalyzer.Desktop.Views"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
    <Border Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.BorderSubtle}"
            BorderThickness="1"
            CornerRadius="2"
            Padding="10"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,12" HorizontalAlignment="Left" VerticalAlignment="Top">
                <TextBlock Text="问题中心" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="聚合当前分析结果中的质量违规项。" Style="{StaticResource SectionHint}"/>
            </StackPanel>

            <DataGrid Grid.Row="1"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      ItemsSource="{Binding Issues}"
                      VerticalAlignment="Stretch"
                      Visibility="{Binding HasIssues, Converter={StaticResource BoolToVis}}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="字段" Binding="{Binding FieldName}" Width="220"/>
                    <DataGridTextColumn Header="规则" Binding="{Binding Check}" Width="150"/>
                    <DataGridTextColumn Header="次数" Binding="{Binding Count}" Width="90"/>
                    <DataGridTextColumn Header="说明" Binding="{Binding Message}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <views:EmptyStateView Grid.Row="1"
                                  VerticalAlignment="Top"
                                  HorizontalAlignment="Stretch"
                                  Glyph="✓"
                                  Title="暂无质量问题"
                                  Hint="当前结果没有检测到质量违规；完成分析后，违规项会在此列出。"
                                  Visibility="{Binding HasIssues, Converter={StaticResource InverseBoolToVis}}"/>
        </Grid>
    </Border>
</UserControl>
