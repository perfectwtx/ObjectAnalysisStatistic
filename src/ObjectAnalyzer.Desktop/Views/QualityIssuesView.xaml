<UserControl x:Class="ObjectAnalyzer.Desktop.Views.QualityIssuesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ObjectAnalyzer.Desktop.Views"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
    <Border Style="{StaticResource ToolPage}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Style="{StaticResource ToolPageHeaderBar}">
                <TextBlock Text="{DynamicResource Str.Tab.Issues}" Style="{StaticResource SectionTitle}"/>
            </Border>

            <DataGrid Grid.Row="1"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      ItemsSource="{Binding Issues}"
                      VerticalAlignment="Stretch"
                      Visibility="{Binding HasIssues, Converter={StaticResource BoolToVis}}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource Str.Col.Field}" Binding="{Binding FieldName}" Width="220"/>
                    <DataGridTextColumn Header="{DynamicResource Str.Col.Rule}" Binding="{Binding Check}" Width="150"/>
                    <DataGridTextColumn Header="{DynamicResource Str.Col.Count}" Binding="{Binding Count}" Width="90"/>
                    <DataGridTextColumn Header="{DynamicResource Str.Col.Message}" Binding="{Binding Message}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <views:EmptyStateView Grid.Row="1"
                                  VerticalAlignment="Top"
                                  HorizontalAlignment="Stretch"
                                  Title="{DynamicResource Str.Empty.NoIssues.Title}"
                                  Hint="{DynamicResource Str.Empty.NoIssues.Hint}"
                                  Visibility="{Binding HasIssues, Converter={StaticResource InverseBoolToVis}}"/>
        </Grid>
    </Border>
</UserControl>
