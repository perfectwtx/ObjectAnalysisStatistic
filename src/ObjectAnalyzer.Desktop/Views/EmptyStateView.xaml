<UserControl x:Class="ObjectAnalyzer.Desktop.Views.EmptyStateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
    <Border Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.BorderSubtle}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="24,20"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
        <!-- 内容从左上开始，避免整页看起来“从中间起” -->
        <StackPanel HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    MaxWidth="520">
            <Border Width="48" Height="48"
                    CornerRadius="12"
                    Background="{DynamicResource Brush.HeaderBg}"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,12">
                <TextBlock Text="{Binding Glyph, ElementName=Root}"
                           FontSize="22"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.Primary}"/>
            </Border>
            <TextBlock Text="{Binding Title, ElementName=Root}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Left"
                       TextAlignment="Left"
                       Foreground="{DynamicResource Brush.TextPrimary}"/>
            <TextBlock Text="{Binding Hint, ElementName=Root}"
                       FontSize="13"
                       Margin="0,8,0,0"
                       HorizontalAlignment="Left"
                       TextAlignment="Left"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.TextSecondary}"/>
        </StackPanel>
    </Border>
</UserControl>
