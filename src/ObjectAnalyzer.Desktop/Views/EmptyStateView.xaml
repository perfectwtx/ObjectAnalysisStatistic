<UserControl x:Class="ObjectAnalyzer.Desktop.Views.EmptyStateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Top">
    <Border Background="Transparent"
            Padding="4,8,4,8"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top">
        <StackPanel HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    MaxWidth="560">
            <Border Width="44" Height="44"
                    CornerRadius="10"
                    Background="{DynamicResource Brush.HeaderBg}"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,12">
                <TextBlock Text="{Binding Glyph, ElementName=Root}"
                           FontSize="20"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.Primary}"/>
            </Border>
            <TextBlock Text="{Binding Title, ElementName=Root}"
                       FontSize="15"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Left"
                       TextAlignment="Left"
                       Foreground="{DynamicResource Brush.TextPrimary}"/>
            <TextBlock Text="{Binding Hint, ElementName=Root}"
                       FontSize="13"
                       Margin="0,8,0,0"
                       HorizontalAlignment="Left"
                       TextAlignment="Left"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.TextSecondary}"/>
        </StackPanel>
    </Border>
</UserControl>
