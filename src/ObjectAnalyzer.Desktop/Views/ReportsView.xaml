<UserControl x:Class="ObjectAnalyzer.Desktop.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource CardBorder}" Margin="0,8,0,0" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,12">
                <WrapPanel DockPanel.Dock="Right">
                    <Button Content="刷新历史报告" Click="RefreshReports_Click"/>
                    <Button Content="打开当前报告" Click="OpenReport_Click" IsEnabled="{Binding HasReport}"/>
                    <Button Content="导出字段 CSV" Style="{StaticResource PrimaryButton}" Click="ExportCsv_Click" IsEnabled="{Binding HasResult}" Margin="0"/>
                </WrapPanel>
                <StackPanel>
                    <TextBlock Text="报告历史" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="双击报告可重新加载到工作台。" Style="{StaticResource SectionHint}" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>

            <DataGrid Grid.Row="1"
                      x:Name="ReportHistoryList"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      ItemsSource="{Binding Reports}"
                      MouseDoubleClick="ReportHistory_DoubleClick"
                      SelectionChanged="ReportHistory_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="报告" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="时间" Binding="{Binding TimeText}" Width="180"/>
                    <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Grid.Row="2"
                       x:Name="ReportDetailsTextBlock"
                       Text="请选择报告查看详情。"
                       Foreground="{DynamicResource Brush.TextSecondary}"
                       TextWrapping="Wrap"
                       Margin="2,12,2,0"
                       FontSize="12"/>
        </Grid>
    </Border>
</UserControl>
