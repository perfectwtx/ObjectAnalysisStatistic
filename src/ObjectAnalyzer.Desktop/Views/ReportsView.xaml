<UserControl x:Class="ObjectAnalyzer.Desktop.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:ObjectAnalyzer.Desktop.Views"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
    <Border Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.BorderSubtle}"
            BorderThickness="1"
            CornerRadius="2"
            Padding="10"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,12">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ui:Button Content="导出 CSV" Click="ExportCsv_Click" Margin="0,0,8,0"/>
                    <ui:Button Content="打开位置" Click="OpenReport_Click" Margin="0,0,8,0"/>
                    <ui:Button Content="刷新" Click="RefreshReports_Click">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="ArrowSync24"/>
                        </ui:Button.Icon>
                    </ui:Button>
                </StackPanel>
                <StackPanel HorizontalAlignment="Left">
                    <TextBlock Text="报告" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="本地生成的分析报告。双击 JSON 可回读到工作台。" Style="{StaticResource SectionHint}" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>

            <DataGrid Grid.Row="1"
                      x:Name="ReportHistoryList"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      ItemsSource="{Binding Reports}"
                      SelectionChanged="ReportHistory_SelectionChanged"
                      MouseDoubleClick="ReportHistory_DoubleClick"
                      VerticalAlignment="Stretch"
                      Visibility="{Binding HasReports, Converter={StaticResource BoolToVis}}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="2*"/>
                    <DataGridTextColumn Header="路径" Binding="{Binding Path}" Width="3*"/>
                </DataGrid.Columns>
            </DataGrid>

            <views:EmptyStateView Grid.Row="1"
                                  VerticalAlignment="Top"
                                  HorizontalAlignment="Stretch"
                                  Glyph="📄"
                                  Title="还没有报告"
                                  Hint="分析完成后会自动生成报告，可在此重新加载或导出字段 CSV。"
                                  Visibility="{Binding HasReports, Converter={StaticResource InverseBoolToVis}}"/>

            <TextBlock Grid.Row="2"
                       x:Name="ReportDetailsTextBlock"
                       Text="选择报告查看详情。"
                       Foreground="{DynamicResource Brush.TextSecondary}"
                       TextWrapping="Wrap"
                       Margin="2,12,2,0"
                       FontSize="12"
                       Visibility="{Binding HasReports, Converter={StaticResource BoolToVis}}"/>
        </Grid>
    </Border>
</UserControl>
