<UserControl x:Class="ObjectAnalyzer.Desktop.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,10,0,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <WrapPanel>
            <TextBlock Text="报告历史" FontSize="17" FontWeight="SemiBold" Margin="0,5,16,0"/>
            <Button Content="刷新历史报告" Click="RefreshReports_Click"/>
            <Button Content="打开当前报告" Click="OpenReport_Click" IsEnabled="{Binding HasReport}"/>
            <Button Content="导出字段 CSV" Click="ExportCsv_Click" IsEnabled="{Binding HasResult}"/>
        </WrapPanel>
        <ListView Grid.Row="1" x:Name="ReportHistoryList" Margin="0,12,0,0"
                  ItemsSource="{Binding Reports}" MouseDoubleClick="ReportHistory_DoubleClick"
                  SelectionChanged="ReportHistory_SelectionChanged">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="报告" DisplayMemberBinding="{Binding Name}" Width="420"/>
                    <GridViewColumn Header="时间" DisplayMemberBinding="{Binding TimeText}" Width="180"/>
                    <GridViewColumn Header="大小" DisplayMemberBinding="{Binding SizeText}" Width="100"/>
                </GridView>
            </ListView.View>
        </ListView>
        <TextBlock Grid.Row="2" x:Name="ReportDetailsTextBlock" Text="请选择报告查看详情。"
                   Foreground="#667085" TextWrapping="Wrap" Margin="4,10,4,0"/>
    </Grid>
</UserControl>