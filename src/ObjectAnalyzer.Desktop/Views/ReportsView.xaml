<UserControl x:Class="ObjectAnalyzer.Desktop.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:ObjectAnalyzer.Desktop.Views"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
    <Border Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.BorderSubtle}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,12">
                <ui:Button DockPanel.Dock="Right" Content="刷新" Click="Refresh_Click">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="ArrowSync24"/>
                    </ui:Button.Icon>
                </ui:Button>
                <StackPanel HorizontalAlignment="Left">
                    <TextBlock Text="报告" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="本地生成的分析报告列表。双击可回读 JSON 报告。" Style="{StaticResource SectionHint}" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>

            <ListBox Grid.Row="1"
                     ItemsSource="{Binding Reports}"
                     VerticalAlignment="Stretch"
                     Visibility="{Binding HasReports, Converter={StaticResource BoolToVis}}"
                     MouseDoubleClick="Reports_DoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <views:EmptyStateView Grid.Row="1"
                                  VerticalAlignment="Top"
                                  HorizontalAlignment="Stretch"
                                  Glyph="📄"
                                  Title="还没有报告"
                                  Hint="完成分析后，报告文件会出现在这里。"
                                  Visibility="{Binding HasReports, Converter={StaticResource InverseBoolToVis}}"/>
        </Grid>
    </Border>
</UserControl>
