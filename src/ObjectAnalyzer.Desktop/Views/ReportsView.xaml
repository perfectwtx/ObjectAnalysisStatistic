<UserControl x:Class="ObjectAnalyzer.Desktop.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:ObjectAnalyzer.Desktop.Views"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
    <Border Style="{StaticResource ToolPage}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Style="{StaticResource ToolPageHeaderBar}" Padding="12,8">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <ui:Button Content="{DynamicResource Str.Reports.ExportCsv}" Click="ExportCsv_Click"
                                   Height="30" Padding="12,0" FontSize="12" Margin="0,0,6,0"/>
                        <ui:Button Content="{DynamicResource Str.Reports.OpenLocation}" Click="OpenReport_Click"
                                   Height="26" Padding="10,0" FontSize="12" Margin="0,0,6,0"/>
                        <ui:Button Content="{DynamicResource Str.Reports.Refresh}" Click="RefreshReports_Click"
                                   Height="26" Padding="10,0" FontSize="12">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="ArrowSync24"/>
                            </ui:Button.Icon>
                        </ui:Button>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Str.Tab.Reports}" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="{DynamicResource Str.Reports.Hint}" Style="{StaticResource SectionHint}"/>
                </DockPanel>
            </Border>

            <DataGrid Grid.Row="1"
                      Margin="10"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      x:Name="ReportHistoryList"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      ItemsSource="{Binding Reports}"
                      SelectionChanged="ReportHistory_SelectionChanged"
                      MouseDoubleClick="ReportHistory_DoubleClick"
                      VerticalAlignment="Stretch"
                      Visibility="{Binding HasReports, Converter={StaticResource BoolToVis}}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource Str.Col.Name}" Binding="{Binding Name}" Width="2*"/>
                    <DataGridTextColumn Header="{DynamicResource Str.Col.Path}" Binding="{Binding Path}" Width="3*"/>
                </DataGrid.Columns>
            </DataGrid>

            <views:EmptyStateView Grid.Row="1"
                                  VerticalAlignment="Top"
                                  HorizontalAlignment="Stretch"
                                  Title="{DynamicResource Str.Empty.NoReports.Title}"
                                  Hint="{DynamicResource Str.Empty.NoReports.Hint}"
                                  Visibility="{Binding HasReports, Converter={StaticResource InverseBoolToVis}}"/>

            <Border Grid.Row="2"
                    BorderBrush="{DynamicResource Brush.BorderSubtle}"
                    BorderThickness="0,1,0,0"
                    Padding="10,6"
                    Visibility="{Binding HasReports, Converter={StaticResource BoolToVis}}">
                <TextBlock x:Name="ReportDetailsTextBlock"
                           Text="{DynamicResource Str.Reports.Details}"
                           Foreground="{DynamicResource Brush.TextSecondary}"
                           TextWrapping="Wrap"
                           FontSize="12"/>
            </Border>
        </Grid>
    </Border>
</UserControl>
