<UserControl x:Class="ObjectAnalyzer.Desktop.Views.AnalysisOptionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Expander Header="分析选项" Margin="0,8,12,0">
        <Border Background="#F8FAFC" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="8" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <CheckBox Content="相关性分析" IsChecked="{Binding EnableCorrelation}" Margin="0,0,0,8"/>
                    <CheckBox Content="字符串模式" IsChecked="{Binding EnableStringPatterns}" Margin="0,0,0,8"/>
                    <CheckBox Content="Unicode 卫生检查" IsChecked="{Binding EnableUnicodeHygiene}"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <CheckBox Content="时间序列分析" IsChecked="{Binding EnableTimeSeries}" Margin="0,0,0,8"/>
                    <CheckBox Content="启用模糊去重" IsChecked="{Binding EnableFuzzyDedup}" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="目标字段" Foreground="#667085" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Margin="10,0,0,0"
                                 Text="{Binding FuzzyDedupField, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="例如：name"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Expander>
</UserControl>
