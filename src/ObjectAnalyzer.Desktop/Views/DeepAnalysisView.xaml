<UserControl x:Class="ObjectAnalyzer.Desktop.Views.DeepAnalysisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
    <Border Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.BorderSubtle}"
            BorderThickness="1"
            CornerRadius="2"
            Padding="10"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,10" HorizontalAlignment="Left" VerticalAlignment="Top">
                <TextBlock Text="深度分析" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="选择分析维度查看详细结果。未启用的项会明确显示“未生成”。"
                           Style="{StaticResource SectionHint}"/>
            </StackPanel>
            <WrapPanel Grid.Row="1" Margin="0,0,0,12" HorizontalAlignment="Left">
                <ui:Button Content="相关性" Click="ShowCorrelation_Click" Margin="0,0,8,8"/>
                <ui:Button Content="模糊去重" Click="ShowFuzzy_Click" Margin="0,0,8,8"/>
                <ui:Button Content="字符串模式" Click="ShowPatterns_Click" Margin="0,0,8,8"/>
                <ui:Button Content="Unicode" Click="ShowUnicode_Click" Margin="0,0,8,8"/>
                <ui:Button Content="时间序列" Click="ShowTimeSeries_Click" Margin="0,0,8,8"/>
                <ui:Button Content="分布漂移" Click="ShowDistribution_Click" Margin="0,0,8,8"/>
                <ui:Button Content="采样置信度" Click="ShowSampling_Click" Margin="0,0,0,8"/>
            </WrapPanel>
            <TextBox Grid.Row="2"
                     x:Name="ResultTextBox"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     VerticalAlignment="Stretch"
                     FontFamily="Cascadia Mono, Consolas"
                     FontSize="12"
                     Padding="14"
                     Background="{DynamicResource Brush.ConsoleBg}"
                     Foreground="{DynamicResource Brush.ConsoleFg}"
                     Text="请选择上方分析维度。&#x0a;&#x0a;未启用的深度分析会明确显示“未生成”。"/>
        </Grid>
    </Border>
</UserControl>
