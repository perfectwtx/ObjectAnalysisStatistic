<UserControl x:Class="ObjectAnalyzer.Desktop.Views.DeepAnalysisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
    <Border Style="{StaticResource ToolPage}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Style="{StaticResource ToolPageHeaderBar}">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Right">
                        <ui:Button Content="{DynamicResource Str.Deep.Correlation}" Click="ShowCorrelation_Click" Height="26" Padding="10,0" FontSize="12" Margin="0,0,4,0"/>
                        <ui:Button Content="{DynamicResource Str.Deep.Fuzzy}" Click="ShowFuzzy_Click" Height="26" Padding="10,0" FontSize="12" Margin="0,0,4,0"/>
                        <ui:Button Content="{DynamicResource Str.Deep.Patterns}" Click="ShowPatterns_Click" Height="26" Padding="10,0" FontSize="12" Margin="0,0,4,0"/>
                        <ui:Button Content="{DynamicResource Str.Deep.Unicode}" Click="ShowUnicode_Click" Height="26" Padding="10,0" FontSize="12" Margin="0,0,4,0"/>
                        <ui:Button Content="{DynamicResource Str.Deep.TimeSeries}" Click="ShowTimeSeries_Click" Height="26" Padding="10,0" FontSize="12" Margin="0,0,4,0"/>
                        <ui:Button Content="{DynamicResource Str.Deep.Distribution}" Click="ShowDistribution_Click" Height="26" Padding="10,0" FontSize="12" Margin="0,0,4,0"/>
                        <ui:Button Content="{DynamicResource Str.Deep.Sampling}" Click="ShowSampling_Click" Height="26" Padding="10,0" FontSize="12"/>
                    </WrapPanel>
                    <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Str.Tab.DeepAnalysis}" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="{DynamicResource Str.Deep.Hint}" Style="{StaticResource SectionHint}"/>
                </DockPanel>
            </Border>
            <TextBox Grid.Row="1"
                     x:Name="ResultTextBox"
                     Style="{StaticResource TerminalTextBox}"
                     VerticalAlignment="Stretch"
                     Text="{DynamicResource Str.Deep.Placeholder}"/>
        </Grid>
    </Border>
</UserControl>
