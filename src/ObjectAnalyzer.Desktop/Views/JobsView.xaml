<UserControl x:Class="ObjectAnalyzer.Desktop.Views.JobsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:ObjectAnalyzer.Desktop.Views"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
    <Border Style="{StaticResource ToolPage}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Style="{StaticResource ToolPageHeaderBar}" Padding="12,8">
                <DockPanel>
                    <ui:Button DockPanel.Dock="Right"
                               Content="{DynamicResource Str.Jobs.Refresh}"
                               Click="RefreshJobs_Click"
                               Height="30"
                               Padding="12,0"
                               FontSize="12">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="ArrowSync24"/>
                        </ui:Button.Icon>
                    </ui:Button>
                    <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Str.Tab.Jobs}" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="{DynamicResource Str.Jobs.Hint}" Style="{StaticResource SectionHint}"/>
                </DockPanel>
            </Border>

            <DataGrid Grid.Row="1"
                      Margin="10"
                      x:Name="JobGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      ItemsSource="{Binding Jobs}"
                      MouseDoubleClick="JobGrid_DoubleClick"
                      VerticalAlignment="Stretch"
                      Visibility="{Binding HasJobs, Converter={StaticResource BoolToVis}}"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      RowHeaderWidth="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource Str.Col.Started}" Binding="{Binding StartedText}" Width="150"/>
                    <DataGridTextColumn Header="{DynamicResource Str.Col.Source}" Binding="{Binding SourceName}" Width="230"/>
                    <DataGridTextColumn Header="{DynamicResource Str.Col.SourceType}" Binding="{Binding SourceType}" Width="80"/>
                    <DataGridTextColumn Header="{DynamicResource Str.Col.Status}" Binding="{Binding StatusText}" Width="80"/>
                    <DataGridTextColumn Header="{DynamicResource Str.Metric.Objects}" Binding="{Binding TotalObjects}" Width="90"/>
                    <DataGridTextColumn Header="{DynamicResource Str.Metric.Fields}" Binding="{Binding FieldCount}" Width="80"/>
                    <DataGridTextColumn Header="{DynamicResource Str.Col.QualityScore}" Binding="{Binding QualityScoreText}" Width="80"/>
                    <DataGridTextColumn Header="{DynamicResource Str.Col.IssueCount}" Binding="{Binding IssueCount}" Width="80"/>
                    <DataGridTextColumn Header="{DynamicResource Str.Col.Duration}" Binding="{Binding DurationText}" Width="100"/>
                    <DataGridTextColumn Header="{DynamicResource Str.Col.Error}" Binding="{Binding ErrorMessage}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <views:EmptyStateView Grid.Row="1"
                                  VerticalAlignment="Top"
                                  HorizontalAlignment="Stretch"
                                  Title="{DynamicResource Str.Empty.NoJobs.Title}"
                                  Hint="{DynamicResource Str.Empty.NoJobs.Hint}"
                                  Visibility="{Binding HasJobs, Converter={StaticResource InverseBoolToVis}}"/>

            <Border Grid.Row="2"
                    BorderBrush="{DynamicResource Brush.BorderSubtle}"
                    BorderThickness="0,1,0,0"
                    Padding="10,6"
                    Visibility="{Binding HasJobs, Converter={StaticResource BoolToVis}}">
                <TextBlock x:Name="JobDetailsTextBlock"
                           Text="{DynamicResource Str.Jobs.Details}"
                           Foreground="{DynamicResource Brush.TextSecondary}"
                           TextWrapping="Wrap"
                           FontSize="12"/>
            </Border>
        </Grid>
    </Border>
</UserControl>
