<UserControl x:Class="ObjectAnalyzer.Desktop.Views.JobsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,10,0,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <WrapPanel Margin="0,0,0,10">
            <TextBlock Text="作业历史" FontSize="17" FontWeight="SemiBold" Margin="0,5,16,0"/>
            <Button Content="刷新作业" Click="RefreshJobs_Click"/>
        </WrapPanel>
        <DataGrid Grid.Row="1" x:Name="JobGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  ItemsSource="{Binding Jobs}" MouseDoubleClick="JobGrid_DoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="开始时间" Binding="{Binding StartedText}" Width="150"/>
                <DataGridTextColumn Header="数据源" Binding="{Binding SourceName}" Width="230"/>
                <DataGridTextColumn Header="类型" Binding="{Binding SourceType}" Width="80"/>
                <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="80"/>
                <DataGridTextColumn Header="对象数" Binding="{Binding TotalObjects}" Width="90"/>
                <DataGridTextColumn Header="字段数" Binding="{Binding FieldCount}" Width="80"/>
                <DataGridTextColumn Header="质量分" Binding="{Binding QualityScoreText}" Width="80"/>
                <DataGridTextColumn Header="问题数" Binding="{Binding IssueCount}" Width="80"/>
                <DataGridTextColumn Header="耗时" Binding="{Binding DurationText}" Width="100"/>
                <DataGridTextColumn Header="错误" Binding="{Binding ErrorMessage}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="2" x:Name="JobDetailsTextBlock" Text="双击作业查看详细信息。"
                   Foreground="#667085" TextWrapping="Wrap" Margin="4,10,4,0"/>
    </Grid>
</UserControl>