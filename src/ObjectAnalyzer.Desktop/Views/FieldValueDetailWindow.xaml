<Window x:Class="ObjectAnalyzer.Desktop.Views.FieldValueDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str.Detail.Title}"
        Width="760" Height="580"
        MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Bg}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource ToolPageHeaderBar}">
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.TextPrimary}"/>
                <TextBlock x:Name="MetaText" Margin="0,2,0,0" FontSize="11"
                           Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap"/>
                <TextBlock x:Name="TruncationText" Margin="0,4,0,0" FontSize="11"
                           Foreground="{DynamicResource Brush.Primary}" TextWrapping="Wrap"
                           Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource ToolPage}" Margin="10,8,10,0">
            <DataGrid x:Name="ValuesGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource Str.Col.Value}" Binding="{Binding Value}" Width="3*"/>
                    <DataGridTextColumn Header="{DynamicResource Str.Col.Count}" Binding="{Binding Count}" Width="*"/>
                    <DataGridTextColumn Header="{DynamicResource Str.Col.Share}" Binding="{Binding ShareText}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="2" Padding="10,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{DynamicResource Str.Detail.CopyAll}" Height="28" Padding="12,0" FontSize="12" Margin="0,0,6,0" Click="CopyAll_Click"/>
                <Button Content="{DynamicResource Str.Detail.ExportCsv}" Height="28" Padding="12,0" FontSize="12" Margin="0,0,6,0" Click="ExportCsv_Click"/>
                <Button Content="{DynamicResource Str.Detail.Close}" Height="28" Padding="14,0" FontSize="12" Click="Close_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
