<Window x:Class="ObjectAnalyzer.Desktop.Views.FieldValueDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="字段取值详情"
        Width="720" Height="560"
        MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Bg}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="18" FontWeight="Bold"
                       Foreground="{DynamicResource Brush.TextPrimary}"/>
            <TextBlock x:Name="MetaText" Margin="0,6,0,0" FontSize="12"
                       Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap"/>
        </StackPanel>

        <TextBlock Grid.Row="1" x:Name="TruncationText" Margin="0,10,0,8" FontSize="12"
                   Foreground="{DynamicResource Brush.Primary}" TextWrapping="Wrap"
                   Visibility="Collapsed"/>

        <DataGrid Grid.Row="2"
                  x:Name="ValuesGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="取值" Binding="{Binding Value}" Width="3*"/>
                <DataGridTextColumn Header="出现次数" Binding="{Binding Count}" Width="*"/>
                <DataGridTextColumn Header="占比(相对非空)" Binding="{Binding ShareText}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="3" Content="关闭" HorizontalAlignment="Right" Margin="0,12,0,0"
                Padding="20,6" Click="Close_Click"/>
    </Grid>
</Window>
