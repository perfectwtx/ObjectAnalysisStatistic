<UserControl x:Class="ObjectAnalyzer.Desktop.Views.QualityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,10,0,0">
        <Grid.RowDefinitions><RowDefinition Height="2*"/><RowDefinition Height="3*"/></Grid.RowDefinitions>
        <Border Background="White" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="质量基线" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="按数据源保存最低质量阈值，并可立即评估当前分析结果。" Foreground="#667085" Margin="0,5,0,10"/>
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding BaselineSourceName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,6" ToolTip="数据源名称"/>
                    <TextBox Grid.Column="1" Text="{Binding MinimumOverallScore, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,6" ToolTip="Overall"/>
                    <TextBox Grid.Column="2" Text="{Binding MinimumCompleteness, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,6" ToolTip="Completeness"/>
                    <TextBox Grid.Column="3" Text="{Binding MinimumValidity, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,6" ToolTip="Validity"/>
                    <TextBox Grid.Column="4" Text="{Binding MinimumUniqueness, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,6" ToolTip="Uniqueness"/>
                    <TextBox Grid.Column="5" Text="{Binding MinimumConsistency, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,6" ToolTip="Consistency"/>
                    <TextBox Grid.Column="6" Text="{Binding MinimumAnomalyControl, UpdateSourceTrigger=PropertyChanged}" ToolTip="AnomalyControl"/>
                </Grid>
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <WrapPanel>
                        <TextBlock Text="数据源 / Overall / 完整性 / 有效性 / 唯一性 / 一致性 / 异常控制" Foreground="#667085" Margin="0,7,12,0"/>
                        <Button Content="读取基线" Click="LoadBaseline_Click"/>
                        <Button Content="保存基线" Click="SaveBaseline_Click"/>
                        <Button Content="删除基线" Click="DeleteBaseline_Click"/>
                        <Button Content="评估当前结果" Click="EvaluateBaseline_Click"/>
                    </WrapPanel>
                    <TextBox Grid.Row="1" x:Name="EvaluationTextBox" Margin="0,10,0,0" IsReadOnly="True" AcceptsReturn="True"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono"
                             Foreground="#344054" BorderBrush="#EAECF0" Text="评估结果会显示在这里。"/>
                </Grid>
            </Grid>
        </Border>
        <Border Grid.Row="1" Background="White" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="10" Padding="12">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="质量趋势" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <DataGrid Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" ItemsSource="{Binding QualityTrend}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="时间" Binding="{Binding TimeText}" Width="150"/>
                        <DataGridTextColumn Header="数据源" Binding="{Binding SourceName}" Width="220"/>
                        <DataGridTextColumn Header="总分" Binding="{Binding OverallText}" Width="80"/>
                        <DataGridTextColumn Header="完整性" Binding="{Binding CompletenessText}" Width="80"/>
                        <DataGridTextColumn Header="有效性" Binding="{Binding ValidityText}" Width="80"/>
                        <DataGridTextColumn Header="唯一性" Binding="{Binding UniquenessText}" Width="80"/>
                        <DataGridTextColumn Header="一致性" Binding="{Binding ConsistencyText}" Width="80"/>
                        <DataGridTextColumn Header="异常控制" Binding="{Binding AnomalyControlText}" Width="90"/>
                        <DataGridTextColumn Header="对象数" Binding="{Binding TotalObjects}" Width="90"/>
                        <DataGridTextColumn Header="问题数" Binding="{Binding IssueCount}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>