<UserControl x:Class="ObjectAnalyzer.Desktop.Views.QualityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:ObjectAnalyzer.Desktop.Views">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource HudPanel}" Margin="0,0,0,12" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Margin="0,0,0,8">
                    <TextBlock Text="{DynamicResource Str.Quality.Baseline}" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="{DynamicResource Str.Quality.BaselineHint}" Style="{StaticResource SectionHint}"/>
                </DockPanel>

                <WrapPanel Grid.Row="1" Margin="0,0,0,12" Orientation="Horizontal">

                    <StackPanel Width="220" Margin="0,0,12,10">
                        <TextBlock Text="{DynamicResource Str.Quality.Source}" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource PathTextBox}" Text="{Binding BaselineSourceName, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Width="132" Margin="0,0,12,10">
                        <TextBlock Text="{DynamicResource Str.Col.Overall}" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource PathTextBox}" Text="{Binding MinimumOverallScore, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Width="132" Margin="0,0,12,10">
                        <TextBlock Text="{DynamicResource Str.Col.Completeness}" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource PathTextBox}" Text="{Binding MinimumCompleteness, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Width="132" Margin="0,0,12,10">
                        <TextBlock Text="{DynamicResource Str.Col.Validity}" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource PathTextBox}" Text="{Binding MinimumValidity, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Width="132" Margin="0,0,12,10">
                        <TextBlock Text="{DynamicResource Str.Col.Uniqueness}" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource PathTextBox}" Text="{Binding MinimumUniqueness, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Width="132" Margin="0,0,12,10">
                        <TextBlock Text="{DynamicResource Str.Col.Consistency}" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource PathTextBox}" Text="{Binding MinimumConsistency, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Width="132" Margin="0,0,12,10">
                        <TextBlock Text="{DynamicResource Str.Quality.Anomaly}" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource PathTextBox}" Text="{Binding MinimumAnomalyControl, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </WrapPanel>

                <WrapPanel Grid.Row="2">
                    <ui:Button Content="{DynamicResource Str.Quality.Load}" Click="LoadBaseline_Click" Height="32" Padding="12,0" FontSize="12" Margin="0,0,6,4"/>
                    <ui:Button Content="{DynamicResource Str.Quality.Save}" Click="SaveBaseline_Click" Height="32" Padding="12,0" FontSize="12" Margin="0,0,6,4"/>
                    <ui:Button Content="{DynamicResource Str.Quality.Delete}" Appearance="Danger" Click="DeleteBaseline_Click" Height="28" Padding="10,0" FontSize="12" Margin="0,0,6,4"/>
                    <ui:Button Content="{DynamicResource Str.Quality.Evaluate}" Appearance="Primary" Click="EvaluateBaseline_Click" Height="28" Padding="10,0" FontSize="12" Margin="0,0,0,4"/>
                </WrapPanel>

                <TextBox Grid.Row="3"
                         x:Name="EvaluationTextBox"
                         Margin="0,8,0,0"
                         MinHeight="72"
                         Style="{StaticResource TerminalTextBox}"
                         Text="{DynamicResource Str.Quality.EvalPlaceholder}"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource ToolPage}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Style="{StaticResource ToolPageHeaderBar}">
                    <TextBlock Text="{DynamicResource Str.Quality.Trend}" Style="{StaticResource SectionTitle}"/>
                </Border>

                <DataGrid Grid.Row="1"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          RowHeaderWidth="0"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ItemsSource="{Binding QualityTrend}"
                          Visibility="{Binding HasQualityTrend, Converter={StaticResource BoolToVis}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource Str.Col.Time}" Binding="{Binding TimeText}" Width="150"/>
                        <DataGridTextColumn Header="{DynamicResource Str.Col.Source}" Binding="{Binding SourceName}" Width="220"/>
                        <DataGridTextColumn Header="{DynamicResource Str.Col.Overall}" Binding="{Binding OverallText}" Width="80"/>
                        <DataGridTextColumn Header="{DynamicResource Str.Col.Completeness}" Binding="{Binding CompletenessText}" Width="80"/>
                        <DataGridTextColumn Header="{DynamicResource Str.Col.Validity}" Binding="{Binding ValidityText}" Width="80"/>
                        <DataGridTextColumn Header="{DynamicResource Str.Col.Uniqueness}" Binding="{Binding UniquenessText}" Width="80"/>
                        <DataGridTextColumn Header="{DynamicResource Str.Col.Consistency}" Binding="{Binding ConsistencyText}" Width="80"/>
                        <DataGridTextColumn Header="{DynamicResource Str.Col.Anomaly}" Binding="{Binding AnomalyControlText}" Width="90"/>
                        <DataGridTextColumn Header="{DynamicResource Str.Metric.Objects}" Binding="{Binding TotalObjects}" Width="90"/>
                        <DataGridTextColumn Header="{DynamicResource Str.Col.IssueCount}" Binding="{Binding IssueCount}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>

                <views:EmptyStateView Grid.Row="1"
                                      Title="{DynamicResource Str.Empty.NoTrend.Title}"
                                      Hint="{DynamicResource Str.Empty.NoTrend.Hint}"
                                      Visibility="{Binding HasQualityTrend, Converter={StaticResource InverseBoolToVis}}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
