<UserControl x:Class="ObjectAnalyzer.Desktop.Views.QualityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:ObjectAnalyzer.Desktop.Views">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:Card Margin="0,0,0,12" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="质量基线" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="按数据源保存最低质量阈值，并可立即评估当前分析结果。"
                               Style="{StaticResource SectionHint}"/>
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="数据源" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding BaselineSourceName, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="总分" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding MinimumOverallScore, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                        <TextBlock Text="完整性" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding MinimumCompleteness, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="0,0,8,0">
                        <TextBlock Text="有效性" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding MinimumValidity, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4" Margin="0,0,8,0">
                        <TextBlock Text="唯一性" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding MinimumUniqueness, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="5" Margin="0,0,8,0">
                        <TextBlock Text="一致性" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding MinimumConsistency, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="异常控制" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding MinimumAnomalyControl, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <WrapPanel Grid.Row="2" Margin="0,4,0,0">
                    <ui:Button Content="读取基线" Click="LoadBaseline_Click" Margin="0,0,8,0"/>
                    <ui:Button Content="保存基线" Click="SaveBaseline_Click" Margin="0,0,8,0"/>
                    <ui:Button Content="删除基线" Appearance="Danger" Click="DeleteBaseline_Click" Margin="0,0,8,0"/>
                    <ui:Button Content="评估当前结果" Appearance="Primary" Click="EvaluateBaseline_Click"/>
                </WrapPanel>

                <TextBox Grid.Row="3"
                         x:Name="EvaluationTextBox"
                         Margin="0,12,0,0"
                         MinHeight="88"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         FontFamily="Cascadia Mono, Consolas"
                         Foreground="{DynamicResource Brush.TextLabel}"
                         Text="评估结果会显示在这里。"/>
            </Grid>
        </ui:Card>

        <ui:Card Grid.Row="1" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="质量趋势" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>

                <DataGrid Grid.Row="1"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          ItemsSource="{Binding QualityTrend}"
                          Visibility="{Binding HasQualityTrend, Converter={StaticResource BoolToVis}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="时间" Binding="{Binding TimeText}" Width="150"/>
                        <DataGridTextColumn Header="数据源" Binding="{Binding SourceName}" Width="220"/>
                        <DataGridTextColumn Header="总分" Binding="{Binding OverallText}" Width="80"/>
                        <DataGridTextColumn Header="完整性" Binding="{Binding CompletenessText}" Width="80"/>
                        <DataGridTextColumn Header="有效性" Binding="{Binding ValidityText}" Width="80"/>
                        <DataGridTextColumn Header="唯一性" Binding="{Binding UniquenessText}" Width="80"/>
                        <DataGridTextColumn Header="一致性" Binding="{Binding ConsistencyText}" Width="80"/>
                        <DataGridTextColumn Header="异常控制" Binding="{Binding AnomalyControlText}" Width="90"/>
                        <DataGridTextColumn Header="对象数" Binding="{Binding TotalObjects}" Width="90"/>
                        <DataGridTextColumn Header="问题数" Binding="{Binding IssueCount}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>

                <views:EmptyStateView Grid.Row="1"
                                      Glyph="◎"
                                      Title="暂无质量趋势"
                                      Hint="完成并保存分析作业后，质量快照会在此形成趋势记录。"
                                      Visibility="{Binding HasQualityTrend, Converter={StaticResource InverseBoolToVis}}"/>
            </Grid>
        </ui:Card>
    </Grid>
</UserControl>
