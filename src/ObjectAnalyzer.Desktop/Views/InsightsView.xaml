<UserControl x:Class="ObjectAnalyzer.Desktop.Views.InsightsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Border Style="{StaticResource ToolPage}">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Border Style="{StaticResource ToolPageHeaderBar}"><StackPanel>
    <TextBlock Text="{DynamicResource Str.Tab.Insights}" Style="{StaticResource SectionTitle}"/>
    <TextBlock Text="{DynamicResource Str.Insights.Hint}" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
   </StackPanel></Border>
   <ListBox Grid.Row="1" x:Name="Dimensions" SelectionChanged="Dimension_Changed" Margin="10" BorderThickness="0" Background="Transparent">
    <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
     <Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="0,0,6,4"/>
     <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
      <Border x:Name="TabBorder" BorderThickness="0,0,0,3" BorderBrush="Transparent" Background="{DynamicResource Brush.Surface}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
      <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource Brush.Primary}"/><Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource Brush.RowAlt}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger></ControlTemplate.Triggers>
     </ControlTemplate></Setter.Value></Setter>
    </Style></ListBox.ItemContainerStyle>
    <ListBoxItem Tag="Lineage" Content="{DynamicResource Str.Insights.Lineage}"/>
    <ListBoxItem Tag="Impact" Content="{DynamicResource Str.Insights.Impact}"/>
    <ListBoxItem Tag="SchemaImpact" Content="{DynamicResource Str.Insights.SchemaImpact}"/>
    <ListBoxItem Tag="Regression" Content="{DynamicResource Str.Insights.Regression}"/>   </ListBox>
   <Grid Grid.Row="2" Margin="16,0,16,16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock x:Name="ResultTitle" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
    <StackPanel Grid.Row="1" x:Name="MissingPanel" VerticalAlignment="Top" Margin="0,12">
     <TextBlock Text="{DynamicResource Str.Insights.Missing}" FontSize="16" FontWeight="SemiBold"/>
     <TextBlock x:Name="MissingHint" TextWrapping="Wrap" Margin="0,10,0,16" Foreground="{DynamicResource Brush.TextMuted}"/>
     <Button x:Name="ConfigureButton" Content="{DynamicResource Str.Insights.OpenReports}" Click="OpenReports_Click" HorizontalAlignment="Left" Padding="16,8"/>
    </StackPanel>
    <DataGrid Grid.Row="1" x:Name="RelationsGrid" Visibility="Collapsed" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeaderWidth="0" MinRowHeight="32">
     <DataGrid.Columns>
      <DataGridTextColumn Header="{DynamicResource Str.Insights.Path}" Binding="{Binding Path}" Width="2*"/>
      <DataGridTextColumn Header="{DynamicResource Str.Insights.Kind}" Binding="{Binding Kind}" Width="*"/>
      <DataGridTextColumn Header="{DynamicResource Str.Insights.Occurrences}" Binding="{Binding OccurrenceCount}" Width="*"/>
      <DataGridTextColumn Header="{DynamicResource Str.Insights.NonNull}" Binding="{Binding NonNullCount}" Width="*"/>
      <DataGridTextColumn Header="{DynamicResource Str.Insights.Targets}" Binding="{Binding Targets}" Width="3*"/>
     </DataGrid.Columns>
     <DataGrid.Resources><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="VerticalAlignment" Value="Center"/></Style></DataGrid.Resources>
    </DataGrid>
    <TextBox Grid.Row="1" x:Name="ResultTextBox" Visibility="Collapsed" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="13" Padding="12"
      Background="{DynamicResource Brush.Surface}" Foreground="{DynamicResource Brush.TextPrimary}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
   </Grid>
  </Grid>
 </Border>
</UserControl>
