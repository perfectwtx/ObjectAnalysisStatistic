<UserControl x:Class="ObjectAnalyzer.Desktop.Views.InsightsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
    <Border Style="{StaticResource ToolPage}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Style="{StaticResource ToolPageHeaderBar}">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Right">
                        <ui:Button Content="{DynamicResource Str.Insights.Lineage}" Click="ShowLineage_Click" Height="30" Padding="12,0" FontSize="12" Margin="0,0,4,0"/>
                        <ui:Button Content="{DynamicResource Str.Insights.Impact}" Click="ShowImpact_Click" Height="30" Padding="12,0" FontSize="12" Margin="0,0,4,0"/>
                        <ui:Button Content="{DynamicResource Str.Insights.SchemaImpact}" Click="ShowSchemaImpact_Click" Height="30" Padding="12,0" FontSize="12" Margin="0,0,4,0"/>
                        <ui:Button Content="{DynamicResource Str.Insights.Regression}" Click="ShowRegression_Click" Height="30" Padding="12,0" FontSize="12"/>
                    </WrapPanel>
                    <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Str.Tab.Insights}" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="{DynamicResource Str.Insights.Hint}" Style="{StaticResource SectionHint}"/>
                </DockPanel>
            </Border>
            <TextBox Grid.Row="1"
                     Margin="10"
                     x:Name="ResultTextBox"
                     Style="{StaticResource TerminalTextBox}"
                     VerticalAlignment="Stretch"
                     Text="{DynamicResource Str.Insights.Placeholder}"/>
        </Grid>
    </Border>
</UserControl>
