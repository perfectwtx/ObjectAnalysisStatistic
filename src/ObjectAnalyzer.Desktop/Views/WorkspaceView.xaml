<UserControl x:Class="ObjectAnalyzer.Desktop.Views.WorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="800" HorizontalAlignment="Left">
            <TextBlock Text="{DynamicResource Str.Tab.Workspace}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{DynamicResource Str.Workspace.Subtitle}" Style="{StaticResource PageSubtitle}" Margin="0,0,0,16"/>

            <ui:Card Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str.Language}" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="{DynamicResource Str.Workspace.LanguageHint}" Style="{StaticResource SectionHint}"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="LangZhRadio" GroupName="Language" Margin="0,0,20,0"
                                     Content="{DynamicResource Str.Lang.Zh}"
                                     Checked="LanguageRadio_Checked"/>
                        <RadioButton x:Name="LangEnRadio" GroupName="Language"
                                     Content="{DynamicResource Str.Lang.En}"
                                     Checked="LanguageRadio_Checked"/>
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str.Theme}" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="{DynamicResource Str.Workspace.ThemeHint}" Style="{StaticResource SectionHint}"/>
                    <StackPanel>
                        <RadioButton x:Name="ThemeLightRadio" GroupName="Theme" Margin="0,0,0,8"
                                     Content="{DynamicResource Str.Theme.Light}"
                                     Checked="ThemeRadio_Checked"/>
                        <RadioButton x:Name="ThemeDarkRadio" GroupName="Theme" Margin="0,0,0,8"
                                     Content="{DynamicResource Str.Theme.Dark}"
                                     Checked="ThemeRadio_Checked"/>
                        <RadioButton x:Name="ThemeSystemRadio" GroupName="Theme" Margin="0,0,0,8"
                                     Content="{DynamicResource Str.Theme.System}"
                                     Checked="ThemeRadio_Checked"/>
                        <RadioButton x:Name="ThemeEyeCareRadio" GroupName="Theme"
                                     Content="{DynamicResource Str.Theme.EyeCare}"
                                     Checked="ThemeRadio_Checked"/>
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str.Workspace.LocalTitle}" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="{DynamicResource Str.Workspace.LocalHint}" Style="{StaticResource SectionHint}"/>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Text="{DynamicResource Str.Workspace.DataDir}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextLabel}" FontSize="13"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="DataDirectoryTextBox"
                                 IsReadOnly="True" Margin="0,0,10,10"/>
                        <ui:Button Grid.Row="0" Grid.Column="2" Content="{DynamicResource Str.Workspace.OpenDir}" Click="OpenDataDirectory_Click"
                                Margin="0,0,0,10">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="FolderOpen24"/>
                            </ui:Button.Icon>
                        </ui:Button>

                        <TextBlock Grid.Row="1" Text="{DynamicResource Str.Workspace.Database}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextLabel}" FontSize="13"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="DatabasePathTextBox"
                                 IsReadOnly="True" Margin="0,0,10,10"/>
                        <ui:Button Grid.Row="1" Grid.Column="2" Content="{DynamicResource Str.Workspace.OpenLocation}" Click="OpenDatabaseLocation_Click"
                                Margin="0,0,0,10">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="FolderOpen24"/>
                            </ui:Button.Icon>
                        </ui:Button>

                        <TextBlock Grid.Row="2" Text="{DynamicResource Str.Workspace.ReportsDir}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextLabel}" FontSize="13"/>
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="ReportsDirectoryTextBox"
                                 IsReadOnly="True" Margin="0,0,10,0"/>
                        <ui:Button Grid.Row="2" Grid.Column="2" Content="{DynamicResource Str.Workspace.OpenDir}" Click="OpenReportsDirectory_Click" Margin="0">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="FolderOpen24"/>
                            </ui:Button.Icon>
                        </ui:Button>
                    </Grid>
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str.Workspace.RuntimeTitle}" Style="{StaticResource SectionTitle}"/>
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Text="{DynamicResource Str.Workspace.AppVersion}" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,0,10"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="AppVersionTextBlock"
                                   Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,10"/>
                        <TextBlock Grid.Row="1" Text=".NET" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,0,10"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DotnetVersionTextBlock"
                                   Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,10"/>
                        <TextBlock Grid.Row="2" Text="{DynamicResource Str.Workspace.OS}" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,0,10"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="OsVersionTextBlock"
                                   Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="3" Text="{DynamicResource Str.Workspace.Runtime}" Foreground="{DynamicResource Brush.TextSecondary}"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="RuntimeTextBlock"
                                   Foreground="{DynamicResource Brush.TextPrimary}"/>
                    </Grid>
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
