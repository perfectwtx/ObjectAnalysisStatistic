<UserControl x:Class="ObjectAnalyzer.Desktop.Views.WorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
        <StackPanel>
            <Border Background="White" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="本地工作区" FontSize="18" FontWeight="SemiBold" Foreground="#182230"/>
                    <TextBlock Text="Desktop 的分析状态、作业历史与报告都保存在当前 Windows 用户目录。" Foreground="#667085" Margin="0,6,0,16" TextWrapping="Wrap"/>

                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Text="数据目录" VerticalAlignment="Center" Foreground="#475467"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="DataDirectoryTextBox" IsReadOnly="True" Margin="0,0,10,8"/>
                        <Button Grid.Row="0" Grid.Column="2" Content="打开目录" Click="OpenDataDirectory_Click"/>
                        <TextBlock Grid.Row="1" Text="SQLite 数据库" VerticalAlignment="Center" Foreground="#475467"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="DatabasePathTextBox" IsReadOnly="True" Margin="0,0,10,8"/>
                        <Button Grid.Row="1" Grid.Column="2" Content="打开位置" Click="OpenDatabaseLocation_Click"/>
                        <TextBlock Grid.Row="2" Text="报告目录" VerticalAlignment="Center" Foreground="#475467"/>
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="ReportsDirectoryTextBox" IsReadOnly="True" Margin="0,0,10,0"/>
                        <Button Grid.Row="2" Grid.Column="2" Content="打开目录" Click="OpenReportsDirectory_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="White" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="10" Padding="18">
                <StackPanel>
                    <TextBlock Text="运行环境" FontSize="18" FontWeight="SemiBold" Foreground="#182230"/>
                    <Grid Margin="0,14,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Text="应用版本" Foreground="#667085" Margin="0,0,0,10"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="AppVersionTextBlock" Margin="0,0,0,10"/>
                        <TextBlock Grid.Row="1" Text=".NET" Foreground="#667085" Margin="0,0,0,10"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DotnetVersionTextBlock" Margin="0,0,0,10"/>
                        <TextBlock Grid.Row="2" Text="操作系统" Foreground="#667085" Margin="0,0,0,10"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="OsVersionTextBlock" Margin="0,0,0,10" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="3" Text="运行时" Foreground="#667085"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="RuntimeTextBlock"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>