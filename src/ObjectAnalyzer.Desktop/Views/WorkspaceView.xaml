<UserControl x:Class="ObjectAnalyzer.Desktop.Views.WorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
        <StackPanel>
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="本地工作区" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="Desktop 的分析状态、作业历史与报告都保存在当前 Windows 用户目录。"
                               Style="{StaticResource SectionHint}"/>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Text="数据目录" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextLabel}" FontSize="13"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="DataDirectoryTextBox"
                                 IsReadOnly="True" Margin="0,0,10,10"/>
                        <Button Grid.Row="0" Grid.Column="2" Content="打开目录" Click="OpenDataDirectory_Click"
                                Margin="0,0,0,10"/>

                        <TextBlock Grid.Row="1" Text="SQLite 数据库" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextLabel}" FontSize="13"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="DatabasePathTextBox"
                                 IsReadOnly="True" Margin="0,0,10,10"/>
                        <Button Grid.Row="1" Grid.Column="2" Content="打开位置" Click="OpenDatabaseLocation_Click"
                                Margin="0,0,0,10"/>

                        <TextBlock Grid.Row="2" Text="报告目录" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextLabel}" FontSize="13"/>
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="ReportsDirectoryTextBox"
                                 IsReadOnly="True" Margin="0,0,10,0"/>
                        <Button Grid.Row="2" Grid.Column="2" Content="打开目录" Click="OpenReportsDirectory_Click"
                                Margin="0"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="运行环境" Style="{StaticResource SectionTitle}"/>
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Text="应用版本" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,0,10"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="AppVersionTextBlock"
                                   Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,10"/>
                        <TextBlock Grid.Row="1" Text=".NET" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,0,10"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DotnetVersionTextBlock"
                                   Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,10"/>
                        <TextBlock Grid.Row="2" Text="操作系统" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,0,10"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="OsVersionTextBlock"
                                   Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="3" Text="运行时" Foreground="{DynamicResource Brush.TextSecondary}"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="RuntimeTextBlock"
                                   Foreground="{DynamicResource Brush.TextPrimary}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
