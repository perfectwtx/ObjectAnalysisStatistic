<UserControl x:Class="ObjectAnalyzer.Desktop.Views.OutputView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:ObjectAnalyzer.Desktop.Views">
    <Border Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1"
            CornerRadius="2"
            Padding="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Terminal title bar -->
            <Border Background="{DynamicResource Brush.HeaderBg}"
                    CornerRadius="2,2,0,0"
                    Padding="10,6"
                    BorderBrush="{DynamicResource Brush.BorderSubtle}"
                    BorderThickness="0,0,0,1">
                <DockPanel>
                    <TextBlock Text="pipeline · stdout"
                               FontFamily="Cascadia Mono, Consolas"
                               FontSize="11"
                               Foreground="{DynamicResource Brush.Primary}"
                               VerticalAlignment="Center"/>
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding Progress, StringFormat={}{0:0}%}"
                               FontFamily="Cascadia Mono, Consolas"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Primary}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <ProgressBar Grid.Row="1"
                         Style="{StaticResource CyanProgressBar}"
                         Margin="12,10,12,8"
                         Value="{Binding Progress, Mode=OneWay}"/>

            <Grid Grid.Row="2" Margin="12,0,12,12">
                <TextBox Style="{StaticResource TerminalTextBox}"
                         Text="{Binding OutputText, Mode=OneWay}"
                         Visibility="{Binding HasOutput, Converter={StaticResource BoolToVis}}"/>

                <views:EmptyStateView Glyph="›_"
                                      Title="等待分析日志"
                                      Hint="点击「开始分析」后，管线日志会实时出现在这里。"
                                      Visibility="{Binding HasOutput, Converter={StaticResource InverseBoolToVis}}"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
