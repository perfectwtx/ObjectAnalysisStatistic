<UserControl x:Class="ObjectAnalyzer.Desktop.Views.OutputView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:ObjectAnalyzer.Desktop.Views">
 <Border Style="{StaticResource ToolPage}">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border Style="{StaticResource ToolPageHeaderBar}"><StackPanel>
    <TextBlock Text="{DynamicResource Str.Output.Title}" Style="{StaticResource SectionTitle}"/>
    <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,4,0,8" TextWrapping="Wrap"/>
    <WrapPanel>
     <Button Content="{DynamicResource Str.Output.Copy}" Click="Copy_Click" IsEnabled="{Binding HasOutput}" Margin="0,0,6,4" Padding="12,6"/>
     <Button Content="{DynamicResource Str.Output.Save}" Click="Save_Click" IsEnabled="{Binding HasOutput}" Margin="0,0,6,4" Padding="12,6"/>
     <Button Content="{DynamicResource Str.Output.Clear}" Click="Clear_Click" IsEnabled="{Binding HasOutput}" Margin="0,0,16,4" Padding="12,6"/>
     <CheckBox x:Name="FollowOutput" Content="{DynamicResource Str.Output.Follow}" IsChecked="True" VerticalAlignment="Center" Margin="0,0,0,4" Checked="Follow_Checked"/>
    </WrapPanel>
   </StackPanel></Border>
   <ProgressBar Grid.Row="1" Style="{StaticResource CyanProgressBar}" Height="3" Value="{Binding Progress, Mode=OneWay}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
   <Grid Grid.Row="2" Margin="10">
    <TextBox x:Name="LogTextBox" Text="{Binding OutputText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Padding="12" FontFamily="Consolas" FontSize="13"
      Background="{DynamicResource Brush.Surface}" Foreground="{DynamicResource Brush.TextPrimary}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" TextChanged="Log_TextChanged"
      Visibility="{Binding HasOutput, Converter={StaticResource BoolToVis}}"/>
    <views:EmptyStateView Title="{DynamicResource Str.Empty.NoOutput.Title}" Hint="{DynamicResource Str.Empty.NoOutput.Hint}" Visibility="{Binding HasOutput, Converter={StaticResource InverseBoolToVis}}"/>
   </Grid>
   <TextBlock Grid.Row="3" x:Name="ActionStatus" Margin="12,0,12,10" Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap"/>
  </Grid>
 </Border>
</UserControl>
