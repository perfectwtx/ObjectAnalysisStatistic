<UserControl x:Class="ObjectAnalyzer.Desktop.Views.OutputView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ObjectAnalyzer.Desktop.Views">
    <Border Style="{StaticResource CardBorder}" Margin="0,8,0,0" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,8">
                <TextBlock Text="分析输出" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="实时显示分析管线日志与进度。" Style="{StaticResource SectionHint}"/>
            </StackPanel>
            <ProgressBar Grid.Row="1" Margin="0,0,0,12" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}"/>

            <Grid Grid.Row="2">
                <TextBox IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Background="{DynamicResource Brush.ConsoleBg}"
                         Foreground="{DynamicResource Brush.ConsoleFg}"
                         CaretBrush="{DynamicResource Brush.ConsoleFg}"
                         FontFamily="Cascadia Mono, Consolas"
                         FontSize="12"
                         Padding="14"
                         Text="{Binding OutputText, Mode=OneWay}"
                         Visibility="{Binding HasOutput, Converter={StaticResource BoolToVis}}"/>

                <views:EmptyStateView Glyph="›_"
                                      Title="等待分析日志"
                                      Hint="点击「开始分析」后，管线日志会实时出现在这里。"
                                      Visibility="{Binding HasOutput, Converter={StaticResource InverseBoolToVis}}"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
