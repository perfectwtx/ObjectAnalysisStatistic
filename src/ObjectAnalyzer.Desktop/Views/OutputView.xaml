<UserControl x:Class="ObjectAnalyzer.Desktop.Views.OutputView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ObjectAnalyzer.Desktop.Views">
    <Border Style="{StaticResource ToolPage}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Style="{StaticResource ToolPageHeaderBar}">
                <DockPanel>
                    <TextBlock Text="{DynamicResource Str.Output.Title}"
                               FontFamily="Cascadia Mono, Consolas"
                               FontSize="11"
                               Foreground="{DynamicResource Brush.Primary}"
                               VerticalAlignment="Center"/>
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding Progress, StringFormat={}{0:0}%}"
                               FontFamily="Cascadia Mono, Consolas"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Primary}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <ProgressBar Grid.Row="1"
                         Style="{StaticResource CyanProgressBar}"
                         Height="3"
                         Value="{Binding Progress, Mode=OneWay}"/>

            <Grid Grid.Row="2">
                <TextBox Style="{StaticResource TerminalTextBox}"
                         Text="{Binding OutputText, Mode=OneWay}"
                         Visibility="{Binding HasOutput, Converter={StaticResource BoolToVis}}"/>

                <views:EmptyStateView Title="{DynamicResource Str.Empty.NoOutput.Title}"
                                      Hint="{DynamicResource Str.Empty.NoOutput.Hint}"
                                      Visibility="{Binding HasOutput, Converter={StaticResource InverseBoolToVis}}"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
