<UserControl x:Class="ObjectAnalyzer.Desktop.Views.AnalyzeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="10">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource HudPanel}" Padding="14">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Str.Analyze.DataFile}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>

                        <TextBlock Text="{DynamicResource Str.Analyze.FilePath}" Style="{StaticResource FieldLabel}"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="InputPathTextBox"
                                     Style="{StaticResource PathTextBox}"
                                     Text="{Binding InputPath, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{Binding InputPath}"
                                     AllowDrop="True"
                                     DragOver="InputPathTextBox_DragOver"
                                     Drop="InputPathTextBox_Drop"/>
                            <ui:Button Grid.Column="1" Content="{DynamicResource Str.SelectFile}" Click="SelectFile_Click"
                                       Margin="8,0,0,0" Height="32" Padding="12,0" FontSize="12">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="FolderOpen24"/>
                                </ui:Button.Icon>
                            </ui:Button>
                        </Grid>

                        <TextBlock Text="{DynamicResource Str.RecentFiles}" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding RecentFiles}"
                                  MinHeight="32"
                                  SelectionChanged="RecentFiles_SelectionChanged"
                                  MaxDropDownHeight="240"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource HudPanel}" Padding="14">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Str.Analyze.RulesOutput}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>

                        <TextBlock Text="{DynamicResource Str.Analyze.RulesFile}" Style="{StaticResource FieldLabel}"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="RulesPathTextBox"
                                     Style="{StaticResource PathTextBox}"
                                     Text="{Binding RulesPath, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{Binding RulesPath}"/>
                            <ui:Button Grid.Column="1" Content="{DynamicResource Str.Analyze.SelectRules}" Click="SelectRules_Click"
                                       Margin="8,0,0,0" Height="32" Padding="12,0" FontSize="12">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="DocumentBulletList24"/>
                                </ui:Button.Icon>
                            </ui:Button>
                        </Grid>

                        <TextBlock Text="{DynamicResource Str.Analyze.ReportFormat}" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="ReportFormatComboBox"
                                  MinHeight="32"
                                  Width="180"
                                  HorizontalAlignment="Left"
                                  SelectedIndex="0"
                                  SelectionChanged="ReportFormatComboBox_SelectionChanged">
                            <ComboBoxItem Content="JSON" Tag="json"/>
                            <ComboBoxItem Content="HTML" Tag="html"/>
                            <ComboBoxItem Content="Markdown" Tag="md"/>
                            <ComboBoxItem Content="CSV" Tag="csv"/>
                            <ComboBoxItem Content="Excel" Tag="xlsx"/>
                        </ComboBox>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource HudPanel}" Margin="0,0,0,12" Padding="14">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str.Analyze.Options}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>

                    <WrapPanel Margin="0,0,0,8">
                        <CheckBox Content="{DynamicResource Str.Analyze.Opt.Correlation}" IsChecked="{Binding EnableCorrelation}" Margin="0,0,16,6"/>
                        <CheckBox Content="{DynamicResource Str.Analyze.Opt.StringPatterns}" IsChecked="{Binding EnableStringPatterns}" Margin="0,0,16,6"/>
                        <CheckBox Content="{DynamicResource Str.Analyze.Opt.Unicode}" IsChecked="{Binding EnableUnicodeHygiene}" Margin="0,0,16,6"/>
                        <CheckBox Content="{DynamicResource Str.Analyze.Opt.TimeSeries}" IsChecked="{Binding EnableTimeSeries}" Margin="0,0,16,6"/>
                        <CheckBox Content="{DynamicResource Str.Analyze.Opt.Distribution}" IsChecked="{Binding EnableDistributionSnapshot}" Margin="0,0,16,6"/>
                    </WrapPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Str.Analyze.FuzzyField}" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding FuzzyDedupField, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource PathTextBox}"
                                     ToolTip="{DynamicResource Str.Analyze.FuzzyFieldHint}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource Str.Analyze.SampleReservoir}" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding SampleReservoirText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource PathTextBox}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ToolPage}" Margin="0,0,0,2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center" Margin="10,8">
                        <TextBlock Text="{Binding Status}"
                                   FontSize="12"
                                   FontFamily="Cascadia Mono, Consolas, Segoe UI"
                                   Foreground="{DynamicResource Brush.TextPrimary}"/>
                        <ProgressBar Style="{StaticResource CyanProgressBar}"
                                     Margin="0,8,16,4"
                                     Value="{Binding Progress, Mode=OneWay}"/>
                        <TextBlock Text="{Binding ReportPath}"
                                   Foreground="{DynamicResource Brush.TextMuted}"
                                   FontFamily="Cascadia Mono, Consolas"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding ReportPath}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <ui:Button x:Name="AnalyzeButton"
                                   Content="{DynamicResource Str.StartAnalysis}"
                                   Appearance="Primary"
                                   Click="Analyze_Click"
                                   Height="32"
                                   Margin="8,0,6,0"
                                   Padding="12,0"
                                   FontSize="12">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Play24"/>
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button x:Name="CancelButton"
                                   Content="{DynamicResource Str.Analyze.Cancel}"
                                   Appearance="Danger"
                                   Click="CancelAnalysis_Click"
                                   Height="32"
                                   IsEnabled="False"
                                   Margin="0,0,6,0"
                                   Padding="12,0"
                                   FontSize="12">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Dismiss24"/>
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button Content="{DynamicResource Str.OpenReport}"
                                   Click="OpenReport_Click"
                                   Height="32"
                                   Margin="0,0,6,0"
                                   Padding="12,0"
                                   FontSize="12"
                                   IsEnabled="{Binding HasReport}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Document24"/>
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button Content="{DynamicResource Str.Analyze.ReportFolder}"
                                   Click="OpenReportFolder_Click"
                                   Height="32"
                                   Padding="12,0"
                                   FontSize="12">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="FolderOpen24"/>
                            </ui:Button.Icon>
                        </ui:Button>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
