<UserControl x:Class="ObjectAnalyzer.Desktop.Views.AnalyzeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="开始分析" Style="{StaticResource PageTitle}" Margin="0,0,0,4"/>
            <TextBlock Text="选择数据文件、可选规则与报告格式，然后启动本地分析。"
                       Style="{StaticResource PageSubtitle}" Margin="0,0,0,16"/>

            <ui:Card Padding="20" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="数据文件" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="支持 JSON / JSONL / CSV / Excel / XML / YAML 及压缩包。可拖拽到路径框。"
                               Style="{StaticResource SectionHint}" Margin="0,0,0,12"/>

                    <TextBlock Text="文件路径" Style="{StaticResource FieldLabel}"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="InputPathTextBox"
                                 Style="{StaticResource PathTextBox}"
                                 Text="{Binding InputPath, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{Binding InputPath}"
                                 AllowDrop="True"
                                 DragOver="InputPathTextBox_DragOver"
                                 Drop="InputPathTextBox_Drop"/>
                        <ui:Button Grid.Column="1" Content="选择文件" Click="SelectFile_Click"
                                   Margin="10,0,0,0" Height="36">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="FolderOpen24"/>
                            </ui:Button.Icon>
                        </ui:Button>
                    </Grid>

                    <TextBlock Text="最近文件" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding RecentFiles}"
                              SelectionChanged="RecentFiles_SelectionChanged"
                              MaxDropDownHeight="240"
                              Margin="0,0,0,0"/>
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="20" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="规则与输出" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="规则文件对应 CLI 的 -r；报告类型按扩展名生成（json / html / md / csv / xlsx）。"
                               Style="{StaticResource SectionHint}" Margin="0,0,0,12"/>

                    <TextBlock Text="规则文件（可选）" Style="{StaticResource FieldLabel}"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="RulesPathTextBox"
                                 Style="{StaticResource PathTextBox}"
                                 Text="{Binding RulesPath, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{Binding RulesPath}"/>
                        <ui:Button Grid.Column="1" Content="选择规则" Click="SelectRules_Click"
                                   Margin="10,0,0,0" Height="36">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="DocumentBulletList24"/>
                            </ui:Button.Icon>
                        </ui:Button>
                    </Grid>

                    <TextBlock Text="报告格式" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="ReportFormatComboBox"
                              Width="200"
                              HorizontalAlignment="Left"
                              SelectedIndex="0"
                              SelectionChanged="ReportFormatComboBox_SelectionChanged">
                        <ComboBoxItem Content="JSON（可回读到工作台）" Tag="json"/>
                        <ComboBoxItem Content="HTML" Tag="html"/>
                        <ComboBoxItem Content="Markdown" Tag="md"/>
                        <ComboBoxItem Content="CSV" Tag="csv"/>
                        <ComboBoxItem Content="Excel" Tag="xlsx"/>
                    </ComboBox>
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="20" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Status}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.TextPrimary}"/>
                        <ProgressBar Margin="0,10,0,6" Height="8"
                                     Minimum="0" Maximum="100"
                                     Value="{Binding Progress, Mode=OneWay}"/>
                        <TextBlock Text="{Binding ReportPath}"
                                   Foreground="{DynamicResource Brush.TextMuted}"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding ReportPath}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button x:Name="AnalyzeButton"
                                   Content="开始分析"
                                   Appearance="Primary"
                                   Click="Analyze_Click"
                                   Height="40"
                                   Margin="16,0,8,0"
                                   Padding="20,0">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Play24"/>
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button x:Name="CancelButton"
                                   Content="取消"
                                   Appearance="Danger"
                                   Click="CancelAnalysis_Click"
                                   Height="40"
                                   IsEnabled="False"
                                   Margin="0,0,8,0">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Dismiss24"/>
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button Content="打开报告"
                                   Click="OpenReport_Click"
                                   Height="40"
                                   IsEnabled="{Binding HasReport}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Document24"/>
                            </ui:Button.Icon>
                        </ui:Button>
                    </StackPanel>
                </Grid>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
