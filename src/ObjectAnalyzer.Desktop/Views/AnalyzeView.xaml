<UserControl x:Class="ObjectAnalyzer.Desktop.Views.AnalyzeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="{DynamicResource Str.Analyze.PageTitle}" Style="{StaticResource PageTitle}" Margin="0,0,0,4"/>
            <TextBlock Text="{DynamicResource Str.Analyze.PageSubtitle}"
                       Style="{StaticResource PageSubtitle}" Margin="0,0,0,18"/>

            <Border Style="{StaticResource HudPanel}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="数据源" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="{DynamicResource Str.Analyze.DataFileHint}"
                               Style="{StaticResource SectionHint}"/>

                    <TextBlock Text="{DynamicResource Str.Analyze.FilePath}" Style="{StaticResource FieldLabel}"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="InputPathTextBox"
                                 Style="{StaticResource PathTextBox}"
                                 Text="{Binding InputPath, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{Binding InputPath}"
                                 AllowDrop="True"
                                 DragOver="InputPathTextBox_DragOver"
                                 Drop="InputPathTextBox_Drop"/>
                        <ui:Button Grid.Column="1" Content="{DynamicResource Str.SelectFile}" Click="SelectFile_Click"
                                   Margin="10,0,0,0" Height="36">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="FolderOpen24"/>
                            </ui:Button.Icon>
                        </ui:Button>
                    </Grid>

                    <TextBlock Text="{DynamicResource Str.RecentFiles}" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding RecentFiles}"
                              SelectionChanged="RecentFiles_SelectionChanged"
                              MaxDropDownHeight="240"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource HudPanel}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="规则与报告" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="{DynamicResource Str.Analyze.RulesHint}"
                               Style="{StaticResource SectionHint}"/>

                    <TextBlock Text="{DynamicResource Str.Analyze.RulesFile}" Style="{StaticResource FieldLabel}"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="RulesPathTextBox"
                                 Style="{StaticResource PathTextBox}"
                                 Text="{Binding RulesPath, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{Binding RulesPath}"/>
                        <ui:Button Grid.Column="1" Content="{DynamicResource Str.Analyze.SelectRules}" Click="SelectRules_Click"
                                   Margin="10,0,0,0" Height="36">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="DocumentBulletList24"/>
                            </ui:Button.Icon>
                        </ui:Button>
                    </Grid>

                    <TextBlock Text="{DynamicResource Str.Analyze.ReportFormat}" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="ReportFormatComboBox"
                              Width="240"
                              HorizontalAlignment="Left"
                              SelectedIndex="0"
                              SelectionChanged="ReportFormatComboBox_SelectionChanged">
                        <ComboBoxItem Content="JSON" Tag="json"/>
                        <ComboBoxItem Content="HTML" Tag="html"/>
                        <ComboBoxItem Content="Markdown" Tag="md"/>
                        <ComboBoxItem Content="CSV" Tag="csv"/>
                        <ComboBoxItem Content="Excel" Tag="xlsx"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource HudPanel}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="分析选项" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="开启深度分析会增加耗时与内存；默认仅做字段统计与质量检查。"
                               Style="{StaticResource SectionHint}"/>

                    <WrapPanel Margin="0,0,0,10">
                        <CheckBox Content="相关性矩阵" IsChecked="{Binding EnableCorrelation}" Margin="0,0,16,8"/>
                        <CheckBox Content="字符串模式" IsChecked="{Binding EnableStringPatterns}" Margin="0,0,16,8"/>
                        <CheckBox Content="Unicode 卫生" IsChecked="{Binding EnableUnicodeHygiene}" Margin="0,0,16,8"/>
                        <CheckBox Content="时间序列" IsChecked="{Binding EnableTimeSeries}" Margin="0,0,16,8"/>
                        <CheckBox Content="分布快照" IsChecked="{Binding EnableDistributionSnapshot}" Margin="0,0,16,8"/>
                    </WrapPanel>

                    <TextBlock Text="模糊去重字段（可选）" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding FuzzyDedupField, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource PathTextBox}"
                             Margin="0,0,0,12"
                             ToolTip="填写字段名后启用模糊去重，例如 email 或 name"/>

                    <TextBlock Text="采样容量 SampleReservoir（0=全量）" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding SampleReservoirText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource PathTextBox}"
                             Width="160"
                             HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource HudPanel}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="运行状态" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding Status}"
                                   FontSize="14"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource Brush.TextPrimary}"/>
                        <ProgressBar Style="{StaticResource CyanProgressBar}"
                                     Margin="0,12,0,6"
                                     Value="{Binding Progress, Mode=OneWay}"/>
                        <TextBlock Text="{Binding ReportPath}"
                                   Foreground="{DynamicResource Brush.TextMuted}"
                                   FontFamily="Cascadia Mono, Consolas"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding ReportPath}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button x:Name="AnalyzeButton"
                                   Content="{DynamicResource Str.StartAnalysis}"
                                   Appearance="Primary"
                                   Click="Analyze_Click"
                                   Height="40"
                                   Margin="16,0,8,0"
                                   Padding="20,0">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Play24"/>
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button x:Name="CancelButton"
                                   Content="{DynamicResource Str.Analyze.Cancel}"
                                   Appearance="Danger"
                                   Click="CancelAnalysis_Click"
                                   Height="40"
                                   IsEnabled="False"
                                   Margin="0,0,8,0">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Dismiss24"/>
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button Content="{DynamicResource Str.OpenReport}"
                                   Click="OpenReport_Click"
                                   Height="40"
                                   Margin="0,0,8,0"
                                   IsEnabled="{Binding HasReport}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Document24"/>
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button Content="报告目录"
                                   Click="OpenReportFolder_Click"
                                   Height="40">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="FolderOpen24"/>
                            </ui:Button.Icon>
                        </ui:Button>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
