<UserControl x:Class="ObjectAnalyzer.Desktop.Views.SchemaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ObjectAnalyzer.Desktop.Views"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
    <Border Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1"
            CornerRadius="2"
            Padding="10"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,10">
                <TextBox DockPanel.Dock="Right"
                         Width="220"
                         Style="{StaticResource PathTextBox}"
                         Text="{Binding FieldFilter, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="按字段名 / 类型 / 语义过滤"/>
                <StackPanel>
                    <TextBlock Text="Schema / 字段结构" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="搜索 · 双击查看取值详情" Style="{StaticResource SectionHint}"/>
                </StackPanel>
            </DockPanel>

            <DataGrid Grid.Row="1"
                      x:Name="FieldsGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      ItemsSource="{Binding FilteredFields}"
                      MouseDoubleClick="FieldsGrid_MouseDoubleClick"
                      VerticalAlignment="Stretch"
                      Visibility="{Binding HasFilteredFields, Converter={StaticResource BoolToVis}}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="字段" Binding="{Binding FieldName}" Width="2*"/>
                    <DataGridTextColumn Header="类型" Binding="{Binding PrimaryType}" Width="*"/>
                    <DataGridTextColumn Header="覆盖率" Binding="{Binding CoverageText}" Width="*"/>
                    <DataGridTextColumn Header="非空" Binding="{Binding Count}" Width="*"/>
                    <DataGridTextColumn Header="空值" Binding="{Binding NullCount}" Width="*"/>
                    <DataGridTextColumn Header="唯一值" Binding="{Binding DistinctCount}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <views:EmptyStateView Grid.Row="1"
                                  VerticalAlignment="Top"
                                  HorizontalAlignment="Stretch"
                                  Glyph="▣"
                                  Title="没有匹配的 Schema 字段"
                                  Hint="调整搜索，或完成分析后再查看。"
                                  Visibility="{Binding HasFilteredFields, Converter={StaticResource InverseBoolToVis}}"/>
        </Grid>
    </Border>
</UserControl>
