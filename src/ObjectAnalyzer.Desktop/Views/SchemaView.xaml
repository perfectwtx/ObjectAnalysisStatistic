<UserControl x:Class="ObjectAnalyzer.Desktop.Views.SchemaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Margin="0,10,0,0" Background="White" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="10" Padding="16">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="Schema / 字段结构" FontSize="17" FontWeight="SemiBold"/>
                <TextBlock Text="查看字段类型、覆盖率与 Schema 演进结果。" Foreground="#667085" Margin="0,6,0,12"/>
            </StackPanel>
            <DataGrid Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" ItemsSource="{Binding Fields}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="字段" Binding="{Binding FieldName}" Width="2*"/>
                    <DataGridTextColumn Header="类型" Binding="{Binding PrimaryType}" Width="*"/>
                    <DataGridTextColumn Header="覆盖率" Binding="{Binding CoverageText}" Width="*"/>
                    <DataGridTextColumn Header="非空" Binding="{Binding Count}" Width="*"/>
                    <DataGridTextColumn Header="空值" Binding="{Binding NullCount}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</UserControl>