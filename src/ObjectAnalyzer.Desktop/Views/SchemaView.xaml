<UserControl x:Class="ObjectAnalyzer.Desktop.Views.SchemaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ObjectAnalyzer.Desktop.Views"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
    <Grid Margin="0">
        <Border Style="{StaticResource ToolPage}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Style="{StaticResource ToolPageHeaderBar}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{DynamicResource Str.Tab.Schema}" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="{DynamicResource Str.Schema.Description}"
                                       Margin="0,3,0,0" FontSize="11"
                                       Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="{DynamicResource Str.Schema.Source}" Foreground="{DynamicResource Brush.TextMuted}" FontSize="11"/>
                                <TextBlock Text="{Binding DisplayFileName}" Margin="6,0,0,0" FontSize="11"
                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           MaxWidth="360" ToolTip="{Binding InputPath}"/>
                                <TextBlock Text="  ·  " Foreground="{DynamicResource Brush.TextMuted}" FontSize="11"/>
                                <TextBlock Text="{Binding FieldCount, StringFormat={}{0:N0}}" FontSize="11" FontWeight="SemiBold" Margin="0,0,4,0"/>
                                <TextBlock Text="{DynamicResource Str.Schema.FieldCount}" Foreground="{DynamicResource Brush.TextMuted}" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="{DynamicResource Str.Filter.Tooltip}" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,4"/>
                        <TextBox Width="220" MinWidth="140" MaxWidth="220"
                                 VerticalAlignment="Top" MinHeight="30"
                                 Style="{StaticResource PathTextBox}"
                                 Text="{Binding FieldFilter, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{DynamicResource Str.Filter.Tooltip}"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <DataGrid Grid.Row="1" x:Name="FieldsGrid" Margin="10" AutoGenerateColumns="False"
                          IsReadOnly="True" CanUserAddRows="False" ItemsSource="{Binding FilteredFields}"
                          MouseDoubleClick="FieldsGrid_MouseDoubleClick" VerticalAlignment="Stretch"
                          RowHeaderWidth="0" MinRowHeight="32" EnableRowVirtualization="True"
                          EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          Visibility="{Binding HasFilteredFields, Converter={StaticResource BoolToVis}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource Str.Schema.FieldName}" Binding="{Binding FieldName}" Width="2*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    <Setter Property="ToolTip" Value="{Binding FieldName}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="{DynamicResource Str.Schema.InferredType}" Binding="{Binding PrimaryType}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    <Setter Property="ToolTip" Value="{Binding PrimaryType}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="{DynamicResource Str.Schema.SemanticType}" Binding="{Binding SemanticTypeDisplay}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    <Setter Property="ToolTip" Value="{Binding SemanticTypeDisplay}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="{DynamicResource Str.Schema.NonNull}" Binding="{Binding NonNullCount, StringFormat={}{0:N0}}" Width="*"/>
                        <DataGridTextColumn Header="{DynamicResource Str.Schema.Null}" Binding="{Binding NullCount, StringFormat={}{0:N0}}" Width="*"/>
                        <DataGridTextColumn Header="{DynamicResource Str.Schema.Distinct}" Binding="{Binding DistinctDisplayText}" Width="*"/>
                        <DataGridTextColumn Header="{DynamicResource Str.Schema.NumericRange}" Binding="{Binding NumericRangeDisplay}" Width="1.4*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    <Setter Property="ToolTip" Value="{Binding NumericRangeTooltip}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <views:EmptyStateView Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Stretch"
                                      Title="{DynamicResource Str.Empty.NoSchema.Title}"
                                      Hint="{DynamicResource Str.Empty.NoSchema.Hint}"
                                      Visibility="{Binding HasFilteredFields, Converter={StaticResource InverseBoolToVis}}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
