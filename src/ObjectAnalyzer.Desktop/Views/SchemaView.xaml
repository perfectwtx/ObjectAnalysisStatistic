<UserControl x:Class="ObjectAnalyzer.Desktop.Views.SchemaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ObjectAnalyzer.Desktop.Views"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
    <Border Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.BorderSubtle}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top">
                <TextBlock Text="Schema / 字段结构" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="查看字段类型、覆盖率与 Schema 演进结果。" Style="{StaticResource SectionHint}"/>
            </StackPanel>

            <DataGrid Grid.Row="1"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      ItemsSource="{Binding Fields}"
                      VerticalAlignment="Stretch"
                      Visibility="{Binding HasFields, Converter={StaticResource BoolToVis}}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="字段" Binding="{Binding FieldName}" Width="2*"/>
                    <DataGridTextColumn Header="类型" Binding="{Binding PrimaryType}" Width="*"/>
                    <DataGridTextColumn Header="覆盖率" Binding="{Binding CoverageText}" Width="*"/>
                    <DataGridTextColumn Header="非空" Binding="{Binding Count}" Width="*"/>
                    <DataGridTextColumn Header="空值" Binding="{Binding NullCount}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <views:EmptyStateView Grid.Row="1"
                                  VerticalAlignment="Top"
                                  HorizontalAlignment="Stretch"
                                  Glyph="▣"
                                  Title="暂无 Schema 数据"
                                  Hint="完成分析后，这里会展示字段类型与覆盖率结构。"
                                  Visibility="{Binding HasFields, Converter={StaticResource InverseBoolToVis}}"/>
        </Grid>
    </Border>
</UserControl>
