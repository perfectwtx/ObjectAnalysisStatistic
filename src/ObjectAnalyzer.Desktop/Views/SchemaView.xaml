<UserControl x:Class="ObjectAnalyzer.Desktop.Views.SchemaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource CardBorder}" Margin="0,8,0,0" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="Schema / 字段结构" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="查看字段类型、覆盖率与 Schema 演进结果。" Style="{StaticResource SectionHint}"/>
            </StackPanel>
            <DataGrid Grid.Row="1"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      ItemsSource="{Binding Fields}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="字段" Binding="{Binding FieldName}" Width="2*"/>
                    <DataGridTextColumn Header="类型" Binding="{Binding PrimaryType}" Width="*"/>
                    <DataGridTextColumn Header="覆盖率" Binding="{Binding CoverageText}" Width="*"/>
                    <DataGridTextColumn Header="非空" Binding="{Binding Count}" Width="*"/>
                    <DataGridTextColumn Header="空值" Binding="{Binding NullCount}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</UserControl>
