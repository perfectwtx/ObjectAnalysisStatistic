<UserControl x:Class="ObjectAnalyzer.Desktop.Views.SchemaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ObjectAnalyzer.Desktop.Views"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource KpiStrip}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource KpiCell}">
                    <StackPanel>
                        <TextBlock Text="对象总数" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding TotalObjects, StringFormat={}{0:N0}}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource KpiCell}">
                    <StackPanel>
                        <TextBlock Text="字段总数" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding FieldCount, StringFormat={}{0:N0}}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource KpiCellLast}">
                    <StackPanel>
                        <TextBlock Text="当前数据源" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding DisplayFileName}" Style="{StaticResource MetricValue}" FontSize="13"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding InputPath}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource ToolPage}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Style="{StaticResource ToolPageHeaderBar}">
                    <DockPanel LastChildFill="False">
                        <TextBox DockPanel.Dock="Right" Width="220" MinHeight="30"
                                 Style="{StaticResource PathTextBox}"
                                 Text="{Binding FieldFilter, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{DynamicResource Str.Filter.Tooltip}"/>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Str.Tab.Schema}" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="检查字段结构、推断类型与字段值分布。双击字段可查看详细统计。"
                                       Margin="0,3,12,0" FontSize="11"
                                       Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <DataGrid Grid.Row="1" x:Name="FieldsGrid" AutoGenerateColumns="False"
                          IsReadOnly="True" CanUserAddRows="False"
                          ItemsSource="{Binding FilteredFields}"
                          MouseDoubleClick="FieldsGrid_MouseDoubleClick"
                          VerticalAlignment="Stretch" RowHeaderWidth="0" MinRowHeight="32"
                          EnableRowVirtualization="True" EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          Visibility="{Binding HasFilteredFields, Converter={StaticResource BoolToVis}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="字段名称" Binding="{Binding FieldName}" Width="2*"/>
                        <DataGridTextColumn Header="推断类型" Binding="{Binding PrimaryType}" Width="*"/>
                        <DataGridTextColumn Header="语义类型" Binding="{Binding SemanticType}" Width="*"/>
                        <DataGridTextColumn Header="非空值" Binding="{Binding Count}" Width="*"/>
                        <DataGridTextColumn Header="空值" Binding="{Binding NullCount}" Width="*"/>
                        <DataGridTextColumn Header="唯一值" Binding="{Binding DistinctCount}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
                <views:EmptyStateView Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Stretch"
                                      Title="{DynamicResource Str.Empty.NoSchema.Title}"
                                      Hint="{DynamicResource Str.Empty.NoSchema.Hint}"
                                      Visibility="{Binding HasFilteredFields, Converter={StaticResource InverseBoolToVis}}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
