<UserControl x:Class="ObjectAnalyzer.Desktop.Views.DuplicateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Margin="0,10,0,0" Background="White" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="10" Padding="16">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="重复分析" FontSize="17" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding DuplicateSummary}" Foreground="#667085" Margin="0,6,0,12"/>
            </StackPanel>
            <DataGrid Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" ItemsSource="{Binding Duplicates}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="对象哈希/摘要" Binding="{Binding Key}" Width="3*"/>
                    <DataGridTextColumn Header="重复次数" Binding="{Binding Count}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</UserControl>