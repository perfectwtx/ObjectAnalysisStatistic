<UserControl x:Class="ObjectAnalyzer.Desktop.Views.DuplicateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ObjectAnalyzer.Desktop.Views"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
    <Border Style="{StaticResource ToolPage}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Style="{StaticResource ToolPageHeaderBar}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding DuplicateSummary}"
                               Style="{StaticResource SectionHint}"
                               Margin="12,0,0,0"/>
                    <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Str.Tab.Duplicates}" Style="{StaticResource SectionTitle}"/>
                </DockPanel>
            </Border>

            <DataGrid Grid.Row="1"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      ItemsSource="{Binding Duplicates}"
                      VerticalAlignment="Stretch"
                      Visibility="{Binding HasDuplicates, Converter={StaticResource BoolToVis}}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource Str.Col.Key}" Binding="{Binding Key}" Width="3*"/>
                    <DataGridTextColumn Header="{DynamicResource Str.Col.DupCount}" Binding="{Binding Count}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <views:EmptyStateView Grid.Row="1"
                                  VerticalAlignment="Top"
                                  HorizontalAlignment="Stretch"
                                  Title="{DynamicResource Str.Empty.NoDuplicates.Title}"
                                  Hint="{DynamicResource Str.Empty.NoDuplicates.Hint}"
                                  Visibility="{Binding HasDuplicates, Converter={StaticResource InverseBoolToVis}}"/>
        </Grid>
    </Border>
</UserControl>
