<UserControl x:Class="ObjectAnalyzer.Desktop.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ObjectAnalyzer.Desktop.Views">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <UniformGrid Columns="4" Margin="0,0,0,14">
            <Border Margin="0,0,10,0" CornerRadius="10" Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                <StackPanel Margin="16,14">
                    <TextBlock Text="对象数" Style="{StaticResource MetricLabel}"/>
                    <TextBlock Text="{Binding TotalObjects, StringFormat={}{0:N0}}" Style="{StaticResource MetricValue}"/>
                </StackPanel>
            </Border>
            <Border Margin="0,0,10,0" CornerRadius="10" Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                <StackPanel Margin="16,14">
                    <TextBlock Text="字段数" Style="{StaticResource MetricLabel}"/>
                    <TextBlock Text="{Binding FieldCount, StringFormat={}{0:N0}}" Style="{StaticResource MetricValue}"/>
                </StackPanel>
            </Border>
            <Border Margin="0,0,10,0" CornerRadius="10" Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                <StackPanel Margin="16,14">
                    <TextBlock Text="重复组" Style="{StaticResource MetricLabel}"/>
                    <TextBlock Text="{Binding DuplicateGroups, StringFormat={}{0:N0}}" Style="{StaticResource MetricValue}"/>
                </StackPanel>
            </Border>
            <Border Margin="0" CornerRadius="10" Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                <StackPanel Margin="16,14">
                    <TextBlock Text="质量问题" Style="{StaticResource MetricLabel}"/>
                    <TextBlock Text="{Binding QualityIssueCount, StringFormat={}{0:N0}}" Style="{StaticResource MetricValue}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="1"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,10">
                    <TextBox DockPanel.Dock="Right"
                             Width="220"
                             Style="{StaticResource PathTextBox}"
                             Text="{Binding FieldFilter, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="按字段名 / 类型 / 语义过滤"/>
                    <TextBlock Text="字段概览" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                    <TextBlock Text="搜索 · 双击查看取值"
                               Style="{StaticResource SectionHint}"
                               Margin="12,0,12,0"
                               VerticalAlignment="Center"/>
                </DockPanel>

                <DataGrid Grid.Row="1"
                          x:Name="FieldsGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          ItemsSource="{Binding FilteredFields}"
                          MouseDoubleClick="FieldsGrid_MouseDoubleClick"
                          Visibility="{Binding HasFilteredFields, Converter={StaticResource BoolToVis}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="字段" Binding="{Binding FieldName}" Width="2*"/>
                        <DataGridTextColumn Header="类型" Binding="{Binding PrimaryType}" Width="*"/>
                        <DataGridTextColumn Header="覆盖率" Binding="{Binding CoverageText}" Width="*"/>
                        <DataGridTextColumn Header="非空" Binding="{Binding Count}" Width="*"/>
                        <DataGridTextColumn Header="空值" Binding="{Binding NullCount}" Width="*"/>
                        <DataGridTextColumn Header="唯一值" Binding="{Binding DistinctCount}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <views:EmptyStateView Grid.Row="1"
                                      VerticalAlignment="Top"
                                      Glyph="◫"
                                      Title="没有匹配的字段"
                                      Hint="调整搜索关键词，或先完成一次分析。"
                                      Visibility="{Binding HasFilteredFields, Converter={StaticResource InverseBoolToVis}}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
