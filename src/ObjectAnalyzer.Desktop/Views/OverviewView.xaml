<UserControl x:Class="ObjectAnalyzer.Desktop.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:ObjectAnalyzer.Desktop.Views">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <UniformGrid Columns="4" Margin="0,0,0,14">
            <Border Margin="0,0,10,0" CornerRadius="12" Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="1">
                <Grid>
                    <Border Width="3" HorizontalAlignment="Left" Background="{DynamicResource Brush.Primary}"
                            CornerRadius="12,0,0,12"/>
                    <StackPanel Margin="16,14">
                        <TextBlock Text="对象数" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding TotalObjects, StringFormat={}{0:N0}}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Margin="0,0,10,0" CornerRadius="12" Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="1">
                <Grid>
                    <Border Width="3" HorizontalAlignment="Left" Background="{DynamicResource Brush.Success}"
                            CornerRadius="12,0,0,12"/>
                    <StackPanel Margin="16,14">
                        <TextBlock Text="字段数" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding FieldCount, StringFormat={}{0:N0}}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Margin="0,0,10,0" CornerRadius="12" Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="1">
                <Grid>
                    <Border Width="3" HorizontalAlignment="Left" Background="#A78BFA"
                            CornerRadius="12,0,0,12"/>
                    <StackPanel Margin="16,14">
                        <TextBlock Text="重复组" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding DuplicateGroups, StringFormat={}{0:N0}}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Margin="0" CornerRadius="12" Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="1">
                <Grid>
                    <Border Width="3" HorizontalAlignment="Left" Background="{DynamicResource Brush.Danger}"
                            CornerRadius="12,0,0,12"/>
                    <StackPanel Margin="16,14">
                        <TextBlock Text="质量问题" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding QualityIssueCount, StringFormat={}{0:N0}}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </UniformGrid>

        <Border Grid.Row="1"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.BorderSubtle}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,10">
                    <TextBlock Text="字段概览" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="双击行查看该字段全部取值 · 按字段名排序"
                               Style="{StaticResource SectionHint}"
                               Margin="12,2,0,0"
                               VerticalAlignment="Center"/>
                </DockPanel>

                <DataGrid Grid.Row="1"
                          x:Name="FieldsGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          ItemsSource="{Binding Fields}"
                          MouseDoubleClick="FieldsGrid_MouseDoubleClick"
                          Visibility="{Binding HasFields, Converter={StaticResource BoolToVis}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="字段" Binding="{Binding FieldName}" Width="2*"/>
                        <DataGridTextColumn Header="类型" Binding="{Binding PrimaryType}" Width="*"/>
                        <DataGridTextColumn Header="覆盖率" Binding="{Binding CoverageText}" Width="*"/>
                        <DataGridTextColumn Header="非空" Binding="{Binding Count}" Width="*"/>
                        <DataGridTextColumn Header="空值" Binding="{Binding NullCount}" Width="*"/>
                        <DataGridTextColumn Header="唯一值" Binding="{Binding DistinctCount}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <views:EmptyStateView Grid.Row="1"
                                      VerticalAlignment="Top"
                                      Glyph="◫"
                                      Title="还没有字段统计"
                                      Hint="选择数据文件并点击「开始分析」后，字段覆盖率与类型分布会显示在这里。双击字段行可查看取值详情。"
                                      Visibility="{Binding HasFields, Converter={StaticResource InverseBoolToVis}}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
