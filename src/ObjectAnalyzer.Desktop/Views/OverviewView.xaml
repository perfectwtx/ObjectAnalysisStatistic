<UserControl x:Class="ObjectAnalyzer.Desktop.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ObjectAnalyzer.Desktop.Views">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource KpiStrip}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource KpiCell}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Str.Metric.Objects}" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding TotalObjects, StringFormat={}{0:N0}}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource KpiCell}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Str.Metric.Fields}" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding FieldCount, StringFormat={}{0:N0}}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource KpiCell}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Str.Metric.DuplicateGroups}" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding DuplicateGroups, StringFormat={}{0:N0}}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource KpiCellLast}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Str.Metric.Issues}" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding QualityIssueCount, StringFormat={}{0:N0}}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource ToolPageHeaderBar}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Str.Overview.Summary}" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{DynamicResource Str.Overview.Description}" Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <StackPanel Visibility="{Binding HasFields, Converter={StaticResource BoolToVis}}">
                    <Border Style="{StaticResource KpiStrip}" Margin="0,0,0,16">
                        <UniformGrid Columns="3">
                            <Border Style="{StaticResource KpiCell}"><StackPanel>
                                <TextBlock Text="{DynamicResource Str.Overview.AverageCoverage}" Style="{StaticResource MetricLabel}"/>
                                <TextBlock Text="{Binding AverageCoverageText}" Style="{StaticResource MetricValue}"/>
                            </StackPanel></Border>
                            <Border Style="{StaticResource KpiCell}"><StackPanel>
                                <TextBlock Text="{DynamicResource Str.Overview.FullCoverage}" Style="{StaticResource MetricLabel}"/>
                                <TextBlock Text="{Binding FullCoverageFields}" Style="{StaticResource MetricValue}"/>
                            </StackPanel></Border>
                            <Border Style="{StaticResource KpiCellLast}"><StackPanel>
                                <TextBlock Text="{DynamicResource Str.Overview.WithNulls}" Style="{StaticResource MetricLabel}"/>
                                <TextBlock Text="{Binding FieldsWithNulls}" Style="{StaticResource MetricValue}"/>
                            </StackPanel></Border>
                        </UniformGrid>
                    </Border>
                    <TextBlock Text="{DynamicResource Str.Overview.Types}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding FieldTypeSummary}" Margin="0,0,0,18">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Border BorderBrush="{DynamicResource Brush.Border}" Background="{DynamicResource Brush.Surface}" BorderThickness="1" CornerRadius="6" Padding="16,12" Margin="0,0,10,8" MinWidth="130">
                                <StackPanel>
                                    <TextBlock Text="{Binding TypeName}" Foreground="{DynamicResource Brush.TextMuted}"/>
                                    <TextBlock Text="{Binding Count}" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{DynamicResource Str.Overview.Gaps}" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="{DynamicResource Str.Overview.GapsHint}" Foreground="{DynamicResource Brush.TextMuted}" FontSize="11" Margin="0,4,0,10" TextWrapping="Wrap"/>
                    <ItemsControl ItemsSource="{Binding LowestCoverageFields}" MouseDoubleClick="FieldCards_MouseDoubleClick">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="12" Background="{DynamicResource Brush.Surface}" Cursor="Hand">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="75"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding FieldName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FieldName}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                    <ProgressBar Grid.Column="1" Height="6" Minimum="0" Maximum="1" Value="{Binding CoverageRatio, Mode=OneWay}" IsHitTestVisible="False"/>
                                    <TextBlock Grid.Column="2" Text="{Binding CoverageText}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </Grid>
                            </Border>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{DynamicResource Str.Overview.NoGaps}" Margin="12" Foreground="{DynamicResource Brush.TextMuted}" Visibility="{Binding HasCoverageGaps, Converter={StaticResource InverseBoolToVis}}"/>
                    <TextBlock Text="{DynamicResource Str.Overview.CoverageNote}" Margin="0,14,0,0" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap"/>
                </StackPanel>
                <views:EmptyStateView Title="{DynamicResource Str.Overview.EmptyTitle}" Hint="{DynamicResource Str.Overview.EmptyHint}" Visibility="{Binding HasFields, Converter={StaticResource InverseBoolToVis}}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
