<UserControl x:Class="ObjectAnalyzer.Desktop.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,10,0,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <UniformGrid Columns="4" Margin="0,0,0,12">
            <Border Background="White" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,8,0">
                <StackPanel><TextBlock Text="对象数" Foreground="#667085"/><TextBlock Text="{Binding TotalObjects, StringFormat={}{0:N0}}" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
            </Border>
            <Border Background="White" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,8,0">
                <StackPanel><TextBlock Text="字段数" Foreground="#667085"/><TextBlock Text="{Binding FieldCount, StringFormat={}{0:N0}}" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
            </Border>
            <Border Background="White" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,8,0">
                <StackPanel><TextBlock Text="重复组" Foreground="#667085"/><TextBlock Text="{Binding DuplicateGroups, StringFormat={}{0:N0}}" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
            </Border>
            <Border Background="White" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="8" Padding="14">
                <StackPanel><TextBlock Text="质量问题" Foreground="#667085"/><TextBlock Text="{Binding QualityIssueCount, StringFormat={}{0:N0}}" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
            </Border>
        </UniformGrid>
        <Border Grid.Row="1" Background="White" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="10" Padding="12">
            <DataGrid AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal" ItemsSource="{Binding Fields}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="字段" Binding="{Binding FieldName}" Width="2*"/>
                    <DataGridTextColumn Header="类型" Binding="{Binding PrimaryType}" Width="*"/>
                    <DataGridTextColumn Header="覆盖率" Binding="{Binding CoverageText}" Width="*"/>
                    <DataGridTextColumn Header="非空" Binding="{Binding Count}" Width="*"/>
                    <DataGridTextColumn Header="空值" Binding="{Binding NullCount}" Width="*"/>
                    <DataGridTextColumn Header="唯一值" Binding="{Binding DistinctCount}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>