<UserControl x:Class="ObjectAnalyzer.Desktop.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ObjectAnalyzer.Desktop.Views">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource KpiStrip}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource KpiCell}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Str.Metric.Objects}" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding TotalObjects, StringFormat={}{0:N0}}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource KpiCell}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Str.Metric.Fields}" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding FieldCount, StringFormat={}{0:N0}}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource KpiCell}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Str.Metric.DuplicateGroups}" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding DuplicateGroups, StringFormat={}{0:N0}}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource KpiCellLast}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Str.Metric.Issues}" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding QualityIssueCount, StringFormat={}{0:N0}}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource ToolPage}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Style="{StaticResource ToolPageHeaderBar}">
                    <DockPanel LastChildFill="True">
                        <TextBox DockPanel.Dock="Right" Width="260" MinWidth="140" MaxWidth="260"
                                 HorizontalAlignment="Right" MinHeight="30" Margin="12,0,0,0"
                                 Style="{StaticResource PathTextBox}"
                                 Text="{Binding FieldFilter, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{DynamicResource Str.Filter.Tooltip}"/>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Str.Overview.Fields}" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="{DynamicResource Str.Overview.Description}"
                                       Margin="0,3,0,0" FontSize="11"
                                       Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding HasFilteredFields, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding FilteredFields}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" IsItemsHost="True"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="270" MinHeight="142" Margin="0,0,10,10" Padding="14"
                                        Background="{DynamicResource Brush.Surface}"
                                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                        CornerRadius="6">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <DockPanel LastChildFill="True">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding CoverageText}"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Brush.Text}"
                                                       Margin="12,0,0,0"/>
                                            <TextBlock Text="{Binding FieldName}" FontSize="13" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding FieldName}"
                                                       Foreground="{DynamicResource Brush.Text}"/>
                                        </DockPanel>
                                        <ProgressBar Grid.Row="1" Margin="0,10,0,0" Height="6"
                                                     Minimum="0" Maximum="1" Value="{Binding CoverageRatio}"
                                                     IsHitTestVisible="False" BorderThickness="0"/>
                                        <StackPanel Grid.Row="2" Margin="0,10,0,0">
                                            <WrapPanel>
                                                <Border Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}"
                                                        BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,6">
                                                    <TextBlock Text="{Binding PrimaryType}" FontSize="10"
                                                               Foreground="{DynamicResource Brush.TextMuted}"/>
                                                </Border>
                                                <Border Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}"
                                                        BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,0,6"
                                                        Visibility="{Binding SemanticType, Converter={StaticResource StringToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding SemanticType}" FontSize="10"
                                                               Foreground="{DynamicResource Brush.TextMuted}"/>
                                                </Border>
                                            </WrapPanel>
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource Str.Col.NonNull}" FontSize="10"
                                                           Foreground="{DynamicResource Brush.TextMuted}"/>
                                                <TextBlock Text="{Binding Count, StringFormat={}{0:N0}}" Margin="0,4,0,0"
                                                           FontSize="13" FontWeight="SemiBold"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{DynamicResource Str.Col.Null}" FontSize="10"
                                                           Foreground="{DynamicResource Brush.TextMuted}"/>
                                                <TextBlock Text="{Binding NullCount, StringFormat={}{0:N0}}" Margin="0,4,0,0"
                                                           FontSize="13" FontWeight="SemiBold"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{DynamicResource Str.Col.Distinct}" FontSize="10"
                                                           Foreground="{DynamicResource Brush.TextMuted}"/>
                                                <TextBlock Text="{Binding DistinctDisplayText}" Margin="0,4,0,0"
                                                           FontSize="13" FontWeight="SemiBold"/>
                                            </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <views:EmptyStateView Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Top"
                                      Title="{DynamicResource Str.Empty.NoFields.Title}"
                                      Hint="{DynamicResource Str.Empty.NoFields.Hint}"
                                      Visibility="{Binding HasFilteredFields, Converter={StaticResource InverseBoolToVis}}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>