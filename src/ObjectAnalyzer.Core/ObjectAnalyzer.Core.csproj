<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ObjectAnalyzer</RootNamespace>
    <Description>Dependency-free values, statistics, rules, schema inference and result contracts.</Description>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ObjectAnalyzer.Parsing" />
    <InternalsVisibleTo Include="ObjectAnalyzer.Exporting" />
    <InternalsVisibleTo Include="ObjectAnalyzer.Application" />
    <InternalsVisibleTo Include="ObjectAnalyzer.Platform" />
    <InternalsVisibleTo Include="ObjectAnalyzer.Infrastructure" />
    <InternalsVisibleTo Include="ObjectAnalyzer.Hosting" />
  </ItemGroup>
</Project>
