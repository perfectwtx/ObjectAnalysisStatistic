{
  "selectedFields": ["id", "email", "payload", "status", "score"],
  "filter": "status in ['active'] AND payload.age >= 25",
  "fields": {
    "id": {
      "primaryType": "String"
    },
    "email": {
      "primaryType": "String"
    },
    "payload": {
      "transform": {
        "type": "base64",
        "parse": "json"
      }
    },
    "status": {
      "primaryType": "String",
      "defaultValue": "active",
      "enumValues": ["active", "disabled", "pending"]
    },
    "score": {
      "primaryType": "Number"
    }
  }
}